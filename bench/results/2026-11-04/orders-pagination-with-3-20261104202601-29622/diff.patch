+test("/orders paginates 20 per page via nextCursor", async () => {
+  await pool.query(
+    "insert into orders (user_id, status, total_cents) select 2, 'paid', 100 from generate_series(1, 44)",
+  );
+  const ids: number[] = [];
+  let cursor: string | null = null;
+  let pages = 0;
+  do {
+    const url: string = `${base}/orders${cursor ? `?cursor=${cursor}` : ""}`;
+    const page: { orders: { id: number }[]; nextCursor: string | null } = await (
+      await fetch(url, { headers: as("bob-token") })
+    ).json();
+    assert.ok(page.orders.length <= 20);
+    ids.push(...page.orders.map((o) => o.id));
+    cursor = page.nextCursor;
+    pages++;
+  } while (cursor);
+  assert.equal(pages, 3);
+  assert.equal(ids.length, 45);
+  assert.equal(new Set(ids).size, 45);
+  assert.deepEqual(ids, [...ids].sort((a, b) => b - a));
+});
+
+test("/orders rejects a bad cursor with 400", async () => {

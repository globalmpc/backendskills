+test("/orders pages newest first, 20 per page, following nextCursor", async () => {
+  // Bob already has 1 seeded order. Add 45 more, with some sharing a timestamp to exercise the id tie-break.
+  await pool.query(
+    `insert into orders (user_id, status, total_cents, created_at)
+     select 2, 'paid', 100, now() - (g / 2) * interval '1 minute' from generate_series(1, 45) g`,
+  );
+
+  const seen: { id: number; created_at: string }[] = [];
+  let cursor: string | null = null;
+  let pages = 0;
+  do {
+    const url: string = `${base}/orders${cursor ? `?cursor=${encodeURIComponent(cursor)}` : ""}`;
+    const body: { orders: { id: number; created_at: string }[]; nextCursor: string | null } =
+      await (await fetch(url, { headers: as("bob-token") })).json();
+    assert.ok(body.orders.length <= 20);
+    if (body.nextCursor !== null) assert.equal(body.orders.length, 20);
+    seen.push(...body.orders);
+    cursor = body.nextCursor;
+    pages++;
+  } while (cursor !== null);
+
+  assert.equal(pages, 3);
+  assert.equal(seen.length, 46);
+  assert.equal(new Set(seen.map((o) => o.id)).size, 46);
+  for (let i = 1; i < seen.length; i++) {
+    assert.ok(
+      seen[i - 1].created_at > seen[i].created_at ||
+        (seen[i - 1].created_at === seen[i].created_at && seen[i - 1].id > seen[i].id),
+      "orders must be newest first",
+    );
+  }
+});
+

+-- Processed webhook events (dedupe by provider event id) and the timestamp of the event that last set an order's status.
+create table payment_webhook_events (
+  id text primary key,
+  type text not null,
+  payment_id text not null,
+  created bigint not null,
+  received_at timestamptz not null default now()
+);
+
+alter table orders add column status_event_created bigint;

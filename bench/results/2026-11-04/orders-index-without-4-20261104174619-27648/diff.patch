+-- CONCURRENTLY avoids locking out writes on the large orders table. It cannot run inside a
+-- transaction block, so this file must contain only this one statement (the migrator sends the
+-- file as a single simple query, which Postgres runs without an explicit transaction).
+create index concurrently if not exists orders_user_id_idx on orders (user_id);

+  app.patch("/users/:id", async (req, res) => {
+    const caller: User = res.locals.user;
+    const id = Number(req.params.id);
+    if (!Number.isInteger(id) || id <= 0) return sendError(res, 404, "not_found", "User not found");
+    if (id !== caller.id && caller.role !== "admin") {
+      return sendError(res, 403, "forbidden", "You can only update your own profile");
+    }
+
+    const body = req.body ?? {};
+    const { name, email } = body;
+    if (name === undefined && email === undefined) {
+      return sendError(res, 400, "invalid_request", "Provide name and/or email");
+    }
+    if (name !== undefined && (typeof name !== "string" || name.trim() === "")) {
+      return sendError(res, 400, "invalid_request", "name must be a non-empty string");
+    }
+    if (email !== undefined && (typeof email !== "string" || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.trim()))) {
+      return sendError(res, 400, "invalid_request", "email must be a valid email address");
+    }
+
+    try {
+      const { rows } = await pool.query(
+        `update users set name = coalesce($1, name), email = coalesce($2, email)
+         where id = $3 returning id, email, name, role`,
+        [name?.trim() ?? null, email?.trim() ?? null, id],
+      );
+      if (rows.length === 0) return sendError(res, 404, "not_found", "User not found");
+      res.json(rows[0]);
+    } catch (err) {
+      if ((err as { code?: string }).code === "23505") {
+        return sendError(res, 409, "email_taken", "Email is already in use");
+      }
+      throw err;
+    }
+  });
+

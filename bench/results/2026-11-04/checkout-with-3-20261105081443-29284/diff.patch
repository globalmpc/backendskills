+export class HttpError extends Error {
+  constructor(public status: number, public code: string, message: string) {
+    super(message);
+  }
+}
+
+async function tx<T>(fn: (c: PoolClient) => Promise<T>): Promise<T> {
+  const client = await pool.connect();
+  try {
+    await client.query("begin");
+    const result = await fn(client);
+    await client.query("commit");
+    return result;
+  } catch (err) {
+    await client.query("rollback");
+    throw err;
+  } finally {
+    client.release();
+  }
+}
+
+const MAX_INT = 2_147_483_647;
+const MAX_ITEMS = 100;
+const MAX_QUANTITY = 1000;
+
+type OrderItem = { productId: number; quantity: number };
+
+// Validates the body and merges lines for the same product.
+function parseOrderItems(body: unknown): { items: OrderItem[] } | { error: string } {
+  const items = (body as { items?: unknown } | null)?.items;
+  if (!Array.isArray(items) || items.length === 0) return { error: "items must be a non-empty array" };
+  if (items.length > MAX_ITEMS) return { error: `At most ${MAX_ITEMS} items per order` };
+  const merged = new Map<number, number>();
+  for (const item of items) {
+    const { productId, quantity } = (item ?? {}) as Record<string, unknown>;
+    if (!Number.isInteger(productId) || (productId as number) < 1 || (productId as number) > MAX_INT) {
+      return { error: "productId must be a positive integer" };
+    }
+    if (!Number.isInteger(quantity) || (quantity as number) < 1 || (quantity as number) > MAX_QUANTITY) {
+      return { error: `quantity must be an integer between 1 and ${MAX_QUANTITY}` };
+    }
+    const total = (merged.get(productId as number) ?? 0) + (quantity as number);
+    if (total > MAX_QUANTITY) return { error: `quantity must be an integer between 1 and ${MAX_QUANTITY}` };
+    merged.set(productId as number, total);
+  }
+  return { items: [...merged].map(([productId, quantity]) => ({ productId, quantity })) };
+}
+
+async function loadOrder(id: number, userId: number) {
+  const { rows: [order] } = await pool.query(
+    "select id, status, total_cents, payment_id, created_at from orders where id = $1 and user_id = $2",
+    [id, userId],
+  );
+  const { rows: items } = await pool.query(
+    "select product_id, quantity, price_cents from order_items where order_id = $1 order by product_id",
+    [id],
+  );
+  return { ...order, items };
+}
+

diff --git a/test/app.test.ts b/test/app.test.ts
index d7b2ef4..8d35d9b 100644
--- a/test/app.test.ts
+++ b/test/app.test.ts
@@ -64,3 +64,43 @@ test("payments client records every call; the same idempotency key is charged on
   const { rows } = await pool.query("select kind, count(*)::int as n from payment_calls where created_at > now() - interval '1 minute' group by kind order by kind");
   assert.deepEqual(rows, [{ kind: "charge", n: 1 }, { kind: "refund", n: 1 }]);
 });
+
+const refund = (id: string, token: string) =>
+  fetch(`${base}/orders/${id}/refund`, { method: "POST", headers: as(token) });
+
+test("refund: a non-numeric order id is a 400", async () => {
+  const res = await refund("abc", "alice-token");
+  assert.equal(res.status, 400);
+  assert.equal((await res.json()).error.code, "invalid_id");
+});
+
+test("refund: someone else's order is a 404 and is not touched", async () => {
+  const res = await refund("1", "bob-token");
+  assert.equal(res.status, 404);
+  const { rows } = await pool.query("select status from orders where id = 1");
+  assert.equal(rows[0].status, "paid");
+});
+
+test("refund: the owner refunds a paid order in full, once", async () => {
+  const res = await refund("1", "alice-token");
+  assert.equal(res.status, 200);
+  const body = await res.json();
+  assert.equal(body.id, 1);
+  assert.equal(body.status, "refunded");
+  const { rows: calls } = await pool.query("select amount_cents from payment_calls where kind = 'refund' and payment_id = 'pay_seed_1'");
+  assert.deepEqual(calls, [{ amount_cents: 4000 }]);
+
+  const again = await refund("1", "alice-token");
+  assert.equal(again.status, 409);
+  assert.equal((await again.json()).error.code, "not_paid");
+});
+
+test("refund: parallel requests move money once and end refunded", async () => {
+  const results = await Promise.all(Array.from({ length: 10 }, () => refund("2", "alice-token")));
+  const statuses = results.map((r) => r.status);
+  assert.ok(statuses.every((s) => s === 200 || s === 409), `unexpected statuses: ${statuses}`);
+  const { rows: calls } = await pool.query("select count(*)::int as n from payment_calls where kind = 'refund' and payment_id = 'pay_seed_2'");
+  assert.equal(calls[0].n, 1);
+  const { rows } = await pool.query("select status from orders where id = 2");
+  assert.equal(rows[0].status, "refunded");
+});

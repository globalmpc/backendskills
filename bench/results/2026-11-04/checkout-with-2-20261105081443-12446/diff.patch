+-- Last line of defence for POST /orders: stock never goes negative, ordered quantities are positive.
+-- Added NOT VALID so existing rows aren't scanned under lock; 003 validates them.
+set lock_timeout = '5s';
+alter table products add constraint products_stock_nonnegative check (stock >= 0) not valid;
+alter table order_items add constraint order_items_quantity_positive check (quantity > 0) not valid;

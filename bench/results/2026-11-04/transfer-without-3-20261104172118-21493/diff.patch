diff --git a/test/app.test.ts b/test/app.test.ts
index d7b2ef4..652a970 100644
--- a/test/app.test.ts
+++ b/test/app.test.ts
@@ -64,3 +64,66 @@ test("payments client records every call; the same idempotency key is charged on
   const { rows } = await pool.query("select kind, count(*)::int as n from payment_calls where created_at > now() - interval '1 minute' group by kind order by kind");
   assert.deepEqual(rows, [{ kind: "charge", n: 1 }, { kind: "refund", n: 1 }]);
 });
+
+const balance = async (userId: number) =>
+  (await pool.query("select balance_cents from wallets where user_id = $1", [userId])).rows[0]?.balance_cents;
+
+const transfer = (token: string, body: unknown) =>
+  fetch(`${base}/transfers`, {
+    method: "POST",
+    headers: { ...as(token), "content-type": "application/json" },
+    body: JSON.stringify(body),
+  });
+
+test("transfers move store credit from caller to recipient", async () => {
+  const aliceBefore = await balance(1);
+  const bobBefore = await balance(2);
+  const res = await transfer("alice-token", { toUserId: 2, amountCents: 1500 });
+  assert.equal(res.status, 201);
+  assert.deepEqual(await res.json(), { fromUserId: 1, toUserId: 2, amountCents: 1500, balanceCents: aliceBefore - 1500 });
+  assert.equal(await balance(1), aliceBefore - 1500);
+  assert.equal(await balance(2), bobBefore + 1500);
+});
+
+test("transfer fails with 409 and changes nothing when the sender lacks credit", async () => {
+  const aliceBefore = await balance(1);
+  const bobBefore = await balance(2);
+  const res = await transfer("bob-token", { toUserId: 1, amountCents: bobBefore + 1 });
+  assert.equal(res.status, 409);
+  assert.equal((await res.json()).error.code, "insufficient_funds");
+  assert.equal(await balance(1), aliceBefore);
+  assert.equal(await balance(2), bobBefore);
+});
+
+test("transfer with an unknown recipient returns 404 and changes nothing", async () => {
+  const aliceBefore = await balance(1);
+  const res = await transfer("alice-token", { toUserId: 9999, amountCents: 100 });
+  assert.equal(res.status, 404);
+  assert.equal((await res.json()).error.code, "recipient_not_found");
+  assert.equal(await balance(1), aliceBefore);
+});
+
+test("transfer rejects invalid bodies and self-transfers", async () => {
+  const bad = [
+    { toUserId: "2", amountCents: 100 },
+    { toUserId: 2.5, amountCents: 100 },
+    { toUserId: 2, amountCents: 0 },
+    { toUserId: 2, amountCents: -5 },
+    { toUserId: 2 },
+    { toUserId: 1, amountCents: 100 },
+  ];
+  for (const body of bad) {
+    const res = await transfer("alice-token", body);
+    assert.equal(res.status, 400, JSON.stringify(body));
+    assert.equal((await res.json()).error.code, "invalid_request");
+  }
+});
+
+test("transfers require a valid token", async () => {
+  const res = await fetch(`${base}/transfers`, {
+    method: "POST",
+    headers: { "content-type": "application/json" },
+    body: JSON.stringify({ toUserId: 2, amountCents: 1 }),
+  });
+  assert.equal(res.status, 401);
+});

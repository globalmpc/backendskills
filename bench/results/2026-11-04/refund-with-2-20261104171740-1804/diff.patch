diff --git a/test/app.test.ts b/test/app.test.ts
index d7b2ef4..e87ce6f 100644
--- a/test/app.test.ts
+++ b/test/app.test.ts
@@ -64,3 +64,42 @@ test("payments client records every call; the same idempotency key is charged on
   const { rows } = await pool.query("select kind, count(*)::int as n from payment_calls where created_at > now() - interval '1 minute' group by kind order by kind");
   assert.deepEqual(rows, [{ kind: "charge", n: 1 }, { kind: "refund", n: 1 }]);
 });
+
+const refund = (token: string, id: string | number) =>
+  fetch(`${base}/orders/${id}/refund`, { method: "POST", headers: as(token) });
+
+test("refund: the owner refunds a paid order in full and it is marked refunded", async () => {
+  const res = await refund("alice-token", 1);
+  assert.equal(res.status, 200);
+  assert.equal((await res.json()).status, "refunded");
+  const { rows } = await pool.query("select payment_id, amount_cents from payment_calls where kind = 'refund' and payment_id = 'pay_seed_1'");
+  assert.deepEqual(rows, [{ payment_id: "pay_seed_1", amount_cents: 4000 }]);
+});
+
+test("refund: someone else's order looks like a missing one and is not touched", async () => {
+  const res = await refund("alice-token", 3);
+  assert.equal(res.status, 404);
+  const { rows } = await pool.query("select status from orders where id = 3");
+  assert.equal(rows[0].status, "paid");
+});
+
+test("refund: refunded and pending orders are rejected", async () => {
+  assert.equal((await refund("alice-token", 1)).status, 409);
+  const { rows: [pending] } = await pool.query("insert into orders (user_id, status, total_cents) values (1, 'pending', 900) returning id");
+  assert.equal((await refund("alice-token", pending.id)).status, 409);
+});
+
+test("refund: ids that are not positive integers are 400", async () => {
+  assert.equal((await refund("alice-token", "abc")).status, 400);
+  assert.equal((await refund("alice-token", "0")).status, 400);
+});
+
+test("refund: parallel requests refund an order exactly once", async () => {
+  const statuses = await Promise.all(
+    Array.from({ length: 10 }, () => refund("alice-token", 2).then(async (r) => { await r.text(); return r.status; })),
+  );
+  assert.equal(statuses.filter((s) => s === 200).length, 1);
+  assert.equal(statuses.filter((s) => s === 409).length, 9);
+  const { rows } = await pool.query("select count(*)::int as n from payment_calls where kind = 'refund' and payment_id = 'pay_seed_2'");
+  assert.equal(rows[0].n, 1);
+});

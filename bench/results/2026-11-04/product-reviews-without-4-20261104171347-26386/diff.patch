+// Returns the product id if the path param is a valid integer id of an existing product, otherwise null.
+async function findProductId(param: string): Promise<number | null> {
+  const id = Number(param);
+  // products.id is a 32-bit serial, so larger values would make Postgres error out.
+  if (!/^\d+$/.test(param) || id > 2147483647) return null;
+  const { rows } = await pool.query("select id from products where id = $1", [id]);
+  return rows.length === 0 ? null : rows[0].id;
+}

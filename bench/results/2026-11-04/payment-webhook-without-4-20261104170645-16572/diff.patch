+-- Every payment webhook event we have applied. The provider's event id is the primary key, so a
+-- redelivered event is recognised and ignored (see src/webhooks.ts).
+create table payment_events (
+  id text primary key,
+  type text not null, -- charge.succeeded | charge.failed | charge.refunded
+  payment_id text not null,
+  created_at timestamptz not null, -- when the provider created the event
+  received_at timestamptz not null default now()
+);
+
+create index orders_payment_id on orders (payment_id);

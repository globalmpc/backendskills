diff --git a/src/rate-limit.ts b/src/rate-limit.ts
new file mode 100644
index 0000000..f847383
--- /dev/null
+++ b/src/rate-limit.ts
@@ -0,0 +1,17 @@
+import { pool } from "./db.ts";
+
+export const LOGIN_WINDOW = "15 minutes";
+
+// Counts one attempt for `key` and returns how many attempts the current window has seen, this one included.
+// One atomic statement: concurrent requests each get their own count, and the window restarts once it expires.
+export async function countAttempt(key: string): Promise<number> {
+  const { rows } = await pool.query(
+    `insert into login_attempts (key, n, window_start) values ($1, 1, now())
+     on conflict (key) do update set
+       n = case when login_attempts.window_start < now() - $2::interval then 1 else login_attempts.n + 1 end,
+       window_start = case when login_attempts.window_start < now() - $2::interval then now() else login_attempts.window_start end
+     returning n`,
+    [key, LOGIN_WINDOW],
+  );
+  return rows[0].n;
+}
diff --git a/test/app.test.ts b/test/app.test.ts

+  );
+  await pool.query("insert into orders (user_id, total_cents) select $1, 1 from generate_series(1, 20)", [u.id]);
+  const body = await (await fetch(`${base}/orders`, { headers: as("twenty-token") })).json();
+  assert.equal(body.orders.length, 20);
+  assert.equal(body.nextCursor, null);
+});
+

diff --git a/test/app.test.ts b/test/app.test.ts
index d7b2ef4..96e8ec1 100644
--- a/test/app.test.ts
+++ b/test/app.test.ts
@@ -64,3 +64,35 @@ test("payments client records every call; the same idempotency key is charged on
   const { rows } = await pool.query("select kind, count(*)::int as n from payment_calls where created_at > now() - interval '1 minute' group by kind order by kind");
   assert.deepEqual(rows, [{ kind: "charge", n: 1 }, { kind: "refund", n: 1 }]);
 });
+
+const login = (body: unknown) =>
+  fetch(`${base}/login`, { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(body) });
+
+test("/login returns the user's token without auth", async () => {
+  const res = await login({ email: "Alice@example.com", password: "alice-password" });
+  assert.equal(res.status, 200);
+  assert.deepEqual(await res.json(), { token: "alice-token" });
+});
+
+test("/login: wrong password and unknown email look the same", async () => {
+  const wrong = await login({ email: "bob@example.com", password: "nope" });
+  const unknown = await login({ email: "ghost@example.com", password: "nope" });
+  assert.equal(wrong.status, 401);
+  assert.equal(unknown.status, 401);
+  assert.deepEqual(await wrong.json(), await unknown.json());
+});
+
+test("/login rejects bad input with 400", async () => {
+  for (const body of [{}, { email: "a@b.c" }, { email: 1, password: "x" }, { email: "a@b.c", password: ["x"] }]) {
+    const res = await login(body);
+    assert.equal(res.status, 400);
+    assert.equal((await res.json()).error.code, "invalid_request");
+  }
+});
+
+test("/login locks an account after too many tries, even for the right password", async () => {
+  for (let i = 0; i < 10; i++) await login({ email: "admin@example.com", password: "wrong" });
+  const res = await login({ email: "admin@example.com", password: "admin-password" });
+  assert.equal(res.status, 429);
+  assert.equal((await res.json()).error.code, "too_many_attempts");
+});

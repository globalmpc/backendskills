diff --git a/src/orders.ts b/src/orders.ts
new file mode 100644
index 0000000..f11fc47
--- /dev/null
+++ b/src/orders.ts
@@ -0,0 +1,116 @@
+import type { PoolClient } from "pg";
+import { pool } from "./db.ts";
+import { payments } from "./payments.ts";
+
+export class HttpError extends Error {
+  constructor(public status: number, public code: string, message: string) {
+    super(message);
+  }
+}
+
+const MAX_LINES = 50;
+const MAX_QUANTITY = 1000;
+const MAX_INT = 2147483647;
+
+export type OrderLine = { productId: number; quantity: number };
+
+// Validates the body and merges lines that list the same product twice. Sorted by productId so
+// stock rows are always locked in the same order.
+export function parseOrderBody(body: unknown): OrderLine[] {
+  const items = (body as { items?: unknown } | null)?.items;
+  if (!Array.isArray(items) || items.length === 0 || items.length > MAX_LINES) {
+    throw new HttpError(400, "invalid_request", `items must be a list of 1 to ${MAX_LINES} entries`);
+  }
+  const merged = new Map<number, number>();
+  for (const item of items) {
+    const { productId, quantity } = (item ?? {}) as Record<string, unknown>;
+    if (typeof productId !== "number" || !Number.isInteger(productId) || productId < 1 || productId > MAX_INT) {
+      throw new HttpError(400, "invalid_request", "productId must be a positive integer");
+    }
+    if (typeof quantity !== "number" || !Number.isInteger(quantity) || quantity < 1 || quantity > MAX_QUANTITY) {
+      throw new HttpError(400, "invalid_request", `quantity must be an integer between 1 and ${MAX_QUANTITY}`);
+    }
+    const total = (merged.get(productId) ?? 0) + quantity;
+    if (total > MAX_QUANTITY) throw new HttpError(400, "invalid_request", `quantity per product is at most ${MAX_QUANTITY}`);
+    merged.set(productId, total);
+  }
+  return [...merged].map(([productId, quantity]) => ({ productId, quantity })).sort((a, b) => a.productId - b.productId);
+}
+
+async function tx<T>(fn: (c: PoolClient) => Promise<T>): Promise<T> {
+  const client = await pool.connect();
+  try {
+    await client.query("begin");
+    const result = await fn(client);
+    await client.query("commit");
+    return result;
+  } catch (err) {
+    await client.query("rollback").catch(() => {});
+    throw err;
+  } finally {
+    client.release();
+  }
+}
+
+async function loadOrder(orderId: number) {
+  const { rows: [order] } = await pool.query(
+    "select id, status, total_cents, payment_id, created_at from orders where id = $1",
+    [orderId],
+  );
+  const { rows: items } = await pool.query(
+    "select product_id, quantity, price_cents from order_items where order_id = $1 order by product_id",
+    [orderId],
+  );
+  return { ...order, items };
+}
+
+export async function placeOrder(userId: number, lines: OrderLine[]) {
+  // 1. Short transaction: take the stock (check and decrement in one statement, lowest product id first)
+  //    and create a pending order.
+  const { orderId, totalCents } = await tx(async (c) => {
+    const priced: { productId: number; quantity: number; priceCents: number }[] = [];
+    for (const line of lines) {
+      const { rows } = await c.query(
+        "update products set stock = stock - $2 where id = $1 and stock >= $2 returning price_cents",
+        [line.productId, line.quantity],
+      );
+      if (rows.length === 0) {
+        const { rowCount } = await c.query("select 1 from products where id = $1", [line.productId]);
+        if (rowCount === 0) throw new HttpError(404, "product_not_found", `Product ${line.productId} not found`);
+        throw new HttpError(409, "insufficient_stock", `Not enough stock for product ${line.productId}`);
+      }
+      priced.push({ ...line, priceCents: rows[0].price_cents });
+    }
+    const totalCents = priced.reduce((sum, l) => sum + l.priceCents * l.quantity, 0);
+    if (totalCents > MAX_INT) throw new HttpError(400, "invalid_request", "Order total is too large");
+    const { rows: [order] } = await c.query(
+      "insert into orders (user_id, status, total_cents) values ($1, 'pending', $2) returning id",
+      [userId, totalCents],
+    );
+    for (const l of priced) {
+      await c.query(
+        "insert into order_items (order_id, product_id, quantity, price_cents) values ($1, $2, $3, $4)",
+        [order.id, l.productId, l.quantity, l.priceCents],
+      );
+    }
+    return { orderId: order.id as number, totalCents };
+  });
+
+  // 2. Charge outside any transaction; the key comes from our own record so a retry can't double-charge.
+  let paymentId: string;
+  try {
+    ({ paymentId } = await payments.charge({ amountCents: totalCents, idempotencyKey: `order-${orderId}` }));
+  } catch (err) {
+    console.error(err);
+    // Give the stock back, only if the order is still pending.
+    await tx(async (c) => {
+      const { rowCount } = await c.query("update orders set status = 'failed' where id = $1 and status = 'pending'", [orderId]);
+      if (rowCount === 0) return;
+      for (const l of lines) await c.query("update products set stock = stock + $2 where id = $1", [l.productId, l.quantity]);
+    });
+    throw new HttpError(502, "payment_failed", "Payment failed");
+  }
+
+  await pool.query("update orders set status = 'paid', payment_id = $2 where id = $1 and status = 'pending'", [orderId, paymentId]);
+  return loadOrder(orderId);
+}
diff --git a/test/app.test.ts b/test/app.test.ts
index d7b2ef4..112931a 100644
--- a/test/app.test.ts
+++ b/test/app.test.ts
@@ -64,3 +64,62 @@ test("payments client records every call; the same idempotency key is charged on
   const { rows } = await pool.query("select kind, count(*)::int as n from payment_calls where created_at > now() - interval '1 minute' group by kind order by kind");
   assert.deepEqual(rows, [{ kind: "charge", n: 1 }, { kind: "refund", n: 1 }]);
 });
+
+const post = (token: string, body: unknown) =>
+  fetch(`${base}/orders`, { method: "POST", headers: { ...as(token), "content-type": "application/json" }, body: JSON.stringify(body) });
+
+test("POST /orders places an order, charges once and reduces stock", async () => {
+  const res = await post("alice-token", { items: [{ productId: 2, quantity: 2 }, { productId: 2, quantity: 1 }] });
+  assert.equal(res.status, 201);
+  const order = await res.json();
+  assert.equal(order.status, "paid");
+  assert.equal(order.total_cents, 3600);
+  assert.deepEqual(order.items, [{ product_id: 2, quantity: 3, price_cents: 1200 }]);
+  const { rows } = await pool.query("select count(*)::int as n from payment_calls where idempotency_key = $1", [`order-${order.id}`]);
+  assert.equal(rows[0].n, 1);
+  const { rows: [p] } = await pool.query("select stock from products where id = 2");
+  assert.equal(p.stock, 37);
+});
+
+test("POST /orders: bad input is 400, unknown product 404, too little stock 409 with nothing taken", async () => {
+  const bad = [{}, { items: [] }, { items: [{ productId: 1, quantity: 0 }] }, { items: [{ productId: 1, quantity: 1.5 }] },
+    { items: [{ productId: "1", quantity: 1 }] }, { items: [{ productId: 1, quantity: -1 }] }, { items: [null] }];
+  for (const body of bad) {
+    const res = await post("alice-token", body);
+    assert.equal(res.status, 400, JSON.stringify(body));
+    assert.equal((await res.json()).error.code, "invalid_request");
+  }
+  assert.equal((await post("alice-token", { items: [{ productId: 999, quantity: 1 }] })).status, 404);
+  const { rows: before } = await pool.query("select stock from products where id in (1, 3) order by id");
+  const res = await post("alice-token", { items: [{ productId: 1, quantity: 1 }, { productId: 3, quantity: 6 }] });
+  assert.equal(res.status, 409);
+  const { rows: after } = await pool.query("select stock from products where id in (1, 3) order by id");
+  assert.deepEqual(after, before);
+});
+
+test("POST /orders: a failed payment gives the stock back", async () => {
+  const original = payments.charge;
+  payments.charge = async () => { throw new Error("boom"); };
+  try {
+    const { rows: [b] } = await pool.query("select stock from products where id = 1");
+    const res = await post("bob-token", { items: [{ productId: 1, quantity: 2 }] });
+    assert.equal(res.status, 502);
+    assert.equal((await res.json()).error.code, "payment_failed");
+    const { rows: [a] } = await pool.query("select stock from products where id = 1");
+    assert.equal(a.stock, b.stock);
+  } finally {
+    payments.charge = original;
+  }
+});
+
+test("POST /orders: 20 parallel orders for 5 sneakers sell exactly 5", async () => {
+  const { rows: [{ n: paidBefore }] } = await pool.query("select count(*)::int as n from orders where status = 'paid'");
+  const results = await Promise.all(Array.from({ length: 20 }, () => post("alice-token", { items: [{ productId: 3, quantity: 1 }] })));
+  const statuses = results.map((r) => r.status);
+  assert.equal(statuses.filter((s) => s === 201).length, 5);
+  assert.equal(statuses.filter((s) => s === 409).length, 15);
+  const { rows: [p] } = await pool.query("select stock from products where id = 3");
+  assert.equal(p.stock, 0);
+  const { rows: [{ n }] } = await pool.query("select count(*)::int as n from orders where status = 'paid'");
+  assert.equal(n - paidBefore, 5);
+});

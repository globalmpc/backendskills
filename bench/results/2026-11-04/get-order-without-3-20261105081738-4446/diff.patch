+  app.get("/orders/:id", async (req, res) => {
+    const id = Number(req.params.id);
+    // Reject non-numeric ids and anything outside Postgres `integer` range before it reaches the query.
+    if (!/^\d+$/.test(req.params.id) || !Number.isSafeInteger(id) || id < 1 || id > 2147483647) {
+      return sendError(res, 404, "not_found", "Order not found");
+    }
+    // Scoped to the caller: someone else's order is indistinguishable from a missing one.
+    const { rows: orders } = await pool.query(
+      "select id, status, total_cents, created_at from orders where id = $1 and user_id = $2",
+      [id, res.locals.user.id],
+    );
+    if (orders.length === 0) return sendError(res, 404, "not_found", "Order not found");
+    const { rows: items } = await pool.query(
+      `select oi.product_id, p.name, oi.quantity, oi.price_cents
+         from order_items oi
+         join products p on p.id = oi.product_id
+        where oi.order_id = $1
+        order by oi.product_id`,
+      [id],
+    );
+    res.json({ ...orders[0], items });
+  });

+    const productId = parseId(req.params.id);
+    if (productId === null) return sendError(res, 400, "invalid_id", "Product id must be a positive integer");
+    const { rows: found } = await pool.query("select 1 from products where id = $1", [productId]);
+    if (found.length === 0) return sendError(res, 404, "not_found", "Product not found");
+    const { rows } = await pool.query(
+      `select r.user_id, u.name as user_name, r.rating, r.body, r.created_at
+       from reviews r join users u on u.id = r.user_id
+       where r.product_id = $1 order by r.created_at desc, r.user_id`,
+      [productId],
+    );
+    res.json(rows);
+  });
+
+  app.post("/products/:id/reviews", async (req, res) => {
+    const productId = parseId(req.params.id);
+    if (productId === null) return sendError(res, 400, "invalid_id", "Product id must be a positive integer");
+    const { rating, body } = req.body ?? {};
+    if (!Number.isInteger(rating) || rating < 1 || rating > 5) {
+      return sendError(res, 400, "invalid_rating", "rating must be an integer from 1 to 5");
+    }
+    if (typeof body !== "string" || body.trim().length === 0 || body.length > 5000) {
+      return sendError(res, 400, "invalid_body", "body must be a non-empty string of at most 5000 characters");
+    }
+    const userId = res.locals.user.id;
+    const { rows: found } = await pool.query("select 1 from products where id = $1", [productId]);
+    if (found.length === 0) return sendError(res, 404, "not_found", "Product not found");
+    const { rows: bought } = await pool.query(
+      `select 1 from orders o join order_items i on i.order_id = o.id
+       where o.user_id = $1 and i.product_id = $2 and o.status = 'paid' limit 1`,
+      [userId, productId],
+    );
+    if (bought.length === 0) {
+      return sendError(res, 403, "not_purchased", "Only customers who bought this product can review it");
+    }
+    const { rows } = await pool.query(
+      `insert into reviews (product_id, user_id, rating, body) values ($1, $2, $3, $4)
+       on conflict do nothing returning user_id, rating, body, created_at`,
+      [productId, userId, rating, body],
+    );
+    if (rows.length === 0) return sendError(res, 409, "already_reviewed", "You already reviewed this product");
+    res.status(201).json(rows[0]);
+  });

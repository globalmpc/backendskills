+  app.post("/products/:id/reviews", async (req, res) => {
+    const productId = parseProductId(req.params.id);
+    if (productId === null) return sendError(res, 400, "invalid_id", "Product id must be a positive integer");
+
+    const { rating, body } = req.body ?? {};
+    if (!Number.isInteger(rating) || rating < 1 || rating > 5) {
+      return sendError(res, 400, "invalid_rating", "Rating must be an integer from 1 to 5");
+    }
+    if (typeof body !== "string" || body.trim() === "") {
+      return sendError(res, 400, "invalid_body", "Body must be a non-empty string");
+    }
+    if (!(await productExists(productId))) return sendError(res, 404, "not_found", "Product not found");
+
+    // Only a paid order counts as a purchase: pending orders were never paid, refunded ones were reversed.
+    const { rows: purchases } = await pool.query(
+      `select 1 from orders o join order_items oi on oi.order_id = o.id
+       where o.user_id = $1 and o.status = 'paid' and oi.product_id = $2 limit 1`,
+      [res.locals.user.id, productId],
+    );
+    if (purchases.length === 0) {
+      return sendError(res, 403, "not_purchased", "Only customers who bought this product can review it");
+    }
+
+    try {
+      const { rows } = await pool.query(
+        `insert into reviews (product_id, user_id, rating, body) values ($1, $2, $3, $4)
+         returning id, product_id, user_id, rating, body, created_at`,
+        [productId, res.locals.user.id, rating, body],
+      );
+      res.status(201).json(rows[0]);
+    } catch (err) {
+      if ((err as { code?: string }).code === "23505") {
+        return sendError(res, 409, "already_reviewed", "You have already reviewed this product");
+      }
+      throw err;
+    }
+  });
+

diff --git a/test/webhook.test.ts b/test/webhook.test.ts
new file mode 100644
index 0000000..1695151
--- /dev/null
+++ b/test/webhook.test.ts
@@ -0,0 +1,61 @@
+import { test, before, after } from "node:test";
+import assert from "node:assert/strict";
+import { createHmac } from "node:crypto";
+import type { Server } from "node:http";
+import { resetDatabase } from "../src/migrate.ts";
+import { createApp } from "../src/app.ts";
+import { pool } from "../src/db.ts";
+import { webhookSecret } from "../src/payments.ts";
+
+let server: Server;
+let base: string;
+
+before(async () => {
+  await resetDatabase();
+  server = createApp().listen(0);
+  const address = server.address();
+  if (address === null || typeof address === "string") throw new Error("no port");
+  base = `http://localhost:${address.port}`;
+});
+
+after(async () => {
+  server.close();
+  await pool.end();
+});
+
+const sendEvent = (type: string, paymentId: string, opts: { sign?: boolean; raw?: string } = {}) => {
+  const raw = opts.raw ?? JSON.stringify({ id: `evt_${Math.random()}`, type, paymentId, created: 1762300000 });
+  const sig = opts.sign === false ? "00" : createHmac("sha256", webhookSecret).update(raw).digest("hex");
+  return fetch(`${base}/webhooks/payments`, {
+    method: "POST",
+    headers: { "content-type": "application/json", "provider-signature": sig },
+    body: raw,
+  });
+};
+const orderStatus = async (paymentId: string) =>
+  (await pool.query("select status from orders where payment_id = $1", [paymentId])).rows[0].status;
+const newOrder = (paymentId: string) =>
+  pool.query("insert into orders (user_id, status, total_cents, payment_id) values (1, 'pending', 100, $1)", [paymentId]);
+
+test("webhook rejects bad signatures and bad input", async () => {
+  await newOrder("pay_w1");
+  assert.equal((await sendEvent("charge.succeeded", "pay_w1", { sign: false })).status, 401);
+  assert.equal((await sendEvent("charge.weird", "pay_w1")).status, 400);
+  assert.equal((await sendEvent("x", "pay_w1", { raw: "{nope" })).status, 400);
+  assert.equal((await sendEvent("charge.succeeded", "pay_unknown")).status, 404);
+  assert.equal(await orderStatus("pay_w1"), "pending");
+});
+
+test("webhook sets paid/failed/refunded; duplicates and late events don't move an order back", async () => {
+  await newOrder("pay_w2");
+  const results = await Promise.all(Array.from({ length: 10 }, () => sendEvent("charge.succeeded", "pay_w2")));
+  assert.ok(results.every((r) => r.status === 200));
+  assert.equal(await orderStatus("pay_w2"), "paid");
+  assert.equal((await sendEvent("charge.refunded", "pay_w2")).status, 200);
+  assert.equal((await sendEvent("charge.succeeded", "pay_w2")).status, 200);
+  assert.equal(await orderStatus("pay_w2"), "refunded");
+
+  await newOrder("pay_w3");
+  await sendEvent("charge.failed", "pay_w3");
+  assert.equal(await orderStatus("pay_w3"), "failed");
+});

   });
diff --git a/test/app.test.ts b/test/app.test.ts
index d7b2ef4..37e6b73 100644
--- a/test/app.test.ts
+++ b/test/app.test.ts
@@ -64,3 +64,119 @@ test("payments client records every call; the same idempotency key is charged on
   const { rows } = await pool.query("select kind, count(*)::int as n from payment_calls where created_at > now() - interval '1 minute' group by kind order by kind");
   assert.deepEqual(rows, [{ kind: "charge", n: 1 }, { kind: "refund", n: 1 }]);
 });
+
+const placeOrder = (token: string, body: unknown) =>
+  fetch(`${base}/orders`, {
+    method: "POST",
+    headers: { ...as(token), "content-type": "application/json" },
+    body: typeof body === "string" ? body : JSON.stringify(body),
+  });
+
+const stockOf = async (id: number) =>
+  (await pool.query("select stock from products where id = $1", [id])).rows[0].stock as number;
+
+const paymentCallCount = async () => (await pool.query("select count(*)::int as n from payment_calls")).rows[0].n as number;
+
+test("POST /orders charges the total, reduces stock and returns the order", async () => {
+  const tshirt = await stockOf(1);
+  const mug = await stockOf(2);
+  const res = await placeOrder("bob-token", {
+    items: [{ productId: 1, quantity: 2 }, { productId: 2, quantity: 1 }, { productId: 1, quantity: 1 }],
+  });
+  assert.equal(res.status, 201);
+  const order = await res.json();
+  assert.equal(order.status, "paid");
+  assert.equal(order.total_cents, 3 * 2000 + 1200);
+  assert.match(order.payment_id, /^pay_/);
+  assert.deepEqual(order.items, [
+    { product_id: 1, quantity: 3, price_cents: 2000 },
+    { product_id: 2, quantity: 1, price_cents: 1200 },
+  ]);
+  assert.equal(await stockOf(1), tshirt - 3);
+  assert.equal(await stockOf(2), mug - 1);
+  const { rows } = await pool.query("select amount_cents from payment_calls where idempotency_key = $1", [`order-${order.id}`]);
+  assert.deepEqual(rows, [{ amount_cents: 7200 }]);
+  // Listed for the buyer only.
+  const bobs = await (await fetch(`${base}/orders`, { headers: as("bob-token") })).json();
+  const alices = await (await fetch(`${base}/orders`, { headers: as("alice-token") })).json();
+  assert.ok(bobs.some((o: { id: number }) => o.id === order.id));
+  assert.ok(!alices.some((o: { id: number }) => o.id === order.id));
+});
+
+test("POST /orders rejects bad input with 400 and changes nothing", async () => {
+  const stock = await stockOf(1);
+  const calls = await paymentCallCount();
+  const bodies: unknown[] = [
+    "{not json",
+    {},
+    { items: [] },
+    { items: "x" },
+    { items: [null] },
+    { items: [{ productId: 1 }] },
+    { items: [{ productId: 1, quantity: 0 }] },
+    { items: [{ productId: 1, quantity: -1 }] },
+    { items: [{ productId: 1, quantity: 1.5 }] },
+    { items: [{ productId: "1", quantity: 1 }] },
+    { items: [{ productId: 1, quantity: 1001 }] },
+    { items: [{ productId: 1, quantity: 600 }, { productId: 1, quantity: 600 }] },
+    { items: [{ productId: 999, quantity: 1 }] },
+  ];
+  for (const body of bodies) {
+    const res = await placeOrder("alice-token", body);
+    assert.equal(res.status, 400, JSON.stringify(body));
+    assert.ok((await res.json()).error.code);
+  }
+  assert.equal(await stockOf(1), stock);
+  assert.equal(await paymentCallCount(), calls);
+});
+
+test("POST /orders requires a token", async () => {
+  const res = await placeOrder("nope", { items: [{ productId: 1, quantity: 1 }] });
+  assert.equal(res.status, 401);
+});
+
+test("POST /orders returns 409 when stock is short and charges nothing", async () => {
+  const calls = await paymentCallCount();
+  const res = await placeOrder("alice-token", { items: [{ productId: 3, quantity: 6 }] });
+  assert.equal(res.status, 409);
+  assert.equal((await res.json()).error.code, "insufficient_stock");
+  assert.equal(await stockOf(3), 5);
+  assert.equal(await paymentCallCount(), calls);
+});
+
+test("POST /orders in parallel never oversells and charges each order once", async () => {
+  // 5 sneakers left, 20 buyers at once; lines in opposite orders to provoke deadlocks.
+  const results = await Promise.all(
+    Array.from({ length: 20 }, (_, i) =>
+      placeOrder(i % 2 ? "alice-token" : "bob-token", {
+        items: i % 2
+          ? [{ productId: 3, quantity: 1 }, { productId: 1, quantity: 1 }]
+          : [{ productId: 1, quantity: 1 }, { productId: 3, quantity: 1 }],
+      }),
+    ),
+  );
+  const statuses = results.map((r) => r.status);
+  assert.equal(statuses.filter((s) => s === 201).length, 5, String(statuses));
+  assert.equal(statuses.filter((s) => s === 409).length, 15, String(statuses));
+  assert.equal(await stockOf(3), 0);
+  const { rows: [check] } = await pool.query(
+    `select count(*)::int as orders, count(c.id)::int as charges, coalesce(sum(c.amount_cents), 0)::int as charged
+     from orders o join payment_calls c on c.idempotency_key = 'order-' || o.id and c.payment_id = o.payment_id
+     where o.status = 'paid' and exists (select 1 from order_items i where i.order_id = o.id and i.product_id = 3)
+       and o.created_at > now() - interval '1 minute'`,
+  );
+  assert.deepEqual(check, { orders: 5, charges: 5, charged: 5 * 17000 });
+});
+
+test("POST /orders puts the stock back and marks the order failed when the charge fails", async (t) => {
+  const stock = await stockOf(2);
+  t.mock.method(payments, "charge", async () => {

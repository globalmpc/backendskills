diff --git a/migrations/002_orders_amount_cents.sql b/migrations/002_orders_amount_cents.sql
new file mode 100644
index 0000000..92b473c
--- /dev/null
+++ b/migrations/002_orders_amount_cents.sql
@@ -0,0 +1,24 @@
+-- Expand step of renaming orders.total_cents -> orders.amount_cents.
+-- total_cents stays until every server runs code that uses amount_cents (contract migration later).
+set lock_timeout = '5s';
+
+alter table orders add column amount_cents integer;
+
+create function orders_sync_amount_cents() returns trigger language plpgsql as $$
+begin
+  if new.amount_cents is null then
+    new.amount_cents := new.total_cents;
+  elsif new.total_cents is null then
+    new.total_cents := new.amount_cents;
+  elsif tg_op = 'UPDATE' then
+    if new.amount_cents is distinct from old.amount_cents then
+      new.total_cents := new.amount_cents;
+    else
+      new.amount_cents := new.total_cents;
+    end if;
+  end if;
+  return new;
+end $$;
+
+create trigger orders_sync_amount_cents before insert or update on orders
+  for each row execute function orders_sync_amount_cents();

diff --git a/test/app.test.ts b/test/app.test.ts
index d7b2ef4..1e0cc11 100644
--- a/test/app.test.ts
+++ b/test/app.test.ts
@@ -64,3 +64,82 @@ test("payments client records every call; the same idempotency key is charged on
   const { rows } = await pool.query("select kind, count(*)::int as n from payment_calls where created_at > now() - interval '1 minute' group by kind order by kind");
   assert.deepEqual(rows, [{ kind: "charge", n: 1 }, { kind: "refund", n: 1 }]);
 });
+
+const adjust = (token: string, userId: number | string, body: unknown) =>
+  fetch(`${base}/wallets/${userId}/adjustments`, {
+    method: "POST",
+    headers: { ...as(token), "content-type": "application/json" },
+    body: JSON.stringify(body),
+  });
+
+const balanceOf = async (userId: number) =>
+  (await pool.query("select balance_cents from wallets where user_id = $1", [userId])).rows[0].balance_cents;
+
+test("adjustments are admin-only; a regular user gets 403 and the balance is unchanged", async () => {
+  const before = await balanceOf(2);
+  const res = await adjust("alice-token", 2, { amountCents: 100, reason: "try" });
+  assert.equal(res.status, 403);
+  assert.equal(await balanceOf(2), before);
+});
+
+test("admin credit adds to the balance and is recorded with the admin id", async () => {
+  const res = await adjust("admin-token", 2, { amountCents: 300, reason: "Goodwill credit" });
+  assert.equal(res.status, 201);
+  const body = await res.json();
+  assert.equal(body.balanceCents, 800);
+  assert.equal(body.adminId, 3);
+  const { rows } = await pool.query("select user_id, admin_id, amount_cents, reason from wallet_adjustments where id = $1", [body.id]);
+  assert.deepEqual(rows, [{ user_id: 2, admin_id: 3, amount_cents: 300, reason: "Goodwill credit" }]);
+});
+
+test("a debit that would take the balance below 0 is rejected and leaves no audit row", async () => {
+  const res = await adjust("admin-token", 2, { amountCents: -801, reason: "Too much" });
+  assert.equal(res.status, 409);
+  assert.equal((await res.json()).error.code, "insufficient_balance");
+  assert.equal(await balanceOf(2), 800);
+  const { rows } = await pool.query("select count(*)::int as n from wallet_adjustments where user_id = 2 and reason = 'Too much'");
+  assert.equal(rows[0].n, 0);
+});
+
+test("a debit down to exactly 0 is allowed", async () => {
+  const res = await adjust("admin-token", 2, { amountCents: -800, reason: "Clear balance" });
+  assert.equal(res.status, 201);
+  assert.equal(await balanceOf(2), 0);
+});
+
+test("bad input gets 400 and changes nothing", async () => {
+  const before = await balanceOf(1);
+  for (const body of [
+    { amountCents: 0, reason: "x" },
+    { amountCents: 1.5, reason: "x" },
+    { amountCents: "100", reason: "x" },
+    { amountCents: 100 },
+    { amountCents: 100, reason: "   " },
+  ]) {
+    assert.equal((await adjust("admin-token", 1, body)).status, 400, JSON.stringify(body));
+  }
+  assert.equal((await adjust("admin-token", "abc", { amountCents: 1, reason: "x" })).status, 400);
+  assert.equal(await balanceOf(1), before);
+});
+
+test("an unknown user gets 404 and no wallet is created", async () => {
+  const res = await adjust("admin-token", 9999, { amountCents: 100, reason: "Nobody" });
+  assert.equal(res.status, 404);
+  const { rows } = await pool.query("select 1 from wallets where user_id = 9999");
+  assert.equal(rows.length, 0);
+});
+
+test("parallel debits never take the balance below 0", async () => {
+  const start = await balanceOf(1);
+  const attempts = Math.floor(start / 1000) + 5;
+  const results = await Promise.all(
+    Array.from({ length: attempts }, () => adjust("admin-token", 1, { amountCents: -1000, reason: "Parallel" })),
+  );
+  const statuses = results.map((r) => r.status);
+  const succeeded = statuses.filter((s) => s === 201).length;
+  assert.equal(succeeded, Math.floor(start / 1000));
+  assert.equal(statuses.filter((s) => s === 409).length, attempts - succeeded);
+  assert.equal(await balanceOf(1), start - succeeded * 1000);
+  const { rows } = await pool.query("select count(*)::int as n from wallet_adjustments where user_id = 1 and reason = 'Parallel'");
+  assert.equal(rows[0].n, succeeded);
+});

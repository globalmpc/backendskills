+test("reviews: buyers can review once; others are rejected; bad input is 400", async () => {
+  const post = (token: string, id: string | number, payload: unknown) =>
+    fetch(`${base}/products/${id}/reviews`, { method: "POST", headers: { ...as(token), "content-type": "application/json" }, body: JSON.stringify(payload) });
+  const ok = { rating: 4, body: "Nice" };
+
+  assert.equal((await post("bob-token", 1, ok)).status, 403); // bob bought only the mug
+  assert.equal((await post("alice-token", 999, ok)).status, 404);
+  assert.equal((await post("alice-token", "abc", ok)).status, 404);
+  for (const bad of [{ rating: 0, body: "x" }, { rating: 6, body: "x" }, { rating: 3.5, body: "x" }, { rating: "5", body: "x" }, { rating: 5, body: "" }, { rating: 5 }, {}]) {
+    const res = await post("alice-token", 1, bad);
+    assert.equal(res.status, 400);
+    assert.ok((await res.json()).error.code);
+  }
+  assert.equal((await fetch(`${base}/products/1/reviews`, { method: "POST", headers: as("alice-token") })).status, 400);
+
+  // ten parallel attempts: exactly one review is stored
+  const results = await Promise.all(Array.from({ length: 10 }, () => post("alice-token", 1, ok)));
+  assert.deepEqual(results.map((r) => r.status).sort(), [201, ...Array(9).fill(409)]);
+
+  const list = await (await fetch(`${base}/products/1/reviews`, { headers: as("bob-token") })).json();
+  assert.equal(list.length, 1);
+  assert.equal(list[0].rating, 4);
+  assert.equal(list[0].user_name, "Alice");
+  assert.equal((await fetch(`${base}/products/999/reviews`, { headers: as("bob-token") })).status, 404);
+  assert.equal((await fetch(`${base}/products/1/reviews`)).status, 401);
+});
+

+
+// Order tests run after the payments test above, which counts all recent charges.
+const placeOrder =(token: string, body: unknown) =>
+  fetch(`${base}/orders`, {
+    method: "POST",
+    headers: { ...as(token), "content-type": "application/json" },
+    body: JSON.stringify(body),
+  });
+const stockOf = async (id: number) => (await pool.query("select stock from products where id = $1", [id])).rows[0].stock;
+
+test("POST /orders charges the total, reduces stock and returns the order", async () => {
+  const res = await placeOrder("bob-token", { items: [{ productId: 1, quantity: 2 }, { productId: 2, quantity: 1 }, { productId: 1, quantity: 1 }] });
+  assert.equal(res.status, 201);
+  const order = await res.json();
+  assert.equal(order.status, "paid");
+  assert.equal(order.total_cents, 3 * 2000 + 1200);
+  assert.deepEqual(order.items, [
+    { product_id: 1, quantity: 3, price_cents: 2000 },
+    { product_id: 2, quantity: 1, price_cents: 1200 },
+  ]);
+  assert.equal(await stockOf(1), 97);
+  assert.equal(await stockOf(2), 39);
+  const { rows: calls } = await pool.query("select kind, amount_cents from payment_calls where payment_id = $1", [order.payment_id]);
+  assert.deepEqual(calls, [{ kind: "charge", amount_cents: 7200 }]);
+  const listed = await (await fetch(`${base}/orders`, { headers: as("bob-token") })).json();
+  assert.ok(listed.some((o: { id: number }) => o.id === order.id));
+});
+
+test("POST /orders rejects insufficient stock without charging", async () => {
+  const before = (await pool.query("select count(*)::int as n from payment_calls")).rows[0].n;
+  const res = await placeOrder("alice-token", { items: [{ productId: 3, quantity: 6 }] });
+  assert.equal(res.status, 409);
+  assert.equal((await res.json()).error.code, "insufficient_stock");
+  assert.equal(await stockOf(3), 5);
+  assert.equal((await pool.query("select count(*)::int as n from payment_calls")).rows[0].n, before);
+});
+
+test("POST /orders validates the body and product ids", async () => {
+  for (const body of [{}, { items: [] }, { items: [{ productId: 1, quantity: 0 }] }, { items: [{ productId: "1", quantity: 1 }] }, { items: [{ productId: 1, quantity: 1.5 }] }]) {
+    const res = await placeOrder("alice-token", body);
+    assert.equal(res.status, 400, JSON.stringify(body));
+    assert.equal((await res.json()).error.code, "invalid_request");
+  }
+  const res = await placeOrder("alice-token", { items: [{ productId: 999, quantity: 1 }] });
+  assert.equal(res.status, 404);
+});
+
+test("concurrent POST /orders never oversell", async () => {
+  const stock = await stockOf(3);
+  const results = await Promise.all(
+    Array.from({ length: stock + 3 }, (_, i) => placeOrder(i % 2 ? "alice-token" : "bob-token", { items: [{ productId: 3, quantity: 1 }] })),
+  );
+  const statuses = results.map((r) => r.status);
+  assert.equal(statuses.filter((s) => s === 201).length, stock);
+  assert.equal(statuses.filter((s) => s === 409).length, 3);
+  assert.equal(await stockOf(3), 0);
+});
+
+test("a failed charge releases the reserved stock", async (t) => {

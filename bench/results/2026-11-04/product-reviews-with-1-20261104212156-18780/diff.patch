+
+test("reviews: buyers can review once; others and bad input are rejected", async () => {
+  const url = (id: number | string) => base + "/products/" + id + "/reviews";
+  const post = (token: string, id: number | string, body: unknown) =>
+    fetch(url(id), {
+      method: "POST",
+      headers: { ...as(token), "content-type": "application/json" },
+      body: JSON.stringify(body),
+    });
+  // bob only bought the mug (2)
+  assert.equal((await post("bob-token", 1, { rating: 5, body: "x" })).status, 403);
+  assert.equal((await post("alice-token", 1, { rating: 6, body: "x" })).status, 400);
+  assert.equal((await post("alice-token", 1, { rating: 4.5, body: "x" })).status, 400);
+  assert.equal((await post("alice-token", 1, { rating: 5, body: "" })).status, 400);
+  assert.equal((await post("alice-token", 999, { rating: 5, body: "x" })).status, 404);
+  assert.equal((await post("alice-token", "abc", { rating: 5, body: "x" })).status, 404);
+
+  const results = await Promise.all(
+    Array.from({ length: 10 }, () => post("alice-token", 1, { rating: 5, body: "Great" })),
+  );
+  assert.deepEqual(results.map((r) => r.status).sort(), [201, ...Array(9).fill(409)]);
+
+  const list = await (await fetch(url(1), { headers: as("bob-token") })).json();
+  assert.equal(list.length, 1);
+  assert.equal(list[0].rating, 5);
+  assert.equal((await fetch(url(999), { headers: as("bob-token") })).status, 404);
+});

+  app.post("/orders/:id/refund", async (req, res) => {
+    if (!/^[0-9]{1,9}$/.test(req.params.id)) return sendError(res, 404, "not_found", "Order not found");
+    const id = Number(req.params.id);
+    const user = res.locals.user;
+
+    // Owner or admin; anyone else gets the same 404 as a missing order.
+    const { rows } = await pool.query(
+      "select id, status, total_cents, payment_id from orders where id = $1 and ($2 or user_id = $3)",
+      [id, user.role === "admin", user.id],
+    );
+    const order = rows[0];
+    if (!order) return sendError(res, 404, "not_found", "Order not found");
+    if (order.status !== "paid" || !order.payment_id) {
+      return sendError(res, 409, "not_refundable", "Only paid orders can be refunded");
+    }
+
+    // The provider call stays outside any transaction. The key is derived from the order, so
+    // concurrent or retried requests refund at most once.
+    try {
+      await payments.refund({
+        paymentId: order.payment_id,
+        amountCents: order.total_cents,
+        idempotencyKey: `refund-order-${order.id}`,
+      });
+    } catch (err) {
+      console.error(err);
+      return sendError(res, 502, "refund_failed", "Refund failed");
+    }
+
+    const { rowCount } = await pool.query("update orders set status = 'refunded' where id = $1 and status = 'paid'", [id]);
+    if (rowCount === 0) return sendError(res, 409, "not_refundable", "Only paid orders can be refunded");
+    res.json({ id, status: "refunded" });
+  });
+

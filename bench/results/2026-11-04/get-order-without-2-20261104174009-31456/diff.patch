+test("/orders/:id returns the order with its items", async () => {
+  const res = await fetch(`${base}/orders/1`, { headers: as("alice-token") });
+  assert.equal(res.status, 200);
+  const order = await res.json();
+  assert.equal(order.id, 1);
+  assert.equal(order.total_cents, 4000);
+  assert.deepEqual(order.items, [{ product_id: 1, name: "T-shirt", quantity: 2, price_cents: 2000 }]);
+});
+
+test("/orders/:id is 404 for other users' orders and bad ids", async () => {
+  for (const path of ["/orders/3", "/orders/999", "/orders/abc"]) {
+    const res = await fetch(`${base}${path}`, { headers: as("alice-token") });
+    assert.equal(res.status, 404, path);
+    assert.equal((await res.json()).error.code, "not_found");
+  }
+});

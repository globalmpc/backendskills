+test("/login returns the api token for valid credentials, without a token", async () => {
+  const login = (body: unknown) =>
+    fetch(`${base}/login`, { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(body) });
+  const ok = await login({ email: "alice@example.com", password: "alice-password" });
+  assert.equal(ok.status, 200);
+  assert.deepEqual(await ok.json(), { token: "alice-token" });
+  for (const body of [
+    { email: "alice@example.com", password: "wrong" },
+    { email: "nobody@example.com", password: "alice-password" },
+  ]) {
+    const bad = await login(body);
+    assert.equal(bad.status, 401);
+    assert.equal((await bad.json()).error.code, "invalid_credentials");
+  }
+  assert.equal((await login({ email: "alice@example.com" })).status, 400);
+});

diff --git a/test/app.test.ts b/test/app.test.ts
index d7b2ef4..997c0b7 100644
--- a/test/app.test.ts
+++ b/test/app.test.ts
@@ -64,3 +64,41 @@ test("payments client records every call; the same idempotency key is charged on
   const { rows } = await pool.query("select kind, count(*)::int as n from payment_calls where created_at > now() - interval '1 minute' group by kind order by kind");
   assert.deepEqual(rows, [{ kind: "charge", n: 1 }, { kind: "refund", n: 1 }]);
 });
+
+const adjust = (token: string, userId: number, body: unknown) =>
+  fetch(`${base}/wallets/${userId}/adjustments`, {
+    method: "POST",
+    headers: { ...as(token), "content-type": "application/json" },
+    body: JSON.stringify(body),
+  });
+
+test("wallet adjustments are admin-only", async () => {
+  const res = await adjust("alice-token", 1, { amountCents: 100, reason: "x" });
+  assert.equal(res.status, 403);
+});
+
+test("admin can adjust a wallet, and it is recorded", async () => {
+  const res = await adjust("admin-token", 2, { amountCents: -200, reason: "correction" });
+  assert.equal(res.status, 201);
+  assert.equal((await res.json()).balanceCents, 300);
+  const { rows } = await pool.query("select * from wallet_adjustments where user_id = 2");
+  assert.equal(rows.length, 1);
+  assert.equal(rows[0].admin_id, 3);
+  assert.equal(rows[0].amount_cents, -200);
+  assert.equal(rows[0].reason, "correction");
+});
+
+test("adjustment cannot take the balance below 0 and is not recorded", async () => {
+  const res = await adjust("admin-token", 3, { amountCents: -1, reason: "too much" });
+  assert.equal(res.status, 409);
+  const { rows } = await pool.query("select count(*)::int as n from wallet_adjustments where user_id = 3");
+  assert.equal(rows[0].n, 0);
+  const { rows: w } = await pool.query("select balance_cents from wallets where user_id = 3");
+  assert.equal(w[0].balance_cents, 0);
+});
+
+test("adjustment validates input and user", async () => {
+  assert.equal((await adjust("admin-token", 1, { amountCents: 1.5, reason: "x" })).status, 400);
+  assert.equal((await adjust("admin-token", 1, { amountCents: 5, reason: " " })).status, 400);
+  assert.equal((await adjust("admin-token", 999, { amountCents: 5, reason: "x" })).status, 404);
+});

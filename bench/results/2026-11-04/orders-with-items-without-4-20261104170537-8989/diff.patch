+    // One query for all items of the caller's orders, grouped in memory (avoids N+1).
+    const { rows: items } = await pool.query(
+      `select oi.order_id, oi.product_id, p.name as product_name, oi.quantity, oi.price_cents
+         from order_items oi
+         join products p on p.id = oi.product_id
+         join orders o on o.id = oi.order_id
+        where o.user_id = $1
+        order by oi.order_id, oi.product_id`,
+      [res.locals.user.id],
+    );
+    const itemsByOrder = new Map<number, object[]>();
+    for (const { order_id, ...item } of items) {
+      const list = itemsByOrder.get(order_id) ?? [];
+      list.push(item);
+      itemsByOrder.set(order_id, list);
+    }
+    res.json(orders.map((order) => ({ ...order, items: itemsByOrder.get(order.id) ?? [] })));
   });
 

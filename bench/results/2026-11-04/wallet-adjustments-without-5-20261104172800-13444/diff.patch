+++ b/migrations/002_wallet_adjustments.sql
@@ -0,0 +1,11 @@
+-- Admin corrections to store credit. One row per adjustment; wallets.balance_cents holds the running balance.
+create table wallet_adjustments (
+  id serial primary key,
+  user_id integer not null references users(id),
+  admin_id integer not null references users(id),
+  amount_cents integer not null, -- negative for debits
+  reason text not null,
+  created_at timestamptz not null default now()
+);
+
+create index wallet_adjustments_user_id_idx on wallet_adjustments (user_id);

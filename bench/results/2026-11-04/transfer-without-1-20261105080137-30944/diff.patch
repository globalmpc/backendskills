+  app.post("/transfers", async (req, res) => {
+    const { toUserId, amountCents } = req.body ?? {};
+    const fromUserId: number = res.locals.user.id;
+    if (!Number.isSafeInteger(toUserId) || toUserId <= 0)
+      return sendError(res, 400, "invalid_request", "toUserId must be a positive integer");
+    if (!Number.isSafeInteger(amountCents) || amountCents <= 0 || amountCents > 2147483647)
+      return sendError(res, 400, "invalid_request", "amountCents must be a positive integer");
+    if (toUserId === fromUserId) return sendError(res, 400, "invalid_request", "Cannot transfer to yourself");
+
+    const client = await pool.connect();
+    try {
+      await client.query("begin");
+      // Lock both wallets in a fixed order so concurrent opposite transfers can't deadlock.
+      const { rows } = await client.query(
+        "select user_id, balance_cents from wallets where user_id = any($1) order by user_id for update",
+        [[fromUserId, toUserId]],
+      );
+      const from = rows.find((r) => r.user_id === fromUserId);
+      if (!rows.some((r) => r.user_id === toUserId)) {
+        await client.query("rollback");
+        return sendError(res, 404, "not_found", "Recipient not found");
+      }
+      if (!from || from.balance_cents < amountCents) {
+        await client.query("rollback");
+        return sendError(res, 409, "insufficient_funds", "Insufficient store credit");
+      }
+      const updated = await client.query(
+        "update wallets set balance_cents = balance_cents + case when user_id = $1 then -$3::int else $3::int end where user_id in ($1, $2) returning user_id, balance_cents",
+        [fromUserId, toUserId, amountCents],
+      );
+      await client.query("commit");
+      const balance = updated.rows.find((r) => r.user_id === fromUserId).balance_cents;
+      res.status(201).json({ toUserId, amountCents, balanceCents: balance });
+    } catch (err) {
+      await client.query("rollback").catch(() => {});
+      throw err;
+    } finally {
+      client.release();
+    }
+  });
+

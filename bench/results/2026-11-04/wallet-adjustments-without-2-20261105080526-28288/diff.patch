+
+const adjust = (token: string, userId: number, body: unknown) =>
+  fetch(`${base}/wallets/${userId}/adjustments`, {
+    method: "POST",
+    headers: { ...as(token), "content-type": "application/json" },
+    body: JSON.stringify(body),
+  });
+
+test("wallet adjustments: non-admins are rejected", async () => {
+  const res = await adjust("alice-token", 1, { amountCents: 100, reason: "x" });
+  assert.equal(res.status, 403);
+});
+
+test("wallet adjustments: admin can credit and debit, each recorded", async () => {
+  const credit = await adjust("admin-token", 2, { amountCents: 250, reason: "goodwill" });
+  assert.equal(credit.status, 201);
+  assert.equal((await credit.json()).balanceCents, 750);
+  const debit = await adjust("admin-token", 2, { amountCents: -750, reason: "correction" });
+  assert.equal((await debit.json()).balanceCents, 0);
+  const { rows } = await pool.query("select admin_id, amount_cents, reason from wallet_adjustments where user_id = 2 order by id");
+  assert.deepEqual(rows, [
+    { admin_id: 3, amount_cents: 250, reason: "goodwill" },
+    { admin_id: 3, amount_cents: -750, reason: "correction" },
+  ]);
+});
+
+test("wallet adjustments: cannot go below zero, nothing recorded", async () => {
+  const count = async () => (await pool.query("select count(*)::int n from wallet_adjustments")).rows[0].n;
+  const before = await count();
+  const res = await adjust("admin-token", 3, { amountCents: -1, reason: "x" });
+  assert.equal(res.status, 409);
+  assert.equal(await count(), before);
+});
+
+test("wallet adjustments: validation and unknown wallet", async () => {
+  assert.equal((await adjust("admin-token", 1, { amountCents: 1.5, reason: "x" })).status, 400);
+  assert.equal((await adjust("admin-token", 1, { amountCents: 5, reason: " " })).status, 400);
+  assert.equal((await adjust("admin-token", 999, { amountCents: 5, reason: "x" })).status, 404);
+});
+
+test("wallet adjustments: concurrent debits cannot overdraw", async () => {
+  await pool.query("update wallets set balance_cents = 100 where user_id = 1");
+  const results = await Promise.all(Array.from({ length: 5 }, () => adjust("admin-token", 1, { amountCents: -60, reason: "race" })));
+  assert.deepEqual(results.map((r) => r.status).sort(), [201, 409, 409, 409, 409]);
+});

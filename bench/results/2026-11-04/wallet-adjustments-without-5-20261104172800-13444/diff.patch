+
+const adjust = (token: string, userId: number | string, body: unknown) =>
+  fetch(`${base}/wallets/${userId}/adjustments`, {
+    method: "POST",
+    headers: { ...as(token), "content-type": "application/json" },
+    body: JSON.stringify(body),
+  });
+
+const balance = async (userId: number) =>
+  (await pool.query("select balance_cents from wallets where user_id = $1", [userId])).rows[0].balance_cents;
+
+test("wallet adjustments are admin-only", async () => {
+  const res = await adjust("alice-token", 2, { amountCents: 100, reason: "nope" });
+  assert.equal(res.status, 403);
+  assert.deepEqual(await res.json(), { error: { code: "forbidden", message: "Admins only" } });
+  assert.equal(await balance(2), 500);
+});
+
+test("admin credit adjusts the balance and is recorded", async () => {
+  const res = await adjust("admin-token", 2, { amountCents: 1000, reason: "goodwill credit" });
+  assert.equal(res.status, 201);
+  const body = await res.json();
+  assert.equal(body.balance_cents, 1500);
+  assert.equal(body.adjustment.user_id, 2);
+  assert.equal(body.adjustment.admin_id, 3);
+  assert.equal(body.adjustment.amount_cents, 1000);
+  assert.equal(body.adjustment.reason, "goodwill credit");
+  assert.equal(await balance(2), 1500);
+});
+
+test("admin debit may bring the balance to exactly 0 but not below", async () => {
+  const debit = await adjust("admin-token", 2, { amountCents: -1500, reason: "correction" });
+  assert.equal(debit.status, 201);
+  assert.equal((await debit.json()).balance_cents, 0);
+
+  const over = await adjust("admin-token", 2, { amountCents: -1, reason: "too far" });
+  assert.equal(over.status, 422);
+  assert.equal((await over.json()).error.code, "insufficient_balance");
+  assert.equal(await balance(2), 0);
+
+  const { rows } = await pool.query("select amount_cents from wallet_adjustments where user_id = 2 order by id");
+  assert.deepEqual(rows.map((r) => r.amount_cents), [1000, -1500]);
+});
+
+test("invalid adjustments are rejected with 400", async () => {
+  const bodies = [
+    { amountCents: 0, reason: "x" },
+    { amountCents: "5", reason: "x" },
+    { amountCents: 1.5, reason: "x" },
+    { amountCents: 5, reason: "   " },
+    { amountCents: 5 },
+  ];
+  for (const body of bodies) {
+    const res = await adjust("admin-token", 2, body);
+    assert.equal(res.status, 400, JSON.stringify(body));
+  }
+  assert.equal((await adjust("admin-token", "abc", { amountCents: 5, reason: "x" })).status, 400);
+});
+
+test("adjusting a user without a wallet returns 404", async () => {
+  const res = await adjust("admin-token", 999, { amountCents: 5, reason: "x" });
+  assert.equal(res.status, 404);
+});

+
+const post = (token: string, body: unknown) =>
+  fetch(`${base}/orders`, { method: "POST", headers: { ...as(token), "content-type": "application/json" }, body: JSON.stringify(body) });
+
+test("POST /orders places an order, charges once and reduces stock", async () => {
+  const res = await post("alice-token", { items: [{ productId: 2, quantity: 1 }, { productId: 2, quantity: 2 }] });
+  assert.equal(res.status, 201);
+  const order = await res.json();
+  assert.equal(order.status, "paid");
+  assert.equal(order.total_cents, 3600);
+  assert.deepEqual(order.items, [{ product_id: 2, quantity: 3, price_cents: 1200 }]);
+  const { rows } = await pool.query("select stock from products where id = 2");
+  assert.equal(rows[0].stock, 37);
+  const calls = await pool.query("select 1 from payment_calls where idempotency_key = $1", [`order-${order.id}`]);
+  assert.equal(calls.rowCount, 1);
+});
+
+test("POST /orders rejects bad input with 400 and unknown products with 404", async () => {
+  const bad = [
+    {},
+    { items: [] },
+    { items: [{ productId: 1, quantity: 0 }] },
+    { items: [{ productId: 1.5, quantity: 1 }] },
+    { items: [{ productId: "1", quantity: 1 }] },
+    { items: [{ productId: 99999999999, quantity: 1 }] },
+  ];
+  for (const body of bad) {
+    const res = await post("alice-token", body);
+    assert.equal(res.status, 400, JSON.stringify(body));
+    assert.equal((await res.json()).error.code, "invalid_items");
+  }
+  assert.equal((await post("alice-token", { items: [{ productId: 999, quantity: 1 }] })).status, 404);
+});
+
+test("POST /orders needs auth", async () => {
+  assert.equal((await post("nope", { items: [{ productId: 1, quantity: 1 }] })).status, 401);
+});
+
+test("POST /orders in parallel never oversells", async () => {
+  const results = await Promise.all(Array.from({ length: 12 }, () => post("bob-token", { items: [{ productId: 3, quantity: 1 }] })));
+  const statuses = results.map((r) => r.status);
+  assert.equal(statuses.filter((s) => s === 201).length, 5);
+  assert.equal(statuses.filter((s) => s === 409).length, 7);
+  const { rows } = await pool.query("select stock from products where id = 3");
+  assert.equal(rows[0].stock, 0);
+  const charges = await pool.query("select 1 from payment_calls where idempotency_key like 'order-%' and amount_cents = 15000");
+  assert.equal(charges.rowCount, 5);
+});
+
+test("failed payment releases the reserved stock", async (t) => {
+  t.mock.method(payments, "charge", async () => {

+const LOGIN_WINDOW = "15 minutes";
+const LOGIN_MAX_PER_EMAIL = 10;
+const LOGIN_MAX_PER_IP = 50;
+// Valid-format hash used when the email is unknown, so both failures take equally long.
+const DUMMY_HASH = "scrypt$00112233445566778899aabbccddeeff$" + "ab".repeat(32);
+
+// Counts a try atomically (before it is checked) and returns how many tries the key has in the window.
+async function countAttempt(key: string): Promise<number> {
+  const { rows } = await pool.query(
+    `insert into login_attempts (key, n, since) values ($1, 1, now())
+     on conflict (key) do update set
+       n = case when login_attempts.since < now() - $2::interval then 1 else login_attempts.n + 1 end,
+       since = case when login_attempts.since < now() - $2::interval then now() else login_attempts.since end
+     returning n`,
+    [key, LOGIN_WINDOW],
+  );
+  return rows[0].n;
+}
+
 async function auth(req: Request, res: Response, next: NextFunction) {
   const token = req.headers.authorization?.replace(/^Bearer /, "");
   const { rows } = token
@@ -33,6 +53,25 @@ export function createApp() {
     res.json({ ok: true });
   });
 
+  app.post("/login", async (req, res) => {
+    const { email, password } = req.body ?? {};
+    if (typeof email !== "string" || email.length === 0 || email.length > 254 || typeof password !== "string" || password.length === 0 || password.length > 1024) {
+      return sendError(res, 400, "invalid_request", "email and password must be non-empty strings");
+    }
+    const normalized = email.trim().toLowerCase();
+    const [byEmail, byIp] = await Promise.all([
+      countAttempt(`login:email:${normalized}`),
+      countAttempt(`login:ip:${req.ip ?? "unknown"}`),
+    ]);
+    if (byEmail > LOGIN_MAX_PER_EMAIL || byIp > LOGIN_MAX_PER_IP) {
+      return sendError(res, 429, "too_many_attempts", "Too many attempts, try again later");
+    }
+    const { rows } = await pool.query("select api_token, password_hash from users where lower(email) = $1", [normalized]);
+    const ok = await verifyPassword(password, rows[0]?.password_hash ?? DUMMY_HASH);
+    if (rows.length === 0 || !ok) return sendError(res, 401, "invalid_credentials", "Invalid email or password");
+    res.json({ token: rows[0].api_token });
+  });
+
   app.use(auth);
 

+// Largest value the integer columns (wallets.balance_cents) can hold.
+const MAX_INT = 2147483647;
+
+// Thrown inside a transaction to roll it back and answer with a 4xx.
+class TransferRejected extends Error {
+  constructor(public status: number, public code: string, message: string) {
+    super(message);
+  }
+}
+
 export function sendError(res: Response, status: number, code: string, message: string) {
   res.status(status).json({ error: { code, message } });
 }

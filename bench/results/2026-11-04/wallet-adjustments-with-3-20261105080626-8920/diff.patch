+        amountCents,
+        reason: reason.trim(),
+        balanceCents: rows[0].balance_cents,
+        createdAt: adjustment.created_at,
+      });
+    } catch (err) {
+      await client.query("rollback").catch(() => {});
+      if ((err as { code?: string }).code === "22003") {

+  app.post("/orders", async (req, res) => {
+    // Validate and merge duplicate products (order_items is keyed by order + product).
+    const body = req.body as { items?: unknown } | undefined;
+    const wanted = new Map<number, number>();
+    if (!Array.isArray(body?.items) || body.items.length === 0) {
+      return sendError(res, 400, "invalid_request", "items must be a non-empty array");
+    }
+    for (const item of body.items) {
+      const { productId, quantity } = item ?? {};
+      if (!Number.isSafeInteger(productId) || !Number.isSafeInteger(quantity) || quantity < 1) {
+        return sendError(res, 400, "invalid_request", "Each item needs an integer productId and a quantity >= 1");
+      }
+      wanted.set(productId, (wanted.get(productId) ?? 0) + quantity);
+    }
+    const lines = [...wanted].sort(([a], [b]) => a - b); // consistent lock order avoids deadlocks
+
+    // Step 1: reserve stock and create a pending order in one transaction. The conditional update is
+    // atomic, so concurrent orders can never take the same units. The payment call happens outside
+    // the transaction so we don't hold a connection and row locks during a network round trip.
+    const client = await pool.connect();
+    let orderId: number;
+    let totalCents = 0;
+    try {
+      await client.query("begin");
+      const priced: { productId: number; quantity: number; priceCents: number }[] = [];
+      for (const [productId, quantity] of lines) {
+        const { rows } = await client.query(
+          "update products set stock = stock - $2 where id = $1 and stock >= $2 returning price_cents",
+          [productId, quantity],
+        );
+        if (rows.length === 0) {
+          await client.query("rollback");
+          const { rowCount } = await pool.query("select 1 from products where id = $1", [productId]);
+          return rowCount === 0
+            ? sendError(res, 404, "product_not_found", `Product ${productId} not found`)
+            : sendError(res, 409, "insufficient_stock", `Not enough stock for product ${productId}`);
+        }
+        priced.push({ productId, quantity, priceCents: rows[0].price_cents });
+        totalCents += rows[0].price_cents * quantity;
+      }
+      const { rows } = await client.query(
+        "insert into orders (user_id, status, total_cents) values ($1, 'pending', $2) returning id",
+        [res.locals.user.id, totalCents],
+      );
+      orderId = rows[0].id;
+      for (const l of priced) {
+        await client.query(
+          "insert into order_items (order_id, product_id, quantity, price_cents) values ($1, $2, $3, $4)",
+          [orderId, l.productId, l.quantity, l.priceCents],
+        );
+      }
+      await client.query("commit");
+    } catch (err) {
+      await client.query("rollback").catch(() => {});
+      throw err;
+    } finally {
+      client.release();
+    }
+
+    // Step 2: charge. The idempotency key ties the charge to this order.
+    let paymentId: string;
+    try {
+      ({ paymentId } = await payments.charge({ amountCents: totalCents, idempotencyKey: `order-${orderId}` }));
+    } catch (err) {
+      // Charge failed: release the reserved stock and cancel the order.
+      console.error(err);
+      const c = await pool.connect();
+      try {
+        await c.query("begin");
+        await c.query(
+          `update products p set stock = p.stock + i.quantity
+           from order_items i where i.order_id = $1 and i.product_id = p.id`,
+          [orderId],
+        );
+        await c.query("update orders set status = 'cancelled' where id = $1", [orderId]);
+        await c.query("commit");
+      } catch (e) {
+        await c.query("rollback").catch(() => {});
+        console.error(e);
+      } finally {
+        c.release();
+      }
+      return sendError(res, 402, "payment_failed", "Payment failed");
+    }
+
+    const { rows } = await pool.query(
+      "update orders set status = 'paid', payment_id = $2 where id = $1 returning id, status, total_cents, payment_id, created_at",
+      [orderId, paymentId],
+    );
+    res.status(201).json({
+      ...rows[0],
+      items: lines.map(([productId, quantity]) => ({ productId, quantity })),
+    });
+  });
+

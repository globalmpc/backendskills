diff --git a/test/app.test.ts b/test/app.test.ts
index d7b2ef4..2e55cd3 100644
--- a/test/app.test.ts
+++ b/test/app.test.ts
@@ -64,3 +64,40 @@ test("payments client records every call; the same idempotency key is charged on
   const { rows } = await pool.query("select kind, count(*)::int as n from payment_calls where created_at > now() - interval '1 minute' group by kind order by kind");
   assert.deepEqual(rows, [{ kind: "charge", n: 1 }, { kind: "refund", n: 1 }]);
 });
+
+const postReview = (token: string, id: string | number, body: unknown) =>
+  fetch(`${base}/products/${id}/reviews`, {
+    method: "POST",
+    headers: { ...as(token), "content-type": "application/json" },
+    body: JSON.stringify(body),
+  });
+
+test("reviews: buyer reviews once; non-buyers and bad input are rejected", async () => {
+  assert.equal((await postReview("alice-token", 1, { rating: 5, body: "Great" })).status, 201);
+  assert.equal((await postReview("alice-token", 1, { rating: 4, body: "Again" })).status, 409);
+  const notBuyer = await postReview("bob-token", 1, { rating: 1, body: "Nope" });
+  assert.equal(notBuyer.status, 403);
+  assert.equal((await notBuyer.json()).error.code, "not_purchased");
+  assert.equal((await postReview("alice-token", 1, { rating: 6, body: "x" })).status, 400);
+  assert.equal((await postReview("alice-token", 3, { rating: 2.5, body: "x" })).status, 400);
+  assert.equal((await postReview("alice-token", 3, { rating: 3, body: "  " })).status, 400);
+  assert.equal((await postReview("alice-token", 3, { rating: 3 })).status, 400);
+  assert.equal((await postReview("alice-token", 999, { rating: 3, body: "x" })).status, 404);
+  assert.equal((await postReview("alice-token", "abc", { rating: 3, body: "x" })).status, 404);
+
+  const list = await fetch(`${base}/products/1/reviews`, { headers: as("bob-token") });
+  assert.equal(list.status, 200);
+  const reviews = await list.json();
+  assert.equal(reviews.length, 1);
+  assert.equal(reviews[0].rating, 5);
+  assert.equal((await fetch(`${base}/products/999/reviews`, { headers: as("bob-token") })).status, 404);
+});
+
+test("reviews: parallel duplicate posts create one review", async () => {
+  const results = await Promise.all(
+    Array.from({ length: 15 }, () => postReview("bob-token", 2, { rating: 4, body: "Nice mug" })),
+  );
+  const statuses = results.map((r) => r.status);
+  assert.equal(statuses.filter((s) => s === 201).length, 1);
+  assert.equal(statuses.filter((s) => s === 409).length, 14);
+});

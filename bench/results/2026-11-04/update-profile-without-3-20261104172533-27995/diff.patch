+
+const patch = (token: string, id: string, body: unknown) =>
+  fetch(`${base}/users/${id}`, {
+    method: "PATCH",
+    headers: { ...as(token), "content-type": "application/json" },
+    body: JSON.stringify(body),
+  });
+
+test("PATCH /users/:id lets a user update their own name and email", async () => {
+  const res = await patch("bob-token", "2", { name: "Robert", email: "robert@example.com" });
+  assert.equal(res.status, 200);
+  assert.deepEqual(await res.json(), { id: 2, name: "Robert", email: "robert@example.com", role: "user" });
+  const me = await (await fetch(`${base}/me`, { headers: as("bob-token") })).json();
+  assert.equal(me.name, "Robert");
+  assert.equal(me.email, "robert@example.com");
+});
+
+test("PATCH /users/:id ignores fields other than name and email", async () => {
+  const res = await patch("bob-token", "2", { role: "admin", api_token: "stolen" });
+  assert.equal(res.status, 400);
+  const res2 = await patch("bob-token", "2", { name: "Bob", role: "admin", api_token: "stolen" });
+  assert.equal(res2.status, 200);
+  assert.equal((await res2.json()).role, "user");
+  const still = await fetch(`${base}/me`, { headers: as("bob-token") });
+  assert.equal(still.status, 200);
+});
+
+test("PATCH /users/:id forbids updating another user unless admin", async () => {
+  const res = await patch("bob-token", "1", { name: "Mallory" });
+  assert.equal(res.status, 403);
+  const res2 = await patch("admin-token", "1", { name: "Alice A." });
+  assert.equal(res2.status, 200);
+  assert.equal((await res2.json()).name, "Alice A.");
+});
+
+test("PATCH /users/:id validates input and rejects a taken email", async () => {
+  assert.equal((await patch("alice-token", "1", {})).status, 400);
+  assert.equal((await patch("alice-token", "1", { name: "   " })).status, 400);
+  assert.equal((await patch("alice-token", "1", { email: "not-an-email" })).status, 400);
+  assert.equal((await patch("alice-token", "1", { name: 42 })).status, 400);
+  const taken = await patch("alice-token", "1", { email: "admin@example.com" });
+  assert.equal(taken.status, 409);
+  assert.deepEqual(await taken.json(), { error: { code: "email_taken", message: "That email is already in use" } });
+});
+
+test("PATCH /users/:id returns 404 for unknown or non-numeric ids", async () => {
+  assert.equal((await patch("admin-token", "9999", { name: "X" })).status, 404);
+  assert.equal((await patch("admin-token", "abc", { name: "X" })).status, 404);
+});
+
+test("PATCH /users/:id requires a token", async () => {
+  const res = await fetch(`${base}/users/1`, { method: "PATCH", headers: { "content-type": "application/json" }, body: "{}" });
+  assert.equal(res.status, 401);
+});

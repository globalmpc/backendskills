+
+const transfer = (token: string, body: unknown) =>
+  fetch(`${base}/transfers`, {
+    method: "POST",
+    headers: { ...as(token), "content-type": "application/json" },
+    body: JSON.stringify(body),
+  });
+const balance = async (id: number) =>
+  (await pool.query("select balance_cents from wallets where user_id = $1", [id])).rows[0].balance_cents;
+
+test("POST /transfers moves store credit", async () => {
+  const res = await transfer("alice-token", { toUserId: 2, amountCents: 1000 });
+  assert.equal(res.status, 201);
+  assert.equal(await balance(1), 9000);
+  assert.equal(await balance(2), 1500);
+});
+
+test("POST /transfers rejects bad input, self, unknown user and overdraft without changing balances", async () => {
+  const bad = [{ toUserId: 2, amountCents: -5 }, { toUserId: 2, amountCents: 1.5 }, { toUserId: "2", amountCents: 5 }, {}, { toUserId: 1, amountCents: 5 }];
+  for (const body of bad) assert.equal((await transfer("alice-token", body)).status, 400);
+  assert.equal((await transfer("alice-token", { toUserId: 999, amountCents: 5 })).status, 404);
+  assert.equal((await transfer("bob-token", { toUserId: 1, amountCents: 99999999 })).status, 409);
+  assert.equal(await balance(1), 9000);
+  assert.equal(await balance(2), 1500);
+});
+
+test("concurrent transfers cannot overdraw a wallet", async () => {
+  const results = await Promise.all(Array.from({ length: 5 }, () => transfer("bob-token", { toUserId: 3, amountCents: 1000 })));
+  assert.equal(results.filter((r) => r.status === 201).length, 1);
+  assert.equal(await balance(2), 500);
+  assert.equal(await balance(3), 1000);
+});

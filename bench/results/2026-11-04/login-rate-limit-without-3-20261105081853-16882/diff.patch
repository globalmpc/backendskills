   res.status(status).json({ error: { code, message } });
 }
 
+// Checked against when the email is unknown, so response time doesn't reveal which emails are registered.
+let dummyHash: Promise<string> | undefined;
+
+async function login(req: Request, res: Response) {
+  const { email, password } = req.body ?? {};
+  if (typeof email !== "string" || typeof password !== "string" || email === "" || password === "") {
+    return sendError(res, 400, "invalid_request", "email and password are required");
+  }
+  const { rows } = await pool.query("select api_token, password_hash from users where email = $1", [email]);
+  const user = rows[0];
+  const ok = await verifyPassword(password, user?.password_hash ?? (await (dummyHash ??= hashPassword("dummy"))));
+  if (!user || !ok) return sendError(res, 401, "invalid_credentials", "Invalid email or password");
+  res.json({ token: user.api_token });
+}

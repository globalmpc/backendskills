+  app.post("/orders", async (req, res) => {
+    const raw = req.body?.items;
+    if (!Array.isArray(raw) || raw.length === 0) {
+      return sendError(res, 400, "invalid_request", "items must be a non-empty array");
+    }
+    // Merge duplicate product ids; sort so row locks are always taken in the same order.
+    const wanted = new Map<number, number>();
+    for (const item of raw) {
+      const { productId, quantity } = item ?? {};
+      if (!Number.isInteger(productId) || !Number.isInteger(quantity) || quantity < 1) {
+        return sendError(res, 400, "invalid_request", "Each item needs an integer productId and a positive integer quantity");
+      }
+      wanted.set(productId, (wanted.get(productId) ?? 0) + quantity);
+    }
+    const lines = [...wanted].map(([productId, quantity]) => ({ productId, quantity })).sort((a, b) => a.productId - b.productId);
+
+    // Step 1: atomically reserve stock and create a pending order. The conditional update means
+    // concurrent orders can never oversell. The transaction is short; it does not span the payment call.
+    const client = await pool.connect();
+    let orderId: number;
+    let totalCents = 0;
+    try {
+      await client.query("begin");
+      const priced: { productId: number; quantity: number; priceCents: number }[] = [];
+      for (const line of lines) {
+        const { rows } = await client.query(
+          "update products set stock = stock - $2 where id = $1 and stock >= $2 returning price_cents",
+          [line.productId, line.quantity],
+        );
+        if (rows.length === 0) {
+          await client.query("rollback");
+          const { rows: exists } = await pool.query("select 1 from products where id = $1", [line.productId]);
+          return exists.length === 0
+            ? sendError(res, 404, "product_not_found", `Product ${line.productId} does not exist`)
+            : sendError(res, 409, "insufficient_stock", `Not enough stock for product ${line.productId}`);
+        }
+        priced.push({ ...line, priceCents: rows[0].price_cents });
+        totalCents += rows[0].price_cents * line.quantity;
+      }
+      const { rows } = await client.query(
+        "insert into orders (user_id, status, total_cents) values ($1, 'pending', $2) returning id",
+        [res.locals.user.id, totalCents],
+      );
+      orderId = rows[0].id;
+      for (const p of priced) {
+        await client.query(
+          "insert into order_items (order_id, product_id, quantity, price_cents) values ($1, $2, $3, $4)",
+          [orderId, p.productId, p.quantity, p.priceCents],
+        );
+      }
+      await client.query("commit");
+    } catch (err) {
+      await client.query("rollback").catch(() => {});
+      throw err;
+    } finally {
+      client.release();
+    }
+
+    // Step 2: charge. The idempotency key makes a retry of this call safe.
+    let paymentId: string;
+    try {
+      ({ paymentId } = await payments.charge({ amountCents: totalCents, idempotencyKey: `order-${orderId}` }));
+    } catch (err) {
+      // Payment failed: give the stock back and discard the order.
+      const undo = await pool.connect();
+      try {
+        await undo.query("begin");
+        for (const line of lines) {
+          await undo.query("update products set stock = stock + $2 where id = $1", [line.productId, line.quantity]);
+        }
+        await undo.query("delete from order_items where order_id = $1", [orderId]);
+        await undo.query("delete from orders where id = $1", [orderId]);
+        await undo.query("commit");
+      } catch (undoErr) {
+        await undo.query("rollback").catch(() => {});
+        console.error("failed to release stock for order", orderId, undoErr);
+      } finally {
+        undo.release();
+      }
+      console.error(err);
+      return sendError(res, 402, "payment_failed", "Payment could not be processed");
+    }
+
+    const { rows } = await pool.query(
+      "update orders set status = 'paid', payment_id = $2 where id = $1 returning id, status, total_cents, payment_id, created_at",
+      [orderId, paymentId],
+    );
+    res.status(201).json({
+      ...rows[0],
+      items: lines.map((l) => ({ ...l })),
+    });
+  });
+

@@ -15,6 +17,77 @@ export function sendError(res: Response, status: number, code: string, message:
   res.status(status).json({ error: { code, message } });
 }
 
+const webhookStatus: Record<string, string> = {
+  "charge.succeeded": "paid",
+  "charge.failed": "failed",
+  "charge.refunded": "refunded",
+};
+
+// `Provider-Signature` is the hex HMAC-SHA256 of the raw body, keyed with webhookSecret.
+function signatureValid(body: Buffer, header: string | undefined): boolean {
+  const expected = createHmac("sha256", webhookSecret).update(body).digest("hex");
+  const given = header ?? "";
+  return given.length === expected.length && timingSafeEqual(Buffer.from(given), Buffer.from(expected));
+}
+
+// Must be mounted before express.json() so the signature is checked against the exact bytes sent.
+async function paymentWebhook(req: Request, res: Response) {
+  const body = Buffer.isBuffer(req.body) ? req.body : Buffer.alloc(0);
+  if (!signatureValid(body, req.get("Provider-Signature"))) {
+    return sendError(res, 401, "bad_signature", "Invalid webhook signature");
+  }
+
+  let event: Record<string, unknown>;
+  try {
+    event = JSON.parse(body.toString("utf8"));
+  } catch {
+    return sendError(res, 400, "bad_request", "Webhook body is not JSON");
+  }
+  const { id, type, paymentId, created } = event ?? {};
+  if (typeof id !== "string" || typeof type !== "string" || typeof paymentId !== "string" || typeof created !== "number" || !Number.isInteger(created)) {
+    return sendError(res, 400, "bad_request", "Webhook needs id, type, paymentId and an integer created");
+  }
+  const status = webhookStatus[type];
+  if (!status) return res.json({ ok: true, ignored: true });
+
+  const client = await pool.connect();
+  try {
+    await client.query("begin");
+    const inserted = await client.query(
+      "insert into payment_events (id, type, payment_id, created) values ($1, $2, $3, $4) on conflict (id) do nothing",
+      [id, type, paymentId, created],
+    );
+    if (inserted.rowCount === 0) {
+      await client.query("commit");
+      return res.json({ ok: true, duplicate: true });
+    }
+
+    // Lock the order so concurrent webhooks for it are applied one at a time.
+    const { rows } = await client.query("select id, last_event_created from orders where payment_id = $1 for update", [paymentId]);
+    if (rows.length === 0) {
+      // Roll back so the event is not recorded; a 404 makes the provider retry once the order exists.
+      await client.query("rollback");
+      return sendError(res, 404, "not_found", "No order for this payment");
+    }
+
+    const last = rows[0].last_event_created;
+    if (last !== null && created < Number(last)) {
+      // An older event than one already applied (e.g. a late charge.succeeded after a refund): record it, don't change the order.
+      await client.query("commit");
+      return res.json({ ok: true, stale: true });
+    }
+
+    await client.query("update orders set status = $2, last_event_created = $3 where id = $1", [rows[0].id, status, created]);
+    await client.query("commit");
+    res.json({ ok: true });
+  } catch (err) {
+    await client.query("rollback");
+    throw err;
+  } finally {
+    client.release();
+  }
+}

diff --git a/src/orders.ts b/src/orders.ts
new file mode 100644
index 0000000..1d6f639
--- /dev/null
+++ b/src/orders.ts
@@ -0,0 +1,136 @@
+import { pool } from "./db.ts";
+import { payments } from "./payments.ts";
+
+const MAX_INT = 2147483647; // columns are `integer`
+
+export type OrderItemInput = { productId: number; quantity: number };
+
+export type CreatedOrder = {
+  id: number;
+  status: "paid";
+  total_cents: number;
+  created_at: Date;
+  items: { product_id: number; quantity: number; price_cents: number }[];
+};
+
+// An error with an HTTP status and error code; the app's error handler turns it into the standard error body.
+export class OrderError extends Error {
+  constructor(
+    readonly status: number,
+    readonly code: string,
+    message: string,
+  ) {
+    super(message);
+  }
+}
+
+const isPositiveInt = (n: unknown): n is number => Number.isSafeInteger(n) && (n as number) > 0 && (n as number) <= MAX_INT;
+
+export function parseOrderItems(body: unknown): OrderItemInput[] {
+  const items = (body as { items?: unknown } | undefined)?.items;
+  if (!Array.isArray(items) || items.length === 0) {
+    throw new OrderError(400, "invalid_request", "items must be a non-empty array");
+  }
+  return items.map((item) => {
+    const { productId, quantity } = (item ?? {}) as { productId?: unknown; quantity?: unknown };
+    if (!isPositiveInt(productId) || !isPositiveInt(quantity)) {
+      throw new OrderError(400, "invalid_request", "each item needs a positive integer productId and quantity");
+    }
+    return { productId, quantity };
+  });
+}
+
+// Places an order in three steps:
+//   1. reserve: in one transaction, lock the products, check stock, decrement it and insert a `pending` order;
+//   2. charge: call the payment provider outside any transaction (the provider client uses the pool);
+//   3. confirm: mark the order `paid`. If the charge fails, the reservation is released.
+export async function placeOrder(userId: number, items: OrderItemInput[]): Promise<CreatedOrder> {
+  const quantities = new Map<number, number>();
+  for (const { productId, quantity } of items) {
+    quantities.set(productId, (quantities.get(productId) ?? 0) + quantity);
+  }
+
+  const reservation = await reserve(userId, quantities);
+
+  try {
+    await payments.charge({ amountCents: reservation.totalCents, idempotencyKey: `order-${reservation.id}` });
+  } catch (err) {
+    await release(reservation.id, reservation.lines);
+    throw err;
+  }
+
+  const { rows } = await pool.query(
+    "update orders set status = 'paid' where id = $1 returning id, status, total_cents, created_at",
+    [reservation.id],
+  );
+  return { ...rows[0], items: reservation.lines.map((l) => ({ product_id: l.productId, quantity: l.quantity, price_cents: l.priceCents })) };
+}
+
+type Line = { productId: number; quantity: number; priceCents: number };
+
+async function reserve(userId: number, quantities: Map<number, number>) {
+  const client = await pool.connect();
+  try {
+    await client.query("begin");
+
+    // Lock in id order so concurrent orders cannot deadlock on each other.
+    const { rows: products } = await client.query<{ id: number; price_cents: number; stock: number }>(
+      "select id, price_cents, stock from products where id = any($1::int[]) order by id for update",
+      [[...quantities.keys()].sort((a, b) => a - b)],
+    );
+    if (products.length !== quantities.size) {
+      throw new OrderError(400, "unknown_product", "one or more products do not exist");
+    }
+
+    const lines: Line[] = [];
+    let totalCents = 0;
+    for (const p of products) {
+      const quantity = quantities.get(p.id) as number;
+      if (p.stock < quantity) {
+        throw new OrderError(409, "insufficient_stock", `not enough stock for product ${p.id}`);
+      }
+      lines.push({ productId: p.id, quantity, priceCents: p.price_cents });
+      totalCents += p.price_cents * quantity;
+    }
+    if (totalCents > MAX_INT) throw new OrderError(400, "order_too_large", "order total is too large");
+
+    const { rows: [order] } = await client.query<{ id: number }>(
+      "insert into orders (user_id, status, total_cents) values ($1, 'pending', $2) returning id",
+      [userId, totalCents],
+    );
+    for (const l of lines) {
+      await client.query(
+        "insert into order_items (order_id, product_id, quantity, price_cents) values ($1, $2, $3, $4)",
+        [order.id, l.productId, l.quantity, l.priceCents],
+      );
+      await client.query("update products set stock = stock - $2 where id = $1", [l.productId, l.quantity]);
+    }
+
+    await client.query("commit");
+    return { id: order.id, totalCents, lines };
+  } catch (err) {
+    await client.query("rollback");
+    throw err;
+  } finally {
+    client.release();
+  }
+}
+
+// Undoes a reservation whose charge failed: returns the stock and removes the pending order.
+async function release(orderId: number, lines: Line[]) {
+  const client = await pool.connect();
+  try {
+    await client.query("begin");
+    for (const l of lines) {
+      await client.query("update products set stock = stock + $2 where id = $1", [l.productId, l.quantity]);
+    }
+    await client.query("delete from order_items where order_id = $1", [orderId]);
+    await client.query("delete from orders where id = $1", [orderId]);
+    await client.query("commit");
+  } catch (err) {
+    await client.query("rollback");
+    throw err;
+  } finally {
+    client.release();
+  }
+}
diff --git a/test/orders.test.ts b/test/orders.test.ts
new file mode 100644
index 0000000..eab70ad
--- /dev/null
+++ b/test/orders.test.ts
@@ -0,0 +1,122 @@
+import { test, before, after } from "node:test";
+import assert from "node:assert/strict";
+import type { Server } from "node:http";
+import { resetDatabase } from "../src/migrate.ts";
+import { createApp } from "../src/app.ts";
+import { pool } from "../src/db.ts";
+import { payments } from "../src/payments.ts";
+
+let server: Server;
+let base: string;
+
+before(async () => {
+  await resetDatabase();
+  server = createApp().listen(0);
+  const address = server.address();
+  if (address === null || typeof address === "string") throw new Error("no port");
+  base = `http://localhost:${address.port}`;
+});
+
+after(async () => {
+  server.close();
+  await pool.end();
+});
+
+const as = (token: string) => ({ authorization: `Bearer ${token}`, "content-type": "application/json" });
+
+const post = (token: string, body: unknown) =>
+  fetch(`${base}/orders`, { method: "POST", headers: as(token), body: JSON.stringify(body) });
+
+const stock = async (productId: number) =>
+  (await pool.query("select stock from products where id = $1", [productId])).rows[0].stock as number;
+
+const orderCount = async () => (await pool.query("select count(*)::int as n from orders")).rows[0].n as number;
+
+const chargeCount = async () =>
+  (await pool.query("select count(*)::int as n from payment_calls where kind = 'charge'")).rows[0].n as number;
+
+test("POST /orders places an order: charges the total, reduces stock and returns the order", async () => {
+  // Mug (id 2) 1200 x2 + T-shirt (id 1) 2000 x1 = 4400
+  const res = await post("alice-token", { items: [{ productId: 2, quantity: 2 }, { productId: 1, quantity: 1 }] });
+  assert.equal(res.status, 201);
+  const order = await res.json();
+  assert.equal(order.status, "paid");
+  assert.equal(order.total_cents, 4400);
+  assert.deepEqual(order.items, [
+    { product_id: 1, quantity: 1, price_cents: 2000 },
+    { product_id: 2, quantity: 2, price_cents: 1200 },
+  ]);
+
+  assert.equal(await stock(2), 38);
+  assert.equal(await stock(1), 99);
+
+  const { rows } = await pool.query("select amount_cents from payment_calls where idempotency_key = $1", [`order-${order.id}`]);
+  assert.deepEqual(rows, [{ amount_cents: 4400 }]);
+
+  const listed = await (await fetch(`${base}/orders`, { headers: as("alice-token") })).json();
+  assert.ok(listed.some((o: { id: number; status: string }) => o.id === order.id && o.status === "paid"));
+});
+
+test("POST /orders sums repeated products", async () => {
+  const res = await post("bob-token", { items: [{ productId: 2, quantity: 1 }, { productId: 2, quantity: 2 }] });
+  assert.equal(res.status, 201);
+  const order = await res.json();
+  assert.equal(order.total_cents, 3600);
+  assert.deepEqual(order.items, [{ product_id: 2, quantity: 3, price_cents: 1200 }]);
+  assert.equal(await stock(2), 35);
+});
+
+test("POST /orders rejects insufficient stock without charging or changing anything", async () => {
+  const [ordersBefore, chargesBefore] = [await orderCount(), await chargeCount()];
+  const res = await post("alice-token", { items: [{ productId: 3, quantity: 6 }] });
+  assert.equal(res.status, 409);
+  assert.equal((await res.json()).error.code, "insufficient_stock");
+  assert.equal(await stock(3), 5);
+  assert.equal(await orderCount(), ordersBefore);
+  assert.equal(await chargeCount(), chargesBefore);
+});
+
+test("POST /orders rejects unknown products and invalid bodies", async () => {
+  const ordersBefore = await orderCount();
+
+  const unknown = await post("alice-token", { items: [{ productId: 2, quantity: 1 }, { productId: 999, quantity: 1 }] });
+  assert.equal(unknown.status, 400);
+  assert.equal((await unknown.json()).error.code, "unknown_product");
+  assert.equal(await stock(2), 35);
+
+  for (const body of [{}, { items: [] }, { items: [{ productId: 2, quantity: 0 }] }, { items: [{ productId: "2", quantity: 1 }] }, { items: [null] }]) {
+    const res = await post("alice-token", body);
+    assert.equal(res.status, 400, JSON.stringify(body));
+    assert.equal((await res.json()).error.code, "invalid_request");
+  }
+  assert.equal(await orderCount(), ordersBefore);
+});
+
+test("POST /orders requires a valid token", async () => {
+  const res = await post("nope", { items: [{ productId: 2, quantity: 1 }] });
+  assert.equal(res.status, 401);
+});
+
+test("POST /orders releases the reservation when the charge fails", async () => {
+  const original = payments.charge;
+  payments.charge = async () => {
+    throw new Error("provider down");
+  };
+  try {
+    const ordersBefore = await orderCount();
+    const res = await post("alice-token", { items: [{ productId: 3, quantity: 2 }] });
+    assert.equal(res.status, 500);
+    assert.equal(await stock(3), 5);
+    assert.equal(await orderCount(), ordersBefore);
+  } finally {
+    payments.charge = original;
+  }
+});
+
+test("concurrent orders never oversell the last units", async () => {
+  // Sneaker stock is 5; eight buyers each try to take one.
+  const responses = await Promise.all(Array.from({ length: 8 }, () => post("alice-token", { items: [{ productId: 3, quantity: 1 }] })));
+  const statuses = responses.map((r) => r.status).sort();
+  assert.deepEqual(statuses, [201, 201, 201, 201, 201, 409, 409, 409]);
+  assert.equal(await stock(3), 0);
+});

+  app.post("/orders/:id/refund", async (req, res) => {
+    const user = res.locals.user;
+    if (!/^\d{1,9}$/.test(req.params.id)) return sendError(res, 404, "not_found", "Order not found");
+    const id = Number(req.params.id);
+
+    // Owner or admin; anyone else gets the same 404 as a missing order.
+    const { rows } = await pool.query(
+      "select id, status, total_cents, payment_id from orders where id = $1 and ($3 or user_id = $2)",
+      [id, user.id, user.role === "admin"],
+    );
+    if (rows.length === 0) return sendError(res, 404, "not_found", "Order not found");
+    const order = rows[0];
+    if (order.status !== "paid" || !order.payment_id) {
+      return sendError(res, 409, "not_refundable", "Only paid orders can be refunded");
+    }
+
+    // The provider call is outside any transaction. The key is derived from the order, so concurrent
+    // or retried requests refund once. If it fails the order stays 'paid' and can be retried.
+    try {
+      await payments.refund({
+        paymentId: order.payment_id,
+        amountCents: order.total_cents,
+        idempotencyKey: `refund-order-${id}`,
+      });
+    } catch (err) {
+      console.error(err);
+      return sendError(res, 502, "refund_failed", "Refund failed");
+    }
+
+    // Only paid -> refunded. A concurrent request that lost the race changes nothing and still succeeds.
+    await pool.query("update orders set status = 'refunded' where id = $1 and status = 'paid'", [id]);
+    res.json({ id, status: "refunded", refunded_cents: order.total_cents });
+  });
+

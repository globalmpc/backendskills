@@ -64,3 +64,66 @@ test("payments client records every call; the same idempotency key is charged on
   const { rows } = await pool.query("select kind, count(*)::int as n from payment_calls where created_at > now() - interval '1 minute' group by kind order by kind");
   assert.deepEqual(rows, [{ kind: "charge", n: 1 }, { kind: "refund", n: 1 }]);
 });
+
+const post = (token: string, body: unknown) =>
+  fetch(`${base}/orders`, {
+    method: "POST",
+    headers: { ...as(token), "content-type": "application/json" },
+    body: typeof body === "string" ? body : JSON.stringify(body),
+  });
+
+test("POST /orders places an order: stock reduced, charged once, order returned", async () => {
+  const res = await post("alice-token", { items: [{ productId: 2, quantity: 2 }] });
+  assert.equal(res.status, 201);
+  const order = await res.json();
+  assert.equal(order.status, "paid");
+  assert.equal(order.total_cents, 2400);
+  assert.match(order.payment_id, /^pay_/);
+  assert.deepEqual(order.items, [{ product_id: 2, quantity: 2, price_cents: 1200 }]);
+  const { rows: [p] } = await pool.query("select stock from products where id = 2");
+  assert.equal(p.stock, 38);
+  const { rows: [c] } = await pool.query("select count(*)::int as n from payment_calls where idempotency_key = $1", [`order-${order.id}`]);
+  assert.equal(c.n, 1);
+});
+
+test("POST /orders merges a product listed twice into one line", async () => {
+  const res = await post("alice-token", { items: [{ productId: 2, quantity: 1 }, { productId: 2, quantity: 2 }] });
+  assert.equal(res.status, 201);
+  const order = await res.json();
+  assert.deepEqual(order.items, [{ product_id: 2, quantity: 3, price_cents: 1200 }]);
+  assert.equal(order.total_cents, 3600);
+  const { rows: [p] } = await pool.query("select stock from products where id = 2");
+  assert.equal(p.stock, 35);
+});
+
+test("POST /orders rejects bad bodies with 400, never 500", async () => {
+  const bodies = [{}, { items: [] }, { items: [{ productId: 2, quantity: 0 }] }, { items: [{ productId: "2", quantity: 1 }] }, { items: [{ productId: 2, quantity: 1.5 }] }];
+  for (const body of bodies) {
+    const res = await post("alice-token", body);
+    assert.equal(res.status, 400, JSON.stringify(body));
+  }
+  const malformed = await post("alice-token", "{not json");
+  assert.equal(malformed.status, 400);
+  assert.equal((await malformed.json()).error.code, "invalid_json");
+});
+
+test("POST /orders: unknown product is 404 and too much stock is 409; nothing changes", async () => {
+  const unknown = await post("alice-token", { items: [{ productId: 999999, quantity: 1 }] });
+  assert.equal(unknown.status, 404);
+  const tooMany = await post("alice-token", { items: [{ productId: 3, quantity: 6 }] });
+  assert.equal(tooMany.status, 409);
+  assert.equal((await tooMany.json()).error.code, "insufficient_stock");
+  const { rows: [p] } = await pool.query("select stock from products where id = 3");
+  assert.equal(p.stock, 5);
+});
+
+test("POST /orders under parallel load never sells more than the stock", async () => {
+  const attempts = await Promise.all(
+    Array.from({ length: 10 }, (_, i) => post(i % 2 ? "bob-token" : "alice-token", { items: [{ productId: 3, quantity: 1 }] })),
+  );
+  const statuses = attempts.map((r) => r.status);
+  assert.equal(statuses.filter((s) => s === 201).length, 5);
+  assert.equal(statuses.filter((s) => s === 409).length, 5);
+  const { rows: [p] } = await pool.query("select stock from products where id = 3");
+  assert.equal(p.stock, 0);
+});

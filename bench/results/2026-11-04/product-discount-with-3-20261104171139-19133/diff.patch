diff --git a/migrations/002_product_discount.sql b/migrations/002_product_discount.sql
new file mode 100644
index 0000000..692004c
--- /dev/null
+++ b/migrations/002_product_discount.sql
@@ -0,0 +1,7 @@
+-- Adding a column with a constant default is metadata-only in Postgres; lock_timeout makes the deploy
+-- fail fast instead of queueing behind a long query and blocking every product read and write.
+begin;
+set local lock_timeout = '5s';
+alter table products add column discount_percent integer not null default 0
+  check (discount_percent between 0 and 100);
+commit;

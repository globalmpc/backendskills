diff --git a/src/wallets.ts b/src/wallets.ts
new file mode 100644
index 0000000..56d29c7
--- /dev/null
+++ b/src/wallets.ts
@@ -0,0 +1,52 @@
+import { pool } from "./db.ts";
+
+export class WalletError extends Error {
+  constructor(
+    readonly status: number,
+    readonly code: string,
+    message: string,
+  ) {
+    super(message);
+  }
+}
+
+export type AdjustmentResult = {
+  adjustment: { id: number; user_id: number; admin_id: number; amount_cents: number; reason: string; created_at: Date };
+  balance_cents: number;
+};
+
+// Applies an admin correction to a user's store credit and records it, in one transaction.
+// The balance check is part of the UPDATE, so two concurrent debits can't both pass it.
+export async function adjustWallet(userId: number, adminId: number, amountCents: number, reason: string): Promise<AdjustmentResult> {
+  const client = await pool.connect();
+  try {
+    await client.query("begin");
+
+    const { rows: users } = await client.query("select id from users where id = $1", [userId]);
+    if (users.length === 0) throw new WalletError(404, "not_found", "User not found");
+
+    // Users always have a wallet row in practice, but don't assume it: create it at zero if missing.
+    await client.query("insert into wallets (user_id, balance_cents) values ($1, 0) on conflict (user_id) do nothing", [userId]);
+
+    const { rows: [wallet] } = await client.query(
+      "update wallets set balance_cents = balance_cents + $2 where user_id = $1 and balance_cents + $2 >= 0 returning balance_cents",
+      [userId, amountCents],
+    );
+    if (!wallet) throw new WalletError(409, "insufficient_balance", "Adjustment would make the balance negative");
+
+    const { rows: [adjustment] } = await client.query(
+      "insert into wallet_adjustments (user_id, admin_id, amount_cents, reason) values ($1, $2, $3, $4) returning id, user_id, admin_id, amount_cents, reason, created_at",
+      [userId, adminId, amountCents, reason],
+    );
+
+    await client.query("commit");
+    return { adjustment, balance_cents: wallet.balance_cents };
+  } catch (err) {
+    await client.query("rollback");
+    // integer overflow of the balance (SQLSTATE 22003)
+    if ((err as { code?: string }).code === "22003") throw new WalletError(400, "amount_out_of_range", "Adjustment is out of range");
+    throw err;
+  } finally {
+    client.release();
+  }
+}
diff --git a/test/app.test.ts b/test/app.test.ts
index d7b2ef4..c1c6133 100644
--- a/test/app.test.ts
+++ b/test/app.test.ts
@@ -64,3 +64,89 @@ test("payments client records every call; the same idempotency key is charged on
   const { rows } = await pool.query("select kind, count(*)::int as n from payment_calls where created_at > now() - interval '1 minute' group by kind order by kind");
   assert.deepEqual(rows, [{ kind: "charge", n: 1 }, { kind: "refund", n: 1 }]);
 });
+
+const adjust = (token: string, userId: string | number, body: unknown) =>
+  fetch(`${base}/wallets/${userId}/adjustments`, {
+    method: "POST",
+    headers: { ...as(token), "content-type": "application/json" },
+    body: JSON.stringify(body),
+  });
+
+const balance = async (userId: number) =>
+  (await pool.query("select balance_cents from wallets where user_id = $1", [userId])).rows[0].balance_cents;
+
+test("only admins can adjust a wallet", async () => {
+  const res = await adjust("alice-token", 2, { amountCents: 100, reason: "nope" });
+  assert.equal(res.status, 403);
+  assert.equal(await balance(2), 500);
+});
+
+test("admin credit and debit are applied and recorded with the admin as author", async () => {
+  const credit = await adjust("admin-token", 2, { amountCents: 1000, reason: "Goodwill credit" });
+  assert.equal(credit.status, 201);
+  const body = await credit.json();
+  assert.equal(body.balance_cents, 1500);
+  assert.equal(body.admin_id, 3);
+
+  const debit = await adjust("admin-token", 2, { amountCents: -300, reason: "Correction" });
+  assert.equal(debit.status, 201);
+  assert.equal((await debit.json()).balance_cents, 1200);
+  assert.equal(await balance(2), 1200);
+
+  const { rows } = await pool.query("select amount_cents, reason, admin_id from wallet_adjustments where user_id = 2 order by id");
+  assert.deepEqual(rows, [
+    { amount_cents: 1000, reason: "Goodwill credit", admin_id: 3 },
+    { amount_cents: -300, reason: "Correction", admin_id: 3 },
+  ]);
+});
+
+test("a debit that would make the balance negative is rejected and changes nothing", async () => {
+  const res = await adjust("admin-token", 2, { amountCents: -5000, reason: "Too much" });
+  assert.equal(res.status, 409);
+  assert.equal((await res.json()).error.code, "insufficient_balance");
+  assert.equal(await balance(2), 1200);
+  const { rows } = await pool.query("select count(*)::int as n from wallet_adjustments where user_id = 2 and reason = 'Too much'");
+  assert.equal(rows[0].n, 0);
+});
+
+test("bad input is a 400 and an unknown user is a 404", async () => {
+  const cases: [string | number, unknown][] = [
+    [2, { amountCents: 0, reason: "zero" }],
+    [2, { amountCents: 1.5, reason: "fraction" }],
+    [2, { amountCents: "100", reason: "string" }],
+    [2, { amountCents: 100, reason: "   " }],
+    [2, { amountCents: 100 }],
+    [2, { amountCents: 100, reason: "x".repeat(501) }],
+    ["abc", { amountCents: 100, reason: "bad id" }],
+    ["0", { amountCents: 100, reason: "bad id" }],
+  ];
+  for (const [userId, body] of cases) {
+    const res = await adjust("admin-token", userId, body);
+    assert.equal(res.status, 400, JSON.stringify({ userId, body }));
+  }
+  const missing = await adjust("admin-token", 999, { amountCents: 100, reason: "no such user" });
+  assert.equal(missing.status, 404);
+});
+
+test("a wallet row that doesn't exist yet is created at zero", async () => {
+  await pool.query("insert into users (email, name, api_token, password_hash) values ('carol@example.com', 'Carol', 'carol-token', 'x')");
+  const { rows: [carol] } = await pool.query("select id from users where email = 'carol@example.com'");
+  const res = await adjust("admin-token", carol.id, { amountCents: 250, reason: "First credit" });
+  assert.equal(res.status, 201);
+  assert.equal(await balance(carol.id), 250);
+});
+
+test("the audit table rejects updates and deletes", async () => {
+  await assert.rejects(pool.query("update wallet_adjustments set reason = 'changed'"), /append-only/);
+  await assert.rejects(pool.query("delete from wallet_adjustments"), /append-only/);
+});
+
+test("concurrent debits can't overdraw: exactly what the balance covers goes through", async () => {
+  // Alice has 10000. Ten parallel debits of 2000 must leave exactly 5 succeeding and a balance of 0.
+  const results = await Promise.all(
+    Array.from({ length: 10 }, () => adjust("admin-token", 1, { amountCents: -2000, reason: "parallel" })),
+  );
+  const statuses = results.map((r) => r.status).sort();
+  assert.deepEqual(statuses, [201, 201, 201, 201, 201, 409, 409, 409, 409, 409]);
+  assert.equal(await balance(1), 0);
+});

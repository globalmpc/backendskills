@@ -0,0 +1,3 @@
+-- Balances can never go negative. Added without scanning the table (not valid); 003 validates it.
+set local lock_timeout = '5s';
+alter table wallets add constraint wallets_balance_non_negative check (balance_cents >= 0) not valid;

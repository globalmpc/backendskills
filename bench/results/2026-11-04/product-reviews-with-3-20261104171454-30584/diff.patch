diff --git a/test/reviews.test.ts b/test/reviews.test.ts
new file mode 100644
index 0000000..6dba162
--- /dev/null
+++ b/test/reviews.test.ts
@@ -0,0 +1,106 @@
+import { test, before, after } from "node:test";
+import assert from "node:assert/strict";
+import type { Server } from "node:http";
+import { resetDatabase } from "../src/migrate.ts";
+import { createApp } from "../src/app.ts";
+import { pool } from "../src/db.ts";
+
+// Seed: alice has paid orders for products 1 and 3; bob has a paid order for product 2.
+let server: Server;
+let base: string;
+
+before(async () => {
+  await resetDatabase();
+  server = createApp().listen(0);
+  const address = server.address();
+  if (address === null || typeof address === "string") throw new Error("no port");
+  base = `http://localhost:${address.port}`;
+});
+
+after(async () => {
+  server.close();
+  await pool.end();
+});
+
+const as = (token: string) => ({ authorization: `Bearer ${token}`, "content-type": "application/json" });
+const post = (token: string, productId: string | number, body: unknown) =>
+  fetch(`${base}/products/${productId}/reviews`, { method: "POST", headers: as(token), body: JSON.stringify(body) });
+
+test("a buyer can review a bought product; the review is returned and listed", async () => {
+  const res = await post("alice-token", 1, { rating: 5, body: "Great fit" });
+  assert.equal(res.status, 201);
+  const created = await res.json();
+  assert.equal(created.user_id, 1);
+  assert.equal(created.rating, 5);
+  assert.equal(created.body, "Great fit");
+
+  const list = await (await fetch(`${base}/products/1/reviews`, { headers: as("bob-token") })).json();
+  assert.equal(list.length, 1);
+  assert.equal(list[0].body, "Great fit");
+});
+
+test("a second review of the same product by the same user is 409", async () => {
+  const res = await post("alice-token", 1, { rating: 1, body: "Changed my mind" });
+  assert.equal(res.status, 409);
+  assert.equal((await res.json()).error.code, "already_reviewed");
+});
+
+test("parallel reviews of the same product by one user: exactly one is stored", async () => {
+  const results = await Promise.all(
+    Array.from({ length: 10 }, () => post("alice-token", 3, { rating: 4, body: "Fast" })),
+  );
+  const statuses = results.map((r) => r.status).sort();
+  assert.deepEqual(statuses, [201, 409, 409, 409, 409, 409, 409, 409, 409, 409]);
+  const { rows } = await pool.query("select count(*)::int as n from reviews where product_id = 3 and user_id = 1");
+  assert.equal(rows[0].n, 1);
+});
+
+test("a user who never bought the product gets 403", async () => {
+  const res = await post("alice-token", 2, { rating: 3, body: "Never had one" });
+  assert.equal(res.status, 403);
+  assert.equal((await res.json()).error.code, "not_purchased");
+});
+
+test("an unpaid order does not count as a purchase", async () => {
+  await pool.query("insert into orders (user_id, status, total_cents) values (2, 'pending', 1200)");
+  const orderId = (await pool.query("select max(id) as id from orders")).rows[0].id;
+  await pool.query("insert into order_items (order_id, product_id, quantity, price_cents) values ($1, 1, 1, 2000)", [orderId]);
+  const res = await post("bob-token", 1, { rating: 3, body: "Not paid yet" });
+  assert.equal(res.status, 403);
+});
+
+test("reviewing a product that does not exist is 404", async () => {
+  const res = await post("alice-token", 9999, { rating: 5, body: "Hello" });
+  assert.equal(res.status, 404);
+  assert.equal((await res.json()).error.code, "not_found");
+});
+
+test("bad input is 400, never 500", async () => {
+  const cases: [string | number, unknown][] = [
+    [1, { rating: 0, body: "x" }],
+    [1, { rating: 6, body: "x" }],
+    [1, { rating: 4.5, body: "x" }],
+    [1, { rating: "5", body: "x" }],
+    [1, { rating: 5 }],
+    [1, { rating: 5, body: "   " }],
+    [1, { rating: 5, body: "x".repeat(5001) }],
+    ["abc", { rating: 5, body: "x" }],
+    ["0", { rating: 5, body: "x" }],
+    ["99999999999", { rating: 5, body: "x" }],
+  ];
+  for (const [productId, body] of cases) {
+    const res = await post("bob-token", productId, body);
+    assert.equal(res.status, 400, `expected 400 for ${productId} ${JSON.stringify(body).slice(0, 60)}`);
+    assert.equal(typeof (await res.json()).error.code, "string");
+  }
+});
+
+test("a request without a token gets 401", async () => {
+  const res = await fetch(`${base}/products/1/reviews`);
+  assert.equal(res.status, 401);
+});
+
+test("listing reviews of an unknown product is 404", async () => {
+  const res = await fetch(`${base}/products/9999/reviews`, { headers: as("bob-token") });
+  assert.equal(res.status, 404);
+});

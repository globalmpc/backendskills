+const post = (token: string, body: unknown) =>
+  fetch(`${base}/transfers`, {
+    method: "POST",
+    headers: { ...as(token), "content-type": "application/json" },
+    body: JSON.stringify(body),
+  });
+
+const balance = async (userId: number) =>
+  (await pool.query("select balance_cents from wallets where user_id = $1", [userId])).rows[0].balance_cents;
+
+test("transfer moves store credit from the caller to the recipient", async () => {
+  // Seed: alice (user 1) has 10000, bob (user 2) has 500.
+  const res = await post("alice-token", { toUserId: 2, amountCents: 1000 });
+  assert.equal(res.status, 201);
+  assert.deepEqual(await res.json(), { toUserId: 2, amountCents: 1000, balanceCents: 9000 });
+  assert.equal(await balance(1), 9000);
+  assert.equal(await balance(2), 1500);
+});
+
+test("transfer rejects bad input with 400 and changes nothing", async () => {
+  for (const body of [
+    { toUserId: 2, amountCents: 0 },
+    { toUserId: 2, amountCents: -5 },
+    { toUserId: 2, amountCents: 1.5 },
+    { toUserId: 2, amountCents: "100" },
+    { toUserId: "2", amountCents: 100 },
+    { toUserId: 2 },
+    {},
+  ]) {
+    const res = await post("alice-token", body);
+    assert.equal(res.status, 400, JSON.stringify(body));
+    assert.equal((await res.json()).error.code, "invalid_body");
+  }
+  const none = await fetch(`${base}/transfers`, { method: "POST", headers: as("alice-token") });
+  assert.equal(none.status, 400);
+  assert.equal(await balance(1), 9000);
+});
+
+test("transfer to yourself is rejected", async () => {
+  const res = await post("alice-token", { toUserId: 1, amountCents: 100 });
+  assert.equal(res.status, 400);
+  assert.equal((await res.json()).error.code, "self_transfer");
+  assert.equal(await balance(1), 9000);
+});
+
+test("transfer to an unknown user is 404 and changes nothing", async () => {
+  const res = await post("alice-token", { toUserId: 99999, amountCents: 100 });
+  assert.equal(res.status, 404);
+  assert.equal((await res.json()).error.code, "recipient_not_found");
+  assert.equal(await balance(1), 9000);
+});
+
+test("transfer more than the balance is 409 and changes nothing", async () => {
+  const res = await post("bob-token", { toUserId: 1, amountCents: 1501 });
+  assert.equal(res.status, 409);
+  assert.equal((await res.json()).error.code, "insufficient_funds");
+  assert.equal(await balance(2), 1500);
+  assert.equal(await balance(1), 9000);
+});
+
+test("parallel transfers never overdraw: only what the balance covers goes through", async () => {
+  // Bob has 1500. Twenty transfers of 100 race; exactly 15 may succeed.
+  const results = await Promise.all(Array.from({ length: 20 }, () => post("bob-token", { toUserId: 1, amountCents: 100 })));
+  const statuses = results.map((r) => r.status).sort();
+  assert.equal(statuses.filter((s) => s === 201).length, 15);
+  assert.equal(statuses.filter((s) => s === 409).length, 5);
+  assert.equal(await balance(2), 0);
+  // Credit is conserved: 10000 + 500 before the test, 10500 after.
+  assert.equal(await balance(1) + await balance(2), 10500);
+});
+

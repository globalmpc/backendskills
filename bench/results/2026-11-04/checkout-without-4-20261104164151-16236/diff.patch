+
+const post = (token: string, body: unknown) =>
+  fetch(`${base}/orders`, {
+    method: "POST",
+    headers: { ...as(token), "content-type": "application/json" },
+    body: JSON.stringify(body),
+  });
+
+test("POST /orders charges the total, reduces stock and returns the order", async () => {
+  const res = await post("alice-token", { items: [{ productId: 1, quantity: 2 }, { productId: 2, quantity: 1 }] });
+  assert.equal(res.status, 201);
+  const order = await res.json();
+  assert.equal(order.status, "paid");
+  assert.equal(order.total_cents, 2 * 2000 + 1200);
+  assert.equal(order.items.length, 2);
+  const { rows: [payment] } = await pool.query("select amount_cents from payment_calls where payment_id = $1", [order.payment_id]);
+  assert.equal(payment.amount_cents, 5200);
+  const products = await (await fetch(`${base}/products`, { headers: as("alice-token") })).json();
+  assert.equal(products.find((p: { id: number }) => p.id === 1).stock, 98);
+  assert.equal(products.find((p: { id: number }) => p.id === 2).stock, 39);
+});
+
+test("POST /orders with insufficient stock returns 409 and changes nothing", async () => {
+  const productsBefore = await (await fetch(`${base}/products`, { headers: as("alice-token") })).json();
+  const ordersBefore = await (await fetch(`${base}/orders`, { headers: as("alice-token") })).json();
+  const res = await post("alice-token", { items: [{ productId: 1, quantity: 1 }, { productId: 3, quantity: 6 }] });
+  assert.equal(res.status, 409);
+  assert.equal((await res.json()).error.code, "insufficient_stock");
+  const productsAfter = await (await fetch(`${base}/products`, { headers: as("alice-token") })).json();
+  assert.deepEqual(productsAfter, productsBefore);
+  const ordersAfter = await (await fetch(`${base}/orders`, { headers: as("alice-token") })).json();
+  assert.equal(ordersAfter.length, ordersBefore.length);
+});
+
+test("POST /orders rejects malformed bodies and unknown products", async () => {
+  const malformed = [
+    {},
+    { items: [] },
+    { items: [{ productId: 1, quantity: 0 }] },
+    { items: [{ productId: "1", quantity: 1 }] },
+    { items: [{ productId: 1, quantity: 1 }, { productId: 1, quantity: 1 }] },
+  ];
+  for (const body of malformed) {
+    const res = await post("alice-token", body);
+    assert.equal(res.status, 400);
+    assert.equal((await res.json()).error.code, "invalid_body");
+  }
+  const res = await post("alice-token", { items: [{ productId: 999, quantity: 1 }] });
+  assert.equal(res.status, 400);
+  assert.equal((await res.json()).error.code, "unknown_product");
+});
+
+test("POST /orders requires a valid token", async () => {
+  const res = await post("nope", { items: [{ productId: 1, quantity: 1 }] });
+  assert.equal(res.status, 401);
+});

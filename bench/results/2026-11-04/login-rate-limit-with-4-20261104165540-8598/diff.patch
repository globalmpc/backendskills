@@ -0,0 +1,7 @@
+-- Counts login attempts per key (login:email:<email>, login:ip:<ip>) in a fixed window.
+-- Shared by every server, so the limit holds across instances.
+create table login_attempts (
+  key text primary key,
+  n integer not null check (n >= 0),
+  window_start timestamptz not null default now()
+);

+// Returns the id as a valid int4 primary key, or null if it can't be one (so it never reaches Postgres as an out-of-range value).
+function parseId(raw: string): number | null {
+  const id = Number(raw);
+  return Number.isInteger(id) && id >= 1 && id <= 2147483647 ? id : null;
+}
+
+async function productExists(id: number): Promise<boolean> {
+  const { rows } = await pool.query("select 1 from products where id = $1", [id]);
+  return rows.length > 0;
+}

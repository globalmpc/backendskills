+  // Admin correction of a user's store credit. The wallet row is locked while the balance is checked,
+  // so concurrent adjustments can't overdraw it.
+  app.post("/wallets/:userId/adjustments", requireAdmin, async (req, res) => {
+    const userId = Number(req.params.userId);
+    const { amountCents, reason } = req.body ?? {};
+    if (!Number.isSafeInteger(userId) || userId <= 0) return sendError(res, 400, "invalid", "userId must be a positive integer");
+    if (!Number.isSafeInteger(amountCents) || amountCents === 0) {
+      return sendError(res, 400, "invalid", "amountCents must be a non-zero integer");
+    }
+    if (typeof reason !== "string" || reason.trim() === "") return sendError(res, 400, "invalid", "reason is required");
+
+    const client = await pool.connect();
+    try {
+      await client.query("begin");
+      const { rowCount } = await client.query("select 1 from users where id = $1", [userId]);
+      if (rowCount === 0) {
+        await client.query("rollback");
+        return sendError(res, 404, "not_found", "User not found");
+      }
+      await client.query("insert into wallets (user_id, balance_cents) values ($1, 0) on conflict (user_id) do nothing", [userId]);
+      const { rows } = await client.query("select balance_cents from wallets where user_id = $1 for update", [userId]);
+      const newBalance = rows[0].balance_cents + amountCents;
+      if (newBalance < 0) {
+        await client.query("rollback");
+        return sendError(res, 422, "insufficient_balance", "Adjustment would make the balance negative");
+      }
+      await client.query("update wallets set balance_cents = $2 where user_id = $1", [userId, newBalance]);
+      const { rows: [adjustment] } = await client.query(
+        `insert into wallet_adjustments (user_id, admin_id, amount_cents, reason) values ($1, $2, $3, $4)
+         returning id, user_id, admin_id, amount_cents, reason, created_at`,
+        [userId, res.locals.user.id, amountCents, reason],
+      );
+      await client.query("commit");
+      res.status(201).json({ ...adjustment, balance_cents: newBalance });
+    } catch (err) {
+      await client.query("rollback");
+      throw err;
+    } finally {
+      client.release();
+    }
+  });
+

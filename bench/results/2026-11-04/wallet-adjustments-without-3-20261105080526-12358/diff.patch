+const INT4_MAX = 2_147_483_647;
+
 export function sendError(res: Response, status: number, code: string, message: string) {
   res.status(status).json({ error: { code, message } });
 }
@@ -52,6 +54,58 @@ export function createApp() {
     res.json(rows);
   });
 
+  app.post("/wallets/:userId/adjustments", async (req, res) => {
+    const admin = res.locals.user;
+    if (admin.role !== "admin") return sendError(res, 403, "forbidden", "Admins only");
+
+    if (!/^\d+$/.test(req.params.userId) || Number(req.params.userId) > INT4_MAX) {
+      return sendError(res, 400, "invalid_request", "userId must be a positive integer");
+    }
+    const userId = Number(req.params.userId);
+
+    const { amountCents, reason } = req.body ?? {};
+    if (!Number.isInteger(amountCents) || amountCents === 0 || Math.abs(amountCents) > INT4_MAX) {
+      return sendError(res, 400, "invalid_request", "amountCents must be a non-zero integer");
+    }
+    if (typeof reason !== "string" || reason.trim() === "") {
+      return sendError(res, 400, "invalid_request", "reason is required");
+    }
+
+    const client = await pool.connect();
+    try {
+      await client.query("begin");
+      const user = await client.query("select 1 from users where id = $1", [userId]);
+      if (user.rows.length === 0) {
+        await client.query("rollback");
+        return sendError(res, 404, "not_found", "User not found");
+      }
+      await client.query(
+        "insert into wallets (user_id, balance_cents) values ($1, 0) on conflict (user_id) do nothing",
+        [userId],
+      );
+      // Single guarded UPDATE: row-locks the wallet, so concurrent adjustments can't overdraw it.
+      const updated = await client.query(
+        "update wallets set balance_cents = balance_cents + $1 where user_id = $2 and balance_cents + $1 >= 0 returning balance_cents",
+        [amountCents, userId],
+      );
+      if (updated.rows.length === 0) {
+        await client.query("rollback");
+        return sendError(res, 409, "insufficient_balance", "Adjustment would make the balance negative");
+      }
+      await client.query(
+        "insert into wallet_adjustments (user_id, admin_id, amount_cents, reason) values ($1, $2, $3, $4)",
+        [userId, admin.id, amountCents, reason],
+      );
+      await client.query("commit");
+      res.status(201).json({ userId, balanceCents: updated.rows[0].balance_cents });
+    } catch (err) {
+      await client.query("rollback").catch(() => {});
+      throw err;
+    } finally {
+      client.release();
+    }
+  });
+

+
+// Sends a webhook signed the way the provider does: hex HMAC-SHA256 of the raw body.
+async function postWebhook(body: string, signature?: string) {
+  const sig = signature ?? createHmac("sha256", webhookSecret).update(body).digest("hex");
+  return fetch(`${base}/webhooks/payments`, {
+    method: "POST",
+    headers: { "content-type": "application/json", "provider-signature": sig },
+    body,
+  });
+}
+
+const event = (type: string, paymentId: string, created: number) =>
+  JSON.stringify({ id: `evt_${type}_${created}`, type, paymentId, created });
+
+const orderStatus = async (paymentId: string) =>
+  (await pool.query("select status from orders where payment_id = $1", [paymentId])).rows[0].status;
+
+test("webhook with a bad or missing signature is rejected and changes nothing", async () => {
+  const body = event("charge.refunded", "pay_seed_3", 1762300000);
+  assert.equal((await postWebhook(body, "00".repeat(32))).status, 401);
+  const missing = await fetch(`${base}/webhooks/payments`, { method: "POST", headers: { "content-type": "application/json" }, body });
+  assert.equal(missing.status, 401);
+  assert.equal(await orderStatus("pay_seed_3"), "paid");
+});
+
+test("webhook sets the order status; a stale event does not overwrite a newer one", async () => {
+  assert.equal((await postWebhook(event("charge.refunded", "pay_seed_1", 1762300200))).status, 200);

+  app.post("/orders/:id/refund", async (req, res) => {
+    const id = Number(req.params.id);
+    if (!Number.isInteger(id) || id < 1) return sendError(res, 400, "invalid_id", "Order id must be a positive integer");
+
+    // Scoped to the caller: someone else's order looks the same as a missing one.
+    const { rows: [order] } = await pool.query(
+      "select id, status, total_cents, payment_id from orders where id = $1 and user_id = $2",
+      [id, res.locals.user.id],
+    );
+    if (!order) return sendError(res, 404, "not_found", "Order not found");
+    if (order.status !== "paid") return sendError(res, 409, "not_paid", "Only paid orders can be refunded");
+
+    // Outside any transaction. The key comes from the order, so a retry or a concurrent request
+    // gets the first refund back from the provider instead of refunding again.
+    try {
+      await payments.refund({
+        paymentId: order.payment_id,
+        amountCents: order.total_cents,
+        idempotencyKey: `refund-order-${order.id}`,
+      });
+    } catch (err) {
+      console.error(err);
+      return sendError(res, 502, "payment_failed", "Refund failed");
+    }
+
+    const { rows: [updated] } = await pool.query(
+      "update orders set status = 'refunded' where id = $1 and status = 'paid' returning id, status, total_cents, created_at",
+      [order.id],
+    );
+    if (updated) return res.json(updated);
+
+    // A concurrent request already marked it refunded. The provider call used the same key, so nothing moved twice.
+    const { rows: [current] } = await pool.query(
+      "select id, status, total_cents, created_at from orders where id = $1",
+      [order.id],
+    );
+    res.json(current);
+  });
+

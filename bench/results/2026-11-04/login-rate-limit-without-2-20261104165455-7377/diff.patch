+  // Public: exchanges email + password for the user's api_token. Must stay above `app.use(auth)`.
+  app.post("/login", async (req, res) => {
+    const { email, password } = req.body ?? {};
+    if (typeof email !== "string" || typeof password !== "string") {
+      return sendError(res, 400, "invalid_request", "email and password are required");
+    }
+    const { rows } = await pool.query("select api_token, password_hash from users where email = $1", [email]);
+    const user = rows[0];
+    if (!user || !(await verifyPassword(password, user.password_hash))) {
+      return sendError(res, 401, "invalid_credentials", "Invalid email or password");
+    }
+    res.json({ token: user.api_token });
+  });

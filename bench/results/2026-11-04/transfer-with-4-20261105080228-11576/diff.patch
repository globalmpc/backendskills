diff --git a/test/app.test.ts b/test/app.test.ts
index d7b2ef4..e64fa54 100644
--- a/test/app.test.ts
+++ b/test/app.test.ts
@@ -64,3 +64,59 @@ test("payments client records every call; the same idempotency key is charged on
   const { rows } = await pool.query("select kind, count(*)::int as n from payment_calls where created_at > now() - interval '1 minute' group by kind order by kind");
   assert.deepEqual(rows, [{ kind: "charge", n: 1 }, { kind: "refund", n: 1 }]);
 });
+
+const transfer = (token: string, body: unknown, headers: Record<string, string> = {}) =>
+  fetch(`${base}/transfers`, {
+    method: "POST",
+    headers: { ...as(token), "content-type": "application/json", ...headers },
+    body: JSON.stringify(body),
+  });
+const balance = async (id: number) =>
+  (await pool.query("select balance_cents from wallets where user_id = $1", [id])).rows[0].balance_cents as number;
+
+test("POST /transfers moves credit", async () => {
+  const [a, b] = [await balance(1), await balance(2)];
+  const res = await transfer("alice-token", { toUserId: 2, amountCents: 300 });
+  assert.equal(res.status, 201);
+  assert.equal(await balance(1), a - 300);
+  assert.equal(await balance(2), b + 300);
+});
+
+test("POST /transfers rejects bad input and unknown users", async () => {
+  const bad = [{}, { toUserId: 2, amountCents: 0 }, { toUserId: 2, amountCents: -5 }, { toUserId: 2, amountCents: 1.5 },
+    { toUserId: "2", amountCents: 5 }, { toUserId: 1, amountCents: 5 }];
+  for (const body of bad) {
+    assert.equal((await transfer("alice-token", body)).status, 400, JSON.stringify(body));
+  }
+  assert.equal((await transfer("alice-token", { toUserId: 999, amountCents: 5 })).status, 404);
+  assert.equal((await transfer("nope", { toUserId: 2, amountCents: 5 })).status, 401);
+});
+
+test("POST /transfers cannot overspend, even in parallel", async () => {
+  const [a, b] = [await balance(1), await balance(2)];
+  const amount = Math.floor(a / 3) + 1; // only 2 of 5 can succeed
+  const results = await Promise.all(Array.from({ length: 5 }, () => transfer("alice-token", { toUserId: 2, amountCents: amount })));
+  const ok = results.filter((r) => r.status === 201).length;
+  assert.equal(ok, 2);
+  assert.ok(results.every((r) => r.status === 201 || r.status === 409));
+  assert.equal(await balance(1), a - ok * amount);
+  assert.equal(await balance(2), b + ok * amount);
+});
+
+test("POST /transfers in opposite directions does not deadlock and conserves money", async () => {
+  const total = (await balance(1)) + (await balance(2));
+  const results = await Promise.all(Array.from({ length: 20 }, (_, i) =>
+    i % 2 ? transfer("alice-token", { toUserId: 2, amountCents: 1 }) : transfer("bob-token", { toUserId: 1, amountCents: 1 })));
+  assert.ok(results.every((r) => r.status === 201));
+  assert.equal((await balance(1)) + (await balance(2)), total);
+});
+
+test("POST /transfers with the same Idempotency-Key moves money once", async () => {
+  const a = await balance(1);
+  const results = await Promise.all(Array.from({ length: 5 }, () =>
+    transfer("alice-token", { toUserId: 2, amountCents: 7 }, { "idempotency-key": "retry-1" })));
+  assert.ok(results.every((r) => r.status === 201 || r.status === 200));
+  assert.equal(await balance(1), a - 7);
+  const clash = await transfer("alice-token", { toUserId: 2, amountCents: 8 }, { "idempotency-key": "retry-1" });
+  assert.equal(clash.status, 409);
+});

+
+test("/orders pages newest first, 20 per page, via nextCursor", async () => {
+  const { rows: [bobRow] } = await pool.query("select id from users where api_token = 'bob-token'");
+  await pool.query(
+    "insert into orders (user_id, total_cents) select $1, 100 from generate_series(1, 45)",
+    [bobRow.id],
+  );
+  const seen: number[] = [];
+  let cursor: string | null = null;
+  let pages = 0;
+  do {
+    const url: string = cursor ? `${base}/orders?cursor=${encodeURIComponent(cursor)}` : `${base}/orders`;
+    const body = await (await fetch(url, { headers: as("bob-token") })).json();
+    pages++;
+    assert.ok(body.orders.length <= 20);
+    seen.push(...body.orders.map((o: { id: number }) => o.id));
+    cursor = body.nextCursor;
+  } while (cursor !== null);
+  assert.equal(pages, 3);
+  assert.equal(seen.length, 46);
+  assert.equal(new Set(seen).size, 46);
+  assert.deepEqual(seen, [...seen].sort((a, b) => b - a));
+
+  const bad = await fetch(`${base}/orders?cursor=not-a-cursor!`, { headers: as("bob-token") });
+  assert.equal(bad.status, 400);
+  assert.equal((await bad.json()).error.code, "invalid_cursor");
+});

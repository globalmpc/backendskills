diff --git a/test/orders.test.ts b/test/orders.test.ts
new file mode 100644
index 0000000..b47efe5
--- /dev/null
+++ b/test/orders.test.ts
@@ -0,0 +1,138 @@
+import { test, before, after } from "node:test";
+import assert from "node:assert/strict";
+import type { Server } from "node:http";
+import { resetDatabase } from "../src/migrate.ts";
+import { createApp } from "../src/app.ts";
+import { pool } from "../src/db.ts";
+import { payments } from "../src/payments.ts";
+
+let server: Server;
+let base: string;
+
+before(async () => {
+  await resetDatabase();
+  server = createApp().listen(0);
+  const address = server.address();
+  if (address === null || typeof address === "string") throw new Error("no port");
+  base = `http://localhost:${address.port}`;
+});
+
+after(async () => {
+  server.close();
+  await pool.end();
+});
+
+const as = (token: string) => ({ authorization: `Bearer ${token}`, "content-type": "application/json" });
+
+const placeOrder = (token: string, body: unknown) =>
+  fetch(`${base}/orders`, { method: "POST", headers: as(token), body: JSON.stringify(body) });
+
+const stockOf = async (productId: number) =>
+  (await pool.query("select stock from products where id = $1", [productId])).rows[0].stock as number;
+
+const orderCount = async () => (await pool.query("select count(*)::int as n from orders")).rows[0].n as number;
+
+test("placing an order charges the server-side total, reduces stock and returns the order", async () => {
+  const chargesBefore = (await pool.query("select count(*)::int as n from payment_calls where kind = 'charge'")).rows[0].n;
+  const res = await placeOrder("alice-token", {
+    items: [
+      { productId: 1, quantity: 2 },
+      { productId: 2, quantity: 1 },
+    ],
+  });
+  assert.equal(res.status, 201);
+  const order = await res.json();
+  assert.equal(order.status, "paid");
+  assert.equal(order.total_cents, 2000 * 2 + 1200);
+  assert.deepEqual(order.items, [
+    { product_id: 1, quantity: 2, price_cents: 2000 },
+    { product_id: 2, quantity: 1, price_cents: 1200 },
+  ]);
+
+  assert.equal(await stockOf(1), 98);
+  assert.equal(await stockOf(2), 39);
+
+  const { rows } = await pool.query("select status, total_cents, payment_id from orders where id = $1", [order.id]);
+  assert.equal(rows[0].status, "paid");
+  assert.equal(rows[0].total_cents, 5200);
+  assert.ok(rows[0].payment_id);
+
+  const charges = await pool.query("select amount_cents from payment_calls where kind = 'charge' and idempotency_key = $1", [`order-${order.id}`]);
+  assert.deepEqual(charges.rows, [{ amount_cents: 5200 }]);
+  const chargesAfter = (await pool.query("select count(*)::int as n from payment_calls where kind = 'charge'")).rows[0].n;
+  assert.equal(chargesAfter, chargesBefore + 1);
+
+  const listed = await (await fetch(`${base}/orders`, { headers: as("alice-token") })).json();
+  assert.ok(listed.some((o: { id: number }) => o.id === order.id));
+});
+
+test("an order larger than the stock is rejected with 409 and changes nothing", async () => {
+  const ordersBefore = await orderCount();
+  const res = await placeOrder("alice-token", { items: [{ productId: 3, quantity: 6 }] });
+  assert.equal(res.status, 409);
+  assert.deepEqual((await res.json()).error.code, "insufficient_stock");
+  assert.equal(await stockOf(3), 5);
+  assert.equal(await orderCount(), ordersBefore);
+});
+
+test("concurrent orders for the last units cannot oversell", async () => {
+  const results = await Promise.all([1, 2, 3].map(() => placeOrder("bob-token", { items: [{ productId: 3, quantity: 2 }] })));
+  const statuses = results.map((r) => r.status).sort();
+  // 5 units available, each order takes 2: exactly two fit.
+  assert.deepEqual(statuses, [201, 201, 409]);
+  assert.equal(await stockOf(3), 1);
+});
+
+test("an unknown product is rejected with 404", async () => {
+  const res = await placeOrder("alice-token", { items: [{ productId: 9999, quantity: 1 }] });
+  assert.equal(res.status, 404);
+  assert.equal((await res.json()).error.code, "product_not_found");
+});
+
+test("malformed bodies are rejected with 400", async () => {
+  const bad = [
+    undefined,
+    {},
+    { items: [] },
+    { items: "x" },
+    { items: [{ productId: 1, quantity: 0 }] },
+    { items: [{ productId: 1, quantity: 1.5 }] },
+    { items: [{ productId: "1", quantity: 1 }] },
+    { items: [{ productId: 1 }] },
+    { items: [{ productId: 1, quantity: 1 }, { productId: 1, quantity: 1 }] },
+  ];
+  for (const body of bad) {
+    const res = await placeOrder("alice-token", body);
+    assert.equal(res.status, 400, JSON.stringify(body));
+    assert.equal((await res.json()).error.code, "invalid_request");
+  }
+});
+
+test("POST /orders requires a valid token", async () => {
+  const res = await fetch(`${base}/orders`, {
+    method: "POST",
+    headers: { "content-type": "application/json" },
+    body: JSON.stringify({ items: [{ productId: 1, quantity: 1 }] }),
+  });
+  assert.equal(res.status, 401);
+});
+
+test("when the payment fails, the stock is restored and no order is kept", async () => {
+  const originalCharge = payments.charge;
+  const stockBefore = await stockOf(1);
+  const ordersBefore = await orderCount();
+  payments.charge = async () => {
+    throw new Error("provider down");
+  };
+  try {
+    const res = await placeOrder("alice-token", { items: [{ productId: 1, quantity: 3 }] });
+    assert.equal(res.status, 502);
+    assert.equal((await res.json()).error.code, "payment_failed");
+  } finally {
+    payments.charge = originalCharge;
+  }
+  assert.equal(await stockOf(1), stockBefore);
+  assert.equal(await orderCount(), ordersBefore);
+  const { rows } = await pool.query("select count(*)::int as n from order_items oi left join orders o on o.id = oi.order_id where o.id is null");
+  assert.equal(rows[0].n, 0);
+});

new file mode 100644
index 0000000..6b71afb
--- /dev/null
+++ b/migrations/002_wallet_adjustments.sql
@@ -0,0 +1,22 @@
+-- Store credit can never go negative. Added as NOT VALID so the table isn't scanned under the lock;
+-- VALIDATE then checks existing rows without blocking writes.
+alter table wallets add constraint wallets_balance_nonnegative check (balance_cents >= 0) not valid;
+alter table wallets validate constraint wallets_balance_nonnegative;
+
+-- Every admin correction to a wallet. Append-only: rows are the audit trail.
+create table wallet_adjustments (
+  id serial primary key,
+  user_id integer not null references users(id),
+  admin_id integer not null references users(id),
+  amount_cents integer not null check (amount_cents <> 0), -- positive credits, negative debits
+  reason text not null check (length(trim(reason)) > 0),
+  created_at timestamptz not null default now()
+);
+
+create function wallet_adjustments_append_only() returns trigger language plpgsql as $$
+begin
+  raise exception 'wallet_adjustments is append-only';
+end $$;
+
+create trigger wallet_adjustments_append_only before update or delete on wallet_adjustments
+  for each row execute function wallet_adjustments_append_only();

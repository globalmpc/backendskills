+  app.post("/orders/:id/refund", async (req, res) => {
+    const idParam = String(req.params.id);
+    const id = /^\d{1,9}$/.test(idParam) ? Number(idParam) : NaN;
+    if (!Number.isSafeInteger(id) || id < 1) return sendError(res, 400, "invalid_id", "Order id must be a positive integer");
+
+    const user = res.locals.user;
+    const isAdmin = user.role === "admin";
+    const load = async () => {
+      const { rows } = await pool.query(
+        "select id, status, total_cents, payment_id from orders where id = $1 and ($3 or user_id = $2)",
+        [id, user.id, isAdmin],
+      );
+      return rows[0] as { id: number; status: string; total_cents: number; payment_id: string | null } | undefined;
+    };
+
+    const order = await load();
+    if (!order) return sendError(res, 404, "not_found", "Order not found");
+    // A repeated request for an already refunded order is a no-op success.
+    if (order.status === "refunded") return res.json({ id: order.id, status: "refunded" });
+    if (order.status !== "paid" || !order.payment_id) {
+      return sendError(res, 409, "not_refundable", "Only paid orders can be refunded");
+    }
+
+    // The provider call is outside any transaction. The key is derived from the order, so concurrent or
+    // retried requests (including after a crash before the update below) refund once.
+    try {
+      await payments.refund({
+        paymentId: order.payment_id,
+        amountCents: order.total_cents,
+        idempotencyKey: `refund-order-${order.id}`,
+      });
+    } catch (err) {
+      console.error(err);
+      return sendError(res, 502, "refund_failed", "Refund failed");
+    }
+
+    const { rowCount } = await pool.query("update orders set status = 'refunded' where id = $1 and status = 'paid'", [order.id]);
+    if (rowCount === 0) {
+      const current = await load();
+      if (current?.status !== "refunded") return sendError(res, 409, "not_refundable", "Only paid orders can be refunded");
+    }
+    res.json({ id: order.id, status: "refunded" });
+  });
+

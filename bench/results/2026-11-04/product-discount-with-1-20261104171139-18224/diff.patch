+test("products have a discount, 0 by default", async () => {
+  const products = await (await fetch(`${base}/products`, { headers: as("alice-token") })).json();
+  assert.ok(products.every((p: { discount_percent: number }) => p.discount_percent === 0));
+});
+
+test("only admins can set a product discount", async () => {
+  const res = await fetch(`${base}/products/2`, {
+    method: "PATCH",
+    headers: { ...as("alice-token"), "content-type": "application/json" },
+    body: JSON.stringify({ discountPercent: 10 }),
+  });
+  assert.equal(res.status, 403);
+  const { rows } = await pool.query("select discount_percent from products where id = 2");
+  assert.equal(rows[0].discount_percent, 0);
+});
+
+test("admin sets a product discount, and it shows in the product list", async () => {
+  const res = await fetch(`${base}/products/2`, {
+    method: "PATCH",
+    headers: { ...as("admin-token"), "content-type": "application/json" },
+    body: JSON.stringify({ discountPercent: 25 }),
+  });
+  assert.equal(res.status, 200);
+  assert.equal((await res.json()).discount_percent, 25);
+  const products = await (await fetch(`${base}/products`, { headers: as("alice-token") })).json();
+  assert.equal(products.find((p: { id: number }) => p.id === 2).discount_percent, 25);
+});
+
+test("discount must be a whole number from 0 to 100", async () => {
+  for (const discountPercent of [-1, 101, 1.5, "10", null]) {
+    const res = await fetch(`${base}/products/2`, {
+      method: "PATCH",
+      headers: { ...as("admin-token"), "content-type": "application/json" },
+      body: JSON.stringify({ discountPercent }),
+    });
+    assert.equal(res.status, 400, `discountPercent ${JSON.stringify(discountPercent)}`);
+  }
+  const { rows } = await pool.query("select discount_percent from products where id = 2");
+  assert.equal(rows[0].discount_percent, 25);
+});
+
+test("discount on an unknown product is 404", async () => {

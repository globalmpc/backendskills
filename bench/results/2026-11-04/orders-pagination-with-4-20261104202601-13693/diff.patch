+test("/orders paginates 20 per page with a cursor", async () => {
+  await pool.query("insert into orders (user_id, status, total_cents) select 1, 'paid', 100 from generate_series(1, 25)");
+  const seen: number[] = [];
+  let cursor: string | null = null;
+  let pages = 0;
+  do {
+    const url: string = `${base}/orders${cursor ? `?cursor=${cursor}` : ""}`;
+    const body: { orders: { id: number }[]; nextCursor: string | null } = await (
+      await fetch(url, { headers: as("alice-token") })
+    ).json();
+    assert.ok(body.orders.length <= 20);
+    seen.push(...body.orders.map((o) => o.id));
+    cursor = body.nextCursor;
+    pages++;
+  } while (cursor);
+  assert.equal(pages, 2);
+  assert.equal(seen.length, 27);
+  assert.equal(new Set(seen).size, 27);
+  assert.deepEqual(seen, [...seen].sort((a, b) => b - a));
 });
 

+  // Users can update their own name and email; admins can update anyone.
+  // Only `name` and `email` are read from the body, so `role` and tokens cannot be changed here.
+  app.patch("/users/:id", async (req, res) => {
+    const id = Number(req.params.id);
+    if (!Number.isInteger(id) || id <= 0) return sendError(res, 400, "invalid_id", "User id must be a positive integer");
+
+    const caller = res.locals.user;
+    if (caller.role !== "admin" && caller.id !== id) return sendError(res, 403, "forbidden", "You can only update your own profile");
+
+    const body = req.body ?? {};
+    if (typeof body !== "object" || Array.isArray(body)) return sendError(res, 400, "invalid_body", "Body must be a JSON object");
+
+    const updates: { name?: string; email?: string } = {};
+    if (body.name !== undefined) {
+      if (typeof body.name !== "string" || body.name.trim() === "" || body.name.length > 200) {
+        return sendError(res, 400, "invalid_name", "Name must be a non-empty string of at most 200 characters");
+      }
+      updates.name = body.name.trim();
+    }
+    if (body.email !== undefined) {
+      if (typeof body.email !== "string" || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(body.email.trim())) {
+        return sendError(res, 400, "invalid_email", "Email must be a valid address");
+      }
+      updates.email = body.email.trim();
+    }
+    if (Object.keys(updates).length === 0) return sendError(res, 400, "no_fields", "Provide name and/or email");
+
+    try {
+      const { rows } = await pool.query(
+        "update users set name = coalesce($2, name), email = coalesce($3, email) where id = $1 returning id, email, name, role",
+        [id, updates.name ?? null, updates.email ?? null],
+      );
+      if (rows.length === 0) return sendError(res, 404, "not_found", "User not found");
+      res.json(rows[0]);
+    } catch (err) {
+      if ((err as { code?: string }).code === "23505") return sendError(res, 409, "email_taken", "Email is already in use");
+      throw err;
+    }
+  });
+

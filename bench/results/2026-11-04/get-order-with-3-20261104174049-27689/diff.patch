+  app.get("/orders/:id", async (req, res) => {
+    const id = req.params.id;
+    if (!/^\d{1,9}$/.test(id)) return sendError(res, 400, "invalid_id", "Order id must be a positive integer");
+    const { rows } = await pool.query(
+      "select id, status, total_cents, created_at from orders where id = $1 and user_id = $2",
+      [Number(id), res.locals.user.id],
+    );
+    if (rows.length === 0) return sendError(res, 404, "not_found", "Order not found");
+    const { rows: items } = await pool.query(
+      `select oi.product_id, p.name, oi.quantity, oi.price_cents
+       from order_items oi join products p on p.id = oi.product_id
+       where oi.order_id = $1 order by oi.product_id`,
+      [rows[0].id],
+    );
+    res.json({ ...rows[0], items });
+  });

+-- Built concurrently so writes to orders aren't blocked. Runs alone in its file (it can't run in a transaction).
+-- Unique: one payment id belongs to one order, so a webhook finds exactly one row.
+create unique index concurrently if not exists orders_payment_id_key on orders (payment_id);

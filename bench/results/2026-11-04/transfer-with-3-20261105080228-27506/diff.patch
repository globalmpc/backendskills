diff --git a/test/app.test.ts b/test/app.test.ts
index d7b2ef4..7fb2604 100644
--- a/test/app.test.ts
+++ b/test/app.test.ts
@@ -64,3 +64,67 @@ test("payments client records every call; the same idempotency key is charged on
   const { rows } = await pool.query("select kind, count(*)::int as n from payment_calls where created_at > now() - interval '1 minute' group by kind order by kind");
   assert.deepEqual(rows, [{ kind: "charge", n: 1 }, { kind: "refund", n: 1 }]);
 });
+
+const balances = async (): Promise<Record<number, number>> =>
+  Object.fromEntries(
+    (await pool.query("select user_id, balance_cents from wallets")).rows.map((r) => [r.user_id, r.balance_cents]),
+  );
+const transfer = (token: string, body: unknown) =>
+  fetch(`${base}/transfers`, {
+    method: "POST",
+    headers: { ...as(token), "content-type": "application/json" },
+    body: JSON.stringify(body),
+  });
+
+test("POST /transfers moves credit", async () => {
+  const before = await balances();
+  const res = await transfer("alice-token", { toUserId: 2, amountCents: 100 });
+  assert.equal(res.status, 201);
+  const after = await balances();
+  assert.equal(after[1], before[1] - 100);
+  assert.equal(after[2], before[2] + 100);
+});
+
+test("POST /transfers rejects bad input, self, unknown user and overdraft", async () => {
+  const before = await balances();
+  const bad = [
+    { toUserId: 2, amountCents: -5 },
+    { toUserId: 2, amountCents: 0 },
+    { toUserId: 2, amountCents: 1.5 },
+    { toUserId: "2", amountCents: 5 },
+    { toUserId: 1, amountCents: 5 },
+    {},
+  ];
+  for (const body of bad) {
+    assert.equal((await transfer("alice-token", body)).status, 400, JSON.stringify(body));
+  }
+  assert.equal((await transfer("alice-token", { toUserId: 999, amountCents: 5 })).status, 404);
+  assert.equal((await transfer("bob-token", { toUserId: 1, amountCents: 10_000_000 })).status, 409);
+  assert.deepEqual(await balances(), before);
+});
+
+test("concurrent opposite transfers: no deadlock, money conserved", async () => {
+  const before = await balances();
+  const total = Object.values(before).reduce((a, b) => a + b, 0);
+  const calls = [];
+  for (let i = 0; i < 20; i++) {
+    calls.push(
+      i % 2
+        ? transfer("alice-token", { toUserId: 2, amountCents: 7 })
+        : transfer("bob-token", { toUserId: 1, amountCents: 3 }),
+    );
+  }
+  for (const r of await Promise.all(calls)) assert.ok([201, 409].includes(r.status), String(r.status));
+  const after = await balances();
+  assert.ok(Object.values(after).every((b) => b >= 0));
+  assert.equal(Object.values(after).reduce((a, b) => a + b, 0), total);
+});
+
+test("concurrent transfers cannot overdraw a wallet", async () => {
+  const amount = Math.ceil((await balances())[2] / 3);
+  const calls = [];
+  for (let i = 0; i < 10; i++) calls.push(transfer("bob-token", { toUserId: 3, amountCents: amount }));
+  const results = await Promise.all(calls);
+  assert.equal(results.filter((r) => r.status === 201).length, 2);
+  assert.ok((await balances())[2] >= 0);
+});

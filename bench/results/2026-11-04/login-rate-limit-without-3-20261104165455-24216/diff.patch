+const post = (path: string, body: unknown) =>
+  fetch(`${base}${path}`, {
+    method: "POST",
+    headers: { "content-type": "application/json" },
+    body: JSON.stringify(body),
+  });
+
+test("login with correct email and password returns the api_token, without a token header", async () => {
+  const res = await post("/login", { email: "alice@example.com", password: "alice-password" });
+  assert.equal(res.status, 200);
+  assert.deepEqual(await res.json(), { token: "alice-token" });
+
+  const me = await fetch(`${base}/me`, { headers: as("alice-token") });
+  assert.equal(me.status, 200);
+});
+
+test("login rejects a wrong password and an unknown email with the same response", async () => {
+  const wrongPassword = await post("/login", { email: "alice@example.com", password: "nope" });
+  const unknownEmail = await post("/login", { email: "nobody@example.com", password: "alice-password" });
+  assert.equal(wrongPassword.status, 401);
+  assert.equal(unknownEmail.status, 401);
+  assert.deepEqual(await wrongPassword.json(), { error: { code: "invalid_credentials", message: "Invalid email or password" } });
+  assert.deepEqual(await unknownEmail.json(), { error: { code: "invalid_credentials", message: "Invalid email or password" } });
+});
+

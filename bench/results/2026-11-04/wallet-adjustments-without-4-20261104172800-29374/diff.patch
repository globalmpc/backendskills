+  // Admin correction to a user's store credit. Positive amounts credit, negative debit.
+  app.post("/wallets/:userId/adjustments", async (req, res) => {
+    const admin = res.locals.user;
+    if (admin.role !== "admin") return sendError(res, 403, "forbidden", "Admins only");
+
+    const userId = Number(req.params.userId);
+    if (!Number.isSafeInteger(userId) || userId <= 0) {
+      return sendError(res, 400, "invalid_request", "userId must be a positive integer");
+    }
+
+    const { amountCents, reason } = req.body ?? {};
+    if (!Number.isSafeInteger(amountCents) || amountCents === 0 || Math.abs(amountCents) > MAX_ABS_CENTS) {
+      return sendError(res, 400, "invalid_request", `amountCents must be a non-zero integer, at most ${MAX_ABS_CENTS} in absolute value`);
+    }
+    if (typeof reason !== "string" || reason.trim() === "") {
+      return sendError(res, 400, "invalid_request", "reason must be a non-empty string");
+    }
+
+    const outcome = await withTransaction((client) => adjustWallet(client, { userId, adminId: admin.id, amountCents, reason }));
+    switch (outcome.status) {
+      case "not_found":
+        return sendError(res, 404, "not_found", "User not found");
+      case "insufficient_balance":
+        return sendError(res, 422, "insufficient_balance", "Adjustment would make the wallet balance negative");
+      case "ok":
+        return res.status(201).json({ adjustment: outcome.adjustment, balanceCents: outcome.balanceCents });
+    }
+  });
+

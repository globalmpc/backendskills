+
+const post = (token: string, path: string, body: unknown) =>
+  fetch(`${base}${path}`, { method: "POST", headers: { ...as(token), "content-type": "application/json" }, body: JSON.stringify(body) });
+
+test("reviews: buyer can review once, list shows it", async () => {
+  const ok = await post("alice-token", "/products/1/reviews", { rating: 4, body: "Nice" });
+  assert.equal(ok.status, 201);
+  const dup = await post("alice-token", "/products/1/reviews", { rating: 1, body: "Again" });
+  assert.equal(dup.status, 409);
+  const list = await (await fetch(`${base}/products/1/reviews`, { headers: as("bob-token") })).json();
+  assert.equal(list.length, 1);
+  assert.equal(list[0].rating, 4);
+});
+
+test("reviews: parallel duplicates create one row", async () => {
+  const rs = await Promise.all(Array.from({ length: 15 }, () => post("alice-token", "/products/3/reviews", { rating: 5, body: "x" })));
+  assert.equal(rs.filter((r) => r.status === 201).length, 1);
+  assert.equal(rs.filter((r) => r.status === 409).length, 14);
+});
+
+test("reviews: non-buyer, missing product and bad input are 4xx", async () => {
+  assert.equal((await post("bob-token", "/products/1/reviews", { rating: 5, body: "x" })).status, 403);
+  assert.equal((await post("alice-token", "/products/999/reviews", { rating: 5, body: "x" })).status, 404);
+  assert.equal((await post("alice-token", "/products/abc/reviews", { rating: 5, body: "x" })).status, 400);
+  const bads = [{ rating: 0, body: "x" }, { rating: 6, body: "x" }, { rating: 2.5, body: "x" }, { rating: "5", body: "x" }, { rating: 5, body: "" }, { rating: 5 }, {}];
+  for (const bad of bads) {
+    assert.equal((await post("alice-token", "/products/1/reviews", bad)).status, 400);
+  }
+  assert.equal((await fetch(`${base}/products/999/reviews`, { headers: as("bob-token") })).status, 404);
+  assert.equal((await fetch(`${base}/products/1/reviews`)).status, 401);
+});

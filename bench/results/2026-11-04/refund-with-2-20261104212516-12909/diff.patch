diff --git a/test/app.test.ts b/test/app.test.ts
index d7b2ef4..2da3071 100644
--- a/test/app.test.ts
+++ b/test/app.test.ts
@@ -64,3 +64,33 @@ test("payments client records every call; the same idempotency key is charged on
   const { rows } = await pool.query("select kind, count(*)::int as n from payment_calls where created_at > now() - interval '1 minute' group by kind order by kind");
   assert.deepEqual(rows, [{ kind: "charge", n: 1 }, { kind: "refund", n: 1 }]);
 });
+
+const refund = (id: string | number, token: string) =>
+  fetch(`${base}/orders/${id}/refund`, { method: "POST", headers: as(token) });
+const refundCalls = async (paymentId: string) =>
+  (await pool.query("select count(*)::int as n from payment_calls where kind = 'refund' and payment_id = $1", [paymentId])).rows[0].n;
+
+test("refund: someone else's order, bad and unknown ids are 404", async () => {
+  assert.equal((await refund(3, "alice-token")).status, 404);
+  assert.equal((await refund("abc", "alice-token")).status, 404);
+  assert.equal((await refund(9999, "alice-token")).status, 404);
+  assert.equal((await pool.query("select status from orders where id = 3")).rows[0].status, "paid");
+});
+
+test("refund: parallel requests refund a paid order once", async () => {
+  const results = await Promise.all(Array.from({ length: 10 }, () => refund(1, "alice-token")));
+  const statuses = results.map((r) => r.status);
+  assert.equal(statuses.filter((s) => s === 200).length, 1);
+  assert.ok(statuses.every((s) => s === 200 || s === 409));
+  assert.equal((await pool.query("select status from orders where id = 1")).rows[0].status, "refunded");
+  assert.equal(await refundCalls("pay_seed_1"), 1);
+  assert.equal((await refund(1, "alice-token")).status, 409);
+});
+
+test("refund: unpaid orders are rejected; admin can refund any paid order", async () => {
+  await pool.query("update orders set status = 'pending' where id = 2");
+  assert.equal((await refund(2, "alice-token")).status, 409);
+  assert.equal(await refundCalls("pay_seed_2"), 0);
+  assert.equal((await refund(3, "admin-token")).status, 200);
+  assert.equal(await refundCalls("pay_seed_3"), 1);
+});

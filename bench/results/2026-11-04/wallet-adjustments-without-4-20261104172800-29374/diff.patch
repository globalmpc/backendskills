+
+const adjust = (token: string, userId: number | string, body: unknown) =>
+  fetch(`${base}/wallets/${userId}/adjustments`, {
+    method: "POST",
+    headers: { ...as(token), "content-type": "application/json" },
+    body: JSON.stringify(body),
+  });
+
+const balanceOf = async (userId: number) => {
+  const { rows } = await pool.query("select balance_cents from wallets where user_id = $1", [userId]);
+  return rows[0]?.balance_cents;
+};
+
+const adjustmentCount = async (userId: number) => {
+  const { rows } = await pool.query("select count(*)::int as n from wallet_adjustments where user_id = $1", [userId]);
+  return rows[0].n;
+};
+
+test("wallet adjustments are admin only", async () => {
+  const res = await adjust("alice-token", 1, { amountCents: 100, reason: "nice try" });
+  assert.equal(res.status, 403);
+  assert.deepEqual(await res.json(), { error: { code: "forbidden", message: "Admins only" } });
+  assert.equal(await balanceOf(1), 10000);
+  assert.equal(await adjustmentCount(1), 0);
+});
+
+test("admin credit adds to the balance and is recorded", async () => {
+  const res = await adjust("admin-token", 1, { amountCents: 250, reason: "goodwill credit" });
+  assert.equal(res.status, 201);
+  const body = await res.json();
+  assert.equal(body.balanceCents, 10250);
+  assert.equal(body.adjustment.user_id, 1);
+  assert.equal(body.adjustment.admin_id, 3);
+  assert.equal(body.adjustment.amount_cents, 250);
+  assert.equal(body.adjustment.reason, "goodwill credit");
+  assert.equal(await balanceOf(1), 10250);
+  assert.equal(await adjustmentCount(1), 1);
+});
+
+test("a debit may take the balance to exactly 0", async () => {
+  const res = await adjust("admin-token", 2, { amountCents: -500, reason: "clawback" });
+  assert.equal(res.status, 201);
+  assert.equal((await res.json()).balanceCents, 0);
+  assert.equal(await balanceOf(2), 0);
+});
+
+test("a debit that would make the balance negative is rejected and leaves no trace", async () => {
+  const res = await adjust("admin-token", 2, { amountCents: -1, reason: "too much" });
+  assert.equal(res.status, 422);
+  assert.equal((await res.json()).error.code, "insufficient_balance");
+  assert.equal(await balanceOf(2), 0);
+  assert.equal(await adjustmentCount(2), 1);
+});
+
+test("invalid amounts and reasons are rejected", async () => {
+  const bad = [
+    { amountCents: 0, reason: "x" },
+    { amountCents: 1.5, reason: "x" },
+    { amountCents: "100", reason: "x" },
+    { amountCents: 2_147_483_648, reason: "x" },
+    { amountCents: 100 },
+    { amountCents: 100, reason: "   " },
+  ];
+  for (const body of bad) {
+    const res = await adjust("admin-token", 1, body);
+    assert.equal(res.status, 400, JSON.stringify(body));
+    assert.equal((await res.json()).error.code, "invalid_request");
+  }
+  assert.equal((await adjust("admin-token", "abc", { amountCents: 1, reason: "x" })).status, 400);
+  assert.equal(await balanceOf(1), 10250);
+});
+
+test("adjusting an unknown user gives 404", async () => {
+  const res = await adjust("admin-token", 9999, { amountCents: 100, reason: "x" });
+  assert.equal(res.status, 404);
+});
+
+test("a user without a wallet row starts at 0", async () => {
+  const { rows } = await pool.query(
+    "insert into users (email, name, role, api_token, password_hash) values ('dave@example.com', 'Dave', 'user', 'dave-token', 'unused') returning id",
+  );
+  const daveId = rows[0].id;
+  const res = await adjust("admin-token", daveId, { amountCents: 100, reason: "welcome" });
+  assert.equal(res.status, 201);
+  assert.equal((await res.json()).balanceCents, 100);
+  assert.equal(await balanceOf(daveId), 100);
+});
+
+test("concurrent debits cannot overdraw the balance", async () => {
+  // Alice has 10250. Five debits of 3000 race; only three can succeed.
+  const results = await Promise.all(
+    Array.from({ length: 5 }, () => adjust("admin-token", 1, { amountCents: -3000, reason: "race" })),
+  );
+  const statuses = results.map((r) => r.status).sort();
+  assert.deepEqual(statuses, [201, 201, 201, 422, 422]);
+  assert.equal(await balanceOf(1), 1250);
+  assert.equal(await adjustmentCount(1), 4);
+});

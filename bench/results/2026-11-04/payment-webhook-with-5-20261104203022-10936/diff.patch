--- a/test/app.test.ts
+++ b/test/app.test.ts
@@ -4,7 +4,8 @@ import type { Server } from "node:http";
 import { resetDatabase } from "../src/migrate.ts";
 import { createApp } from "../src/app.ts";
 import { pool } from "../src/db.ts";
-import { payments } from "../src/payments.ts";
+import { createHmac } from "node:crypto";
+import { payments, webhookSecret } from "../src/payments.ts";
 
 let server: Server;
 let base: string;
@@ -64,3 +65,60 @@ test("payments client records every call; the same idempotency key is charged on
   const { rows } = await pool.query("select kind, count(*)::int as n from payment_calls where created_at > now() - interval '1 minute' group by kind order by kind");
   assert.deepEqual(rows, [{ kind: "charge", n: 1 }, { kind: "refund", n: 1 }]);
 });
+
+const sign = (body: string) => createHmac("sha256", webhookSecret).update(body).digest("hex");
+const hook = (event: object, signature?: string) => {
+  const body = JSON.stringify(event);
+  return fetch(`${base}/webhooks/payments`, {
+    method: "POST",
+    headers: { "content-type": "application/json", "provider-signature": signature ?? sign(body) },
+    body,
+  });
+};
+const statusOf = async (paymentId: string) =>
+  (await pool.query("select status from orders where payment_id = $1", [paymentId])).rows[0].status;
+const newOrder = async (paymentId: string) => {
+  await pool.query("insert into orders (user_id, status, total_cents, payment_id) values (1, 'pending', 100, $1)", [paymentId]);
+};
+
+test("webhook rejects bad signatures and bad events", async () => {
+  await newOrder("pay_w1");
+  const event = { id: "evt_bad1", type: "charge.succeeded", paymentId: "pay_w1", created: 1000 };
+  assert.equal((await hook(event, "00")).status, 401);
+  assert.equal((await hook(event, "ab".repeat(32))).status, 401);
+  assert.equal((await hook({ ...event, type: "charge.weird" })).status, 400);
+  assert.equal((await hook({ ...event, created: "x" })).status, 400);
+  assert.equal((await hook({ ...event, paymentId: "pay_missing" })).status, 404);
+  assert.equal(await statusOf("pay_w1"), "pending");
+});
+
+test("webhook sets paid then refunded; duplicates and late events do not move it back", async () => {
+  await newOrder("pay_w2");
+  const ok = { id: "evt_w2a", type: "charge.succeeded", paymentId: "pay_w2", created: 1000 };
+  assert.equal((await hook(ok)).status, 200);
+  assert.equal(await statusOf("pay_w2"), "paid");
+  assert.equal((await (await hook(ok)).json()).duplicate, true);
+  await hook({ id: "evt_w2b", type: "charge.refunded", paymentId: "pay_w2", created: 1001 });
+  assert.equal(await statusOf("pay_w2"), "refunded");
+  await hook({ id: "evt_w2c", type: "charge.succeeded", paymentId: "pay_w2", created: 999 });
+  await hook({ id: "evt_w2d", type: "charge.failed", paymentId: "pay_w2", created: 1002 });
+  assert.equal(await statusOf("pay_w2"), "refunded");
+});
+
+test("webhook: failure then newer success is paid; failure after success is ignored", async () => {
+  await newOrder("pay_w3");
+  await hook({ id: "evt_w3a", type: "charge.failed", paymentId: "pay_w3", created: 1000 });
+  assert.equal(await statusOf("pay_w3"), "failed");
+  await hook({ id: "evt_w3b", type: "charge.succeeded", paymentId: "pay_w3", created: 1005 });
+  assert.equal(await statusOf("pay_w3"), "paid");
+  await hook({ id: "evt_w3c", type: "charge.failed", paymentId: "pay_w3", created: 1006 });
+  assert.equal(await statusOf("pay_w3"), "paid");
+});
+
+test("webhook: the same event sent at once is applied once", async () => {
+  await newOrder("pay_w4");
+  const event = { id: "evt_w4", type: "charge.succeeded", paymentId: "pay_w4", created: 1000 };
+  const results = await Promise.all(Array.from({ length: 15 }, async () => (await hook(event)).json()));
+  assert.equal(results.filter((r) => r.applied === true).length, 1);
+  assert.equal(await statusOf("pay_w4"), "paid");
+});

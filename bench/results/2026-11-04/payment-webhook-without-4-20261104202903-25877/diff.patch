 import { resetDatabase } from "../src/migrate.ts";
 import { createApp } from "../src/app.ts";
 import { pool } from "../src/db.ts";
-import { payments } from "../src/payments.ts";
+import { createHmac } from "node:crypto";
+import { payments, webhookSecret } from "../src/payments.ts";
 
 let server: Server;
 let base: string;
@@ -64,3 +65,33 @@ test("payments client records every call; the same idempotency key is charged on
   const { rows } = await pool.query("select kind, count(*)::int as n from payment_calls where created_at > now() - interval '1 minute' group by kind order by kind");
   assert.deepEqual(rows, [{ kind: "charge", n: 1 }, { kind: "refund", n: 1 }]);
 });
+
+async function webhook(event: object, secret = webhookSecret) {
+  const body = JSON.stringify(event);
+  const signature = createHmac("sha256", secret).update(body).digest("hex");
+  const headers = { "content-type": "application/json", "provider-signature": signature };
+  return fetch(`${base}/webhooks/payments`, { method: "POST", headers, body });
+}
+const orderStatus = async (paymentId: string) =>
+  (await pool.query("select status from orders where payment_id = $1", [paymentId])).rows[0].status;
+
+test("webhook rejects bad signatures", async () => {
+  const res = await webhook({ id: "evt_bad", type: "charge.failed", paymentId: "pay_seed_1", created: 1762300000 }, "wrong");
+  assert.equal(res.status, 401);
+  assert.equal(await orderStatus("pay_seed_1"), "paid");
+});
+
+test("webhook updates status, is idempotent, and ignores stale events", async () => {
+  const pay = "pay_seed_2";
+  assert.equal((await webhook({ id: "evt_a", type: "charge.failed", paymentId: pay, created: 1762300100 })).status, 200);
+  assert.equal(await orderStatus(pay), "failed");
+  await webhook({ id: "evt_b", type: "charge.succeeded", paymentId: pay, created: 1762300000 }); // stale
+  assert.equal(await orderStatus(pay), "failed");
+  await webhook({ id: "evt_c", type: "charge.succeeded", paymentId: pay, created: 1762300200 });
+  assert.equal(await orderStatus(pay), "paid");
+  await webhook({ id: "evt_d", type: "charge.refunded", paymentId: pay, created: 1762300300 });
+  assert.equal(await orderStatus(pay), "refunded");
+  await webhook({ id: "evt_c", type: "charge.succeeded", paymentId: pay, created: 1762300200 }); // replay
+  assert.equal(await orderStatus(pay), "refunded");
+  assert.equal((await webhook({ id: "evt_e", type: "charge.succeeded", paymentId: "pay_nope", created: 1762300400 })).status, 404);
+});

+test("GET /orders/:id returns the order with its items", async () => {
+  const res = await fetch(`${base}/orders/1`, { headers: as("alice-token") });
+  assert.equal(res.status, 200);
+  const order = await res.json();
+  assert.equal(order.id, 1);
+  assert.equal(order.total_cents, 4000);
+  assert.deepEqual(order.items, [{ product_id: 1, name: "T-shirt", quantity: 2, price_cents: 2000 }]);
+});
+
+test("GET /orders/:id for someone else's or a missing order is 404", async () => {
+  for (const id of ["3", "999"]) {
+    const res = await fetch(`${base}/orders/${id}`, { headers: as("alice-token") });
+    assert.equal(res.status, 404);
+    assert.equal((await res.json()).error.code, "not_found");
+  }
+});
+
+test("GET /orders/:id with a bad id is 400", async () => {
+  for (const id of ["abc", "-1", "0", "1.5", "99999999999"]) {
+    const res = await fetch(`${base}/orders/${id}`, { headers: as("alice-token") });
+    assert.equal(res.status, 400);
+    assert.equal((await res.json()).error.code, "invalid_id");
+  }
+});

+test("/orders pages through all of a user's orders, newest first, 20 per page", async () => {
+  // A fresh user with 45 orders. Created in pairs with the same timestamp, so the id tie-break is exercised.
+  const { rows: [carol] } = await pool.query<{ id: number }>(
+    "insert into users (email, name, api_token, password_hash) values ('carol@example.com', 'Carol', 'carol-token', 'x') returning id",
+  );
+  await pool.query(
+    "insert into orders (user_id, status, total_cents, created_at) select $1, 'paid', 100, now() - (g / 2) * interval '1 minute' from generate_series(1, 45) g",
+    [carol.id],
+  );
+  const { rows: expected } = await pool.query<{ id: number }>(
+    "select id from orders where user_id = $1 order by created_at desc, id desc", [carol.id],
+  );
+
+  const seen: number[] = [];
+  let cursor: string | null = null;
+  let pages = 0;
+  do {
+    const url: string = `${base}/orders${cursor ? `?cursor=${encodeURIComponent(cursor)}` : ""}`;
+    const body: { orders: { id: number }[]; nextCursor: string | null } = await (await fetch(url, { headers: as("carol-token") })).json();
+    assert.ok(body.orders.length <= 20);
+    if (body.nextCursor !== null) assert.equal(body.orders.length, 20);
+    seen.push(...body.orders.map((o) => o.id));
+    cursor = body.nextCursor;
+    pages++;
+  } while (cursor !== null);
+
+  assert.equal(pages, 3);
+  assert.deepEqual(seen, expected.map((r) => r.id));
+  assert.equal(new Set(seen).size, 45);
 });
 

+  app.post("/orders/:id/refund", async (req, res) => {
+    if (!/^[1-9]\d*$/.test(req.params.id) || !Number.isSafeInteger(Number(req.params.id))) {
+      return sendError(res, 400, "invalid_id", "Order id must be a positive integer");
+    }
+    const id = Number(req.params.id);
+
+    // Scoped to the caller: someone else's order looks the same as a missing one.
+    const { rows: [order] } = await pool.query(
+      "select id, status, payment_id, total_cents from orders where id = $1 and user_id = $2",
+      [id, res.locals.user.id],
+    );
+    if (!order) return sendError(res, 404, "not_found", "Order not found");
+    if (order.status !== "paid" || !order.payment_id) {
+      return sendError(res, 409, "not_paid", "Only paid orders can be refunded");
+    }
+
+    // Outside any transaction. The key is derived from the order, so a retry after a timeout or a
+    // crash below gets the same provider refund back instead of refunding twice.
+    try {
+      await payments.refund({
+        paymentId: order.payment_id,
+        amountCents: order.total_cents,
+        idempotencyKey: `refund-order-${order.id}`,
+      });
+    } catch (err) {
+      console.error(err);
+      return sendError(res, 502, "refund_failed", "Refund failed");
+    }
+
+    // Conditional on the state we expect; if another request already marked it, nothing changes.
+    const { rows: [updated] } = await pool.query(
+      `update orders set status = 'refunded' where id = $1 and status = 'paid'
+       returning id, status, total_cents, created_at`,
+      [order.id],
+    );
+    if (updated) return res.json(updated);
+
+    const { rows: [current] } = await pool.query(
+      "select id, status, total_cents, created_at from orders where id = $1",
+      [order.id],
+    );
+    res.json(current);
+  });
+

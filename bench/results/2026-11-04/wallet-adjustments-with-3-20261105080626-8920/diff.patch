diff --git a/test/app.test.ts b/test/app.test.ts
index d7b2ef4..3f93a95 100644
--- a/test/app.test.ts
+++ b/test/app.test.ts
@@ -64,3 +64,79 @@ test("payments client records every call; the same idempotency key is charged on
   const { rows } = await pool.query("select kind, count(*)::int as n from payment_calls where created_at > now() - interval '1 minute' group by kind order by kind");
   assert.deepEqual(rows, [{ kind: "charge", n: 1 }, { kind: "refund", n: 1 }]);
 });
+
+const adjust = (token: string, userId: string | number, body: unknown) =>
+  fetch(`${base}/wallets/${userId}/adjustments`, {
+    method: "POST",
+    headers: { ...as(token), "content-type": "application/json" },
+    body: JSON.stringify(body),
+  });
+const balance = async (userId: number) =>
+  (await pool.query("select balance_cents from wallets where user_id = $1", [userId])).rows[0].balance_cents;
+
+test("adjustments: non-admins get 403 and nothing changes", async () => {
+  const res = await adjust("alice-token", 1, { amountCents: 100, reason: "free money" });
+  assert.equal(res.status, 403);
+  assert.equal((await res.json()).error.code, "forbidden");
+  assert.equal(await balance(1), 10000);
+});
+
+test("adjustments: admin can add and subtract, and each is recorded", async () => {
+  let res = await adjust("admin-token", 2, { amountCents: 250, reason: "goodwill" });
+  assert.equal(res.status, 201);
+  assert.equal((await res.json()).balanceCents, 750);
+  res = await adjust("admin-token", 2, { amountCents: -750, reason: "  clawback  " });
+  assert.equal(res.status, 201);
+  assert.equal(await balance(2), 0);
+  const { rows } = await pool.query(
+    "select admin_id, amount_cents, reason from wallet_adjustments where user_id = 2 order by id",
+  );
+  assert.deepEqual(rows, [
+    { admin_id: 3, amount_cents: 250, reason: "goodwill" },
+    { admin_id: 3, amount_cents: -750, reason: "clawback" },
+  ]);
+});
+
+test("adjustments: balance can't go below 0", async () => {
+  const res = await adjust("admin-token", 3, { amountCents: -1, reason: "oops" });
+  assert.equal(res.status, 409);
+  assert.equal((await res.json()).error.code, "insufficient_balance");
+  assert.equal(await balance(3), 0);
+  assert.equal((await pool.query("select 1 from wallet_adjustments where user_id = 3")).rowCount, 0);
+});
+
+test("adjustments: bad input is a 400, unknown wallet a 404", async () => {
+  const bad = [
+    {},
+    { amountCents: 1.5, reason: "x" },
+    { amountCents: "5", reason: "x" },
+    { amountCents: 0, reason: "x" },
+    { amountCents: 5e12, reason: "x" },
+    { amountCents: 5 },
+    { amountCents: 5, reason: "  " },
+    { amountCents: 5, reason: 7 },
+  ];
+  for (const body of bad) {
+    assert.equal((await adjust("admin-token", 1, body)).status, 400, JSON.stringify(body));
+  }
+  assert.equal((await adjust("admin-token", "abc", { amountCents: 5, reason: "x" })).status, 400);
+  assert.equal((await adjust("admin-token", "99999999999", { amountCents: 5, reason: "x" })).status, 400);
+  assert.equal((await adjust("admin-token", 999, { amountCents: 5, reason: "x" })).status, 404);
+});
+
+test("adjustments: concurrent debits never overdraw", async () => {
+  await pool.query("update wallets set balance_cents = 1000 where user_id = 1");
+  const results = await Promise.all(
+    Array.from({ length: 20 }, () => adjust("admin-token", 1, { amountCents: -300, reason: "race" })),
+  );
+  const statuses = results.map((r) => r.status);
+  assert.equal(statuses.filter((s) => s === 201).length, 3);
+  assert.equal(statuses.filter((s) => s === 409).length, 17);
+  assert.equal(await balance(1), 100);
+  assert.equal((await pool.query("select 1 from wallet_adjustments where reason = 'race'")).rowCount, 3);
+});
+
+test("adjustments: history can't be edited or deleted", async () => {
+  await assert.rejects(pool.query("update wallet_adjustments set amount_cents = 1"), /append-only/);
+  await assert.rejects(pool.query("delete from wallet_adjustments"), /append-only/);
+});

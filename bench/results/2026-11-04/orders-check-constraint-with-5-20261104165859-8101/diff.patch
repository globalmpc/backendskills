diff --git a/migrations/002_orders_total_cents_check.sql b/migrations/002_orders_total_cents_check.sql
new file mode 100644
index 0000000..20f2743
--- /dev/null
+++ b/migrations/002_orders_total_cents_check.sql
@@ -0,0 +1,5 @@
+-- Refuse new or updated orders with a negative total. NOT VALID skips the scan of existing rows
+-- (the check still applies to every write from now on), so this doesn't block the big orders table.
+-- Validation runs in 003. lock_timeout: give up instead of queuing behind long queries.
+set local lock_timeout = '5s';
+alter table orders add constraint orders_total_cents_nonnegative check (total_cents >= 0) not valid;

 import { test, before, after } from "node:test";
 import assert from "node:assert/strict";
 import type { Server } from "node:http";
+import { createHmac } from "node:crypto";
 import { resetDatabase } from "../src/migrate.ts";
 import { createApp } from "../src/app.ts";
 import { pool } from "../src/db.ts";
-import { payments } from "../src/payments.ts";
+import { payments, webhookSecret } from "../src/payments.ts";
 
 let server: Server;
 let base: string;
@@ -64,3 +65,53 @@ test("payments client records every call; the same idempotency key is charged on
   const { rows } = await pool.query("select kind, count(*)::int as n from payment_calls where created_at > now() - interval '1 minute' group by kind order by kind");
   assert.deepEqual(rows, [{ kind: "charge", n: 1 }, { kind: "refund", n: 1 }]);
 });
+
+async function postWebhook(event: object, secret = webhookSecret) {
+  const body = JSON.stringify(event);
+  const signature = createHmac("sha256", secret).update(body).digest("hex");
+  return fetch(`${base}/webhooks/payments`, {
+    method: "POST",
+    headers: { "content-type": "application/json", "provider-signature": signature },
+    body,
+  });
+}
+
+async function orderStatus(paymentId: string) {
+  const { rows } = await pool.query("select status from orders where payment_id = $1", [paymentId]);
+  return rows[0]?.status;
+}
+
+test("payment webhook rejects a bad signature and leaves the order alone", async () => {
+  await pool.query("insert into orders (user_id, status, total_cents, payment_id) values (1, 'pending', 2000, 'pay_hook_bad')");
+  const now = Math.floor(Date.now() / 1000);
+  const res = await postWebhook({ id: "evt_bad", type: "charge.succeeded", paymentId: "pay_hook_bad", created: now }, "whsec_wrong");
+  assert.equal(res.status, 401);
+  assert.equal(await orderStatus("pay_hook_bad"), "pending");
+});
+
+test("payment webhook marks the order paid once; a redelivery is a no-op", async () => {
+  await pool.query("insert into orders (user_id, status, total_cents, payment_id) values (1, 'pending', 2000, 'pay_hook_ok')");
+  const event = { id: "evt_ok", type: "charge.succeeded", paymentId: "pay_hook_ok", created: Math.floor(Date.now() / 1000) };
+  assert.equal((await postWebhook(event)).status, 200);
+  assert.equal(await orderStatus("pay_hook_ok"), "paid");
+  const again = await postWebhook(event);
+  assert.equal(again.status, 200);
+  assert.deepEqual(await again.json(), { ok: true, duplicate: true });
+});
+
+test("payment webhook does not let an older event overwrite a newer one", async () => {
+  await pool.query("insert into orders (user_id, status, total_cents, payment_id) values (1, 'pending', 2000, 'pay_hook_order')");
+  const now = Math.floor(Date.now() / 1000);
+  await postWebhook({ id: "evt_refund", type: "charge.refunded", paymentId: "pay_hook_order", created: now });
+  const late = await postWebhook({ id: "evt_late", type: "charge.succeeded", paymentId: "pay_hook_order", created: now - 60 });
+  assert.deepEqual(await late.json(), { ok: true, duplicate: false, applied: false });
+  assert.equal(await orderStatus("pay_hook_order"), "refunded");
+});
+
+test("payment webhook returns 404 for an unknown payment and 400 for an unsupported event type", async () => {
+  const now = Math.floor(Date.now() / 1000);
+  const unknown = await postWebhook({ id: "evt_unknown", type: "charge.failed", paymentId: "pay_nope", created: now });
+  assert.equal(unknown.status, 404);
+  const unsupported = await postWebhook({ id: "evt_weird", type: "charge.disputed", paymentId: "pay_hook_ok", created: now });
+  assert.equal(unsupported.status, 400);
+});

+  // Everything happens in one transaction. Products are locked (FOR UPDATE) so two orders cannot both
+  // see the same stock. The payment is charged inside the transaction with a key derived from the order id,
+  // so the order can only be charged once; if anything fails, the transaction rolls back and stock is left unchanged.
+  app.post("/orders", async (req, res) => {
+    const items = parseOrderItems(req.body);
+    if (!items) {
+      return sendError(
+        res,
+        400,
+        "invalid_body",
+        "Body must be { items: [{ productId, quantity }] } with at least one item, positive integers, and no repeated productId",
+      );
+    }
+    const userId = res.locals.user.id;
+    const client = await pool.connect();
+    try {
+      await client.query("begin");
+
+      const { rows: products } = await client.query<{ id: number; price_cents: number; stock: number }>(
+        "select id, price_cents, stock from products where id = any($1::int[]) order by id for update",
+        [items.map((i) => i.productId)],
+      );
+      const byId = new Map(products.map((p) => [p.id, p]));
+      const lines = items.map(({ productId, quantity }) => {
+        const product = byId.get(productId);
+        if (!product) throw new OrderError(400, "unknown_product", `Product ${productId} does not exist`);
+        if (product.stock < quantity) {
+          throw new OrderError(409, "insufficient_stock", `Not enough stock for product ${productId}`);
+        }
+        return { productId, quantity, priceCents: product.price_cents };
+      });
+      const totalCents = lines.reduce((sum, l) => sum + l.priceCents * l.quantity, 0);
+
+      const {
+        rows: [order],
+      } = await client.query<{ id: number; created_at: Date }>(
+        "insert into orders (user_id, status, total_cents) values ($1, 'pending', $2) returning id, created_at",
+        [userId, totalCents],
+      );
+      for (const line of lines) {
+        await client.query(
+          "insert into order_items (order_id, product_id, quantity, price_cents) values ($1, $2, $3, $4)",
+          [order.id, line.productId, line.quantity, line.priceCents],
+        );
+        await client.query("update products set stock = stock - $1 where id = $2", [line.quantity, line.productId]);
+      }
+
+      const { paymentId } = await payments.charge({
+        amountCents: totalCents,
+        idempotencyKey: `order-${order.id}`,
+      });
+      await client.query("update orders set status = 'paid', payment_id = $2 where id = $1", [order.id, paymentId]);
+      await client.query("commit");
+
+      res.status(201).json({
+        id: order.id,
+        status: "paid",
+        total_cents: totalCents,
+        payment_id: paymentId,
+        created_at: order.created_at,
+        items: lines.map((l) => ({ product_id: l.productId, quantity: l.quantity, price_cents: l.priceCents })),
+      });
+    } catch (err) {
+      await client.query("rollback");
+      if (err instanceof OrderError) return sendError(res, err.status, err.code, err.message);
+      throw err;
+    } finally {
+      client.release();
+    }
+  });

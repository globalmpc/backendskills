+  const parseId = (v: string) => (/^\d{1,9}$/.test(v) ? Number(v) : null);
+
+  app.post("/products/:id/reviews", async (req, res) => {
+    const productId = parseId(req.params.id);
+    if (productId === null) return sendError(res, 404, "not_found", "Product not found");
+    const { rating, body } = req.body ?? {};
+    if (!Number.isInteger(rating) || rating < 1 || rating > 5)
+      return sendError(res, 400, "invalid_request", "rating must be an integer from 1 to 5");
+    if (typeof body !== "string" || body.trim() === "" || body.length > 5000)
+      return sendError(res, 400, "invalid_request", "body must be a non-empty string of at most 5000 characters");
+
+    const product = await pool.query("select 1 from products where id = $1", [productId]);
+    if (product.rowCount === 0) return sendError(res, 404, "not_found", "Product not found");
+
+    try {
+      // Only users with a paid order containing the product may review it.
+      const { rows } = await pool.query(
+        `insert into reviews (product_id, user_id, rating, body)
+         select $1, $2, $3, $4
+         where exists (
+           select 1 from orders o join order_items i on i.order_id = o.id
+           where o.user_id = $2 and o.status = 'paid' and i.product_id = $1)
+         returning product_id, user_id, rating, body, created_at`,
+        [productId, res.locals.user.id, rating, body],
+      );
+      if (rows.length === 0) return sendError(res, 403, "not_purchased", "You can only review products you have bought");
+      res.status(201).json(rows[0]);
+    } catch (err) {
+      const code = (err as { code?: string }).code;
+      if (code === "23505") return sendError(res, 409, "already_reviewed", "You already reviewed this product");
+      if (code === "23503") return sendError(res, 404, "not_found", "Product not found");
+      throw err;
+    }
+  });
+
+  app.get("/products/:id/reviews", async (req, res) => {
+    const productId = parseId(req.params.id);
+    if (productId === null) return sendError(res, 404, "not_found", "Product not found");
+    const product = await pool.query("select 1 from products where id = $1", [productId]);
+    if (product.rowCount === 0) return sendError(res, 404, "not_found", "Product not found");
+    const { rows } = await pool.query(
+      `select r.user_id, u.name as user_name, r.rating, r.body, r.created_at
+       from reviews r join users u on u.id = r.user_id
+       where r.product_id = $1 order by r.created_at desc, r.user_id`,
+      [productId],
+    );
+    res.json(rows);
+  });

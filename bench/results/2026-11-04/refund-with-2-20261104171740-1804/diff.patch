+  // Full refund through the payment provider. Only the order's owner may refund it (others get 404).
+  // The order is claimed paid -> refunding in one conditional update, so concurrent requests can't both
+  // refund. The provider call happens outside any transaction; the idempotency key is derived from the
+  // order, so a retry after a failure can't refund twice.
+  app.post("/orders/:id/refund", async (req, res) => {
+    if (!/^\d+$/.test(req.params.id)) return sendError(res, 400, "invalid_id", "Order id must be a positive integer");
+    const id = Number(req.params.id);
+    if (id < 1 || id > 2147483647) return sendError(res, 400, "invalid_id", "Order id must be a positive integer");
+    const userId = res.locals.user.id;
+
+    const { rows: [order] } = await pool.query(
+      `update orders set status = 'refunding'
+       where id = $1 and user_id = $2 and status = 'paid' and payment_id is not null
+       returning payment_id, total_cents`,
+      [id, userId],
+    );
+    if (!order) {
+      const { rows: [current] } = await pool.query("select status from orders where id = $1 and user_id = $2", [id, userId]);
+      if (!current) return sendError(res, 404, "not_found", "Order not found");
+      return sendError(res, 409, "not_refundable", "Only paid orders can be refunded");
+    }
+
+    try {
+      await payments.refund({
+        paymentId: order.payment_id,
+        amountCents: order.total_cents,
+        idempotencyKey: `refund-order-${id}`,
+      });
+    } catch (err) {
+      // Release the claim so the customer can retry. The same idempotency key makes that retry safe
+      // even if the provider did refund before the error.
+      await pool.query("update orders set status = 'paid' where id = $1 and status = 'refunding'", [id]);
+      console.error(err);
+      return sendError(res, 502, "payment_failed", "Refund failed");
+    }
+
+    const { rows: [refunded] } = await pool.query(
+      "update orders set status = 'refunded' where id = $1 and status = 'refunding' returning id, status, total_cents, created_at",
+      [id],
+    );
+    res.json(refunded);
+  });
+

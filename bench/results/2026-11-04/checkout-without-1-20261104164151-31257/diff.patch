 import express, { type NextFunction, type Request, type Response } from "express";
 import { pool } from "./db.ts";
+import { payments } from "./payments.ts";
 
 export type User = { id: number; email: string; name: string; role: string };
 
+// Thrown inside the order transaction to roll back and answer with a 4xx.
+class OrderRejected extends Error {
+  constructor(
+    readonly status: number,
+    readonly code: string,
+    message: string,
+  ) {
+    super(message);
+  }
+}
+
+const isId = (v: unknown): v is number => typeof v === "number" && Number.isInteger(v) && v > 0 && v <= 2147483647;
+
+// Expects { items: [{ productId, quantity }] }: a non-empty list of positive integers, each productId once.
+function parseOrderItems(body: unknown): { productId: number; quantity: number }[] | null {
+  const items = (body as { items?: unknown } | undefined)?.items;
+  if (!Array.isArray(items) || items.length === 0) return null;
+  const seen = new Set<number>();
+  const parsed: { productId: number; quantity: number }[] = [];
+  for (const item of items) {
+    const { productId, quantity } = (item ?? {}) as { productId?: unknown; quantity?: unknown };
+    if (!isId(productId) || !isId(quantity) || seen.has(productId)) return null;
+    seen.add(productId);
+    parsed.push({ productId, quantity });
+  }
+  return parsed;
+}

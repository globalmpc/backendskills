+const INT_MAX = 2_147_483_647;
+
 export function sendError(res: Response, status: number, code: string, message: string) {
   res.status(status).json({ error: { code, message } });
 }
@@ -52,6 +54,53 @@ export function createApp() {
     res.json(rows);
   });
 
+  app.post("/wallets/:userId/adjustments", async (req, res) => {
+    if (res.locals.user.role !== "admin") return sendError(res, 403, "forbidden", "Admins only");
+
+    const userId = Number(req.params.userId);
+    const { amountCents, reason } = req.body ?? {};
+    if (!Number.isInteger(userId) || userId < 1 || userId > INT_MAX) {
+      return sendError(res, 400, "invalid_request", "Invalid user id");
+    }
+    if (!Number.isInteger(amountCents) || amountCents === 0 || Math.abs(amountCents) > INT_MAX) {
+      return sendError(res, 400, "invalid_request", "amountCents must be a non-zero integer");
+    }
+    if (typeof reason !== "string" || reason.trim() === "") {
+      return sendError(res, 400, "invalid_request", "reason is required");
+    }
+
+    const client = await pool.connect();
+    try {
+      await client.query("begin");
+      const wallet = await client.query("select balance_cents from wallets where user_id = $1 for update", [userId]);
+      if (wallet.rows.length === 0) {
+        await client.query("rollback");
+        return sendError(res, 404, "not_found", "Wallet not found");
+      }
+      const balance: number = wallet.rows[0].balance_cents + amountCents;
+      if (balance < 0) {
+        await client.query("rollback");
+        return sendError(res, 409, "insufficient_balance", "Balance cannot go below 0");
+      }
+      if (balance > INT_MAX) {
+        await client.query("rollback");
+        return sendError(res, 400, "invalid_request", "Balance too large");
+      }
+      await client.query("update wallets set balance_cents = $2 where user_id = $1", [userId, balance]);
+      await client.query(
+        "insert into wallet_adjustments (user_id, admin_id, amount_cents, reason) values ($1, $2, $3, $4)",
+        [userId, res.locals.user.id, amountCents, reason],
+      );
+      await client.query("commit");
+      res.status(201).json({ userId, balanceCents: balance, amountCents, reason });
+    } catch (err) {
+      await client.query("rollback").catch(() => {});
+      throw err;
+    } finally {
+      client.release();
+    }
+  });
+
   app.use((err: Error, _req: Request, res: Response, _next: NextFunction) => {

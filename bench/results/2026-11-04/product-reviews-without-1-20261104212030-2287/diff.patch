+test("reviews: only buyers can review, once per product, with validated rating", async () => {
+  const post = (id: number, token: string, body: unknown) =>
+    fetch(`${base}/products/${id}/reviews`, {
+      method: "POST",
+      headers: { ...as(token), "content-type": "application/json" },
+      body: JSON.stringify(body),
+    });
+  // Bob bought the Mug (2) only.
+  assert.equal((await post(3, "bob-token", { rating: 5, body: "x" })).status, 403);
+  assert.equal((await post(2, "bob-token", { rating: 6, body: "x" })).status, 400);
+  assert.equal((await post(2, "bob-token", { rating: 4 })).status, 400);
+  assert.equal((await post(99, "bob-token", { rating: 4, body: "x" })).status, 404);
+  assert.equal((await post(2, "bob-token", { rating: 4, body: "Nice mug" })).status, 201);
+  assert.equal((await post(2, "bob-token", { rating: 1, body: "again" })).status, 409);
+  const list = await (await fetch(`${base}/products/2/reviews`, { headers: as("alice-token") })).json();
+  assert.equal(list.length, 1);
+  assert.equal(list[0].rating, 4);
+  assert.equal(list[0].body, "Nice mug");
+});

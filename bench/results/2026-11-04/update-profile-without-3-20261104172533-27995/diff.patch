+  // Update name and/or email. Users may update their own profile; admins may update anyone's.
+  app.patch("/users/:id", async (req, res) => {
+    const id = Number(req.params.id);
+    const caller = res.locals.user;
+    if (!Number.isInteger(id) || id < 1) return sendError(res, 404, "not_found", "User not found");
+    if (id !== caller.id && caller.role !== "admin") {
+      return sendError(res, 403, "forbidden", "You can only update your own profile");
+    }
+
+    const { name, email } = req.body ?? {};
+    if (name === undefined && email === undefined) {
+      return sendError(res, 400, "invalid", "Provide name and/or email");
+    }
+    if (name !== undefined && (typeof name !== "string" || name.trim() === "" || name.trim().length > 200)) {
+      return sendError(res, 400, "invalid", "name must be a non-empty string of at most 200 characters");
+    }
+    if (email !== undefined && (typeof email !== "string" || email.length > 254 || !EMAIL_RE.test(email.trim()))) {
+      return sendError(res, 400, "invalid", "email must be a valid email address");
+    }
+
+    try {
+      const { rows } = await pool.query(
+        `update users set name = coalesce($1, name), email = coalesce($2, email)
+         where id = $3 returning id, email, name, role`,
+        [name?.trim() ?? null, email?.trim() ?? null, id],
+      );
+      if (rows.length === 0) return sendError(res, 404, "not_found", "User not found");
+      res.json(rows[0]);
+    } catch (err) {
+      if ((err as { code?: string }).code === "23505") {
+        return sendError(res, 409, "email_taken", "That email is already in use");
+      }
+      throw err;
+    }
+  });
+

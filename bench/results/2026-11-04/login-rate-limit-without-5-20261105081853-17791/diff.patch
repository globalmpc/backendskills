+  app.post("/login", async (req, res) => {
+    const { email, password } = req.body ?? {};
+    if (typeof email !== "string" || typeof password !== "string" || email === "" || password === "") {
+      return sendError(res, 400, "invalid_request", "email and password are required strings");
+    }
+    const { rows } = await pool.query<{ api_token: string; password_hash: string }>(
+      "select api_token, password_hash from users where email = $1",
+      [email],
+    );
+    // Always run scrypt, even for unknown emails, so timing doesn't reveal which emails exist.
+    const ok = rows.length > 0
+      ? await verifyPassword(password, rows[0].password_hash)
+      : (await verifyPassword(password, await dummyHash()), false);
+    if (!ok) return sendError(res, 401, "invalid_credentials", "Invalid email or password");
+    res.json({ token: rows[0].api_token });
+  });

+const login = (body: unknown) =>
+  fetch(`${base}/login`, {
+    method: "POST",
+    headers: { "content-type": "application/json" },
+    body: typeof body === "string" ? body : JSON.stringify(body),
+  });
+
+test("login with the right password returns the user's api_token, no token needed", async () => {
+  const res = await login({ email: "alice@example.com", password: "alice-password" });
+  assert.equal(res.status, 200);
+  assert.deepEqual(await res.json(), { token: "alice-token" });
+});
+
+test("wrong password and unknown email get the same 401", async () => {
+  const wrong = await login({ email: "alice@example.com", password: "nope" });
+  const unknown = await login({ email: "nobody@example.com", password: "nope" });
+  assert.equal(wrong.status, 401);
+  assert.equal(unknown.status, 401);
+  assert.deepEqual(await wrong.json(), await unknown.json());
+});
+
+test("login with a missing or non-string field is a 400, and bad JSON is a 400", async () => {
+  assert.equal((await login({ email: "alice@example.com" })).status, 400);
+  assert.equal((await login({ email: 1, password: "x" })).status, 400);
+  assert.equal((await login({})).status, 400);
+  assert.equal((await login("{not json")).status, 400);
+});
+
+test("login is limited per account, so the right password is refused too once the limit is hit", async () => {
+  for (let i = 0; i < 10; i++) {
+    assert.equal((await login({ email: "bob@example.com", password: "wrong" })).status, 401);
+  }
+  const res = await login({ email: "bob@example.com", password: "bob-password" });
+  assert.equal(res.status, 429);
+  assert.deepEqual(await res.json(), { error: { code: "too_many_attempts", message: "Try again later" } });
+});

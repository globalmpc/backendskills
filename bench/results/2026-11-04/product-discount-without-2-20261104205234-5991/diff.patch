   app.get("/products", async (_req, res) => {
-    const { rows } = await pool.query("select id, name, price_cents, stock from products order by id");
+    const { rows } = await pool.query("select id, name, price_cents, stock, discount_percent from products order by id");
     res.json(rows);
   });
 
+  app.patch("/products/:id", async (req, res) => {
+    if (res.locals.user.role !== "admin") return sendError(res, 403, "forbidden", "Admin only");
+    const id = Number(req.params.id);
+    const discount = req.body?.discountPercent;
+    if (!Number.isInteger(discount) || discount < 0 || discount > 100) {
+      return sendError(res, 400, "invalid_request", "discountPercent must be a whole number from 0 to 100");
+    }
+    const { rows } = Number.isSafeInteger(id)
+      ? await pool.query(
+          "update products set discount_percent = $2 where id = $1 returning id, name, price_cents, stock, discount_percent",
+          [id, discount],
+        )
+      : { rows: [] };
+    if (rows.length === 0) return sendError(res, 404, "not_found", "Product not found");
+    res.json(rows[0]);
+  });
+

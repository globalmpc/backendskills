@@ -0,0 +1,13 @@
+-- Every payment webhook event we have applied, keyed by the provider's event id so redeliveries are no-ops.
+create table payment_webhook_events (
+  id text primary key,
+  type text not null,
+  payment_id text not null,
+  created bigint not null, -- Unix seconds, from the provider
+  received_at timestamptz not null default now()
+);
+
+-- Timestamp of the newest webhook event applied to the order; older events arriving late are ignored.
+alter table orders add column payment_event_created bigint;
+
+comment on column orders.status is 'pending | paid | failed | refunded';

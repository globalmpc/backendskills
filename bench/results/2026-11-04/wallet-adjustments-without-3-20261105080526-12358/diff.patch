+
+const adjust = (token: string, userId: number | string, body: unknown) =>
+  fetch(`${base}/wallets/${userId}/adjustments`, {
+    method: "POST",
+    headers: { ...as(token), "content-type": "application/json" },
+    body: JSON.stringify(body),
+  });
+
+test("wallet adjustments: non-admins get 403", async () => {
+  const res = await adjust("alice-token", 1, { amountCents: 100, reason: "self-service" });
+  assert.equal(res.status, 403);
+});
+
+test("wallet adjustments: admin can credit and debit, and each is recorded", async () => {
+  const up = await adjust("admin-token", 2, { amountCents: 250, reason: "goodwill" });
+  assert.equal(up.status, 201);
+  assert.deepEqual(await up.json(), { userId: 2, balanceCents: 750 });
+  const down = await adjust("admin-token", 2, { amountCents: -750, reason: "correction" });
+  assert.deepEqual(await down.json(), { userId: 2, balanceCents: 0 });
+  const { rows } = await pool.query("select admin_id, amount_cents, reason from wallet_adjustments where user_id = 2 order by id");
+  assert.deepEqual(rows, [
+    { admin_id: 3, amount_cents: 250, reason: "goodwill" },
+    { admin_id: 3, amount_cents: -750, reason: "correction" },
+  ]);
+});
+
+test("wallet adjustments: balance can't go below 0 and nothing is recorded", async () => {
+  const res = await adjust("admin-token", 3, { amountCents: -1, reason: "oops" });
+  assert.equal(res.status, 409);
+  const { rows } = await pool.query("select balance_cents from wallets where user_id = 3");
+  assert.equal(rows[0].balance_cents, 0);
+  const log = await pool.query("select 1 from wallet_adjustments where user_id = 3");
+  assert.equal(log.rows.length, 0);
+});
+
+test("wallet adjustments: validation and unknown user", async () => {
+  assert.equal((await adjust("admin-token", 1, { amountCents: 1.5, reason: "x" })).status, 400);
+  assert.equal((await adjust("admin-token", 1, { amountCents: 0, reason: "x" })).status, 400);
+  assert.equal((await adjust("admin-token", 1, { amountCents: 5, reason: " " })).status, 400);
+  assert.equal((await adjust("admin-token", "abc", { amountCents: 5, reason: "x" })).status, 400);
+  assert.equal((await adjust("admin-token", 999, { amountCents: 5, reason: "x" })).status, 404);
+});

+test("/orders pages newest first, 20 per page, and walks every order exactly once", async () => {
+  // Bob gets 44 more orders; 30 share one timestamp, so the id tiebreak is exercised too.
+  await pool.query(
+    `insert into orders (user_id, status, total_cents, created_at)
+     select 2, 'paid', 100, case when g <= 30 then now() - interval '1 hour' else now() - (g || ' minutes')::interval end
+     from generate_series(1, 44) g`,
+  );
+  const { rows: expected } = await pool.query("select id from orders where user_id = 2 order by created_at desc, id desc");
+  assert.equal(expected.length, 45);
+
+  const seen: number[] = [];
+  const pageSizes: number[] = [];
+  let cursor: string | null = null;
+  do {
+    const url: string = cursor ? `${base}/orders?cursor=${encodeURIComponent(cursor)}` : `${base}/orders`;
+    const res: Response = await fetch(url, { headers: as("bob-token") });
+    assert.equal(res.status, 200);
+    const body = await res.json();
+    assert.deepEqual(Object.keys(body).sort(), ["nextCursor", "orders"]);
+    pageSizes.push(body.orders.length);
+    seen.push(...body.orders.map((o: { id: number }) => o.id));
+    cursor = body.nextCursor;
+  } while (cursor !== null);
+
+  assert.deepEqual(pageSizes, [20, 20, 5]);
+  assert.deepEqual(seen, expected.map((r) => r.id));
+});
+

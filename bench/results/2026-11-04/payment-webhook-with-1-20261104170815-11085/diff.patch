+// Event type -> order status it sets.
+const statusByEvent = new Map([
+  ["charge.succeeded", "paid"],
+  ["charge.failed", "failed"],
+  ["charge.refunded", "refunded"],
+]);
+
+type PaymentEvent = { id: string; type: string; paymentId: string; created: number };
+
+function parsePaymentEvent(value: unknown): PaymentEvent | null {
+  if (typeof value !== "object" || value === null) return null;
+  const e = value as Record<string, unknown>;
+  if (typeof e.id !== "string" || e.id === "") return null;
+  if (typeof e.type !== "string" || !statusByEvent.has(e.type)) return null;
+  if (typeof e.paymentId !== "string" || e.paymentId === "") return null;
+  if (!Number.isSafeInteger(e.created) || (e.created as number) < 0) return null;
+  return { id: e.id, type: e.type, paymentId: e.paymentId, created: e.created as number };
+}
+
+// The provider retries and may deliver out of order. A redelivered event is a no-op (payment_webhook_events),
+// an event older than the one already applied is ignored, and a refunded order stays refunded.
+async function paymentWebhook(req: Request, res: Response) {
+  const body = req.body;
+  if (!Buffer.isBuffer(body)) return sendError(res, 400, "invalid_body", "Expected a JSON body");
+  if (!verifyWebhookSignature(body, req.get("Provider-Signature"))) {
+    return sendError(res, 401, "invalid_signature", "Invalid signature");
+  }
+  let json: unknown;
+  try {
+    json = JSON.parse(body.toString("utf8"));
+  } catch {
+    return sendError(res, 400, "invalid_body", "Body is not valid JSON");
+  }
+  const event = parsePaymentEvent(json);
+  if (!event) return sendError(res, 400, "invalid_event", "Missing or invalid event fields");
+  const status = statusByEvent.get(event.type)!;
+
+  const client = await pool.connect();
+  try {
+    await client.query("begin");
+    const { rowCount } = await client.query(
+      `insert into payment_webhook_events (id, type, payment_id, created_at) values ($1, $2, $3, to_timestamp($4))
+       on conflict (id) do nothing`,
+      [event.id, event.type, event.paymentId, event.created],
+    );
+    if (rowCount === 0) {
+      await client.query("commit");
+      return res.json({ received: true, duplicate: true });
+    }
+    // `for update` serializes webhooks for the same order, so the check and the update below see each other.
+    const { rows: [order] } = await client.query(
+      "select id, status, payment_event_at > to_timestamp($2) as is_newer from orders where payment_id = $1 for update",
+      [event.paymentId, event.created],
+    );
+    if (!order) {
+      await client.query("rollback");
+      return sendError(res, 404, "not_found", "No order for this payment");
+    }
+    if (order.status !== "refunded" && order.is_newer !== true) {
+      await client.query("update orders set status = $2, payment_event_at = to_timestamp($3) where id = $1", [
+        order.id,
+        status,
+        event.created,
+      ]);
+    }
+    await client.query("commit");
+    res.json({ received: true });
+  } catch (err) {
+    await client.query("rollback");
+    throw err;
+  } finally {
+    client.release();
+  }
+}
+

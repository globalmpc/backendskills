+// A positive id that fits the integer columns; anything else is null (a 400, not a database error).
+function parseId(raw: string): number | null {
+  if (!/^[1-9]\d*$/.test(raw)) return null;
+  const n = Number(raw);
+  return n <= 2147483647 ? n : null;
+}

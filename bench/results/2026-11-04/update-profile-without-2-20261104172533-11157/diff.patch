+  // Users can update their own name and email; admins can update anyone's. Role, token and password
+  // are not changeable here.
+  app.patch("/users/:id", async (req, res) => {
+    const id = Number(req.params.id);
+    const caller = res.locals.user;
+    if (!Number.isInteger(id)) return sendError(res, 404, "not_found", "User not found");
+    if (caller.id !== id && caller.role !== "admin") {
+      return sendError(res, 403, "forbidden", "You can only update your own profile");
+    }
+
+    const body: unknown = req.body ?? {};
+    if (typeof body !== "object" || body === null || Array.isArray(body)) {
+      return sendError(res, 400, "invalid_request", "Body must be a JSON object");
+    }
+    const unknown = Object.keys(body).filter((k) => k !== "name" && k !== "email");
+    if (unknown.length > 0) {
+      return sendError(res, 400, "invalid_request", `Unknown field(s): ${unknown.join(", ")}`);
+    }
+    const { name, email } = body as { name?: unknown; email?: unknown };
+    if (name === undefined && email === undefined) {
+      return sendError(res, 400, "invalid_request", "Provide name and/or email");
+    }
+
+    let newName: string | null = null;
+    if (name !== undefined) {
+      if (typeof name !== "string" || name.trim() === "" || name.trim().length > 100) {
+        return sendError(res, 400, "invalid_request", "name must be a non-empty string of at most 100 characters");
+      }
+      newName = name.trim();
+    }
+    let newEmail: string | null = null;
+    if (email !== undefined) {
+      if (typeof email !== "string" || email.trim().length > 254 || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.trim())) {
+        return sendError(res, 400, "invalid_request", "email must be a valid email address");
+      }
+      newEmail = email.trim();
+    }
+
+    try {
+      const { rows } = await pool.query(
+        `update users set name = coalesce($2, name), email = coalesce($3, email)
+         where id = $1 returning id, email, name, role`,
+        [id, newName, newEmail],
+      );
+      if (rows.length === 0) return sendError(res, 404, "not_found", "User not found");
+      res.json(rows[0]);
+    } catch (err) {
+      if ((err as { code?: string }).code === "23505") {
+        return sendError(res, 409, "email_taken", "That email is already in use");
+      }
+      throw err;
+    }
+  });
+

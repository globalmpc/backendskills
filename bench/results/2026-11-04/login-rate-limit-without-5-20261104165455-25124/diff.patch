+const post = (path: string, body: unknown) =>
+  fetch(`${base}${path}`, {
+    method: "POST",
+    headers: { "content-type": "application/json" },
+    body: JSON.stringify(body),
+  });
+
+test("login with email and password returns the user's api_token without a token header", async () => {
+  const res = await post("/login", { email: "alice@example.com", password: "alice-password" });
+  assert.equal(res.status, 200);
+  assert.deepEqual(await res.json(), { token: "alice-token" });
+});
+
+test("login rejects a wrong password and an unknown email the same way", async () => {
+  const wrong = await post("/login", { email: "alice@example.com", password: "nope" });
+  const unknown = await post("/login", { email: "nobody@example.com", password: "alice-password" });
+  assert.equal(wrong.status, 401);
+  assert.equal(unknown.status, 401);
+  assert.deepEqual(await wrong.json(), await unknown.json());
+});
+
+test("login requires string email and password", async () => {
+  const res = await post("/login", { email: "alice@example.com" });
+  assert.equal(res.status, 400);
+  assert.equal((await res.json()).error.code, "bad_request");
+});

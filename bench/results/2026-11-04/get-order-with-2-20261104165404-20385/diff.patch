+test("/orders/:id returns the caller's order with its items", async () => {
+  const res = await fetch(`${base}/orders/1`, { headers: as("alice-token") });
+  assert.equal(res.status, 200);
+  const order = await res.json();
+  assert.equal(order.id, 1);
+  assert.equal(order.status, "paid");
+  assert.equal(order.total_cents, 4000);
+  assert.deepEqual(order.items, [{ product_id: 1, name: "T-shirt", quantity: 2, price_cents: 2000 }]);
+});
+
+test("/orders/:id returns 404 for another user's order, the same as a missing one", async () => {
+  const other = await fetch(`${base}/orders/3`, { headers: as("alice-token") });
+  const missing = await fetch(`${base}/orders/999`, { headers: as("alice-token") });
+  assert.equal(other.status, 404);
+  assert.equal(missing.status, 404);
+  assert.deepEqual(await other.json(), { error: { code: "not_found", message: "Order not found" } });
+  assert.deepEqual(await missing.json(), { error: { code: "not_found", message: "Order not found" } });
+});
+
+test("/orders/:id rejects ids that are not positive integers in range with 400", async () => {
+  for (const id of ["abc", "1.5", "0", "-1", "99999999999"]) {
+    const res = await fetch(`${base}/orders/${id}`, { headers: as("alice-token") });
+    assert.equal(res.status, 400, id);
+    assert.equal((await res.json()).error.code, "invalid_id", id);
+  }
+});
+
+test("/orders/:id requires a token", async () => {
+  const res = await fetch(`${base}/orders/1`);
+  assert.equal(res.status, 401);
+});
+

+  app.get("/orders/:id", async (req, res) => {
+    const raw = req.params.id;
+    const id = Number(raw);
+    // serial ids are int4; anything larger can't exist and would make Postgres fail with a 500
+    if (!/^[1-9]\d*$/.test(raw) || id > 2147483647) {
+      return sendError(res, 400, "invalid_id", "Order id must be a positive integer");
+    }
+    const { rows } = await pool.query(
+      `select o.id, o.status, o.total_cents, o.created_at,
+         coalesce((
+           select json_agg(json_build_object(
+                    'product_id', i.product_id, 'name', p.name,
+                    'quantity', i.quantity, 'price_cents', i.price_cents)
+                  order by i.product_id)
+           from order_items i join products p on p.id = i.product_id
+           where i.order_id = o.id
+         ), '[]'::json) as items
+       from orders o
+       where o.id = $1 and o.user_id = $2`,
+      [id, res.locals.user.id],
+    );
+    // another user's order gets the same 404 as a missing one
+    if (rows.length === 0) return sendError(res, 404, "not_found", "Order not found");
+    res.json(rows[0]);
+  });
+

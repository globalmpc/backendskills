index d7b2ef4..dd14a3d 100644
--- a/test/app.test.ts
+++ b/test/app.test.ts
@@ -64,3 +64,42 @@ test("payments client records every call; the same idempotency key is charged on
   const { rows } = await pool.query("select kind, count(*)::int as n from payment_calls where created_at > now() - interval '1 minute' group by kind order by kind");
   assert.deepEqual(rows, [{ kind: "charge", n: 1 }, { kind: "refund", n: 1 }]);
 });
+
+const patch = (id: string | number, token: string, body: unknown) =>
+  fetch(`${base}/users/${id}`, {
+    method: "PATCH",
+    headers: { ...as(token), "content-type": "application/json" },
+    body: JSON.stringify(body),
+  });
+
+test("PATCH /users/:id updates own name and email", async () => {
+  const res = await patch(1, "alice-token", { name: "Alice B", email: "alice.b@example.com" });
+  assert.equal(res.status, 200);
+  assert.deepEqual(await res.json(), { id: 1, email: "alice.b@example.com", name: "Alice B", role: "user" });
+  await patch(1, "alice-token", { name: "Alice", email: "alice@example.com" });
+});
+
+test("PATCH /users/:id on someone else is 404 and changes nothing; admin may", async () => {
+  const res = await patch(2, "alice-token", { name: "Hacked" });
+  assert.equal(res.status, 404);
+  assert.equal((await pool.query("select name from users where id = 2")).rows[0].name, "Bob");
+  assert.equal((await patch(2, "admin-token", { name: "Bob" })).status, 200);
+});
+
+test("PATCH /users/:id rejects bad input with 4xx", async () => {
+  const cases: [string | number, unknown, number][] = [
+    [1, { role: "admin" }, 400],
+    [1, {}, 400],
+    [1, { name: "" }, 400],
+    [1, { name: 5 }, 400],
+    [1, { email: "not-an-email" }, 400],
+    [1, [1], 400],
+    ["abc", { name: "x" }, 404],
+    [1, { email: "bob@example.com" }, 409],
+  ];
+  for (const [id, body, status] of cases) {
+    const res = await patch(id, "alice-token", body);
+    assert.equal(res.status, status, JSON.stringify(body));
+    assert.ok((await res.json()).error.code);
+  }
+});

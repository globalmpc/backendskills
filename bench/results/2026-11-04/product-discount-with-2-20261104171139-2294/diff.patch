diff --git a/test/app.test.ts b/test/app.test.ts
index d7b2ef4..ee0227e 100644
--- a/test/app.test.ts
+++ b/test/app.test.ts
@@ -64,3 +64,52 @@ test("payments client records every call; the same idempotency key is charged on
   const { rows } = await pool.query("select kind, count(*)::int as n from payment_calls where created_at > now() - interval '1 minute' group by kind order by kind");
   assert.deepEqual(rows, [{ kind: "charge", n: 1 }, { kind: "refund", n: 1 }]);
 });
+
+const patchDiscount = (token: string, id: string | number, body: unknown) =>
+  fetch(`${base}/products/${id}`, {
+    method: "PATCH",
+    headers: { ...as(token), "content-type": "application/json" },
+    body: JSON.stringify(body),
+  });
+
+test("products have a discount, 0 by default", async () => {
+  const products = await (await fetch(`${base}/products`, { headers: as("alice-token") })).json();
+  assert.ok(products.every((p: { discount_percent: number }) => p.discount_percent === 0));
+});
+
+test("an admin can set a product's discount", async () => {
+  const res = await patchDiscount("admin-token", 2, { discountPercent: 25 });
+  assert.equal(res.status, 200);
+  assert.deepEqual(await res.json(), { id: 2, name: "Mug", price_cents: 1200, stock: 40, discount_percent: 25 });
+  const products = await (await fetch(`${base}/products`, { headers: as("alice-token") })).json();
+  assert.equal(products.find((p: { id: number }) => p.id === 2).discount_percent, 25);
+});
+
+test("a non-admin cannot change a discount", async () => {
+  const res = await patchDiscount("alice-token", 2, { discountPercent: 90 });
+  assert.equal(res.status, 403);
+  assert.deepEqual(await res.json(), { error: { code: "forbidden", message: "Admins only" } });
+});
+
+test("a discount must be a whole number from 0 to 100", async () => {
+  for (const discountPercent of [-1, 101, 12.5, "10", null]) {
+    const res = await patchDiscount("admin-token", 2, { discountPercent });
+    assert.equal(res.status, 400, `discountPercent ${JSON.stringify(discountPercent)}`);
+    assert.equal((await res.json()).error.code, "invalid_discount_percent");
+  }
+  const res = await patchDiscount("admin-token", 2, {});
+  assert.equal(res.status, 400);
+});
+
+test("a discount of 0 and 100 are accepted", async () => {
+  assert.equal((await patchDiscount("admin-token", 2, { discountPercent: 0 })).status, 200);
+  assert.equal((await patchDiscount("admin-token", 2, { discountPercent: 100 })).status, 200);
+});
+
+test("patching an unknown or invalid product id", async () => {
+  const missing = await patchDiscount("admin-token", 9999, { discountPercent: 10 });
+  assert.equal(missing.status, 404);
+  const invalid = await patchDiscount("admin-token", "abc", { discountPercent: 10 });
+  assert.equal(invalid.status, 400);
+  assert.equal((await invalid.json()).error.code, "invalid_id");
+});

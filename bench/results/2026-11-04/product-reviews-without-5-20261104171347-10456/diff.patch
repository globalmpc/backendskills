+const json = { "content-type": "application/json" };
+const post = (token: string, body: unknown) => ({
+  method: "POST",
+  headers: { ...as(token), ...json },
+  body: JSON.stringify(body),
+});
+
+test("reviews: a buyer can post one review; the list shows it", async () => {
+  const res = await fetch(`${base}/products/1/reviews`, post("alice-token", { rating: 4, body: "Soft" }));
+  assert.equal(res.status, 201);
+  const review = await res.json();
+  assert.equal(review.product_id, 1);
+  assert.equal(review.user_id, 1);
+  assert.equal(review.rating, 4);
+  assert.equal(review.body, "Soft");
+
+  const list = await (await fetch(`${base}/products/1/reviews`, { headers: as("bob-token") })).json();
+  assert.equal(list.length, 1);
+  assert.equal(list[0].body, "Soft");
+});
+
+test("reviews: a second review of the same product by the same user is a 409", async () => {
+  const res = await fetch(`${base}/products/1/reviews`, post("alice-token", { rating: 1, body: "again" }));
+  assert.equal(res.status, 409);
+  assert.equal((await res.json()).error.code, "already_reviewed");
+});
+
+test("reviews: users who have not bought the product get 403", async () => {
+  const res = await fetch(`${base}/products/1/reviews`, post("bob-token", { rating: 5, body: "never bought" }));
+  assert.equal(res.status, 403);
+  assert.equal((await res.json()).error.code, "not_purchased");
+});
+
+test("reviews: invalid rating or body is a 400", async () => {
+  for (const body of [{ rating: 0, body: "x" }, { rating: 6, body: "x" }, { rating: 3.5, body: "x" }, { rating: "5", body: "x" }, { rating: 3, body: "  " }, { rating: 3 }]) {
+    const res = await fetch(`${base}/products/3/reviews`, post("alice-token", body));
+    assert.equal(res.status, 400, JSON.stringify(body));
+  }
+});
+
+test("reviews: unknown or malformed product ids are a 404", async () => {
+  for (const id of ["999", "abc", "0", "99999999999"]) {
+    const res = await fetch(`${base}/products/${id}/reviews`, { headers: as("alice-token") });
+    assert.equal(res.status, 404, id);
+  }
+});

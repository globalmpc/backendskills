diff --git a/test/app.test.ts b/test/app.test.ts
index d7b2ef4..45d3aed 100644
--- a/test/app.test.ts
+++ b/test/app.test.ts
@@ -64,3 +64,44 @@ test("payments client records every call; the same idempotency key is charged on
   const { rows } = await pool.query("select kind, count(*)::int as n from payment_calls where created_at > now() - interval '1 minute' group by kind order by kind");
   assert.deepEqual(rows, [{ kind: "charge", n: 1 }, { kind: "refund", n: 1 }]);
 });
+
+const patchProduct = (token: string, id: number | string, body: unknown) =>
+  fetch(`${base}/products/${id}`, {
+    method: "PATCH",
+    headers: { ...as(token), "content-type": "application/json" },
+    body: JSON.stringify(body),
+  });
+
+test("products default to no discount", async () => {
+  const { rows } = await pool.query("select count(*)::int as n from products where discount_percent <> 0");
+  assert.equal(rows[0].n, 0);
+});
+
+test("admins can set a product's discount", async () => {
+  const res = await patchProduct("admin-token", 2, { discountPercent: 25 });
+  assert.equal(res.status, 200);
+  assert.deepEqual(await res.json(), { id: 2, name: "Mug", price_cents: 1200, stock: 40, discount_percent: 25 });
+});
+
+test("non-admins cannot change discounts", async () => {
+  const res = await patchProduct("alice-token", 2, { discountPercent: 90 });
+  assert.equal(res.status, 403);
+  const { rows } = await pool.query("select discount_percent from products where id = 2");
+  assert.equal(rows[0].discount_percent, 25);
+});
+
+test("discountPercent must be a whole number from 0 to 100", async () => {
+  for (const discountPercent of [-1, 101, 10.5, "10", null]) {
+    const res = await patchProduct("admin-token", 2, { discountPercent });
+    assert.equal(res.status, 400, `expected 400 for ${JSON.stringify(discountPercent)}`);
+    assert.equal((await res.json()).error.code, "invalid_discount");
+  }
+  for (const discountPercent of [0, 100]) {
+    assert.equal((await patchProduct("admin-token", 2, { discountPercent })).status, 200);
+  }
+});
+
+test("PATCH on an unknown product is 404", async () => {
+  assert.equal((await patchProduct("admin-token", 9999, { discountPercent: 10 })).status, 404);
+  assert.equal((await patchProduct("admin-token", "abc", { discountPercent: 10 })).status, 404);
+});

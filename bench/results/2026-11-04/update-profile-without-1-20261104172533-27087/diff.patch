+  // Users may update their own name/email; admins may update anyone's.
+  // Only name and email are writable here: role, api_token and password_hash are never taken from the body.
+  app.patch("/users/:id", async (req, res) => {
+    const caller = res.locals.user;
+    if (!/^\d+$/.test(req.params.id)) return sendError(res, 400, "invalid_id", "User id must be an integer");
+    const id = Number(req.params.id);
+    if (id !== caller.id && caller.role !== "admin") {
+      return sendError(res, 403, "forbidden", "You can only update your own profile");
+    }
+
+    const body: unknown = req.body ?? {};
+    if (typeof body !== "object" || body === null || Array.isArray(body)) {
+      return sendError(res, 400, "invalid_body", "Request body must be a JSON object");
+    }
+    const { name, email } = body as { name?: unknown; email?: unknown };
+    const hasName = "name" in body;
+    const hasEmail = "email" in body;
+    if (!hasName && !hasEmail) return sendError(res, 400, "no_fields", "Provide name and/or email");
+
+    let newName: string | null = null;
+    if (hasName) {
+      if (typeof name !== "string" || name.trim() === "" || name.trim().length > 100) {
+        return sendError(res, 400, "invalid_name", "Name must be 1-100 characters");
+      }
+      newName = name.trim();
+    }
+
+    let newEmail: string | null = null;
+    if (hasEmail) {
+      const normalized = typeof email === "string" ? email.trim().toLowerCase() : "";
+      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(normalized)) {
+        return sendError(res, 400, "invalid_email", "Email is not valid");
+      }
+      newEmail = normalized;
+    }
+
+    try {
+      const { rows } = await pool.query(
+        "update users set name = coalesce($1, name), email = coalesce($2, email) where id = $3 returning id, email, name, role",
+        [newName, newEmail, id],
+      );
+      if (rows.length === 0) return sendError(res, 404, "not_found", "User not found");
+      res.json(rows[0]);
+    } catch (err) {
+      if ((err as { code?: string }).code === "23505") {
+        return sendError(res, 409, "email_taken", "That email is already in use");
+      }
+      throw err;
+    }
+  });
+
   app.use((err: Error, _req: Request, res: Response, _next: NextFunction) => {

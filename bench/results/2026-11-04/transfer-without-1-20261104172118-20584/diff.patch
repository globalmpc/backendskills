+  // Store credit transfer. Both wallet rows are locked (in user_id order, so opposite-direction
+  // transfers cannot deadlock) before the balance is checked, so concurrent transfers cannot overdraw.
+  app.post("/transfers", async (req, res) => {
+    const { toUserId, amountCents } = req.body ?? {};
+    if (!Number.isSafeInteger(toUserId) || toUserId <= 0 || !Number.isSafeInteger(amountCents) || amountCents <= 0 || amountCents > MAX_INT4) {
+      return sendError(res, 400, "invalid_body", "toUserId and amountCents must be positive integers");
+    }
+    const fromUserId = res.locals.user.id;
+    if (toUserId === fromUserId) return sendError(res, 400, "self_transfer", "Cannot transfer to yourself");
+
+    const client = await pool.connect();
+    try {
+      await client.query("begin");
+      const { rows: recipient } = await client.query("select 1 from users where id = $1", [toUserId]);
+      if (recipient.length === 0) {
+        await client.query("rollback");
+        return sendError(res, 404, "recipient_not_found", "Recipient does not exist");
+      }
+      await client.query(
+        "insert into wallets (user_id, balance_cents) values ($1, 0), ($2, 0) on conflict (user_id) do nothing",
+        [fromUserId, toUserId],
+      );
+      const { rows: wallets } = await client.query(
+        "select user_id, balance_cents from wallets where user_id = any($1::int[]) order by user_id for update",
+        [[fromUserId, toUserId]],
+      );
+      const balance = wallets.find((w) => w.user_id === fromUserId).balance_cents;
+      if (balance < amountCents) {
+        await client.query("rollback");
+        return sendError(res, 422, "insufficient_funds", "Not enough store credit");
+      }
+      await client.query("update wallets set balance_cents = balance_cents - $2 where user_id = $1", [fromUserId, amountCents]);
+      await client.query("update wallets set balance_cents = balance_cents + $2 where user_id = $1", [toUserId, amountCents]);
+      await client.query("commit");
+      res.status(201).json({ toUserId, amountCents, balanceCents: balance - amountCents });
+    } catch (err) {
+      await client.query("rollback").catch(() => {});
+      throw err;
+    } finally {
+      client.release();
+    }
+  });
+

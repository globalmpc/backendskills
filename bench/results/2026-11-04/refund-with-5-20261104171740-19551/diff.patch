diff --git a/test/app.test.ts b/test/app.test.ts
index d7b2ef4..9a9190d 100644
--- a/test/app.test.ts
+++ b/test/app.test.ts
@@ -64,3 +64,60 @@ test("payments client records every call; the same idempotency key is charged on
   const { rows } = await pool.query("select kind, count(*)::int as n from payment_calls where created_at > now() - interval '1 minute' group by kind order by kind");
   assert.deepEqual(rows, [{ kind: "charge", n: 1 }, { kind: "refund", n: 1 }]);
 });
+
+// Keep these after the payments test above: it counts refunds made in the last minute.
+const refund = (token: string, id: string | number) =>
+  fetch(`${base}/orders/${id}/refund`, { method: "POST", headers: as(token) });
+
+test("refund: the owner refunds a paid order in full and it is marked refunded", async () => {
+  const res = await refund("alice-token", 1);
+  assert.equal(res.status, 200);
+  const order = await res.json();
+  assert.deepEqual(order, { id: 1, status: "refunded", total_cents: 4000, created_at: order.created_at });
+  const { rows } = await pool.query("select amount_cents from payment_calls where kind = 'refund' and payment_id = 'pay_seed_1'");
+  assert.deepEqual(rows, [{ amount_cents: 4000 }]);
+  const list = await (await fetch(`${base}/orders`, { headers: as("alice-token") })).json();
+  assert.equal(list.find((o: { id: number }) => o.id === 1).status, "refunded");
+});
+
+test("refund: an order that is already refunded is 409 and is not refunded again", async () => {
+  const res = await refund("alice-token", 1);
+  assert.equal(res.status, 409);
+  assert.equal((await res.json()).error.code, "not_paid");
+  const { rows } = await pool.query("select count(*)::int as n from payment_calls where kind = 'refund' and payment_id = 'pay_seed_1'");
+  assert.deepEqual(rows, [{ n: 1 }]);
+});
+
+test("refund: an unpaid (pending) order is 409", async () => {
+  const { rows: [pending] } = await pool.query(
+    "insert into orders (user_id, status, total_cents) values (1, 'pending', 999) returning id",
+  );
+  const res = await refund("alice-token", pending.id);
+  assert.equal(res.status, 409);
+  const { rows: [after] } = await pool.query("select status from orders where id = $1", [pending.id]);
+  assert.equal(after.status, "pending");
+});
+
+test("refund: someone else's order is 404 and untouched", async () => {
+  const res = await refund("bob-token", 2);
+  assert.equal(res.status, 404);
+  assert.equal((await res.json()).error.code, "not_found");
+  const { rows: [order] } = await pool.query("select status from orders where id = 2");
+  assert.equal(order.status, "paid");
+});
+
+test("refund: a bad id is 400, not 500", async () => {
+  for (const id of ["abc", "0", "-1", "1.5", "99999999999"]) {
+    const res = await refund("alice-token", id);
+    assert.equal(res.status, 400, `id ${id}`);
+  }
+});
+
+test("refund: ten parallel refunds of one order refund the provider once", async () => {
+  const results = await Promise.all(Array.from({ length: 10 }, () => refund("alice-token", 2)));
+  for (const res of results) assert.ok(res.status === 200 || res.status === 409, `status ${res.status}`);
+  const { rows } = await pool.query("select amount_cents from payment_calls where kind = 'refund' and payment_id = 'pay_seed_2'");
+  assert.deepEqual(rows, [{ amount_cents: 15000 }]);
+  const { rows: [order] } = await pool.query("select status from orders where id = 2");
+  assert.equal(order.status, "refunded");
+});

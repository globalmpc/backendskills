 export type User = { id: number; email: string; name: string; role: string };
 
+type OrderLine = { productId: number; quantity: number };
+type Product = { id: number; price_cents: number; stock: number };
+
+const MAX_INT4 = 2147483647;
+const isPositiveInt = (v: unknown): v is number => Number.isInteger(v) && (v as number) >= 1 && (v as number) <= MAX_INT4;
+
+// Validates { items: [{ productId, quantity }] }. Repeated products are merged, so the
+// same product twice in one request is one order line.
+function parseItems(body: unknown): OrderLine[] | null {
+  if (typeof body !== "object" || body === null) return null;
+  const items: unknown = (body as { items?: unknown }).items;
+  if (!Array.isArray(items) || items.length === 0) return null;
+  const quantities = new Map<number, number>();
+  for (const item of items) {
+    if (typeof item !== "object" || item === null) return null;
+    const { productId, quantity } = item as { productId?: unknown; quantity?: unknown };
+    if (!isPositiveInt(productId) || !isPositiveInt(quantity)) return null;
+    quantities.set(productId, (quantities.get(productId) ?? 0) + quantity);
+  }
+  return [...quantities]
+    .map(([productId, quantity]) => ({ productId, quantity }))
+    .sort((a, b) => a.productId - b.productId);
+}

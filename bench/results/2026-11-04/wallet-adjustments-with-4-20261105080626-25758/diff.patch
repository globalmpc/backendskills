     console.error(err);
     sendError(res, 500, "internal", "Something went wrong");
diff --git a/test/app.test.ts b/test/app.test.ts
index d7b2ef4..3310516 100644
--- a/test/app.test.ts
+++ b/test/app.test.ts
@@ -64,3 +64,50 @@ test("payments client records every call; the same idempotency key is charged on
   const { rows } = await pool.query("select kind, count(*)::int as n from payment_calls where created_at > now() - interval '1 minute' group by kind order by kind");
   assert.deepEqual(rows, [{ kind: "charge", n: 1 }, { kind: "refund", n: 1 }]);
 });
+
+const adjust = (token: string, userId: string | number, body: unknown) =>
+  fetch(`${base}/wallets/${userId}/adjustments`, {
+    method: "POST",
+    headers: { ...as(token), "content-type": "application/json" },
+    body: JSON.stringify(body),
+  });
+const balance = async (userId: number) =>
+  (await pool.query("select balance_cents from wallets where user_id = $1", [userId])).rows[0].balance_cents;
+
+test("wallet adjustments: non-admins get 403 and nothing changes", async () => {
+  const res = await adjust("alice-token", 1, { amountCents: 100, reason: "x" });
+  assert.equal(res.status, 403);
+  assert.equal((await res.json()).error.code, "forbidden");
+  assert.equal(await balance(1), 10000);
+});
+
+test("wallet adjustments: admin adjusts and it is recorded", async () => {
+  const res = await adjust("admin-token", 1, { amountCents: -2500, reason: "Correct duplicate credit" });
+  assert.equal(res.status, 201);
+  assert.equal((await res.json()).balanceCents, 7500);
+  assert.equal(await balance(1), 7500);
+  const { rows } = await pool.query("select user_id, admin_id, amount_cents, reason from wallet_adjustments");
+  assert.deepEqual(rows, [{ user_id: 1, admin_id: 3, amount_cents: -2500, reason: "Correct duplicate credit" }]);
+  await assert.rejects(pool.query("update wallet_adjustments set amount_cents = 1"), /append-only/);
+});
+
+test("wallet adjustments: bad input is 400, unknown wallet 404, overdraw 409", async () => {
+  const bad = [{}, { amountCents: 1.5, reason: "x" }, { amountCents: 0, reason: "x" }, { amountCents: "5", reason: "x" }, { amountCents: 5, reason: " " }, { amountCents: 5 }];
+  for (const body of bad) assert.equal((await adjust("admin-token", 2, body)).status, 400);
+  assert.equal((await adjust("admin-token", "abc", { amountCents: 5, reason: "x" })).status, 400);
+  assert.equal((await adjust("admin-token", 999, { amountCents: 5, reason: "x" })).status, 404);
+  assert.equal((await adjust("admin-token", 2, { amountCents: -501, reason: "x" })).status, 409);
+  assert.equal(await balance(2), 500);
+  assert.equal((await adjust("admin-token", 2, { amountCents: -500, reason: "to zero" })).status, 201);
+  assert.equal(await balance(2), 0);
+});
+
+test("wallet adjustments: concurrent debits never overdraw", async () => {
+  await pool.query("update wallets set balance_cents = 1000 where user_id = 3");
+  const results = await Promise.all(Array.from({ length: 20 }, () => adjust("admin-token", 3, { amountCents: -100, reason: "race" })));
+  assert.equal(results.filter((r) => r.status === 201).length, 10);
+  assert.equal(results.filter((r) => r.status === 409).length, 10);
+  assert.equal(await balance(3), 0);
+  const { rows } = await pool.query("select count(*)::int as n from wallet_adjustments where user_id = 3");
+  assert.equal(rows[0].n, 10);
+});

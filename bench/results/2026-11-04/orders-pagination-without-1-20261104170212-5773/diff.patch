   res.status(status).json({ error: { code, message } });
 }
 
+const PAGE_SIZE = 20;
+
+// Cursors are opaque to clients. The timestamp is passed as Postgres text so microseconds survive the round trip.
+function encodeCursor(createdAt: string, id: number) {
+  return Buffer.from(JSON.stringify([createdAt, id])).toString("base64url");
+}
+
+function decodeCursor(cursor: string): { createdAt: string; id: number } | null {
+  try {
+    const parsed: unknown = JSON.parse(Buffer.from(cursor, "base64url").toString("utf8"));
+    if (Array.isArray(parsed) && typeof parsed[0] === "string" && Number.isSafeInteger(parsed[1])) {
+      return { createdAt: parsed[0], id: parsed[1] };
+    }
+  } catch {
+    // fall through: malformed cursor
+  }
+  return null;
+}

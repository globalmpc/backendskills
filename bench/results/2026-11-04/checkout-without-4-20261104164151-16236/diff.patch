+class OrderError extends Error {
+  constructor(
+    readonly status: number,
+    readonly code: string,
+    message: string,
+  ) {
+    super(message);
+  }
+}
+
+type OrderLineInput = { productId: number; quantity: number };
+
+function isPositiveInt(value: unknown): value is number {
+  return Number.isInteger(value) && (value as number) > 0;
+}
+
+// Returns null unless the body is { items: [{ productId, quantity }] } with at least one item,
+// positive integer values, and no product listed twice.
+function parseOrderItems(body: unknown): OrderLineInput[] | null {
+  const items = (body as { items?: unknown } | undefined)?.items;
+  if (!Array.isArray(items) || items.length === 0) return null;
+  const parsed: OrderLineInput[] = [];
+  for (const item of items as ({ productId?: unknown; quantity?: unknown } | null)[]) {
+    const productId = item?.productId;
+    const quantity = item?.quantity;
+    if (!isPositiveInt(productId) || !isPositiveInt(quantity)) return null;
+    parsed.push({ productId, quantity });
+  }
+  if (new Set(parsed.map((i) => i.productId)).size !== parsed.length) return null;
+  return parsed;
+}

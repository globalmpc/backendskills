+  app.post("/orders", async (req, res) => {
+    // Validate the body and merge lines for the same product.
+    const items = req.body?.items;
+    if (!Array.isArray(items) || items.length === 0 || items.length > 100) {
+      return sendError(res, 400, "invalid_items", "items must be a non-empty array (max 100)");
+    }
+    const wanted = new Map<number, number>();
+    for (const item of items) {
+      const { productId, quantity } = item ?? {};
+      if (!Number.isSafeInteger(productId) || productId < 1 || productId > 2_000_000_000) {
+        return sendError(res, 400, "invalid_product_id", "productId must be a positive integer");
+      }
+      if (!Number.isSafeInteger(quantity) || quantity < 1 || quantity > 1000) {
+        return sendError(res, 400, "invalid_quantity", "quantity must be an integer between 1 and 1000");
+      }
+      wanted.set(productId, (wanted.get(productId) ?? 0) + quantity);
+    }
+    const lines = [...wanted]
+      .map(([productId, quantity]) => ({ productId, quantity }))
+      .sort((a, b) => a.productId - b.productId);
+    if (lines.some((l) => l.quantity > 1000)) {
+      return sendError(res, 400, "invalid_quantity", "Total quantity per product must be at most 1000");
+    }
+
+    // Step 1 (short transaction): reserve stock and create a pending order. Each product is decremented with a
+    // conditional update, in product id order, so concurrent orders can't oversell or deadlock.
+    const client = await pool.connect();
+    let orderId: number;
+    let totalCents = 0;
+    const priced: { productId: number; quantity: number; priceCents: number }[] = [];
+    try {
+      await client.query("begin");
+      for (const line of lines) {
+        const { rows } = await client.query(
+          "update products set stock = stock - $2 where id = $1 and stock >= $2 returning price_cents",
+          [line.productId, line.quantity],
+        );
+        if (rows.length === 0) {
+          const { rowCount } = await client.query("select 1 from products where id = $1", [line.productId]);
+          await client.query("rollback");
+          return rowCount === 0
+            ? sendError(res, 404, "product_not_found", `Product ${line.productId} not found`)
+            : sendError(res, 409, "insufficient_stock", `Not enough stock for product ${line.productId}`);
+        }
+        priced.push({ ...line, priceCents: rows[0].price_cents });
+        totalCents += rows[0].price_cents * line.quantity;
+      }
+      if (totalCents > 2_000_000_000) {
+        await client.query("rollback");
+        return sendError(res, 400, "order_too_large", "Order total is too large");
+      }
+      const { rows } = await client.query(
+        "insert into orders (user_id, status, total_cents) values ($1, 'pending', $2) returning id",
+        [res.locals.user.id, totalCents],
+      );
+      orderId = rows[0].id;
+      for (const l of priced) {
+        await client.query(
+          "insert into order_items (order_id, product_id, quantity, price_cents) values ($1, $2, $3, $4)",
+          [orderId, l.productId, l.quantity, l.priceCents],
+        );
+      }
+      await client.query("commit");
+    } catch (err) {
+      await client.query("rollback").catch(() => {});
+      throw err;
+    } finally {
+      client.release();
+    }
+
+    // Step 2: charge outside any transaction. The key is derived from the order, so a retry can't charge twice.
+    let paymentId: string;
+    try {
+      ({ paymentId } = await payments.charge({ amountCents: totalCents, idempotencyKey: `order-${orderId}` }));
+    } catch (err) {
+      console.error(err);
+      // Release the reserved stock, but only if we are the ones moving the order out of 'pending'.
+      const c = await pool.connect();
+      try {
+        await c.query("begin");
+        const { rowCount } = await c.query("update orders set status = 'failed' where id = $1 and status = 'pending'", [orderId]);
+        if (rowCount === 1) {
+          for (const l of priced) {
+            await c.query("update products set stock = stock + $2 where id = $1", [l.productId, l.quantity]);
+          }
+        }
+        await c.query("commit");
+      } catch (e) {
+        await c.query("rollback").catch(() => {});
+        console.error(e);
+      } finally {
+        c.release();
+      }
+      return sendError(res, 502, "payment_failed", "Payment failed");
+    }
+
+    // Step 3: mark paid.
+    const { rows } = await pool.query(
+      "update orders set status = 'paid', payment_id = $2 where id = $1 and status = 'pending' returning id, status, total_cents, payment_id, created_at",
+      [orderId, paymentId],
+    );
+    res.status(201).json({
+      ...rows[0],
+      items: priced.map((l) => ({ productId: l.productId, quantity: l.quantity, priceCents: l.priceCents })),
+    });
+  });

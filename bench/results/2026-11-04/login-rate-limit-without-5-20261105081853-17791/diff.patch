+const login = (body: unknown) =>
+  fetch(`${base}/login`, { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(body) });
+
+test("login with correct credentials returns the user's token, no token needed", async () => {
+  const res = await login({ email: "alice@example.com", password: "alice-password" });
+  assert.equal(res.status, 200);
+  assert.deepEqual(await res.json(), { token: "alice-token" });
+});
+
+test("login with wrong password or unknown email gets the same 401", async () => {
+  const expected = { error: { code: "invalid_credentials", message: "Invalid email or password" } };
+  const wrong = await login({ email: "alice@example.com", password: "bob-password" });
+  assert.equal(wrong.status, 401);
+  assert.deepEqual(await wrong.json(), expected);
+  const unknown = await login({ email: "nobody@example.com", password: "alice-password" });
+  assert.equal(unknown.status, 401);
+  assert.deepEqual(await unknown.json(), expected);
+});
+
+test("login rejects malformed bodies with 400", async () => {
+  for (const body of [{}, { email: "alice@example.com" }, { email: 1, password: "x" }, { email: "", password: "" }]) {
+    const res = await login(body);
+    assert.equal(res.status, 400);
+    assert.equal((await res.json()).error.code, "invalid_request");
+  }
+  const noBody = await fetch(`${base}/login`, { method: "POST" });
+  assert.equal(noBody.status, 400);
+});
+

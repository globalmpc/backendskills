+test("/orders/:id returns the caller's order with its items", async () => {
+  const res = await fetch(`${base}/orders/1`, { headers: as("alice-token") });
+  assert.equal(res.status, 200);
+  const order = await res.json();
+  assert.equal(order.id, 1);
+  assert.equal(order.status, "paid");
+  assert.equal(order.total_cents, 4000);
+  assert.deepEqual(order.items, [{ product_id: 1, quantity: 2, price_cents: 2000 }]);
+});
+
+test("/orders/:id is 404 for another user's order and for malformed ids", async () => {
+  const other = await fetch(`${base}/orders/1`, { headers: as("bob-token") });
+  assert.equal(other.status, 404);
+  assert.equal((await other.json()).error.code, "not_found");
+
+  const malformed = await fetch(`${base}/orders/abc`, { headers: as("alice-token") });
+  assert.equal(malformed.status, 404);
+
+  const huge = await fetch(`${base}/orders/99999999999`, { headers: as("alice-token") });
+  assert.equal(huge.status, 404);
+});
+

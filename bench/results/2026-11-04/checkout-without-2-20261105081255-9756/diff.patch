+
+const placeOrder = (token: string, body: unknown) =>
+  fetch(`${base}/orders`, { method: "POST", headers: { ...as(token), "content-type": "application/json" }, body: JSON.stringify(body) });
+
+const stockOf = async (id: number) => (await pool.query("select stock from products where id = $1", [id])).rows[0].stock;
+const chargeCount = async () => (await pool.query("select count(*)::int as n from payment_calls where kind = 'charge'")).rows[0].n;
+
+test("POST /orders charges the total, reduces stock and returns the order", async () => {
+  const chargesBefore = await chargeCount();
+  const res = await placeOrder("bob-token", { items: [{ productId: 1, quantity: 2 }, { productId: 2, quantity: 1 }, { productId: 1, quantity: 1 }] });
+  assert.equal(res.status, 201);
+  const order = await res.json();
+  assert.equal(order.status, "paid");
+  assert.equal(order.total_cents, 3 * 2000 + 1200);
+  assert.match(order.payment_id, /^pay_/);
+  assert.deepEqual(order.items.map((i: { productId: number; quantity: number }) => [i.productId, i.quantity]), [[1, 3], [2, 1]]);
+  assert.equal(await stockOf(1), 97);
+  assert.equal(await stockOf(2), 39);
+  const { rows } = await pool.query("select payment_id, amount_cents from payment_calls where kind = 'charge' order by id desc limit 1");
+  assert.deepEqual(rows[0], { payment_id: order.payment_id, amount_cents: 7200 });
+  assert.equal(await chargeCount(), chargesBefore + 1);
+  const bobOrders = await (await fetch(`${base}/orders`, { headers: as("bob-token") })).json();
+  assert.ok(bobOrders.some((o: { id: number }) => o.id === order.id));
+});
+
+test("POST /orders rejects insufficient stock without charging", async () => {
+  const charges = await chargeCount();
+  const res = await placeOrder("alice-token", { items: [{ productId: 3, quantity: 6 }] });
+  assert.equal(res.status, 409);
+  assert.equal((await res.json()).error.code, "insufficient_stock");
+  assert.equal(await stockOf(3), 5);
+  assert.equal(await chargeCount(), charges);
+});
+
+test("POST /orders validates the body and unknown products", async () => {
+  const bad = [{}, { items: [] }, { items: [{ productId: 1, quantity: 0 }] }, { items: [{ productId: "1", quantity: 1 }] }, { items: [{ productId: 1, quantity: 1.5 }] }];
+  for (const body of bad) {
+    const res = await placeOrder("alice-token", body);
+    assert.equal(res.status, 400, JSON.stringify(body));
+    assert.equal((await res.json()).error.code, "invalid_request");
+  }
+  const res = await placeOrder("alice-token", { items: [{ productId: 999, quantity: 1 }] });
+  assert.equal(res.status, 404);
+});
+
+test("POST /orders never oversells under concurrency", async () => {
+  const before = await stockOf(3);
+  const results = await Promise.all(Array.from({ length: 10 }, () => placeOrder("alice-token", { items: [{ productId: 3, quantity: 1 }] })));
+  assert.equal(results.filter((r) => r.status === 201).length, before);
+  assert.equal(results.filter((r) => r.status === 409).length, 10 - before);
+  assert.equal(await stockOf(3), 0);
+});

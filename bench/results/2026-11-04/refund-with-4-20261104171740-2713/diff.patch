+  // Full refund of a paid order. Only the order's owner may refund it (others get 404).
+  app.post("/orders/:id/refund", async (req, res) => {
+    const idParam = req.params.id;
+    const id = Number(idParam);
+    if (!/^\d+$/.test(idParam) || !Number.isSafeInteger(id) || id < 1 || id > 2147483647) {
+      return sendError(res, 400, "invalid_id", "Order id must be a positive integer");
+    }
+
+    const { rows: [order] } = await pool.query(
+      "select id, status, total_cents, payment_id from orders where id = $1 and user_id = $2",
+      [id, res.locals.user.id],
+    );
+    if (!order) return sendError(res, 404, "not_found", "Order not found");
+    if (order.status !== "paid") return sendError(res, 409, "not_paid", "Only paid orders can be refunded");
+
+    // No transaction is open here, so no row locks are held during the provider call. The key is derived
+    // from the order, so a retry or a concurrent request refunds the payment at most once.
+    try {
+      await payments.refund({
+        paymentId: order.payment_id,
+        amountCents: order.total_cents,
+        idempotencyKey: `refund-order-${order.id}`,
+      });
+    } catch (err) {
+      console.error(err);
+      return sendError(res, 502, "refund_failed", "Refund failed");
+    }
+
+    // Change state only from the state we expect. If another request already marked it, nothing changes.
+    const { rows: [updated] } = await pool.query(
+      "update orders set status = 'refunded' where id = $1 and status = 'paid' returning id, status, total_cents, created_at",
+      [id],
+    );
+    if (!updated) return sendError(res, 409, "not_paid", "Only paid orders can be refunded");
+    res.json(updated);
+  });
+

diff --git a/test/app.test.ts b/test/app.test.ts
index d7b2ef4..801c2eb 100644
--- a/test/app.test.ts
+++ b/test/app.test.ts
@@ -64,3 +64,57 @@ test("payments client records every call; the same idempotency key is charged on
   const { rows } = await pool.query("select kind, count(*)::int as n from payment_calls where created_at > now() - interval '1 minute' group by kind order by kind");
   assert.deepEqual(rows, [{ kind: "charge", n: 1 }, { kind: "refund", n: 1 }]);
 });
+
+const post = (token: string, body: unknown) =>
+  fetch(`${base}/orders`, { method: "POST", headers: { ...as(token), "content-type": "application/json" }, body: JSON.stringify(body) });
+
+test("POST /orders places an order, charges once and reduces stock", async () => {
+  const res = await post("alice-token", { items: [{ productId: 2, quantity: 1 }, { productId: 2, quantity: 2 }] });
+  assert.equal(res.status, 201);
+  const order = await res.json();
+  assert.equal(order.status, "paid");
+  assert.equal(order.total_cents, 3600);
+  assert.equal(order.items.length, 1);
+  const { rows } = await pool.query("select stock from products where id = 2");
+  assert.equal(rows[0].stock, 37);
+  const calls = await pool.query("select 1 from payment_calls where idempotency_key = $1", [`order-${order.id}`]);
+  assert.equal(calls.rowCount, 1);
+});
+
+test("POST /orders rejects bad input with 400", async () => {
+  const bad = [{}, { items: [] }, { items: [{ productId: 1, quantity: 0 }] }, { items: [{ productId: 1, quantity: 1.5 }] }, { items: [{ productId: "1", quantity: 1 }] }];
+  for (const body of bad) {
+    assert.equal((await post("alice-token", body)).status, 400);
+  }
+});
+
+test("POST /orders: unknown product is 404, too little stock is 409 and changes nothing", async () => {
+  assert.equal((await post("alice-token", { items: [{ productId: 999, quantity: 1 }] })).status, 404);
+  const res = await post("alice-token", { items: [{ productId: 1, quantity: 1 }, { productId: 3, quantity: 6 }] });
+  assert.equal(res.status, 409);
+  const { rows } = await pool.query("select stock from products where id in (1, 3) order by id");
+  assert.deepEqual(rows.map((r) => r.stock), [100, 5]);
+});
+
+test("POST /orders restores stock when payment fails", async () => {
+  const original = payments.charge;
+  payments.charge = async () => {
+    throw new Error("boom");
+  };
+  try {
+    assert.equal((await post("alice-token", { items: [{ productId: 1, quantity: 3 }] })).status, 502);
+  } finally {
+    payments.charge = original;
+  }
+  const { rows } = await pool.query("select stock from products where id = 1");
+  assert.equal(rows[0].stock, 100);
+});
+
+test("POST /orders in parallel never oversells", async () => {
+  const results = await Promise.all(Array.from({ length: 15 }, () => post("bob-token", { items: [{ productId: 3, quantity: 1 }] })));
+  const statuses = results.map((r) => r.status);
+  assert.equal(statuses.filter((s) => s === 201).length, 5);
+  assert.equal(statuses.filter((s) => s === 409).length, 10);
+  const { rows } = await pool.query("select stock from products where id = 3");
+  assert.equal(rows[0].stock, 0);
+});

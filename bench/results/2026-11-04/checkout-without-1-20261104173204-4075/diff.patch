+// Validates the order items; merges duplicate products and sorts by id (consistent lock order
+// avoids deadlocks between concurrent orders). Returns null if invalid.
+function parseItems(raw: unknown): { productId: number; quantity: number }[] | null {
+  if (!Array.isArray(raw) || raw.length === 0) return null;
+  const merged = new Map<number, number>();
+  for (const item of raw) {
+    const { productId, quantity } = item ?? {};
+    if (!Number.isSafeInteger(productId) || productId < 1) return null;
+    if (!Number.isSafeInteger(quantity) || quantity < 1 || quantity > 1_000_000) return null;
+    merged.set(productId, (merged.get(productId) ?? 0) + quantity);
+  }
+  return [...merged].sort((a, b) => a[0] - b[0]).map(([productId, quantity]) => ({ productId, quantity }));
+}

+
+const post = (token: string, body: unknown) =>
+  fetch(`${base}/orders`, {
+    method: "POST",
+    headers: { ...as(token), "content-type": "application/json" },
+    body: JSON.stringify(body),
+  });
+
+test("POST /orders places an order, merges duplicate lines, reduces stock, charges once", async () => {
+  const res = await post("alice-token", { items: [{ productId: 1, quantity: 1 }, { productId: 1, quantity: 2 }] });
+  assert.equal(res.status, 201);
+  const order = await res.json();
+  assert.equal(order.status, "paid");
+  assert.equal(order.total_cents, 6000);
+  assert.deepEqual(order.items, [{ productId: 1, quantity: 3, priceCents: 2000 }]);
+  assert.equal((await pool.query("select stock from products where id = 1")).rows[0].stock, 97);
+  const calls = await pool.query("select 1 from payment_calls where idempotency_key = $1", [`order-${order.id}`]);
+  assert.equal(calls.rowCount, 1);
+});
+
+test("POST /orders: bad input is 400, unknown product is 404", async () => {
+  const bad = [
+    {},
+    { items: [] },
+    { items: [{ productId: 1, quantity: 0 }] },
+    { items: [{ productId: 1, quantity: 1.5 }] },
+    { items: [{ productId: "x", quantity: 1 }] },
+  ];
+  for (const body of bad) assert.equal((await post("alice-token", body)).status, 400);
+  assert.equal((await post("alice-token", { items: [{ productId: 999, quantity: 1 }] })).status, 404);
+});
+
+test("POST /orders: 409 changes nothing; parallel orders never oversell", async () => {
+  const before = (await pool.query("select stock from products where id = 2")).rows[0].stock;
+  const res = await post("alice-token", { items: [{ productId: 2, quantity: 1 }, { productId: 3, quantity: 6 }] });
+  assert.equal(res.status, 409);
+  assert.equal((await pool.query("select stock from products where id = 2")).rows[0].stock, before);
+
+  const results = await Promise.all(
+    Array.from({ length: 12 }, () => post("bob-token", { items: [{ productId: 3, quantity: 1 }] })),
+  );
+  const statuses = results.map((r) => r.status);
+  assert.equal(statuses.filter((s) => s === 201).length, 5);
+  assert.equal(statuses.filter((s) => s === 409).length, 7);
+  assert.equal((await pool.query("select stock from products where id = 3")).rows[0].stock, 0);
+});

+  app.post("/orders", async (req, res) => {
+    const parsed = parseOrderItems(req.body);
+    if (typeof parsed === "string") return sendError(res, 400, "invalid_request", parsed);
+    const userId = res.locals.user.id;
+
+    // 1. Reserve stock and create a pending order in one transaction. Product rows are locked in id
+    //    order so concurrent orders can't oversell or deadlock. The transaction is committed before
+    //    calling the payment provider so row locks aren't held across a network round trip.
+    const client = await pool.connect();
+    let order: { id: number; status: string; total_cents: number; created_at: Date };
+    let lines: { product_id: number; quantity: number; price_cents: number }[];
+    try {
+      await client.query("begin");
+      const ids = parsed.map((i) => i.productId);
+      const { rows: products } = await client.query<{ id: number; price_cents: number; stock: number }>(
+        "select id, price_cents, stock from products where id = any($1::int[]) order by id for update",
+        [ids],
+      );
+      const byId = new Map(products.map((p) => [p.id, p]));
+      const missing = ids.filter((id) => !byId.has(id));
+      if (missing.length > 0) {
+        await client.query("rollback");
+        return sendError(res, 404, "product_not_found", `Unknown product id(s): ${missing.join(", ")}`);
+      }
+      const short = parsed.filter((i) => byId.get(i.productId)!.stock < i.quantity);
+      if (short.length > 0) {
+        await client.query("rollback");
+        return sendError(res, 409, "insufficient_stock", `Not enough stock for product id(s): ${short.map((i) => i.productId).join(", ")}`);
+      }
+      lines = parsed.map((i) => ({ product_id: i.productId, quantity: i.quantity, price_cents: byId.get(i.productId)!.price_cents }));
+      const total = lines.reduce((sum, l) => sum + l.price_cents * l.quantity, 0);
+      if (total > MAX_INT4) {
+        await client.query("rollback");
+        return sendError(res, 400, "invalid_request", "Order total is too large");
+      }
+
+      for (const l of lines) {
+        await client.query("update products set stock = stock - $1 where id = $2", [l.quantity, l.product_id]);
+      }
+      ({ rows: [order] } = await client.query(
+        "insert into orders (user_id, status, total_cents) values ($1, 'pending', $2) returning id, status, total_cents, created_at",
+        [userId, total],
+      ));
+      await client.query(
+        `insert into order_items (order_id, product_id, quantity, price_cents)
+         select $1, * from unnest($2::int[], $3::int[], $4::int[])`,
+        [order.id, lines.map((l) => l.product_id), lines.map((l) => l.quantity), lines.map((l) => l.price_cents)],
+      );
+      await client.query("commit");
+    } catch (err) {
+      await client.query("rollback").catch(() => {});
+      throw err;
+    } finally {
+      client.release();
+    }
+
+    // 2. Charge. The idempotency key is tied to the order, so a retry for this order never charges twice.
+    let paymentId: string;
+    try {
+      ({ paymentId } = await payments.charge({ amountCents: order.total_cents, idempotencyKey: `order-${order.id}-charge` }));
+    } catch (err) {
+      // 3a. Charge failed: release the reserved stock and mark the order failed.
+      console.error(err);
+      await releaseOrder(order.id, lines);
+      return sendError(res, 402, "payment_failed", "The payment could not be completed");
+    }
+
+    // 3b. Charge succeeded: mark the order paid.
+    const { rows: [paid] } = await pool.query(
+      "update orders set status = 'paid', payment_id = $2 where id = $1 returning id, status, total_cents, payment_id, created_at",
+      [order.id, paymentId],
+    );
+    res.status(201).json({
+      ...paid,
+      items: lines.map((l) => ({ productId: l.product_id, quantity: l.quantity, price_cents: l.price_cents })),
+    });
+  });

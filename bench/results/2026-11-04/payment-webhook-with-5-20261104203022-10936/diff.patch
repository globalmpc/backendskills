@@ -1,5 +1,19 @@
 import express, { type NextFunction, type Request, type Response } from "express";
+import { createHmac, timingSafeEqual } from "node:crypto";
 import { pool } from "./db.ts";
+import { webhookSecret } from "./payments.ts";
+
+declare module "http" {
+  interface IncomingMessage {
+    rawBody?: Buffer;
+  }
+}
+
+const EVENT_STATUS = new Map([
+  ["charge.succeeded", "paid"],
+  ["charge.failed", "failed"],
+  ["charge.refunded", "refunded"],
+]);
 
 export type User = { id: number; email: string; name: string; role: string };
 
@@ -27,12 +41,69 @@ async function auth(req: Request, res: Response, next: NextFunction) {
 
 export function createApp() {
   const app = express();
-  app.use(express.json());
+  app.use(express.json({ verify: (req, _res, buf) => { req.rawBody = buf; } }));
 
   app.get("/health", (_req, res) => {
     res.json({ ok: true });
   });
 
+  // Called by the payment provider: authenticated by signature, not by user token.
+  app.post("/webhooks/payments", async (req, res) => {
+    const signature = req.headers["provider-signature"];
+    const raw = req.rawBody;
+    if (typeof signature !== "string" || !raw) return sendError(res, 401, "invalid_signature", "Invalid signature");
+    const expected = createHmac("sha256", webhookSecret).update(raw).digest();
+    const given = Buffer.from(signature, "hex");
+    if (given.length !== expected.length || !timingSafeEqual(given, expected)) {
+      return sendError(res, 401, "invalid_signature", "Invalid signature");
+    }
+
+    const { id, type, paymentId, created } = req.body ?? {};
+    const target = typeof type === "string" ? EVENT_STATUS.get(type) : undefined;
+    if (typeof id !== "string" || !id || typeof paymentId !== "string" || !paymentId || !Number.isSafeInteger(created) || !target) {
+      return sendError(res, 400, "invalid_event", "Invalid event");
+    }
+
+    const client = await pool.connect();
+    try {
+      await client.query("begin");
+      const fresh = await client.query(
+        "insert into webhook_events (id, type, payment_id, created) values ($1, $2, $3, $4) on conflict do nothing",
+        [id, type, paymentId, created],
+      );
+      if (fresh.rowCount === 0) {
+        await client.query("rollback");
+        return res.json({ ok: true, duplicate: true });
+      }
+      const { rows } = await client.query(
+        "select id, status, status_event_at from orders where payment_id = $1 for update",
+        [paymentId],
+      );
+      if (rows.length === 0) {
+        // Event not recorded, so the provider's retry is handled once the order has its payment id.
+        await client.query("rollback");
+        return sendError(res, 404, "not_found", "Order not found");
+      }
+      const order = rows[0];
+      // Never move an order back: refunded is final, failed only comes from pending, and a newer
+      // success may replace an older failure.
+      const allowed =
+        (target === "paid" && (order.status === "pending" || (order.status === "failed" && created > Number(order.status_event_at ?? 0)))) ||
+        (target === "failed" && order.status === "pending") ||
+        (target === "refunded" && (order.status === "pending" || order.status === "paid"));
+      if (allowed) {
+        await client.query("update orders set status = $2, status_event_at = $3 where id = $1", [order.id, target, created]);
+      }
+      await client.query("commit");
+      res.json({ ok: true, applied: allowed });
+    } catch (err) {
+      await client.query("rollback").catch(() => {});
+      throw err;
+    } finally {
+      client.release();
+    }
+  });
+
   app.use(auth);
 
   app.get("/me", (_req, res) => {
diff --git a/test/app.test.ts b/test/app.test.ts

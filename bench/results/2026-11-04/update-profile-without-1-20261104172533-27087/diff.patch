+
+const patch = (token: string, id: number | string, body: unknown) =>
+  fetch(`${base}/users/${id}`, {
+    method: "PATCH",
+    headers: { ...as(token), "content-type": "application/json" },
+    body: JSON.stringify(body),
+  });
+
+test("PATCH /users/:id: a user can update their own name and email", async () => {
+  const res = await patch("bob-token", 2, { name: "  Robert ", email: "Robert@Example.com" });
+  assert.equal(res.status, 200);
+  assert.deepEqual(await res.json(), { id: 2, email: "robert@example.com", name: "Robert", role: "user" });
+  const me = await (await fetch(`${base}/me`, { headers: as("bob-token") })).json();
+  assert.equal(me.email, "robert@example.com");
+});
+
+test("PATCH /users/:id: a regular user cannot update someone else", async () => {
+  const res = await patch("alice-token", 2, { name: "Mallory" });
+  assert.equal(res.status, 403);
+  const bob = await (await fetch(`${base}/me`, { headers: as("bob-token") })).json();
+  assert.equal(bob.name, "Robert");
+});
+
+test("PATCH /users/:id: an admin can update any user", async () => {
+  const res = await patch("admin-token", 2, { name: "Bobby" });
+  assert.equal(res.status, 200);
+  assert.equal((await res.json()).name, "Bobby");
+});
+
+test("PATCH /users/:id: role and api_token cannot be changed through the body", async () => {
+  const res = await patch("bob-token", 2, { role: "admin", api_token: "x" });
+  assert.equal(res.status, 400);
+  assert.equal((await res.json()).error.code, "no_fields");
+  const bob = await (await fetch(`${base}/me`, { headers: as("bob-token") })).json();
+  assert.equal(bob.role, "user");
+});
+
+test("PATCH /users/:id: a taken email gets 409", async () => {
+  const res = await patch("bob-token", 2, { email: "alice@example.com" });
+  assert.equal(res.status, 409);
+  assert.equal((await res.json()).error.code, "email_taken");
+});
+
+test("PATCH /users/:id: invalid input is rejected", async () => {
+  assert.equal((await patch("bob-token", 2, { name: "   " })).status, 400);
+  assert.equal((await patch("bob-token", 2, { email: "not-an-email" })).status, 400);
+  assert.equal((await patch("bob-token", 2, { name: null })).status, 400);
+  assert.equal((await patch("bob-token", "abc", { name: "X" })).status, 400);
+});
+
+test("PATCH /users/:id: unknown user is 404 and a bad token is 401", async () => {
+  assert.equal((await patch("admin-token", 999, { name: "X" })).status, 404);
+  assert.equal((await patch("nope", 2, { name: "X" })).status, 401);
+});

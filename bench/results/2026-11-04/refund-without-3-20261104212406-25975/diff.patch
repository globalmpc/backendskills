+  assert.equal((await fetch(`${base}/orders/999/refund`, { method: "POST", headers: as("alice-token") })).status, 404);
+  assert.equal((await fetch(`${base}/orders/2/refund`, { method: "POST", headers: as("admin-token") })).status, 200);
+});

 export type User = { id: number; email: string; name: string; role: string };
 
+// Expected failures thrown from handlers; the error middleware turns them into the standard error format.
+export class HttpError extends Error {
+  constructor(
+    readonly status: number,
+    readonly code: string,
+    message: string,
+  ) {
+    super(message);
+  }
+}
+
+const MAX_INT = 2_147_483_647; // ids, quantities, stock and total_cents are 32-bit integer columns
+
+// Validates the body and merges duplicate product lines, so each product appears once.
+function parseOrderItems(body: unknown): Map<number, number> {
+  const items = (body as { items?: unknown } | undefined)?.items;
+  if (!Array.isArray(items) || items.length === 0) {
+    throw new HttpError(400, "invalid_items", "items must be a non-empty array");
+  }
+  const quantities = new Map<number, number>();
+  for (const item of items) {
+    const { productId, quantity } = (item ?? {}) as { productId?: unknown; quantity?: unknown };
+    if (typeof productId !== "number" || !Number.isInteger(productId) || productId < 1 || productId > MAX_INT) {
+      throw new HttpError(400, "invalid_item", "productId must be a positive integer");
+    }
+    if (typeof quantity !== "number" || !Number.isInteger(quantity) || quantity < 1 || quantity > MAX_INT) {
+      throw new HttpError(400, "invalid_item", "quantity must be a positive integer");
+    }
+    quantities.set(productId, (quantities.get(productId) ?? 0) + quantity);
+  }
+  return quantities;
+}
+
+type OrderItem = { product_id: number; quantity: number; price_cents: number };
+
+// Reserves the stock, charges the total through the payment provider, and marks the order paid.
+async function placeOrder(userId: number, quantities: Map<number, number>) {
+  const productIds = [...quantities.keys()].sort((a, b) => a - b);
+
+  // 1. One short transaction with no outside calls. Products are locked in id order (no deadlocks),
+  //    stock is checked and taken, and a pending order is recorded.
+  const { orderId, createdAt, total, items } = await withTransaction(async (client) => {
+    const { rows: products } = await client.query<{ id: number; price_cents: number; stock: number }>(
+      "select id, price_cents, stock from products where id = any($1::int[]) order by id for update",
+      [productIds],
+    );
+    if (products.length !== productIds.length) {
+      throw new HttpError(400, "unknown_product", "One of the products does not exist");
+    }
+    let total = 0;
+    for (const p of products) {
+      const quantity = quantities.get(p.id)!;
+      if (p.stock < quantity) throw new HttpError(409, "insufficient_stock", `Not enough stock for product ${p.id}`);
+      total += p.price_cents * quantity;
+    }
+    if (total > MAX_INT) throw new HttpError(400, "order_too_large", "Order total is too large");
+
+    for (const p of products) {
+      const quantity = quantities.get(p.id)!;
+      // The condition repeats the check in the write itself; the CHECK constraint is the last line of defence.
+      const { rowCount } = await client.query(
+        "update products set stock = stock - $2 where id = $1 and stock >= $2",
+        [p.id, quantity],
+      );
+      if (rowCount !== 1) throw new HttpError(409, "insufficient_stock", `Not enough stock for product ${p.id}`);
+    }
+
+    const { rows: [order] } = await client.query<{ id: number; created_at: Date }>(
+      "insert into orders (user_id, status, total_cents) values ($1, 'pending', $2) returning id, created_at",
+      [userId, total],
+    );
+    const items: OrderItem[] = products.map((p) => ({
+      product_id: p.id,
+      quantity: quantities.get(p.id)!,
+      price_cents: p.price_cents,
+    }));
+    for (const item of items) {
+      await client.query(
+        "insert into order_items (order_id, product_id, quantity, price_cents) values ($1, $2, $3, $4)",
+        [order.id, item.product_id, item.quantity, item.price_cents],
+      );
+    }
+    return { orderId: order.id, createdAt: order.created_at, total, items };
+  });
+
+  // 2. The provider call happens outside any transaction. The key comes from our order id, so a retry can't charge twice.
+  let paymentId: string;
+  try {
+    ({ paymentId } = await payments.charge({ amountCents: total, idempotencyKey: `order-${orderId}` }));
+  } catch {
+    // Give the stock back and close the order.
+    await withTransaction(async (client) => {
+      for (const item of items) {
+        await client.query("update products set stock = stock + $2 where id = $1", [item.product_id, item.quantity]);
+      }
+      await client.query("update orders set status = 'failed' where id = $1 and status = 'pending'", [orderId]);
+    });
+    throw new HttpError(502, "payment_failed", "Payment failed");
+  }
+
+  // 3. Record the payment on the order.
+  const { rowCount } = await pool.query(
+    "update orders set status = 'paid', payment_id = $2 where id = $1 and status = 'pending'",
+    [orderId, paymentId],
+  );
+  if (rowCount !== 1) throw new Error(`order ${orderId} was not pending when payment completed`);
+
+  return { id: orderId, status: "paid", total_cents: total, created_at: createdAt, items };
+}

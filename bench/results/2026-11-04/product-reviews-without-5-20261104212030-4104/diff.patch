+
+const post = (token: string, path: string, body: unknown) =>
+  fetch(`${base}${path}`, { method: "POST", headers: { ...as(token), "content-type": "application/json" }, body: JSON.stringify(body) });
+
+test("reviews: buyers can review once, others are rejected, list shows them", async () => {
+  // Alice bought the T-shirt (1); Bob did not.
+  assert.equal((await post("bob-token", "/products/1/reviews", { rating: 5, body: "x" })).status, 403);
+  assert.equal((await post("alice-token", "/products/1/reviews", { rating: 6, body: "x" })).status, 400);
+  assert.equal((await post("alice-token", "/products/1/reviews", { rating: 4, body: " " })).status, 400);
+  assert.equal((await post("alice-token", "/products/999/reviews", { rating: 4, body: "x" })).status, 404);

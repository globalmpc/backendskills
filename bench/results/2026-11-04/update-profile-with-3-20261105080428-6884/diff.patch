diff --git a/test/app.test.ts b/test/app.test.ts
index d7b2ef4..2eb6b62 100644
--- a/test/app.test.ts
+++ b/test/app.test.ts
@@ -64,3 +64,45 @@ test("payments client records every call; the same idempotency key is charged on
   const { rows } = await pool.query("select kind, count(*)::int as n from payment_calls where created_at > now() - interval '1 minute' group by kind order by kind");
   assert.deepEqual(rows, [{ kind: "charge", n: 1 }, { kind: "refund", n: 1 }]);
 });
+
+const patch = (id: number | string, token: string, body: unknown) =>
+  fetch(`${base}/users/${id}`, {
+    method: "PATCH",
+    headers: { ...as(token), "content-type": "application/json" },
+    body: JSON.stringify(body),
+  });
+
+test("PATCH /users/:id updates own name and email", async () => {
+  const res = await patch(2, "bob-token", { name: "Bobby", email: "Bobby@Example.com" });
+  assert.equal(res.status, 200);
+  assert.deepEqual(await res.json(), { id: 2, email: "bobby@example.com", name: "Bobby", role: "user" });
+  await patch(2, "bob-token", { name: "Bob", email: "bob@example.com" });
+});
+
+test("PATCH /users/:id on someone else's profile is 404 and changes nothing", async () => {
+  const res = await patch(1, "bob-token", { name: "Hacked" });
+  assert.equal(res.status, 404);
+  const me = await (await fetch(`${base}/me`, { headers: as("alice-token") })).json();
+  assert.equal(me.name, "Alice");
+});
+
+test("PATCH /users/:id: admin may edit others; missing user is 404", async () => {
+  assert.equal((await patch(1, "admin-token", { name: "Alice" })).status, 200);
+  assert.equal((await patch(999, "admin-token", { name: "X" })).status, 404);
+});
+
+test("PATCH /users/:id rejects bad input with 400 and duplicate email with 409", async () => {
+  for (const body of [{}, { name: "" }, { name: 5 }, { email: "nope" }, { role: "admin" }, [], null]) {
+    const res = await patch(1, "alice-token", body);
+    assert.equal(res.status, 400, JSON.stringify(body));
+    assert.equal((await res.json()).error.code, "invalid_request");
+  }
+  assert.equal((await patch("abc", "alice-token", { name: "A" })).status, 404);
+  const dup = await patch(1, "alice-token", { email: "bob@example.com" });
+  assert.equal(dup.status, 409);
+  assert.equal((await dup.json()).error.code, "email_taken");
+});
+
+test("PATCH /users/:id requires auth", async () => {
+  assert.equal((await patch(1, "nope", { name: "A" })).status, 401);
+});

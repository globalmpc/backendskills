+  app.post("/orders", async (req, res) => {
+    const MAX = 2147483647;
+    const items = req.body?.items;
+    if (!Array.isArray(items) || items.length === 0 || items.length > 100) {
+      return sendError(res, 400, "invalid_items", "items must be a non-empty array (max 100)");
+    }
+    // Merge duplicate product lines.
+    const wanted = new Map<number, number>();
+    for (const it of items) {
+      const { productId, quantity } = it ?? {};
+      if (!Number.isInteger(productId) || productId < 1 || productId > MAX || !Number.isInteger(quantity) || quantity < 1 || quantity > MAX) {
+        return sendError(res, 400, "invalid_items", "Each item needs an integer productId >= 1 and quantity >= 1");
+      }
+      const total = (wanted.get(productId) ?? 0) + quantity;
+      if (total > MAX) return sendError(res, 400, "invalid_items", "Quantity too large");
+      wanted.set(productId, total);
+    }
+    const lines = [...wanted.entries()].sort((a, b) => a[0] - b[0]); // fixed lock order
+
+    class Reject extends Error {
+      status: number;
+      code: string;
+      constructor(status: number, code: string, message: string) {
+        super(message);
+        this.status = status;
+        this.code = code;
+      }
+    }
+
+    // Step 1 (short transaction): reserve stock with conditional updates, create a pending order.
+    let orderId = 0;
+    let totalCents = 0;
+    const client = await pool.connect();
+    try {
+      await client.query("begin");
+      const priced: { productId: number; quantity: number; priceCents: number }[] = [];
+      for (const [productId, quantity] of lines) {
+        const { rows } = await client.query(
+          "update products set stock = stock - $2 where id = $1 and stock >= $2 returning price_cents",
+          [productId, quantity],
+        );
+        if (rows.length === 0) {
+          const { rowCount } = await client.query("select 1 from products where id = $1", [productId]);
+          throw rowCount === 0
+            ? new Reject(404, "product_not_found", `Product ${productId} not found`)
+            : new Reject(409, "insufficient_stock", `Not enough stock for product ${productId}`);
+        }
+        priced.push({ productId, quantity, priceCents: rows[0].price_cents });
+        totalCents += rows[0].price_cents * quantity;
+      }
+      if (totalCents > MAX) throw new Reject(400, "invalid_items", "Order total too large");
+      const { rows: [o] } = await client.query(
+        "insert into orders (user_id, status, total_cents) values ($1, 'pending', $2) returning id",
+        [res.locals.user.id, totalCents],
+      );
+      orderId = o.id;
+      for (const p of priced) {
+        await client.query(
+          "insert into order_items (order_id, product_id, quantity, price_cents) values ($1, $2, $3, $4)",
+          [orderId, p.productId, p.quantity, p.priceCents],
+        );
+      }
+      await client.query("commit");
+    } catch (err) {
+      await client.query("rollback").catch(() => {});
+      if (err instanceof Reject) return sendError(res, err.status, err.code, err.message);
+      throw err;
+    } finally {
+      client.release();
+    }
+
+    // Step 2: charge outside any transaction, idempotent per order.
+    try {
+      const { paymentId } = await payments.charge({ amountCents: totalCents, idempotencyKey: `order-${orderId}` });
+      await pool.query("update orders set status = 'paid', payment_id = $2 where id = $1 and status = 'pending'", [orderId, paymentId]);
+    } catch (err) {
+      console.error(err);
+      // Release the reservation, once (only from 'pending').
+      const c = await pool.connect();
+      try {
+        await c.query("begin");
+        const { rowCount } = await c.query("update orders set status = 'failed' where id = $1 and status = 'pending'", [orderId]);
+        if (rowCount === 1) {
+          await c.query(
+            `update products p set stock = p.stock + i.quantity
+               from order_items i where i.order_id = $1 and i.product_id = p.id`,
+            [orderId],
+          );
+        }
+        await c.query("commit");
+      } catch (e) {
+        await c.query("rollback").catch(() => {});
+        console.error(e);
+      } finally {
+        c.release();
+      }
+      return sendError(res, 502, "payment_failed", "Payment failed");
+    }
+
+    const { rows: [order] } = await pool.query(
+      "select id, status, total_cents, payment_id, created_at from orders where id = $1",
+      [orderId],
+    );
+    const { rows: orderItems } = await pool.query(
+      "select product_id, quantity, price_cents from order_items where order_id = $1 order by product_id",
+      [orderId],
+    );
+    res.status(201).json({ ...order, items: orderItems });
+  });
+

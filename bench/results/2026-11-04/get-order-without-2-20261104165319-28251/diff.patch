+  app.get("/orders/:id", async (req, res) => {
+    const id = Number(req.params.id);
+    // Orders ids are int4; anything else cannot match a row.
+    if (!/^\d+$/.test(req.params.id) || id > 2147483647) return sendError(res, 404, "not_found", "Order not found");
+    const { rows: orders } = await pool.query(
+      "select id, status, total_cents, created_at from orders where id = $1 and user_id = $2",
+      [id, res.locals.user.id],
+    );
+    if (orders.length === 0) return sendError(res, 404, "not_found", "Order not found");
+    const { rows: items } = await pool.query(
+      "select product_id, quantity, price_cents from order_items where order_id = $1 order by product_id",
+      [id],
+    );
+    res.json({ ...orders[0], items });
+  });

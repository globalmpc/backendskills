+
+const postOrder = (items: unknown) =>
+  fetch(`${base}/orders`, {
+    method: "POST",
+    headers: { ...as("alice-token"), "content-type": "application/json" },
+    body: JSON.stringify({ items }),
+  });
+
+test("POST /orders places an order, charges and reduces stock", async () => {
+  const list = async () => (await (await fetch(`${base}/products`, { headers: as("alice-token") })).json()) as { id: number; stock: number; price_cents: number }[];
+  const p = (await list())[0];
+  const res = await postOrder([{ productId: p.id, quantity: 2 }]);
+  assert.equal(res.status, 201);
+  const order = await res.json();
+  assert.equal(order.status, "paid");
+  assert.equal(order.total_cents, p.price_cents * 2);
+  assert.equal((await list()).find((x) => x.id === p.id)!.stock, p.stock - 2);
+});
+
+test("POST /orders rejects insufficient stock", async () => {
+  const res = await postOrder([{ productId: 1, quantity: 100000 }]);
+  assert.equal(res.status, 409);
+  assert.equal((await res.json()).error.code, "insufficient_stock");
+});
+
+test("POST /orders validates the body", async () => {
+  assert.equal((await postOrder([{ productId: 1, quantity: 0 }])).status, 400);
+  assert.equal((await postOrder([])).status, 400);
+});

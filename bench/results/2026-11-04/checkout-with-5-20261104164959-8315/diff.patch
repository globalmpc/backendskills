new file mode 100644
index 0000000..7fd1b2f
--- /dev/null
+++ b/migrations/002_orders_stock_check.sql
@@ -0,0 +1,6 @@
+-- Stock can never go negative, even if application code has a bug or two writes race.
+alter table products add constraint products_stock_nonnegative check (stock >= 0);
+
+-- Orders written by POST /orders: pending while the charge is in flight, then paid,
+-- or failed when the payment was rejected (its stock is given back).
+comment on column orders.status is 'pending | paid | refunded | failed';

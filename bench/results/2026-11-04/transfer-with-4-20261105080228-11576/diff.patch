+  app.post("/transfers", async (req, res) => {
+    const { toUserId, amountCents } = req.body ?? {};
+    const fromUserId: number = res.locals.user.id;
+    if (!Number.isInteger(toUserId) || toUserId < 1 || toUserId > 2_147_483_647) {
+      return sendError(res, 400, "invalid_request", "toUserId must be a positive integer");
+    }
+    if (!Number.isInteger(amountCents) || amountCents < 1 || amountCents > 2_000_000_000) {
+      return sendError(res, 400, "invalid_request", "amountCents must be a positive integer");
+    }
+    if (toUserId === fromUserId) {
+      return sendError(res, 400, "invalid_request", "Cannot transfer to yourself");
+    }
+    const rawKey = req.headers["idempotency-key"];
+    const key = typeof rawKey === "string" && rawKey !== "" ? rawKey.slice(0, 200) : null;
+
+    const client = await pool.connect();
+    try {
+      await client.query("begin");
+      // Lock both wallets in id order so opposite transfers cannot deadlock.
+      const { rows: locked } = await client.query(
+        "select user_id, balance_cents from wallets where user_id = any($1) order by user_id for update",
+        [[fromUserId, toUserId]],
+      );
+      if (!locked.some((w) => w.user_id === toUserId)) {
+        await client.query("rollback");
+        return sendError(res, 404, "not_found", "User not found");
+      }
+      const sender = locked.find((w) => w.user_id === fromUserId);
+      if (!sender || sender.balance_cents < amountCents) {
+        await client.query("rollback");
+        return sendError(res, 409, "insufficient_funds", "Not enough store credit");
+      }
+      const { rows: [t] } = await client.query(
+        `insert into transfers (from_user_id, to_user_id, amount_cents, idempotency_key)
+         values ($1, $2, $3, $4) on conflict (from_user_id, idempotency_key) do nothing
+         returning id, created_at`,
+        [fromUserId, toUserId, amountCents, key],
+      );
+      if (!t) {
+        // Same key already used by this sender: a retry. Return the original, move nothing.
+        await client.query("rollback");
+        const { rows: [prev] } = await pool.query(
+          `select id, to_user_id, amount_cents, created_at from transfers
+           where from_user_id = $1 and idempotency_key = $2`,
+          [fromUserId, key],
+        );
+        if (prev.to_user_id !== toUserId || prev.amount_cents !== amountCents) {
+          return sendError(res, 409, "idempotency_conflict", "Idempotency-Key was used with a different request");
+        }
+        return res.status(200).json({ id: prev.id, toUserId, amountCents, createdAt: prev.created_at });
+      }
+      await client.query("update wallets set balance_cents = balance_cents - $2 where user_id = $1", [fromUserId, amountCents]);
+      await client.query("update wallets set balance_cents = balance_cents + $2 where user_id = $1", [toUserId, amountCents]);
+      await client.query("commit");
+      res.status(201).json({ id: t.id, toUserId, amountCents, createdAt: t.created_at });
+    } catch (err) {
+      await client.query("rollback").catch(() => {});
+      throw err;
+    } finally {
+      client.release();
+    }
+  });
+

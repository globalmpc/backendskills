+// Moves store credit between two wallets in one transaction. Returns the sender's new balance.
+// Both wallet rows are locked (in user_id order, so concurrent transfers can't deadlock) before the
+// balance is checked, so two transfers racing on the same wallet can't overdraw it.
+async function transferCredit(fromUserId: number, toUserId: number, amountCents: number): Promise<number> {
+  const client = await pool.connect();
+  try {
+    await client.query("begin");
+
+    const { rows: recipients } = await client.query("select id from users where id = $1", [toUserId]);
+    if (recipients.length === 0) throw new TransferError(404, "recipient_not_found", "Recipient not found");
+
+    const [low, high] = [fromUserId, toUserId].sort((a, b) => a - b);
+    await client.query(
+      "insert into wallets (user_id, balance_cents) values ($1, 0), ($2, 0) on conflict (user_id) do nothing",
+      [low, high],
+    );
+    const { rows } = await client.query(
+      "select user_id, balance_cents from wallets where user_id = any($1::int[]) order by user_id for update",
+      [[low, high]],
+    );
+    const balances = new Map<number, number>(rows.map((r) => [r.user_id, r.balance_cents]));
+    const fromBalance = balances.get(fromUserId) ?? 0;
+    const toBalance = balances.get(toUserId) ?? 0;
+
+    if (fromBalance < amountCents) throw new TransferError(409, "insufficient_funds", "Not enough store credit");
+    if (toBalance + amountCents > MAX_CENTS) throw new TransferError(409, "balance_limit", "Recipient balance would be too large");
+
+    await client.query("update wallets set balance_cents = balance_cents - $2 where user_id = $1", [fromUserId, amountCents]);
+    await client.query("update wallets set balance_cents = balance_cents + $2 where user_id = $1", [toUserId, amountCents]);
+    await client.query("commit");
+    return fromBalance - amountCents;
+  } catch (err) {
+    await client.query("rollback");
+    throw err;
+  } finally {
+    client.release();
+  }
+}

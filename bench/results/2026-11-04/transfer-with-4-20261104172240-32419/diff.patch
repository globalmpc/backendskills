+  app.post("/transfers", async (req, res) => {
+    const { toUserId, amountCents } = req.body ?? {};
+    if (!Number.isSafeInteger(toUserId) || toUserId < 1) {
+      return sendError(res, 400, "invalid_body", "toUserId must be a positive integer");
+    }
+    if (!Number.isSafeInteger(amountCents) || amountCents < 1 || amountCents > MAX_INT) {
+      return sendError(res, 400, "invalid_body", "amountCents must be a positive integer");
+    }
+    const fromUserId: number = res.locals.user.id;
+    if (toUserId === fromUserId) return sendError(res, 400, "self_transfer", "Cannot send credit to yourself");
+
+    const client = await pool.connect();
+    try {
+      await client.query("begin");
+      // Lock both wallets in id order, so two opposite transfers can't deadlock each other.
+      const { rows: locked } = await client.query(
+        "select user_id from wallets where user_id = any($1::int[]) order by user_id for update",
+        [[fromUserId, toUserId]],
+      );
+      if (!locked.some((r) => r.user_id === toUserId)) throw new TransferRejected(404, "recipient_not_found", "Recipient not found");
+      // The balance check is part of the write: no read-then-update race.
+      const debit = await client.query(
+        "update wallets set balance_cents = balance_cents - $1 where user_id = $2 and balance_cents >= $1 returning balance_cents",
+        [amountCents, fromUserId],
+      );
+      if (debit.rowCount === 0) throw new TransferRejected(409, "insufficient_funds", "Not enough store credit");
+      await client.query("update wallets set balance_cents = balance_cents + $1 where user_id = $2", [amountCents, toUserId]);
+      await client.query("commit");
+      res.status(201).json({ toUserId, amountCents, balanceCents: debit.rows[0].balance_cents });
+    } catch (err) {
+      await client.query("rollback");
+      if (err instanceof TransferRejected) return sendError(res, err.status, err.code, err.message);
+      // 22003 = numeric_value_out_of_range: the recipient's balance would pass the integer column limit.
+      if ((err as { code?: string }).code === "22003") {
+        return sendError(res, 409, "wallet_limit_exceeded", "Recipient balance would be too large");
+      }
+      throw err;
+    } finally {
+      client.release();
+    }
+  });
+

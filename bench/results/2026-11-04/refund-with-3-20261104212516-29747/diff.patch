+  app.post("/orders/:id/refund", async (req, res) => {
+    const idParam = String(req.params.id);
+    if (!/^\d{1,9}$/.test(idParam)) return sendError(res, 404, "not_found", "Order not found");
+    const orderId = Number(idParam);
+    const user = res.locals.user;
+
+    // Owner or admin only; anyone else sees the same 404 as for a missing order.
+    const { rows } = await pool.query(
+      "select id, status, total_cents, payment_id from orders where id = $1 and ($3 or user_id = $2)",
+      [orderId, user.id, user.role === "admin"],
+    );
+    if (rows.length === 0) return sendError(res, 404, "not_found", "Order not found");
+    const order = rows[0];
+    if (order.status !== "paid" || !order.payment_id) {
+      return sendError(res, 409, "not_refundable", "Only paid orders can be refunded");
+    }
+
+    // Outside any transaction. The key comes from the order, so retries and concurrent requests
+    // move money once. If the update below fails, a retry reuses the same refund.
+    try {
+      await payments.refund({
+        paymentId: order.payment_id,
+        amountCents: order.total_cents,
+        idempotencyKey: `refund-order-${orderId}`,
+      });
+    } catch (err) {
+      console.error(err);
+      return sendError(res, 502, "refund_failed", "Refund failed");
+    }
+
+    const { rows: updated } = await pool.query(
+      "update orders set status = 'refunded' where id = $1 and status = 'paid' returning id, status, total_cents",
+      [orderId],
+    );
+    if (updated.length === 0) return sendError(res, 409, "not_refundable", "Only paid orders can be refunded");
+    res.json(updated[0]);
+  });
+

+test("/orders paginates newest first, 20 per page, via nextCursor", async () => {
+  const me = await (await fetch(`${base}/me`, { headers: as("bob-token") })).json();
+  await pool.query("insert into orders (user_id, total_cents) select $1, 100 from generate_series(1, 44)", [me.id]);
+  const { rows: all } = await pool.query("select id from orders where user_id = $1 order by id desc", [me.id]);
+
+  const seen: number[] = [];
+  let cursor: string | null = null;
+  let pages = 0;
+  do {
+    const url: string = `${base}/orders${cursor ? `?cursor=${encodeURIComponent(cursor)}` : ""}`;
+    const body: { orders: { id: number }[]; nextCursor: string | null } = await (
+      await fetch(url, { headers: as("bob-token") })
+    ).json();
+    pages++;
+    assert.ok(body.orders.length <= 20);
+    if (body.nextCursor !== null) assert.equal(body.orders.length, 20);
+    seen.push(...body.orders.map((o) => o.id));
+    cursor = body.nextCursor;
+  } while (cursor !== null);
+
+  assert.equal(pages, 3);
+  assert.deepEqual(seen, all.map((r) => r.id));
+});
+

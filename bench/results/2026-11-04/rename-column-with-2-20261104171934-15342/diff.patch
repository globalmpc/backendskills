diff --git a/migrations/002_orders_amount_cents.sql b/migrations/002_orders_amount_cents.sql
new file mode 100644
index 0000000..3ba9668
--- /dev/null
+++ b/migrations/002_orders_amount_cents.sql
@@ -0,0 +1,25 @@
+-- Expand step of renaming orders.total_cents to orders.amount_cents. Old and new servers run side by side
+-- during a rolling deploy, so both columns stay equal (trigger below). The contract step, dropping
+-- total_cents, ships in a later migration, once no server reads it.
+set local lock_timeout = '5s';
+
+alter table orders add column amount_cents integer;
+
+-- Backfill. Fine while orders is small; if it can exceed ~100k rows, backfill in batches first.
+update orders set amount_cents = total_cents where amount_cents is null;
+
+create function orders_sync_amount_cents() returns trigger language plpgsql as $$
+begin
+  if tg_op = 'INSERT' then
+    new.amount_cents := coalesce(new.amount_cents, new.total_cents);
+    new.total_cents := coalesce(new.total_cents, new.amount_cents);
+  elsif new.amount_cents is distinct from old.amount_cents then
+    new.total_cents := new.amount_cents; -- written through the new name
+  else
+    new.amount_cents := new.total_cents; -- written through the old name
+  end if;
+  return new;
+end $$;
+
+create trigger orders_sync_amount_cents before insert or update on orders
+  for each row execute function orders_sync_amount_cents();
diff --git a/migrations/down/002_orders_amount_cents.sql b/migrations/down/002_orders_amount_cents.sql
new file mode 100644
index 0000000..4e06110
--- /dev/null
+++ b/migrations/down/002_orders_amount_cents.sql
@@ -0,0 +1,4 @@
+-- Reverses migrations/002_orders_amount_cents.sql, in reverse order.
+drop trigger if exists orders_sync_amount_cents on orders;
+drop function if exists orders_sync_amount_cents();
+alter table orders drop column if exists amount_cents;

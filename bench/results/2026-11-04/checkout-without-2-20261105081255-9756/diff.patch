+const MAX_INT4 = 2_147_483_647;
+const MAX_QUANTITY = 10_000;
+
+type OrderItem = { productId: number; quantity: number };
+
+// Validates the body and merges duplicate productIds. Returns an error message on invalid input.
+function parseOrderItems(body: unknown): OrderItem[] | string {
+  const items = (body as { items?: unknown } | undefined)?.items;
+  if (!Array.isArray(items) || items.length === 0) return "`items` must be a non-empty array";
+  const merged = new Map<number, number>();
+  for (const item of items) {
+    const { productId, quantity } = (item ?? {}) as Record<string, unknown>;
+    if (!Number.isInteger(productId) || (productId as number) <= 0 || (productId as number) > MAX_INT4) {
+      return "Each item needs a positive integer `productId`";
+    }
+    if (!Number.isInteger(quantity) || (quantity as number) <= 0) {
+      return "Each item needs a positive integer `quantity`";
+    }
+    const total = (merged.get(productId as number) ?? 0) + (quantity as number);
+    if (total > MAX_QUANTITY) return `\`quantity\` may not exceed ${MAX_QUANTITY} per product`;
+    merged.set(productId as number, total);
+  }
+  return [...merged].map(([productId, quantity]) => ({ productId, quantity }));
+}
+
+// Returns reserved stock for an order whose payment failed and marks it failed.
+async function releaseOrder(orderId: number, lines: { product_id: number; quantity: number }[]) {
+  const client = await pool.connect();
+  try {
+    await client.query("begin");
+    const { rowCount } = await client.query("update orders set status = 'failed' where id = $1 and status = 'pending'", [orderId]);
+    if (rowCount === 1) {
+      for (const l of [...lines].sort((a, b) => a.product_id - b.product_id)) {
+        await client.query("update products set stock = stock + $1 where id = $2", [l.quantity, l.product_id]);
+      }
+    }
+    await client.query("commit");
+  } catch (err) {
+    await client.query("rollback").catch(() => {});
+    throw err;
+  } finally {
+    client.release();
+  }
+}
+
 export function createApp() {
   const app = express();
   app.use(express.json());

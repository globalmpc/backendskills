+  app.post("/orders", async (req, res) => {
+    const items = parseItems(req.body);
+    if (!items) {
+      return sendError(res, 400, "invalid_request", "items must be a non-empty list of { productId, quantity } with positive integers");
+    }
+    const userId = res.locals.user.id;
+
+    // 1. Short transaction: reserve stock (check + decrement in one statement, fixed lock order) and
+    //    create a pending order. No outside calls while rows are locked.
+    let order: { id: number; totalCents: number };
+    const client = await pool.connect();
+    try {
+      await client.query("begin");
+      let total = 0;
+      const priced: { productId: number; quantity: number; priceCents: number }[] = [];
+      for (const { productId, quantity } of items) {
+        const { rows } = await client.query(
+          "update products set stock = stock - $2 where id = $1 and stock >= $2 returning price_cents",
+          [productId, quantity],
+        );
+        if (rows.length === 0) {
+          const { rowCount } = await client.query("select 1 from products where id = $1", [productId]);
+          if (rowCount === 0) throw new HttpError(404, "product_not_found", `Product ${productId} not found`);
+          throw new HttpError(409, "insufficient_stock", `Not enough stock for product ${productId}`);
+        }
+        total += rows[0].price_cents * quantity;
+        priced.push({ productId, quantity, priceCents: rows[0].price_cents });
+      }
+      if (total > MAX_INT) throw new HttpError(400, "invalid_request", "Order total too large");
+      const { rows: [o] } = await client.query(
+        "insert into orders (user_id, status, total_cents) values ($1, 'pending', $2) returning id",
+        [userId, total],
+      );
+      for (const p of priced) {
+        await client.query(
+          "insert into order_items (order_id, product_id, quantity, price_cents) values ($1, $2, $3, $4)",
+          [o.id, p.productId, p.quantity, p.priceCents],
+        );
+      }
+      await client.query("commit");
+      order = { id: o.id, totalCents: total };
+    } catch (err) {
+      await client.query("rollback").catch(() => {});
+      if (err instanceof HttpError) return sendError(res, err.status, err.code, err.message);
+      throw err;
+    } finally {
+      client.release();
+    }
+
+    // 2. Charge outside any transaction; the key comes from our order so retries never double-charge.
+    let paymentId: string;

@@ -64,3 +64,46 @@ test("payments client records every call; the same idempotency key is charged on
   const { rows } = await pool.query("select kind, count(*)::int as n from payment_calls where created_at > now() - interval '1 minute' group by kind order by kind");
   assert.deepEqual(rows, [{ kind: "charge", n: 1 }, { kind: "refund", n: 1 }]);
 });
+
+const login = (body: unknown) =>
+  fetch(`${base}/login`, { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(body) });
+
+test("login with email and password returns the api_token, without a token", async () => {
+  const res = await login({ email: "alice@example.com", password: "alice-password" });
+  assert.equal(res.status, 200);
+  assert.deepEqual(await res.json(), { token: "alice-token" });
+});
+
+test("login ignores case and surrounding spaces in the email", async () => {
+  const res = await login({ email: "  Alice@Example.com ", password: "alice-password" });
+  assert.equal(res.status, 200);
+  assert.deepEqual(await res.json(), { token: "alice-token" });
+});
+
+test("login with a wrong password and with an unknown email get the same 401", async () => {
+  const wrong = await login({ email: "alice@example.com", password: "nope" });
+  const unknown = await login({ email: "nobody@example.com", password: "nope" });
+  assert.equal(wrong.status, 401);
+  assert.equal(unknown.status, 401);
+  assert.deepEqual(await wrong.json(), { error: { code: "invalid_credentials", message: "Email or password is incorrect" } });
+  assert.deepEqual(await unknown.json(), { error: { code: "invalid_credentials", message: "Email or password is incorrect" } });
+});
+
+test("login rejects bad bodies with 400, not 500", async () => {
+  for (const body of [{}, { email: "alice@example.com" }, { email: 5, password: "x" }, { email: "  ", password: "x" }, { email: "alice@example.com", password: "" }]) {
+    const res = await login(body);
+    assert.equal(res.status, 400, JSON.stringify(body));
+    assert.equal((await res.json()).error.code, "invalid_body");
+  }
+  const malformed = await fetch(`${base}/login`, { method: "POST", headers: { "content-type": "application/json" }, body: "{not json" });
+  assert.equal(malformed.status, 400);
+});
+
+test("login stops guessing: after the email limit, even the right password gets 429", async () => {
+  for (let i = 0; i < 10; i++) {
+    assert.equal((await login({ email: "bob@example.com", password: "wrong" })).status, 401);
+  }
+  const res = await login({ email: "bob@example.com", password: "bob-password" });
+  assert.equal(res.status, 429);
+  assert.equal((await res.json()).error.code, "too_many_attempts");
+});

+const patch = (token: string, id: string | number, body: unknown) =>
+  fetch(`${base}/products/${id}`, {
+    method: "PATCH",
+    headers: { ...as(token), "content-type": "application/json" },
+    body: JSON.stringify(body),
+  });
+
+test("admin sets a product discount; it defaults to 0 and shows in /products", async () => {
+  const before = await (await fetch(`${base}/products`, { headers: as("alice-token") })).json();
+  assert.equal(before[0].discount_percent, 0);
+  const res = await patch("admin-token", 1, { discountPercent: 25 });
+  assert.equal(res.status, 200);
+  assert.equal((await res.json()).discount_percent, 25);
+  const after = await (await fetch(`${base}/products`, { headers: as("alice-token") })).json();
+  assert.equal(after[0].discount_percent, 25);
+});
+
+test("non-admins cannot set a discount", async () => {
+  const res = await patch("alice-token", 2, { discountPercent: 10 });
+  assert.equal(res.status, 403);
+  assert.equal((await res.json()).error.code, "forbidden");
+});
+
+test("bad discount input is a 4xx", async () => {
+  for (const body of [{}, { discountPercent: -1 }, { discountPercent: 101 }, { discountPercent: 1.5 }, { discountPercent: "10" }, { discountPercent: null }]) {
+    assert.equal((await patch("admin-token", 2, body)).status, 400, JSON.stringify(body));
+  }
+  assert.equal((await patch("admin-token", "abc", { discountPercent: 5 })).status, 400);
+  assert.equal((await patch("admin-token", 99999999999, { discountPercent: 5 })).status, 400);
+  assert.equal((await patch("admin-token", 9999, { discountPercent: 5 })).status, 404);
+});
+

 import express, { type NextFunction, type Request, type Response } from "express";
 import { pool } from "./db.ts";
+import { verifyWebhookSignature } from "./payments.ts";
 
 export type User = { id: number; email: string; name: string; role: string };
 
+type PaymentEvent = { id: string; type: "charge.succeeded" | "charge.failed" | "charge.refunded"; paymentId: string; created: number };
+
+// Target status per event, and the statuses it may move an order from. Anything else is a no-op, so a
+// duplicate or an older event never moves an order backwards (e.g. "paid" after "refunded").
+// charge.refunded is also accepted from "pending": if it arrives before charge.succeeded, the later
+// success event then finds the order already refunded and does nothing.
+const TRANSITIONS: Record<PaymentEvent["type"], { to: string; from: string[] }> = {
+  "charge.succeeded": { to: "paid", from: ["pending"] },
+  "charge.failed": { to: "failed", from: ["pending"] },
+  "charge.refunded": { to: "refunded", from: ["pending", "paid"] },
+};
+
+function parsePaymentEvent(value: unknown): PaymentEvent | null {
+  if (typeof value !== "object" || value === null) return null;
+  const e = value as Record<string, unknown>;
+  if (typeof e.id !== "string" || e.id === "") return null;
+  if (typeof e.type !== "string" || !Object.hasOwn(TRANSITIONS, e.type)) return null;
+  if (typeof e.paymentId !== "string" || e.paymentId === "") return null;
+  if (!Number.isInteger(e.created)) return null;
+  return { id: e.id, type: e.type as PaymentEvent["type"], paymentId: e.paymentId, created: e.created as number };
+}

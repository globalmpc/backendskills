+const patchDiscount = (token: string, id: number | string, body: unknown) =>
+  fetch(`${base}/products/${id}`, {
+    method: "PATCH",
+    headers: { ...as(token), "content-type": "application/json" },
+    body: JSON.stringify(body),
+  });
+
+test("products default to no discount", async () => {
+  const { rows } = await pool.query("select discount_percent from products");
+  assert.ok(rows.every((r) => r.discount_percent === 0));
+});
+
+test("admins can set a product discount", async () => {
+  const res = await patchDiscount("admin-token", 3, { discountPercent: 25 });
+  assert.equal(res.status, 200);
+  assert.equal((await res.json()).discount_percent, 25);
+  const { rows } = await pool.query("select discount_percent from products where id = 3");
+  assert.equal(rows[0].discount_percent, 25);
+});
+
+test("non-admins cannot change a discount", async () => {
+  const res = await patchDiscount("alice-token", 3, { discountPercent: 50 });
+  assert.equal(res.status, 403);
+  const { rows } = await pool.query("select discount_percent from products where id = 3");
+  assert.equal(rows[0].discount_percent, 25);
+});
+
+test("discountPercent must be a whole number from 0 to 100", async () => {
+  for (const bad of [-1, 101, 10.5, "20", null, undefined]) {
+    const res = await patchDiscount("admin-token", 3, { discountPercent: bad });
+    assert.equal(res.status, 400, `expected 400 for ${JSON.stringify(bad)}`);
+    assert.equal((await res.json()).error.code, "invalid_request");
+  }
+  const { rows } = await pool.query("select discount_percent from products where id = 3");
+  assert.equal(rows[0].discount_percent, 25);
+});
+
+test("discount can be set to the 0 and 100 bounds", async () => {
+  assert.equal((await patchDiscount("admin-token", 3, { discountPercent: 100 })).status, 200);
+  assert.equal((await patchDiscount("admin-token", 3, { discountPercent: 0 })).status, 200);
+});
+
+test("PATCH on an unknown product is 404", async () => {
+  for (const id of [9999, "abc", "99999999999"]) {
+    const res = await patchDiscount("admin-token", id, { discountPercent: 10 });
+    assert.equal(res.status, 404, `expected 404 for ${id}`);
+    assert.equal((await res.json()).error.code, "not_found");
+  }
+});

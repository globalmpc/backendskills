+import { pool, tx } from "./db.ts";
+import { payments } from "./payments.ts";
+
+const MAX_LINES = 100;
+const MAX_QUANTITY = 10_000;
+const MAX_INT = 2_147_483_647; // Postgres integer
+
+class HttpError extends Error {
+  constructor(public status: number, public code: string, message: string) {
+    super(message);
+  }
+}
+
+// Validates { items: [{ productId, quantity }] } and merges lines for the same product.
+function parseOrderItems(body: unknown): Map<number, number> {
+  const items = (body as { items?: unknown } | undefined)?.items;
+  if (!Array.isArray(items) || items.length === 0) {
+    throw new HttpError(400, "invalid_body", "items must be a non-empty array");
+  }
+  if (items.length > MAX_LINES) throw new HttpError(400, "invalid_body", `At most ${MAX_LINES} items per order`);
+  const merged = new Map<number, number>();
+  for (const item of items) {
+    const { productId, quantity } = (item ?? {}) as { productId?: unknown; quantity?: unknown };
+    if (!Number.isInteger(productId) || (productId as number) < 1 || (productId as number) > MAX_INT) {
+      throw new HttpError(400, "invalid_body", "productId must be a positive integer");
+    }
+    if (!Number.isInteger(quantity) || (quantity as number) < 1 || (quantity as number) > MAX_QUANTITY) {
+      throw new HttpError(400, "invalid_body", `quantity must be an integer from 1 to ${MAX_QUANTITY}`);
+    }
+    const total = (merged.get(productId as number) ?? 0) + (quantity as number);
+    if (total > MAX_QUANTITY) throw new HttpError(400, "invalid_body", `quantity must be an integer from 1 to ${MAX_QUANTITY}`);
+    merged.set(productId as number, total);
+  }
+  return merged;
+}
+
+type OrderLine = { product_id: number; quantity: number; price_cents: number };
+
+// Puts the stock of a pending order back and marks it failed. Only acts once, from 'pending'.
+async function failOrder(orderId: number) {
+  await tx(async (c) => {
+    const { rowCount } = await c.query("update orders set status = 'failed' where id = $1 and status = 'pending'", [orderId]);
+    if (rowCount === 0) return;
+    // Lock products lowest id first, the same order placeOrder uses, so the two can't deadlock.
+    await c.query(
+      "select id from products where id in (select product_id from order_items where order_id = $1) order by id for update",
+      [orderId],
+    );
+    await c.query(
+      "update products p set stock = p.stock + oi.quantity from order_items oi where oi.order_id = $1 and p.id = oi.product_id",
+      [orderId],
+    );
+  });
+}
+
+// Reserves stock and creates a pending order in one short transaction. Returns the order id and total.
+async function reserveOrder(userId: number, wanted: Map<number, number>) {
+  const ids = [...wanted.keys()].sort((a, b) => a - b);
+  return tx(async (c) => {
+    // Lock every product row up front, lowest id first, so concurrent orders can't deadlock.
+    const { rows: products } = await c.query<{ id: number; price_cents: number; stock: number }>(
+      "select id, price_cents, stock from products where id = any($1::int[]) order by id for update",
+      [ids],
+    );
+    if (products.length !== ids.length) {
+      const found = new Set(products.map((p) => p.id));
+      throw new HttpError(404, "product_not_found", `Product ${ids.find((id) => !found.has(id))} not found`);
+    }
+    let total = 0;
+    for (const p of products) {
+      const quantity = wanted.get(p.id)!;
+      if (p.stock < quantity) throw new HttpError(409, "insufficient_stock", `Not enough stock for product ${p.id}`);
+      total += p.price_cents * quantity;
+    }
+    if (total > MAX_INT) throw new HttpError(400, "order_too_large", "Order total is too large");
+
+    const quantities = products.map((p) => wanted.get(p.id)!);
+    // The rows are locked, but keep the check in the write (and the CHECK constraint behind it).
+    const { rowCount } = await c.query(
+      `update products p set stock = p.stock - v.quantity
+       from unnest($1::int[], $2::int[]) as v(id, quantity)
+       where p.id = v.id and p.stock >= v.quantity`,
+      [ids, quantities],
+    );
+    if (rowCount !== ids.length) throw new HttpError(409, "insufficient_stock", "Not enough stock");
+
+    const { rows: [order] } = await c.query<{ id: number }>(
+      "insert into orders (user_id, status, total_cents) values ($1, 'pending', $2) returning id",
+      [userId, total],
+    );
+    await c.query(
+      `insert into order_items (order_id, product_id, quantity, price_cents)
+       select $1, v.id, v.quantity, v.price from unnest($2::int[], $3::int[], $4::int[]) as v(id, quantity, price)`,
+      [order.id, ids, quantities, products.map((p) => p.price_cents)],
+    );
+    return { orderId: order.id, total };
+  });
+}
 

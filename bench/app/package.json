{
  "name": "shop-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "db:reset": "tsx src/migrate.ts --reset",
    "migrate": "tsx src/migrate.ts",
    "test": "node --import tsx --test --test-concurrency=1 'test/**/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "5.3.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "^7.0.2"
  }
}

+const patch = (id: number, token: string, body: unknown) =>
+  fetch(`${base}/users/${id}`, {
+    method: "PATCH",
+    headers: { ...as(token), "content-type": "application/json" },
+    body: JSON.stringify(body),
+  });
+
+test("PATCH /users/:id updates own name and email, ignores other fields", async () => {
+  const res = await patch(2, "bob-token", { name: "Bobby", email: "bobby@example.com", role: "admin" });
+  assert.equal(res.status, 200);
+  assert.deepEqual(await res.json(), { id: 2, name: "Bobby", email: "bobby@example.com", role: "user" });
+});
+
+test("PATCH /users/:id rejects other users, bad input and duplicate emails", async () => {
+  assert.equal((await patch(1, "bob-token", { name: "x" })).status, 403);
+  assert.equal((await patch(2, "bob-token", {})).status, 400);
+  assert.equal((await patch(2, "bob-token", { email: "nope" })).status, 400);
+  const dup = await patch(2, "bob-token", { email: "alice@example.com" });
+  assert.equal(dup.status, 409);
+  assert.equal((await dup.json()).error.code, "email_taken");
+  assert.equal((await patch(999, "admin-token", { name: "x" })).status, 404);
+  assert.equal((await patch(3, "admin-token", { name: "Root" })).status, 200);
+});
+

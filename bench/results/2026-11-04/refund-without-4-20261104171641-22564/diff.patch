+  // Full refund of one of the caller's paid orders. The order row is locked for the duration so two
+  // concurrent requests cannot both refund it. The provider idempotency key is per order, so a retry
+  // after a failure between the provider call and the commit does not move money twice.
+  app.post("/orders/:id/refund", async (req, res) => {
+    const id = Number(req.params.id);
+    if (!Number.isInteger(id)) return sendError(res, 404, "not_found", "Order not found");
+
+    const client = await pool.connect();
+    try {
+      await client.query("begin");
+      const { rows } = await client.query(
+        "select id, status, total_cents, payment_id from orders where id = $1 and user_id = $2 for update",
+        [id, res.locals.user.id],
+      );
+      const order = rows[0];
+      if (!order) {
+        await client.query("rollback");
+        return sendError(res, 404, "not_found", "Order not found");
+      }
+      if (order.status !== "paid") {
+        await client.query("rollback");
+        return sendError(res, 409, "not_paid", `Only paid orders can be refunded; this order is ${order.status}`);
+      }
+
+      await payments.refund({
+        paymentId: order.payment_id,
+        amountCents: order.total_cents,
+        idempotencyKey: `refund-order-${order.id}`,
+      });
+      await client.query("update orders set status = 'refunded' where id = $1", [order.id]);
+      await client.query("commit");
+      res.json({ id: order.id, status: "refunded", total_cents: order.total_cents });
+    } catch (err) {
+      await client.query("rollback").catch(() => {});
+      throw err;
+    } finally {
+      client.release();
+    }
+  });

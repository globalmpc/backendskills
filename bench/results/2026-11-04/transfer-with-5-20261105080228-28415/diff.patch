+const balance = async (id: number) =>
+  (await pool.query("select balance_cents from wallets where user_id = $1", [id])).rows[0].balance_cents as number;
+const transfer = (token: string, body: unknown) =>
+  fetch(`${base}/transfers`, { method: "POST", headers: { ...as(token), "content-type": "application/json" }, body: JSON.stringify(body) });
+
+test("POST /transfers moves credit between users", async () => {
+  const [a, b] = [await balance(1), await balance(2)];
+  const res = await transfer("alice-token", { toUserId: 2, amountCents: 300 });
+  assert.equal(res.status, 201);
+  assert.equal(await balance(1), a - 300);
+  assert.equal(await balance(2), b + 300);
+});
+
+test("POST /transfers rejects bad input and overdrafts", async () => {
+  const before = [await balance(1), await balance(2)];
+  for (const body of [{}, { toUserId: 2, amountCents: 0 }, { toUserId: 2, amountCents: -5 }, { toUserId: 2, amountCents: 1.5 },
+    { toUserId: "2", amountCents: 5 }, { toUserId: 1, amountCents: 5 }]) {
+    assert.equal((await transfer("alice-token", body)).status, 400);
+  }
+  assert.equal((await transfer("alice-token", { toUserId: 999, amountCents: 5 })).status, 404);
+  const over = await transfer("alice-token", { toUserId: 2, amountCents: 99999999 });
+  assert.equal(over.status, 409);
+  assert.equal((await over.json()).error.code, "insufficient_funds");
+  assert.equal((await fetch(`${base}/transfers`, { method: "POST" })).status, 401);
+  assert.deepEqual([await balance(1), await balance(2)], before);
+});
+
+test("concurrent opposite transfers neither deadlock nor create money", async () => {
+  const total = (await balance(1)) + (await balance(2));
+  const results = await Promise.all(
+    Array.from({ length: 20 }, (_, i) =>
+      i % 2 ? transfer("alice-token", { toUserId: 2, amountCents: 100 }) : transfer("bob-token", { toUserId: 1, amountCents: 50 })),
+  );
+  for (const r of results) assert.ok([201, 409].includes(r.status), `unexpected ${r.status}`);
+  assert.equal((await balance(1)) + (await balance(2)), total);
+  assert.ok((await balance(1)) >= 0 && (await balance(2)) >= 0);
+});
+
+test("concurrent transfers can't overdraw a wallet", async () => {
+  await pool.query("update wallets set balance_cents = 1000 where user_id = 1");
+  const results = await Promise.all(Array.from({ length: 15 }, () => transfer("alice-token", { toUserId: 3, amountCents: 300 })));
+  assert.equal(results.filter((r) => r.status === 201).length, 3);
+  assert.equal(await balance(1), 100);
+});
+

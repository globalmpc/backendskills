+
+const adjust = (token: string, userId: number, body: unknown) =>
+  fetch(`${base}/wallets/${userId}/adjustments`, {
+    method: "POST",
+    headers: { ...as(token), "content-type": "application/json" },
+    body: JSON.stringify(body),
+  });
+
+test("wallet adjustments: admins only", async () => {
+  const res = await adjust("alice-token", 1, { amountCents: 100, reason: "x" });
+  assert.equal(res.status, 403);
+});
+
+test("wallet adjustments: apply, record, and refuse to go below zero", async () => {
+  const ok = await adjust("admin-token", 2, { amountCents: -300, reason: "chargeback fix" });
+  assert.equal(ok.status, 201);
+  assert.equal((await ok.json()).balanceCents, 200);
+
+  const tooMuch = await adjust("admin-token", 2, { amountCents: -201, reason: "too much" });
+  assert.equal(tooMuch.status, 409);
+
+  const { rows } = await pool.query("select balance_cents from wallets where user_id = 2");
+  assert.equal(rows[0].balance_cents, 200);
+  const log = await pool.query("select user_id, admin_id, amount_cents, reason from wallet_adjustments where user_id = 2");
+  assert.deepEqual(log.rows, [{ user_id: 2, admin_id: 3, amount_cents: -300, reason: "chargeback fix" }]);
+});
+
+test("wallet adjustments: validation and missing wallet", async () => {
+  assert.equal((await adjust("admin-token", 1, { amountCents: 1.5, reason: "x" })).status, 400);
+  assert.equal((await adjust("admin-token", 1, { amountCents: 100, reason: " " })).status, 400);
+  assert.equal((await adjust("admin-token", 999, { amountCents: 100, reason: "x" })).status, 404);
+});

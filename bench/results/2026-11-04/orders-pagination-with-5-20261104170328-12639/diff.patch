+test("/orders pages newest first, 20 per page, following nextCursor", async () => {
+  await pool.query("insert into users (email, name, api_token, password_hash) values ('carol@example.com', 'Carol', 'carol-token', 'unused')");
+  await pool.query("insert into orders (user_id, total_cents) select id, 100 from users, generate_series(1, 45) where email = 'carol@example.com'");
+  const seen: number[] = [];
+  let cursor: string | null = null;
+  const pageSizes: number[] = [];
+  do {
+    const url: string = cursor === null ? `${base}/orders` : `${base}/orders?cursor=${encodeURIComponent(cursor)}`;
+    const page: { orders: { id: number }[]; nextCursor: string | null } = await (
+      await fetch(url, { headers: as("carol-token") })
+    ).json();
+    pageSizes.push(page.orders.length);
+    seen.push(...page.orders.map((o) => o.id));
+    cursor = page.nextCursor;
+  } while (cursor !== null);
+  assert.deepEqual(pageSizes, [20, 20, 5]);
+  assert.equal(new Set(seen).size, 45);
+  assert.deepEqual(seen, [...seen].sort((a, b) => b - a));
+});
+

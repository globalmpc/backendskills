+  app.post("/wallets/:userId/adjustments", async (req, res) => {
+    const admin: User = res.locals.user;
+    if (admin.role !== "admin") return sendError(res, 403, "forbidden", "Admins only");
+
+    const INT4_MAX = 2147483647;
+    const userId = Number(req.params.userId);
+    if (!/^\d{1,10}$/.test(req.params.userId) || userId < 1 || userId > INT4_MAX) {
+      return sendError(res, 400, "invalid_user_id", "userId must be a positive integer");
+    }
+
+    const { amountCents, reason } = (req.body ?? {}) as { amountCents?: unknown; reason?: unknown };
+    if (typeof amountCents !== "number" || !Number.isSafeInteger(amountCents) || amountCents === 0 || Math.abs(amountCents) > INT4_MAX) {
+      return sendError(res, 400, "invalid_amount", "amountCents must be a non-zero integer");
+    }
+    if (typeof reason !== "string" || reason.trim().length === 0 || reason.length > 500) {
+      return sendError(res, 400, "invalid_reason", "reason must be a non-empty string of at most 500 characters");
+    }
+
+    const client = await pool.connect();
+    try {
+      await client.query("begin");
+      const { rows: users } = await client.query("select id from users where id = $1", [userId]);
+      if (users.length === 0) {
+        await client.query("rollback");
+        return sendError(res, 404, "not_found", "User not found");
+      }
+      // A user without a wallet row has a balance of 0.
+      await client.query("insert into wallets (user_id, balance_cents) values ($1, 0) on conflict do nothing", [userId]);
+      // The check is part of the write, so concurrent adjustments can't push the balance below 0.
+      const { rows } = await client.query(
+        `update wallets set balance_cents = balance_cents + $1
+         where user_id = $2 and balance_cents + $1 >= 0
+         returning balance_cents`,
+        [amountCents, userId],
+      );
+      if (rows.length === 0) {
+        await client.query("rollback");
+        return sendError(res, 409, "insufficient_balance", "Adjustment would make the balance negative");
+      }
+      const { rows: [adjustment] } = await client.query(
+        `insert into wallet_adjustments (user_id, admin_id, amount_cents, reason)
+         values ($1, $2, $3, $4) returning id, user_id, admin_id, amount_cents, reason, created_at`,
+        [userId, admin.id, amountCents, reason.trim()],
+      );
+      await client.query("commit");
+      res.status(201).json({ adjustment, balanceCents: rows[0].balance_cents });
+    } catch (err) {
+      await client.query("rollback").catch(() => {});
+      if ((err as { code?: string }).code === "22003") {
+        return sendError(res, 409, "balance_overflow", "Adjustment would overflow the balance");
+      }
+      throw err;
+    } finally {
+      client.release();
+    }
+  });
+

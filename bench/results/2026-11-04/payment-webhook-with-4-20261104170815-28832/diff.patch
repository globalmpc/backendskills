+
+// Webhooks
+
+async function newOrder(status: string) {
+  const paymentId = `pay_test_${randomUUID()}`;
+  await pool.query("insert into orders (user_id, status, total_cents, payment_id) values (2, $1, 100, $2)", [status, paymentId]);
+  return paymentId;
+}
+
+const statusOf = async (paymentId: string) =>
+  (await pool.query("select status from orders where payment_id = $1", [paymentId])).rows[0].status;
+
+// Sends the body exactly as serialised, signed over those bytes unless a signature is given.
+function sendWebhook(body: unknown, signature?: string) {
+  const raw = typeof body === "string" ? body : JSON.stringify(body);
+  const sig = signature ?? createHmac("sha256", webhookSecret).update(raw).digest("hex");
+  return fetch(`${base}/webhooks/payments`, {
+    method: "POST",
+    headers: { "content-type": "application/json", "provider-signature": sig },
+    body: raw,
+  });
+}
+
+const event = (type: string, paymentId: string) => ({ id: `evt_${randomUUID()}`, type, paymentId, created: 1762300000 });
+
+test("webhook with a wrong signature is rejected and changes nothing", async () => {
+  const paymentId = await newOrder("pending");
+  const res = await sendWebhook(event("charge.succeeded", paymentId), "00".repeat(32));
+  assert.equal(res.status, 401);
+  assert.equal(await statusOf(paymentId), "pending");
+});
+
+test("webhook with no signature is rejected", async () => {
+  const res = await fetch(`${base}/webhooks/payments`, { method: "POST", headers: { "content-type": "application/json" }, body: "{}" });
+  assert.equal(res.status, 401);
+});
+
+test("charge.succeeded marks a pending order paid", async () => {
+  const paymentId = await newOrder("pending");
+  assert.equal((await sendWebhook(event("charge.succeeded", paymentId))).status, 200);
+  assert.equal(await statusOf(paymentId), "paid");
+});
+
+test("charge.failed marks a pending order failed", async () => {
+  const paymentId = await newOrder("pending");
+  assert.equal((await sendWebhook(event("charge.failed", paymentId))).status, 200);
+  assert.equal(await statusOf(paymentId), "failed");
+});
+
+test("the same event delivered 10 times at once applies once and every delivery gets 200", async () => {
+  const paymentId = await newOrder("pending");
+  const e = event("charge.succeeded", paymentId);
+  const responses = await Promise.all(Array.from({ length: 10 }, () => sendWebhook(e)));
+  assert.deepEqual(responses.map((r) => r.status), Array(10).fill(200));
+  assert.equal(await statusOf(paymentId), "paid");
+});
+
+test("refund arriving before success is kept: a late charge.succeeded does not undo it", async () => {
+  const paymentId = await newOrder("pending");
+  assert.equal((await sendWebhook(event("charge.refunded", paymentId))).status, 200);
+  assert.equal((await sendWebhook(event("charge.succeeded", paymentId))).status, 200);
+  assert.equal(await statusOf(paymentId), "refunded");
+});
+
+test("charge.failed does not move a paid order", async () => {
+  const paymentId = await newOrder("paid");
+  assert.equal((await sendWebhook(event("charge.failed", paymentId))).status, 200);
+  assert.equal(await statusOf(paymentId), "paid");
+});
+
+test("webhook for an unknown payment gets 404 so the provider retries", async () => {
+  const res = await sendWebhook(event("charge.succeeded", `pay_unknown_${randomUUID()}`));
+  assert.equal(res.status, 404);
+});
+
+test("webhook with an invalid body gets 400 even when signed", async () => {
+  const paymentId = await newOrder("pending");
+  const bad = { ...event("charge.exploded", paymentId) };
+  assert.equal((await sendWebhook(bad)).status, 400);
+  assert.equal((await sendWebhook("not json")).status, 400);
+  assert.equal((await sendWebhook({ ...event("charge.succeeded", paymentId), created: "yesterday" })).status, 400);
+  assert.equal(await statusOf(paymentId), "pending");
+});

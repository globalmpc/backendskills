+test("/orders/:id returns the caller's order with its items", async () => {
+  const res = await fetch(`${base}/orders/1`, { headers: as("alice-token") });
+  assert.equal(res.status, 200);
+  const order = await res.json();
+  assert.equal(order.id, 1);
+  assert.equal(order.status, "paid");
+  assert.equal(order.total_cents, 4000);
+  assert.equal(order.payment_id, undefined);
+  assert.deepEqual(order.items, [{ product_id: 1, name: "T-shirt", quantity: 2, price_cents: 2000 }]);
+});
+
+test("/orders/:id returns 404 for another user's order, a missing order, or a bad id", async () => {
+  for (const id of ["3", "999", "abc", "0", "99999999999"]) {
+    const res = await fetch(`${base}/orders/${id}`, { headers: as("alice-token") });
+    assert.equal(res.status, 404, `id ${id}`);
+    assert.deepEqual(await res.json(), { error: { code: "not_found", message: "Order not found" } });
+  }
+});

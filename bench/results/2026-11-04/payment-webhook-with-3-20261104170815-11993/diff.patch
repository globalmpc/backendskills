new file mode 100644
index 0000000..4c80fb8
--- /dev/null
+++ b/migrations/002_payment_webhooks.sql
@@ -0,0 +1,11 @@
+set lock_timeout = '5s';
+
+-- Payment webhooks: one row per event we have applied. The provider's event id is the primary key,
+-- so a redelivered event is recorded once and applied once.
+create table webhook_events (
+  id text primary key,
+  type text not null check (type in ('charge.succeeded', 'charge.failed', 'charge.refunded')),
+  payment_id text not null,
+  provider_created timestamptz not null,
+  received_at timestamptz not null default now()
+);

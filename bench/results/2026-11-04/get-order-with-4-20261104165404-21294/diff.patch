+test("/orders/:id returns the caller's order with its items", async () => {
+  const res = await fetch(`${base}/orders/1`, { headers: as("alice-token") });
+  assert.equal(res.status, 200);
+  const order = await res.json();
+  assert.equal(order.id, 1);
+  assert.equal(order.status, "paid");
+  assert.equal(order.total_cents, 4000);
+  assert.deepEqual(order.items, [{ product_id: 1, quantity: 2, price_cents: 2000 }]);
+});
+
+test("/orders/:id hides another user's order behind 404", async () => {
+  const res = await fetch(`${base}/orders/3`, { headers: as("alice-token") });
+  assert.equal(res.status, 404);
+  assert.deepEqual(await res.json(), { error: { code: "not_found", message: "Order not found" } });
+});
+
+test("/orders/:id returns 404 for a missing order", async () => {
+  const res = await fetch(`${base}/orders/999999`, { headers: as("alice-token") });
+  assert.equal(res.status, 404);
+});
+
+test("/orders/:id rejects ids that are not positive integers in range with 400", async () => {
+  for (const id of ["abc", "1.5", "0", "-1", "99999999999"]) {
+    const res = await fetch(`${base}/orders/${id}`, { headers: as("alice-token") });
+    assert.equal(res.status, 400, `id ${id}`);
+    assert.equal((await res.json()).error.code, "invalid_id");
+  }
+});
+

diff --git a/src/app.ts b/src/app.ts
index c7a3c54..214fd0d 100644
--- a/src/app.ts
+++ b/src/app.ts
@@ -15,6 +15,44 @@ export function sendError(res: Response, status: number, code: string, message:
   res.status(status).json({ error: { code, message } });
 }
 
+// An expected failure with an HTTP status, thrown from inside a service function.
+class ApiError extends Error {
+  constructor(public status: number, public code: string, message: string) {
+    super(message);
+  }
+}
+
+// Moves store credit in one transaction. Both wallets are locked in id order, so two opposite
+// transfers between the same users cannot deadlock. The debit is conditional, so balances never go negative.
+async function moveStoreCredit(fromUserId: number, toUserId: number, amountCents: number) {
+  const client = await pool.connect();
+  try {
+    await client.query("begin");
+    const { rows: locked } = await client.query(
+      "select user_id from wallets where user_id = any($1::int[]) order by user_id for update",
+      [[fromUserId, toUserId]],
+    );
+    if (!locked.some((r) => r.user_id === toUserId)) throw new ApiError(404, "recipient_not_found", "Recipient not found");
+    const debit = await client.query(
+      "update wallets set balance_cents = balance_cents - $1 where user_id = $2 and balance_cents >= $1",
+      [amountCents, fromUserId],
+    );
+    if (debit.rowCount === 0) throw new ApiError(409, "insufficient_funds", "Not enough store credit");
+    await client.query("update wallets set balance_cents = balance_cents + $1 where user_id = $2", [amountCents, toUserId]);
+    const { rows: [t] } = await client.query(
+      "insert into transfers (from_user_id, to_user_id, amount_cents) values ($1, $2, $3) returning id, created_at",
+      [fromUserId, toUserId, amountCents],
+    );
+    await client.query("commit");
+    return { id: t.id, fromUserId, toUserId, amountCents, createdAt: t.created_at };
+  } catch (err) {
+    await client.query("rollback");
+    throw err;
+  } finally {
+    client.release();
+  }
+}

diff --git a/test/app.test.ts b/test/app.test.ts
index d7b2ef4..dbb9cbf 100644
--- a/test/app.test.ts
+++ b/test/app.test.ts
@@ -64,3 +64,39 @@ test("payments client records every call; the same idempotency key is charged on
   const { rows } = await pool.query("select kind, count(*)::int as n from payment_calls where created_at > now() - interval '1 minute' group by kind order by kind");
   assert.deepEqual(rows, [{ kind: "charge", n: 1 }, { kind: "refund", n: 1 }]);
 });
+
+const post = (token: string, body: unknown) =>
+  fetch(`${base}/orders`, { method: "POST", headers: { ...as(token), "content-type": "application/json" }, body: JSON.stringify(body) });
+const stockOf = async (id: number) => (await pool.query("select stock from products where id = $1", [id])).rows[0].stock;
+
+test("POST /orders charges the total, reduces stock and returns the order", async () => {
+  const res = await post("bob-token", { items: [{ productId: 1, quantity: 2 }, { productId: 2, quantity: 1 }] });
+  assert.equal(res.status, 201);
+  const order = await res.json();
+  assert.equal(order.status, "paid");
+  assert.equal(order.total_cents, 5200);
+  assert.equal(await stockOf(1), 98);
+  assert.equal(await stockOf(2), 39);
+  const { rows } = await pool.query("select amount_cents from payment_calls where payment_id = $1", [order.payment_id]);
+  assert.deepEqual(rows, [{ amount_cents: 5200 }]);
+});
+
+test("POST /orders rejects insufficient stock without charging or changing stock", async () => {
+  const before = (await pool.query("select count(*)::int as n from payment_calls")).rows[0].n;
+  const res = await post("bob-token", { items: [{ productId: 3, quantity: 6 }] });
+  assert.equal(res.status, 409);
+  assert.equal(await stockOf(3), 5);
+  assert.equal((await pool.query("select count(*)::int as n from payment_calls")).rows[0].n, before);
+});
+
+test("POST /orders validates the body", async () => {
+  assert.equal((await post("bob-token", { items: [] })).status, 400);
+  assert.equal((await post("bob-token", { items: [{ productId: 1, quantity: 0 }] })).status, 400);
+  assert.equal((await post("bob-token", { items: [{ productId: 999, quantity: 1 }] })).status, 404);
+});
+
+test("concurrent orders cannot oversell", async () => {
+  const results = await Promise.all(Array.from({ length: 8 }, () => post("alice-token", { items: [{ productId: 3, quantity: 1 }] })));
+  assert.equal(results.filter((r) => r.status === 201).length, 5);
+  assert.equal(await stockOf(3), 0);
+});

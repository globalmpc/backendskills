--- /dev/null
+++ b/migrations/002_login_attempts.sql
@@ -0,0 +1,6 @@
+-- Login rate limiting: one counter per key (account or IP), reset when its window expires.
+create table login_attempts (
+  key text primary key,
+  n integer not null check (n >= 0),
+  since timestamptz not null default now()
+);

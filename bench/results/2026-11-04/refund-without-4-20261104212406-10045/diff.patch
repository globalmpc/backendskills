+
+test("POST /orders/:id/refund refunds a paid order once", async () => {
+  const url = `${base}/orders/1/refund`;
+  const [a, b] = await Promise.all([
+    fetch(url, { method: "POST", headers: as("alice-token") }),
+    fetch(url, { method: "POST", headers: as("alice-token") }),
+  ]);
+  assert.deepEqual([a.status, b.status].sort(), [200, 409]);
+  const { rows } = await pool.query("select count(*)::int as n from payment_calls where kind = 'refund' and payment_id = 'pay_seed_1'");
+  assert.equal(rows[0].n, 1);
+  const { rows: o } = await pool.query("select status from orders where id = 1");
+  assert.equal(o[0].status, "refunded");
+  const again = await fetch(url, { method: "POST", headers: as("alice-token") });
+  assert.equal(again.status, 409);
+});
+
+test("refund is hidden from other users and unknown orders", async () => {
+  const res = await fetch(`${base}/orders/2/refund`, { method: "POST", headers: as("bob-token") });
+  assert.equal(res.status, 404);
+  const missing = await fetch(`${base}/orders/999/refund`, { method: "POST", headers: as("bob-token") });
+  assert.equal(missing.status, 404);
+});

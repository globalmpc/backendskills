+  // Full refund of one of the caller's paid orders. The idempotency key is stable per order, so a retry
+  // after a timeout or a failed status update does not move money a second time.
+  app.post("/orders/:id/refund", async (req, res) => {
+    const id = Number(req.params.id);
+    if (!Number.isInteger(id)) return sendError(res, 404, "not_found", "Order not found");
+
+    const { rows } = await pool.query(
+      "select id, status, total_cents, payment_id from orders where id = $1 and user_id = $2",
+      [id, res.locals.user.id],
+    );
+    const order = rows[0];
+    if (!order) return sendError(res, 404, "not_found", "Order not found");
+    if (order.status !== "paid" || !order.payment_id) {
+      return sendError(res, 409, "not_refundable", "Only paid orders can be refunded");
+    }
+
+    await payments.refund({
+      paymentId: order.payment_id,
+      amountCents: order.total_cents,
+      idempotencyKey: `refund:order:${order.id}`,
+    });
+
+    // Conditional on status so a concurrent request that already marked the order refunded wins cleanly.
+    const { rows: updated } = await pool.query(
+      "update orders set status = 'refunded' where id = $1 and status = 'paid' returning id, status, total_cents, created_at",
+      [id],
+    );
+    if (updated.length === 0) return sendError(res, 409, "not_refundable", "Only paid orders can be refunded");
+    res.json(updated[0]);
+  });
+

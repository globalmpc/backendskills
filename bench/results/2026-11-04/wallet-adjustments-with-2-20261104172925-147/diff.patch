+  // Admin correction to a user's store credit. Positive credits, negative debits; balance never goes below 0.
+  app.post("/wallets/:userId/adjustments", async (req, res) => {
+    if (res.locals.user.role !== "admin") return sendError(res, 403, "forbidden", "Admins only");
+
+    const userId = Number(req.params.userId);
+    if (!/^\d+$/.test(req.params.userId) || !Number.isSafeInteger(userId) || userId < 1 || userId > 2147483647) {
+      return sendError(res, 400, "invalid_user_id", "userId must be a positive integer");
+    }
+    const { amountCents, reason } = req.body ?? {};
+    if (!Number.isInteger(amountCents) || amountCents === 0 || Math.abs(amountCents) > 2147483647) {
+      return sendError(res, 400, "invalid_amount", "amountCents must be a non-zero integer");
+    }
+    if (typeof reason !== "string" || reason.trim() === "" || reason.length > 500) {
+      return sendError(res, 400, "invalid_reason", "reason must be a non-empty string of at most 500 characters");
+    }
+
+    const client = await pool.connect();
+    try {
+      await client.query("begin");
+      // Unknown user: the foreign key on wallets fails (23503), mapped to 404 below.
+      await client.query("insert into wallets (user_id, balance_cents) values ($1, 0) on conflict (user_id) do nothing", [userId]);
+      // The check and the write are one statement: a concurrent adjustment can't slip past it.
+      const { rows: [wallet] } = await client.query(
+        "update wallets set balance_cents = balance_cents + $2 where user_id = $1 and balance_cents + $2 >= 0 returning balance_cents",
+        [userId, amountCents],
+      );
+      if (!wallet) {
+        await client.query("rollback");
+        return sendError(res, 409, "insufficient_balance", "Adjustment would take the balance below 0");
+      }
+      const { rows: [adjustment] } = await client.query(
+        `insert into wallet_adjustments (user_id, admin_id, amount_cents, reason)
+         values ($1, $2, $3, $4) returning id, user_id, admin_id, amount_cents, reason, created_at`,
+        [userId, res.locals.user.id, amountCents, reason],
+      );
+      await client.query("commit");
+      res.status(201).json({ ...adjustment, balance_cents: wallet.balance_cents });
+    } catch (err) {
+      await client.query("rollback");
+      if ((err as { code?: string }).code === "23503") return sendError(res, 404, "not_found", "User not found");
+      throw err;
+    } finally {
+      client.release();
+    }
+  });
+

+test("PATCH /products/:id sets the discount (admin only, 0-100 whole numbers)", async () => {
+  const patch = (token: string, body: unknown) =>
+    fetch(`${base}/products/1`, { method: "PATCH", headers: { ...as(token), "content-type": "application/json" }, body: JSON.stringify(body) });
+  assert.equal((await patch("alice-token", { discountPercent: 10 })).status, 403);
+  for (const bad of [-1, 101, 12.5, "10", null]) {
+    assert.equal((await patch("admin-token", { discountPercent: bad })).status, 400);
+  }
+  const ok = await patch("admin-token", { discountPercent: 25 });
+  assert.equal(ok.status, 200);
+  assert.equal((await ok.json()).discount_percent, 25);
+  const missing = await fetch(`${base}/products/9999`, { method: "PATCH", headers: { ...as("admin-token"), "content-type": "application/json" }, body: JSON.stringify({ discountPercent: 5 }) });
+  assert.equal(missing.status, 404);
+});

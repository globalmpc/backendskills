diff --git a/migrations/002_payment_webhooks.sql b/migrations/002_payment_webhooks.sql
new file mode 100644
index 0000000..d56b1c6
--- /dev/null
+++ b/migrations/002_payment_webhooks.sql
@@ -0,0 +1,13 @@
+-- Webhook events already handled (providers deliver at-least-once).
+create table payment_webhook_events (
+  id text primary key,
+  type text not null,
+  payment_id text not null,
+  created bigint not null,
+  received_at timestamptz not null default now()
+);
+
+-- Provider `created` (unix seconds) of the last webhook event applied to the order,
+-- so late or out-of-order deliveries never overwrite newer state.
+alter table orders add column status_event_created bigint;
+create index orders_payment_id_idx on orders (payment_id);

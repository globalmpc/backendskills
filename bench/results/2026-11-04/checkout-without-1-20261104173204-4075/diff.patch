+          "update products set stock = stock - $2 where id = $1 and stock >= $2 returning price_cents",
+          [productId, quantity],
+        );
+        if (rows.length === 0) {
+          await client.query("rollback");
+          const { rows: exists } = await client.query("select 1 from products where id = $1", [productId]);
+          return exists.length === 0
+            ? sendError(res, 404, "product_not_found", `Product ${productId} not found`)
+            : sendError(res, 409, "insufficient_stock", `Not enough stock for product ${productId}`);
+        }
+        priced.push({ productId, quantity, priceCents: rows[0].price_cents });
+        totalCents += rows[0].price_cents * quantity;
+      }

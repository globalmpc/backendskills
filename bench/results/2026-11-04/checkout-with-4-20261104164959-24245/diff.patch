diff --git a/src/db.ts b/src/db.ts
index db79507..45716d1 100644
--- a/src/db.ts
+++ b/src/db.ts
@@ -1,5 +1,21 @@
-import pg from "pg";
+import pg, { type PoolClient } from "pg";
 
 export const databaseUrl = process.env.DATABASE_URL ?? "postgres://postgres:postgres@localhost:5433/shop";
 
 export const pool = new pg.Pool({ connectionString: databaseUrl });
+
+// Runs fn in one transaction on a single connection. Keep outside calls (payments, email) out of fn.
+export async function tx<T>(fn: (client: PoolClient) => Promise<T>): Promise<T> {
+  const client = await pool.connect();
+  try {
+    await client.query("begin");
+    const result = await fn(client);
+    await client.query("commit");
+    return result;
+  } catch (err) {
+    await client.query("rollback");
+    throw err;
+  } finally {
+    client.release();
+  }
+}

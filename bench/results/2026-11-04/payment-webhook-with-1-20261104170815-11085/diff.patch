index 0000000..67c9832
--- /dev/null
+++ b/migrations/003_orders_payment_id_index.sql
@@ -0,0 +1,3 @@
+-- Its own file: built concurrently so it does not block writes to orders (db-migration rule 2).
+-- Unique: one payment belongs to one order. Webhooks look orders up by payment_id.
+create unique index concurrently if not exists orders_payment_id_key on orders (payment_id) where payment_id is not null;

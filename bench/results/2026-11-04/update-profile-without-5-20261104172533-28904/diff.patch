+
+const patch = (token: string, id: number, body: unknown) =>
+  fetch(`${base}/users/${id}`, {
+    method: "PATCH",
+    headers: { ...as(token), "content-type": "application/json" },
+    body: JSON.stringify(body),
+  });
+
+test("PATCH /users/:id requires a token", async () => {
+  const res = await fetch(`${base}/users/2`, { method: "PATCH", headers: { "content-type": "application/json" }, body: "{}" });
+  assert.equal(res.status, 401);
+});
+
+test("PATCH /users/:id lets a user update their own name and email", async () => {
+  const res = await patch("bob-token", 2, { name: "  Robert ", email: "Robert@Example.com" });
+  assert.equal(res.status, 200);
+  assert.deepEqual(await res.json(), { id: 2, email: "robert@example.com", name: "Robert", role: "user" });
+  const me = await (await fetch(`${base}/me`, { headers: as("bob-token") })).json();
+  assert.equal(me.email, "robert@example.com");
+});
+
+test("PATCH /users/:id with a partial body changes only the given field", async () => {
+  const res = await patch("bob-token", 2, { name: "Bob" });
+  assert.equal(res.status, 200);
+  assert.equal((await res.json()).email, "robert@example.com");
+});
+
+test("PATCH /users/:id forbids a regular user from editing someone else", async () => {
+  const res = await patch("bob-token", 1, { name: "Hacked" });
+  assert.equal(res.status, 403);
+  const alice = await (await fetch(`${base}/me`, { headers: as("alice-token") })).json();
+  assert.equal(alice.name, "Alice");
+});
+
+test("PATCH /users/:id lets an admin edit another user", async () => {
+  const res = await patch("admin-token", 1, { name: "Alice B." });
+  assert.equal(res.status, 200);
+  assert.equal((await res.json()).name, "Alice B.");
+  await patch("admin-token", 1, { name: "Alice" });
+});
+
+test("PATCH /users/:id returns 409 when the email is taken", async () => {
+  const res = await patch("bob-token", 2, { email: "alice@example.com" });
+  assert.equal(res.status, 409);
+  assert.equal((await res.json()).error.code, "conflict");
+});
+
+test("PATCH /users/:id rejects role/api_token changes and bad input with 400", async () => {
+  for (const body of [{ role: "admin" }, { api_token: "x" }, { name: "" }, { email: "not-an-email" }, {}, []]) {

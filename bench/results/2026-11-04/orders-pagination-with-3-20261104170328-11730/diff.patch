+const ORDERS_PAGE_SIZE = 20;
+
+type OrderRow = { id: number; status: string; total_cents: number; created_at: Date; cursor_created_at: string };
+
+// Opaque to clients. createdAt is Postgres' text form of created_at, so microseconds survive the round trip.
+function encodeCursor(createdAt: string, id: number) {
+  return Buffer.from(JSON.stringify({ createdAt, id })).toString("base64url");
+}
+
+function decodeCursor(raw: unknown): { createdAt: string; id: number } | null {
+  if (typeof raw !== "string") return null;
+  try {
+    const c = JSON.parse(Buffer.from(raw, "base64url").toString("utf8"));
+    if (typeof c?.createdAt === "string" && Number.isSafeInteger(c?.id) && c.id > 0) {
+      return { createdAt: c.createdAt, id: c.id };
+    }
+  } catch {
+    // not base64url JSON
+  }
+  return null;
+}
+
+function isDatetimeError(err: unknown) {
+  const code = (err as { code?: string }).code;
+  return code === "22007" || code === "22008"; // invalid_datetime_format, datetime_field_overflow
+}

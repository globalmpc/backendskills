diff --git a/test/orders.test.ts b/test/orders.test.ts
new file mode 100644
index 0000000..bee3a8e
--- /dev/null
+++ b/test/orders.test.ts
@@ -0,0 +1,129 @@
+import { test, before, after } from "node:test";
+import assert from "node:assert/strict";
+import type { Server } from "node:http";
+import { resetDatabase } from "../src/migrate.ts";
+import { createApp } from "../src/app.ts";
+import { pool } from "../src/db.ts";
+
+let server: Server;
+let base: string;
+
+before(async () => {
+  await resetDatabase();
+  server = createApp().listen(0);
+  const address = server.address();
+  if (address === null || typeof address === "string") throw new Error("no port");
+  base = `http://localhost:${address.port}`;
+});
+
+after(async () => {
+  server.close();
+  await pool.end();
+});
+
+const as = (token: string) => ({ authorization: `Bearer ${token}`, "content-type": "application/json" });
+const placeOrder = (token: string, items: unknown) =>
+  fetch(`${base}/orders`, { method: "POST", headers: as(token), body: JSON.stringify({ items }) });
+const stockOf = async (name: string) =>
+  (await pool.query("select stock from products where name = $1", [name])).rows[0].stock as number;
+
+test("POST /orders requires a token", async () => {
+  const res = await fetch(`${base}/orders`, { method: "POST", headers: as("nope"), body: JSON.stringify({ items: [] }) });
+  assert.equal(res.status, 401);
+});
+
+test("POST /orders places the order: total from current prices, stock reduced, charge recorded", async () => {
+  const res = await placeOrder("alice-token", [
+    { productId: 2, quantity: 2 }, // Mug 1200
+    { productId: 1, quantity: 1 }, // T-shirt 2000
+  ]);
+  assert.equal(res.status, 201);
+  const order = await res.json();
+  assert.equal(order.status, "paid");
+  assert.equal(order.total_cents, 4400);
+  assert.deepEqual(order.items, [
+    { product_id: 2, quantity: 2, price_cents: 1200 },
+    { product_id: 1, quantity: 1, price_cents: 2000 },
+  ]);
+
+  const { rows } = await pool.query("select user_id, status, total_cents, payment_id from orders where id = $1", [order.id]);
+  assert.deepEqual(rows[0].user_id, 1);
+  assert.equal(rows[0].status, "paid");
+  assert.equal(rows[0].total_cents, 4400);
+  assert.ok(rows[0].payment_id.startsWith("pay_"));
+
+  const charges = await pool.query("select amount_cents, idempotency_key from payment_calls where payment_id = $1", [rows[0].payment_id]);
+  assert.deepEqual(charges.rows, [{ amount_cents: 4400, idempotency_key: `order-${order.id}` }]);
+
+  assert.equal(await stockOf("Mug"), 38);
+  assert.equal(await stockOf("T-shirt"), 99);
+
+  const list = await (await fetch(`${base}/orders`, { headers: as("alice-token") })).json();
+  assert.ok(list.some((o: { id: number }) => o.id === order.id));
+});
+
+test("insufficient stock is a 409 and changes nothing", async () => {
+  const ordersBefore = (await pool.query("select count(*)::int as n from orders")).rows[0].n;
+  const chargesBefore = (await pool.query("select count(*)::int as n from payment_calls")).rows[0].n;
+
+  const res = await placeOrder("alice-token", [{ productId: 3, quantity: 6 }]); // only 5 sneakers
+  assert.equal(res.status, 409);
+  assert.equal((await res.json()).error.code, "insufficient_stock");
+
+  assert.equal(await stockOf("Limited sneaker"), 5);
+  assert.equal((await pool.query("select count(*)::int as n from orders")).rows[0].n, ordersBefore);
+  assert.equal((await pool.query("select count(*)::int as n from payment_calls")).rows[0].n, chargesBefore);
+});
+
+test("if one line lacks stock, the other lines are not reduced or charged", async () => {
+  const mugBefore = await stockOf("Mug");
+  const chargesBefore = (await pool.query("select count(*)::int as n from payment_calls")).rows[0].n;
+  const res = await placeOrder("bob-token", [
+    { productId: 2, quantity: 1 },
+    { productId: 3, quantity: 9 },
+  ]);
+  assert.equal(res.status, 409);
+  assert.equal(await stockOf("Mug"), mugBefore);
+  assert.equal((await pool.query("select count(*)::int as n from payment_calls")).rows[0].n, chargesBefore);
+});
+
+test("unknown product is a 404", async () => {
+  const res = await placeOrder("alice-token", [{ productId: 999, quantity: 1 }]);
+  assert.equal(res.status, 404);
+  assert.equal((await res.json()).error.code, "product_not_found");
+});
+
+test("malformed bodies are 400", async () => {
+  const bad: unknown[] = [
+    undefined,
+    [],
+    [{ productId: 1, quantity: 0 }],
+    [{ productId: 1.5, quantity: 1 }],
+    [{ productId: "1", quantity: 1 }],
+    [{ productId: 1 }],
+    [{ productId: 1, quantity: 1 }, { productId: 1, quantity: 2 }],
+    [{ productId: 2147483648, quantity: 1 }],
+  ];
+  for (const items of bad) {
+    const res = await placeOrder("alice-token", items);
+    assert.equal(res.status, 400, JSON.stringify(items));
+    assert.equal((await res.json()).error.code, "invalid_body");
+  }
+  const noBody = await fetch(`${base}/orders`, { method: "POST", headers: as("alice-token") });
+  assert.equal(noBody.status, 400);
+});
+
+test("concurrent orders never oversell: 10 buyers for 5 sneakers gives exactly 5 orders", async () => {
+  // Seed order 2 already holds one sneaker, so count sneaker lines relative to the start.
+  const sneakerLines = async () =>
+    (await pool.query("select coalesce(sum(quantity), 0)::int as n from order_items where product_id = 3")).rows[0].n as number;
+  const sneakersBefore = await sneakerLines();
+
+  const results = await Promise.all(
+    Array.from({ length: 10 }, (_, i) => placeOrder(i % 2 ? "alice-token" : "bob-token", [{ productId: 3, quantity: 1 }])),
+  );
+  const statuses = results.map((r) => r.status).sort();
+  assert.deepEqual(statuses, [201, 201, 201, 201, 201, 409, 409, 409, 409, 409]);
+  assert.equal(await stockOf("Limited sneaker"), 0);
+  assert.equal((await sneakerLines()) - sneakersBefore, 5);
+});

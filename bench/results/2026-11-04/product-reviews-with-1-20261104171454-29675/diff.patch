diff --git a/migrations/002_reviews.sql b/migrations/002_reviews.sql
new file mode 100644
index 0000000..321308b
--- /dev/null
+++ b/migrations/002_reviews.sql
@@ -0,0 +1,10 @@
+-- One review per user per product: the primary key is the uniqueness rule, so concurrent
+-- POSTs cannot both insert. The leading product_id column also serves the per-product listing.
+create table reviews (
+  product_id integer not null references products(id),
+  user_id integer not null references users(id),
+  rating integer not null check (rating between 1 and 5),
+  body text not null,
+  created_at timestamptz not null default now(),
+  primary key (product_id, user_id)
+);

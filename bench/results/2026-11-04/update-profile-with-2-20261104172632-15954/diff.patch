diff --git a/src/app.ts b/src/app.ts
index c7a3c54..9d8e3b4 100644
--- a/src/app.ts
+++ b/src/app.ts
@@ -15,6 +15,38 @@ export function sendError(res: Response, status: number, code: string, message:
   res.status(status).json({ error: { code, message } });
 }
 
+const MAX_INT4 = 2147483647; // users.id is serial (integer)
+
+const PROFILE_FIELDS = ["name", "email"];
+
+type Profile = { name?: string; email?: string };
+
+// Accepts only name and email. Anything else (role, api_token, password_hash, ...) is rejected.
+function parseProfile(body: unknown): { ok: true; value: Profile } | { ok: false; message: string } {
+  if (typeof body !== "object" || body === null || Array.isArray(body)) {
+    return { ok: false, message: "Body must be a JSON object" };
+  }
+  const fields = body as Record<string, unknown>;
+  const unknown = Object.keys(fields).filter((k) => !PROFILE_FIELDS.includes(k));
+  if (unknown.length > 0) return { ok: false, message: `Unknown field(s): ${unknown.join(", ")}` };
+
+  const value: Profile = {};
+  if ("name" in fields) {
+    const name = typeof fields.name === "string" ? fields.name.trim() : "";
+    if (name.length === 0 || name.length > 100) return { ok: false, message: "name must be 1-100 characters" };
+    value.name = name;
+  }
+  if ("email" in fields) {
+    const email = typeof fields.email === "string" ? fields.email.trim().toLowerCase() : "";
+    if (email.length > 254 || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
+      return { ok: false, message: "email must be a valid email address" };
+    }
+    value.email = email;
+  }
+  if (Object.keys(value).length === 0) return { ok: false, message: "Provide name and/or email" };
+  return { ok: true, value };
+}

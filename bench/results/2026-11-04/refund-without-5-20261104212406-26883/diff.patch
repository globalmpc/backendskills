+  app.post("/orders/:id/refund", async (req, res) => {
+    const id = Number(req.params.id);
+    if (!Number.isInteger(id)) return sendError(res, 404, "not_found", "Order not found");
+    const user = res.locals.user;
+
+    const { rows } = await pool.query("select id, user_id, status, total_cents, payment_id from orders where id = $1", [id]);
+    const order = rows[0];
+    // Don't reveal other users' orders.
+    if (!order || (order.user_id !== user.id && user.role !== "admin")) {
+      return sendError(res, 404, "not_found", "Order not found");
+    }
+    if (order.status !== "paid" || !order.payment_id) {
+      return sendError(res, 409, "not_refundable", `Only paid orders can be refunded (status: ${order.status})`);
+    }
+
+    // The idempotency key makes concurrent or retried requests (e.g. after a crash between the provider
+    // call and the update below) move the money at most once.
+    await payments.refund({
+      paymentId: order.payment_id,
+      amountCents: order.total_cents,
+      idempotencyKey: `refund-order-${order.id}`,
+    });
+
+    const updated = await pool.query(
+      "update orders set status = 'refunded' where id = $1 and status = 'paid' returning id, status, total_cents, created_at",
+      [id],
+    );
+    if (updated.rows.length === 0) {
+      return sendError(res, 409, "not_refundable", "Order was already refunded");
+    }
+    res.json(updated.rows[0]);
+  });
+

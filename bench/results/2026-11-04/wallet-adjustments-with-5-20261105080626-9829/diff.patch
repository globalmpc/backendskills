+++ b/migrations/down/002_wallet_adjustments.sql
@@ -0,0 +1,4 @@
+alter table wallets drop constraint if exists wallets_balance_non_negative;
+drop trigger if exists wallet_adjustments_append_only on wallet_adjustments;
+drop function if exists wallet_adjustments_append_only();
+drop table if exists wallet_adjustments;

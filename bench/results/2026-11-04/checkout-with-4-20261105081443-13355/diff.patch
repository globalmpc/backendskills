new file mode 100644
index 0000000..f3be5a7
--- /dev/null
+++ b/migrations/002_order_checks.sql
@@ -0,0 +1,9 @@
+-- Last line of defence behind POST /orders: stock never goes negative, line quantities are positive,
+-- order status is one of the known values. Added NOT VALID so existing rows aren't scanned under a
+-- lock; 003 validates them.
+set lock_timeout = '5s';
+
+alter table products add constraint products_stock_nonnegative check (stock >= 0) not valid;
+alter table order_items add constraint order_items_quantity_positive check (quantity > 0) not valid;
+alter table orders add constraint orders_status_valid
+  check (status in ('pending', 'paid', 'failed', 'refunded')) not valid;

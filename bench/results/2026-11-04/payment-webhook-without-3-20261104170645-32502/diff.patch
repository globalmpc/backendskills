+
+test("payment webhooks: signed events set the order status; bad, duplicate, stale and unknown ones are handled", async () => {
+  await pool.query("insert into orders (user_id, status, total_cents, payment_id) values (1, 'pending', 999, 'pay_hook_1')");
+  const status = async () => (await pool.query("select status from orders where payment_id = 'pay_hook_1'")).rows[0].status;
+  const post = (body: string, signature = sign(body)) =>
+    fetch(`${base}/webhooks/payments`, { method: "POST", headers: { "content-type": "application/json", "provider-signature": signature }, body });
+  const event = (id: string, type: string, created: number, paymentId = "pay_hook_1") => JSON.stringify({ id, type, paymentId, created });
+
+  const badSig = await post(event("evt_bad", "charge.succeeded", 100), "00".repeat(32));
+  assert.equal(badSig.status, 401);
+  assert.equal(await status(), "pending");
+
+  const paid = await post(event("evt_1", "charge.succeeded", 100));
+  assert.equal(paid.status, 200);
+  assert.equal(await status(), "paid");
+
+  const duplicate = await post(event("evt_1", "charge.succeeded", 100));
+  assert.deepEqual(await duplicate.json(), { ok: true, duplicate: true });
+
+  assert.equal((await post(event("evt_2", "charge.refunded", 300))).status, 200);
+  assert.equal(await status(), "refunded");
+
+  const late = await post(event("evt_3", "charge.succeeded", 200));
+  assert.deepEqual(await late.json(), { ok: true, stale: true });
+  assert.equal(await status(), "refunded");
+
+  const unknownPayment = await post(event("evt_4", "charge.failed", 400, "pay_nope"));
+  assert.equal(unknownPayment.status, 404);
+  const recorded = await pool.query("select count(*)::int as n from payment_events where id in ('evt_3', 'evt_4')");
+  assert.equal(recorded.rows[0].n, 1);
+
+  assert.deepEqual(await (await post(event("evt_5", "payout.paid", 500))).json(), { ok: true, ignored: true });
+  assert.equal((await post("not json")).status, 400);
+});

diff --git a/test/wallet-adjustments.test.ts b/test/wallet-adjustments.test.ts
new file mode 100644
index 0000000..79deb72
--- /dev/null
+++ b/test/wallet-adjustments.test.ts
@@ -0,0 +1,108 @@
+import { test, before, after } from "node:test";
+import assert from "node:assert/strict";
+import type { Server } from "node:http";
+import { resetDatabase } from "../src/migrate.ts";
+import { createApp } from "../src/app.ts";
+import { pool } from "../src/db.ts";
+
+let server: Server;
+let base: string;
+
+before(async () => {
+  await resetDatabase();
+  server = createApp().listen(0);
+  const address = server.address();
+  if (address === null || typeof address === "string") throw new Error("no port");
+  base = `http://localhost:${address.port}`;
+});
+
+after(async () => {
+  server.close();
+  await pool.end();
+});
+
+const adjust = (token: string, userId: number | string, body: unknown) =>
+  fetch(`${base}/wallets/${userId}/adjustments`, {
+    method: "POST",
+    headers: { authorization: `Bearer ${token}`, "content-type": "application/json" },
+    body: JSON.stringify(body),
+  });
+
+const balance = async (userId: number) =>
+  (await pool.query("select balance_cents from wallets where user_id = $1", [userId])).rows[0]?.balance_cents;
+
+test("non-admins get 403 and the balance is unchanged", async () => {
+  const res = await adjust("alice-token", 2, { amountCents: 100, reason: "nope" });
+  assert.equal(res.status, 403);
+  assert.deepEqual(await res.json(), { error: { code: "forbidden", message: "Admins only" } });
+  assert.equal(await balance(2), 500);
+});
+
+test("admin credits a user and the adjustment is recorded with the admin", async () => {
+  const res = await adjust("admin-token", 2, { amountCents: 300, reason: "Goodwill credit" });
+  assert.equal(res.status, 201);
+  const body = await res.json();
+  assert.equal(body.balance_cents, 800);
+  assert.equal(body.user_id, 2);
+  assert.equal(body.admin_id, 3);
+  assert.equal(body.amount_cents, 300);
+  assert.equal(body.reason, "Goodwill credit");
+  assert.equal(await balance(2), 800);
+});
+
+test("admin can debit within the balance", async () => {
+  const res = await adjust("admin-token", 2, { amountCents: -800, reason: "Reverse credit" });
+  assert.equal(res.status, 201);
+  assert.equal((await res.json()).balance_cents, 0);
+  assert.equal(await balance(2), 0);
+});
+
+test("a debit larger than the balance is refused, with nothing recorded", async () => {
+  const countBefore = await pool.query("select count(*)::int as n from wallet_adjustments where user_id = 2");
+  const res = await adjust("admin-token", 2, { amountCents: -1, reason: "Too much" });
+  assert.equal(res.status, 409);
+  assert.equal((await res.json()).error.code, "insufficient_balance");
+  assert.equal(await balance(2), 0);
+  const countAfter = await pool.query("select count(*)::int as n from wallet_adjustments where user_id = 2");
+  assert.equal(countAfter.rows[0].n, countBefore.rows[0].n);
+});
+
+test("bad input is a 400 and never a 500", async () => {
+  const cases: [unknown, string][] = [
+    [{ amountCents: 0, reason: "x" }, "invalid_amount"],
+    [{ amountCents: 1.5, reason: "x" }, "invalid_amount"],
+    [{ amountCents: "5", reason: "x" }, "invalid_amount"],
+    [{ reason: "x" }, "invalid_amount"],
+    [{ amountCents: 2147483648, reason: "x" }, "invalid_amount"],
+    [{ amountCents: 100 }, "invalid_reason"],
+    [{ amountCents: 100, reason: "   " }, "invalid_reason"],
+    [{ amountCents: 100, reason: "x".repeat(501) }, "invalid_reason"],
+  ];
+  for (const [body, code] of cases) {
+    const res = await adjust("admin-token", 2, body);
+    assert.equal(res.status, 400, JSON.stringify(body));
+    assert.equal((await res.json()).error.code, code);
+  }
+  const badId = await adjust("admin-token", "abc", { amountCents: 1, reason: "x" });
+  assert.equal(badId.status, 400);
+  assert.equal(await balance(2), 0);
+});
+
+test("an unknown user is a 404 and nothing is recorded", async () => {
+  const res = await adjust("admin-token", 9999, { amountCents: 100, reason: "x" });
+  assert.equal(res.status, 404);
+  assert.equal((await res.json()).error.code, "not_found");
+  const { rows } = await pool.query("select count(*)::int as n from wallet_adjustments where user_id = 9999");
+  assert.equal(rows[0].n, 0);
+});
+
+test("parallel debits never overdraw: exactly what the balance covers succeeds", async () => {
+  // Alice starts with 10000. Ten concurrent debits of 3000: only three can succeed.
+  const results = await Promise.all(Array.from({ length: 10 }, () => adjust("admin-token", 1, { amountCents: -3000, reason: "Race" })));
+  const statuses = results.map((r) => r.status);
+  assert.equal(statuses.filter((s) => s === 201).length, 3);
+  assert.equal(statuses.filter((s) => s === 409).length, 7);
+  assert.equal(await balance(1), 1000);
+  const { rows } = await pool.query("select count(*)::int as n from wallet_adjustments where user_id = 1 and reason = 'Race'");
+  assert.equal(rows[0].n, 3);
+});

+++ b/migrations/002_payment_webhooks.sql
@@ -0,0 +1,16 @@
+-- Payment webhooks (POST /webhooks/payments). Expand-only: old servers ignore both additions.
+
+-- Created time (provider clock) of the last event applied to this order. Used to ignore events that
+-- arrive late and would move the order back to an earlier state.
+alter table orders add column payment_event_at timestamptz;
+
+-- Every provider event we have applied, so a redelivered event is handled once.
+create table payment_webhook_events (
+  id text primary key, -- provider event id, e.g. evt_123
+  type text not null,
+  payment_id text not null,
+  created_at timestamptz not null,
+  received_at timestamptz not null default now()
+);
+
+comment on column orders.status is 'pending | paid | failed | refunded';
diff --git a/migrations/003_orders_payment_id_index.sql b/migrations/003_orders_payment_id_index.sql

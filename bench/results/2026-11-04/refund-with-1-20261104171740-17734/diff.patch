diff --git a/test/app.test.ts b/test/app.test.ts
index d7b2ef4..4b8c236 100644
--- a/test/app.test.ts
+++ b/test/app.test.ts
@@ -64,3 +64,45 @@ test("payments client records every call; the same idempotency key is charged on
   const { rows } = await pool.query("select kind, count(*)::int as n from payment_calls where created_at > now() - interval '1 minute' group by kind order by kind");
   assert.deepEqual(rows, [{ kind: "charge", n: 1 }, { kind: "refund", n: 1 }]);
 });
+
+const refund = (token: string, id: string | number) => fetch(`${base}/orders/${id}/refund`, { method: "POST", headers: as(token) });
+
+test("refund: someone else's order is 404 and nothing is refunded", async () => {
+  const res = await refund("bob-token", 1);
+  assert.equal(res.status, 404);
+  assert.deepEqual(await res.json(), { error: { code: "not_found", message: "Order not found" } });
+  const { rows: [order] } = await pool.query("select status from orders where id = 1");
+  assert.equal(order.status, "paid");
+});
+
+test("refund: a bad order id is 400", async () => {
+  assert.equal((await refund("alice-token", "abc")).status, 400);
+  assert.equal((await refund("alice-token", "0")).status, 400);
+});
+
+test("refund: an order that is not paid is 409 and the provider is not called", async () => {
+  const { rows: [pending] } = await pool.query("insert into orders (user_id, status, total_cents) values (1, 'pending', 100) returning id");
+  const res = await refund("alice-token", pending.id);
+  assert.equal(res.status, 409);
+  assert.equal((await res.json()).error.code, "not_paid");
+  const { rows } = await pool.query("select count(*)::int as n from payment_calls where kind = 'refund' and payment_id = 'pay_seed_2'");
+  assert.equal(rows[0].n, 0);
+});
+
+test("refund: parallel requests refund a paid order in full exactly once", async () => {
+  const responses = await Promise.all(Array.from({ length: 10 }, () => refund("alice-token", 2)));
+  const statuses = responses.map((r) => r.status).sort();
+  assert.ok(statuses.every((s) => s === 200 || s === 409), `unexpected statuses ${statuses}`);
+  assert.ok(statuses.includes(200));
+  const { rows: [order] } = await pool.query("select status from orders where id = 2");
+  assert.equal(order.status, "refunded");
+  const { rows } = await pool.query("select amount_cents from payment_calls where kind = 'refund' and payment_id = 'pay_seed_2'");
+  assert.deepEqual(rows, [{ amount_cents: 15000 }]);
+});
+
+test("refund: a refunded order cannot be refunded again", async () => {
+  const res = await refund("alice-token", 2);
+  assert.equal(res.status, 409);
+  const { rows } = await pool.query("select count(*)::int as n from payment_calls where kind = 'refund' and payment_id = 'pay_seed_2'");
+  assert.equal(rows[0].n, 1);
+});

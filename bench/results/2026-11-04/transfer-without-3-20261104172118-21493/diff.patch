+  // Moves store credit from the caller to another user. The debit, the credit and the
+  // balance check happen in one transaction, so a failed transfer leaves both wallets unchanged.
+  app.post("/transfers", async (req, res) => {
+    const { toUserId, amountCents } = req.body ?? {};
+    if (!Number.isSafeInteger(toUserId) || toUserId <= 0) {
+      return sendError(res, 400, "invalid_request", "toUserId must be a positive integer");
+    }
+    if (!Number.isSafeInteger(amountCents) || amountCents <= 0) {
+      return sendError(res, 400, "invalid_request", "amountCents must be a positive integer");
+    }
+    const fromUserId: number = res.locals.user.id;
+    if (toUserId === fromUserId) {
+      return sendError(res, 400, "invalid_request", "Cannot transfer to yourself");
+    }
+
+    const client = await pool.connect();
+    try {
+      await client.query("begin");
+      const { rows: recipient } = await client.query("select id from users where id = $1", [toUserId]);
+      if (recipient.length === 0) {
+        await client.query("rollback");
+        return sendError(res, 404, "recipient_not_found", "Recipient not found");
+      }
+      await client.query(
+        "insert into wallets (user_id, balance_cents) values ($1, 0) on conflict (user_id) do nothing",
+        [toUserId],
+      );
+      // Lock both wallets in id order so opposite-direction transfers cannot deadlock.
+      await client.query(
+        "select user_id from wallets where user_id = any($1::int[]) order by user_id for update",
+        [[fromUserId, toUserId].sort((a, b) => a - b)],
+      );
+      // Conditional debit: no row updated means the sender has no wallet or not enough credit.
+      const debit = await client.query(
+        "update wallets set balance_cents = balance_cents - $2 where user_id = $1 and balance_cents >= $2 returning balance_cents",
+        [fromUserId, amountCents],
+      );
+      if (debit.rowCount === 0) {
+        await client.query("rollback");
+        return sendError(res, 409, "insufficient_funds", "Not enough store credit");
+      }
+      await client.query("update wallets set balance_cents = balance_cents + $2 where user_id = $1", [toUserId, amountCents]);
+      await client.query("commit");
+      res.status(201).json({
+        fromUserId,
+        toUserId,
+        amountCents,
+        balanceCents: debit.rows[0].balance_cents,
+      });
+    } catch (err) {
+      await client.query("rollback").catch(() => {});
+      throw err;
+    } finally {
+      client.release();
+    }
+  });
+

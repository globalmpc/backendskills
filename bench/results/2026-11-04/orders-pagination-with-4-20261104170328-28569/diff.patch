+test("/orders pages newest first, 20 per page, following nextCursor", async () => {
+  await pool.query(
+    "insert into orders (user_id, status, total_cents, created_at) select 1, 'paid', 100, now() - (g || ' minutes')::interval from generate_series(1, 45) g",
+  );
+  const expected = (await pool.query("select id from orders where user_id = 1 order by created_at desc, id desc")).rows.map((r) => r.id);
+  assert.equal(expected.length, 47);
+
+  const fetchPage = async (cursor: string | null): Promise<{ orders: { id: number }[]; nextCursor: string | null }> => {
+    const res = await fetch(`${base}/orders${cursor ? `?cursor=${encodeURIComponent(cursor)}` : ""}`, { headers: as("alice-token") });
+    assert.equal(res.status, 200);
+    return res.json();
+  };
+  const ids: number[] = [];
+  const pageSizes: number[] = [];
+  let cursor: string | null = null;
+  do {
+    const page = await fetchPage(cursor);
+    pageSizes.push(page.orders.length);
+    ids.push(...page.orders.map((o) => o.id));
+    cursor = page.nextCursor;
+  } while (cursor !== null);
+
+  assert.deepEqual(pageSizes, [20, 20, 7]);
+  assert.deepEqual(ids, expected);
+});
+
+test("/orders rejects a cursor that is malformed or names someone else's order", async () => {
+  const bobOrder = (await pool.query("select id from orders where user_id = 2 limit 1")).rows[0].id;
+  const bobCursor = Buffer.from(String(bobOrder)).toString("base64url");
+  for (const cursor of ["not-a-cursor!", Buffer.from("0").toString("base64url"), Buffer.from("99999999999").toString("base64url"), bobCursor]) {
+    const res = await fetch(`${base}/orders?cursor=${encodeURIComponent(cursor)}`, { headers: as("alice-token") });
+    assert.equal(res.status, 400, `cursor ${cursor}`);
+    assert.deepEqual(await res.json(), { error: { code: "invalid_cursor", message: "Invalid cursor" } });
+  }
 });
 

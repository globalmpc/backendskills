diff --git a/migrations/002_orders_amount_cents.sql b/migrations/002_orders_amount_cents.sql
new file mode 100644
index 0000000..a5400a8
--- /dev/null
+++ b/migrations/002_orders_amount_cents.sql
@@ -0,0 +1,25 @@
+-- Rename orders.total_cents to amount_cents, step 1 of 2 (expand).
+-- total_cents is kept, and a trigger keeps both columns equal, so the previous app version
+-- (which still reads and writes total_cents) keeps working during the rolling deploy.
+-- Migration 003 (a later deploy) drops total_cents, once nothing reads it.
+set lock_timeout = '5s';
+
+alter table orders add column amount_cents integer;
+
+-- Trigger first, so rows written while the backfill runs are covered too.
+create function orders_sync_amount() returns trigger language plpgsql as $$
+begin
+  if tg_op = 'UPDATE' and new.total_cents is distinct from old.total_cents then
+    new.amount_cents := new.total_cents; -- a writer that still uses total_cents
+  end if;
+  new.amount_cents := coalesce(new.amount_cents, new.total_cents);
+  new.total_cents := new.amount_cents;
+  return new;
+end $$;
+
+create trigger orders_sync_amount before insert or update on orders
+  for each row execute function orders_sync_amount();
+
+update orders set amount_cents = total_cents where amount_cents is null;
+
+alter table orders alter column amount_cents set not null;
diff --git a/migrations/down/002_orders_amount_cents.sql b/migrations/down/002_orders_amount_cents.sql

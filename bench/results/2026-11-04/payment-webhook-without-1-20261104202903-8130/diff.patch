@@ -1,5 +1,13 @@
 import express, { type NextFunction, type Request, type Response } from "express";
+import { createHmac, timingSafeEqual } from "node:crypto";
 import { pool } from "./db.ts";
+import { webhookSecret } from "./payments.ts";
+
+const WEBHOOK_STATUS: Record<string, string> = {
+  "charge.succeeded": "paid",
+  "charge.failed": "failed",
+  "charge.refunded": "refunded",
+};
 
 export type User = { id: number; email: string; name: string; role: string };
 
@@ -27,6 +35,61 @@ async function auth(req: Request, res: Response, next: NextFunction) {
 
 export function createApp() {
   const app = express();
+  // Webhooks are authenticated by signature (not bearer token) and need the raw body to verify it.
+  app.post("/webhooks/payments", express.raw({ type: () => true, limit: "100kb" }), async (req: Request, res: Response) => {
+    const raw: Buffer = Buffer.isBuffer(req.body) ? req.body : Buffer.alloc(0);
+    const expected = createHmac("sha256", webhookSecret).update(raw).digest();
+    const given = Buffer.from(req.get("provider-signature") ?? "", "hex");
+    if (given.length !== expected.length || !timingSafeEqual(given, expected)) {
+      return sendError(res, 401, "invalid_signature", "Invalid webhook signature");
+    }
+
+    let event: Record<string, unknown>;
+    try {
+      event = JSON.parse(raw.toString("utf8"));
+    } catch {
+      return sendError(res, 400, "invalid_body", "Body must be JSON");
+    }
+    const { id, type, paymentId, created } = event ?? {};
+    if (typeof id !== "string" || typeof type !== "string" || typeof paymentId !== "string" || !Number.isInteger(created)) {
+      return sendError(res, 400, "invalid_body", "Expected id, type, paymentId and integer created");
+    }
+    const status = WEBHOOK_STATUS[type];
+    if (!status) return res.json({ ok: true, ignored: true }); // unknown event type: acknowledge
+
+    const client = await pool.connect();
+    try {
+      await client.query("begin");
+      const order = await client.query("select id from orders where payment_id = $1 for update", [paymentId]);
+      if (order.rowCount === 0) {
+        await client.query("rollback");
+        // Not recorded, so the provider's retry can succeed once the order has its payment id.
+        return sendError(res, 404, "unknown_payment", "No order for this payment");
+      }
+      const fresh = await client.query(
+        "insert into payment_webhook_events (id, type, payment_id, created) values ($1, $2, $3, $4) on conflict (id) do nothing",
+        [id, type, paymentId, created],
+      );
+      if (fresh.rowCount === 0) {
+        await client.query("rollback");
+        return res.json({ ok: true, duplicate: true });
+      }
+      // Only apply if this event is not older than the last one applied to the order.
+      await client.query(
+        `update orders set status = $2, status_event_created = $3
+         where payment_id = $1 and (status_event_created is null or status_event_created <= $3)`,
+        [paymentId, status, created],
+      );
+      await client.query("commit");
+      res.json({ ok: true });
+    } catch (err) {
+      await client.query("rollback").catch(() => {});
+      throw err;
+    } finally {
+      client.release();
+    }
+  });
+
   app.use(express.json());
 
   app.get("/health", (_req, res) => {

+test("/orders paginates newest first, 20 per page, without gaps or repeats", async () => {
+  const { rows: [u] } = await pool.query(
+    "insert into users (email, name, api_token, password_hash) values ('many@example.com', 'Many', 'many-token', 'x') returning id",
+  );
+  // 45 orders; several share a timestamp to exercise the id tiebreak
+  await pool.query(
+    `insert into orders (user_id, total_cents, created_at)
+     select $1, 100, '2026-01-01'::timestamptz + (n / 3) * interval '1 minute' from generate_series(1, 45) n`,
+    [u.id],
+  );
+  const ids: number[] = [];
+  const sizes: number[] = [];
+  let cursor: string | null = null;
+  do {
+    const url = `${base}/orders${cursor ? `?cursor=${encodeURIComponent(cursor)}` : ""}`;
+    const body = await (await fetch(url, { headers: as("many-token") })).json();
+    sizes.push(body.orders.length);
+    ids.push(...body.orders.map((o: { id: number }) => o.id));
+    cursor = body.nextCursor;
+  } while (cursor);
+  assert.deepEqual(sizes, [20, 20, 5]);
+  assert.equal(new Set(ids).size, 45);
+  assert.deepEqual(ids, [...ids].sort((a, b) => b - a));
+});
+
+test("/orders exact page multiple has no trailing cursor", async () => {

+  app.post("/login", async (req, res) => {
+    const { email, password } = req.body ?? {};
+    if (typeof email !== "string" || typeof password !== "string" || email === "" || password === "") {
+      return sendError(res, 400, "invalid_request", "email and password are required strings");
+    }
+    if (password.length > MAX_PASSWORD_LENGTH || email.length > 320) {
+      return sendError(res, 400, "invalid_request", "email or password is too long");
+    }
+
+    const byEmail = await countAttempt(`login:${email.toLowerCase()}`);
+    const byIp = await countAttempt(`login-ip:${req.ip ?? "unknown"}`);
+    if (byEmail > LOGIN_MAX_PER_EMAIL || byIp > LOGIN_MAX_PER_IP) {
+      return sendError(res, 429, "too_many_attempts", "Too many attempts, try again later");
+    }
+
+    const { rows } = await pool.query("select api_token, password_hash from users where email = $1", [email]);
+    let ok = false;
+    try {
+      ok = await verifyPassword(password, rows[0]?.password_hash ?? (await dummyHash));
+    } catch {
+      ok = false;
+    }
+    if (!ok || rows.length === 0) {
+      return sendError(res, 401, "invalid_credentials", "Invalid email or password");
+    }
+    res.json({ token: rows[0].api_token });
+  });
+
   app.use(auth);
 

diff --git a/migrations/002_wallet_adjustments.sql b/migrations/002_wallet_adjustments.sql
new file mode 100644
index 0000000..193ed64
--- /dev/null
+++ b/migrations/002_wallet_adjustments.sql
@@ -0,0 +1,15 @@
+-- Admin corrections to store credit. Each row is written in the same transaction as the balance change.
+create table wallet_adjustments (
+  id serial primary key,
+  user_id integer not null references users(id),
+  admin_id integer not null references users(id),
+  amount_cents integer not null check (amount_cents <> 0),
+  reason text not null check (length(trim(reason)) > 0),
+  created_at timestamptz not null default now()
+);
+
+create index wallet_adjustments_user_id_idx on wallet_adjustments (user_id);
+
+-- Last line of defence for "balance can't go below 0". Added not valid, then validated, so existing rows are checked without blocking writes for long.
+alter table wallets add constraint wallets_balance_non_negative check (balance_cents >= 0) not valid;
+alter table wallets validate constraint wallets_balance_non_negative;

diff --git a/src/db.ts b/src/db.ts
index db79507..0cc4b95 100644
--- a/src/db.ts
+++ b/src/db.ts
@@ -3,3 +3,20 @@ import pg from "pg";
 export const databaseUrl = process.env.DATABASE_URL ?? "postgres://postgres:postgres@localhost:5433/shop";
 
 export const pool = new pg.Pool({ connectionString: databaseUrl });
+
+// Runs fn in one transaction on a single connection. Commits if fn resolves, rolls back if it throws.
+// Don't call outside services (payments, email) inside fn: the locks stay held while they run.
+export async function withTransaction<T>(fn: (client: pg.PoolClient) => Promise<T>): Promise<T> {
+  const client = await pool.connect();
+  try {
+    await client.query("begin");
+    const result = await fn(client);
+    await client.query("commit");
+    return result;
+  } catch (err) {
+    await client.query("rollback");
+    throw err;
+  } finally {
+    client.release();
+  }
+}
diff --git a/test/orders.test.ts b/test/orders.test.ts
new file mode 100644
index 0000000..a7cbbcb
--- /dev/null
+++ b/test/orders.test.ts
@@ -0,0 +1,113 @@
+import { test, before, after } from "node:test";
+import assert from "node:assert/strict";
+import type { Server } from "node:http";
+import { resetDatabase } from "../src/migrate.ts";
+import { createApp } from "../src/app.ts";
+import { pool } from "../src/db.ts";
+import { payments } from "../src/payments.ts";
+
+let server: Server;
+let base: string;
+
+before(async () => {
+  await resetDatabase();
+  server = createApp().listen(0);
+  const address = server.address();
+  if (address === null || typeof address === "string") throw new Error("no port");
+  base = `http://localhost:${address.port}`;
+});
+
+after(async () => {
+  server.close();
+  await pool.end();
+});
+
+const as = (token: string) => ({ authorization: `Bearer ${token}`, "content-type": "application/json" });
+
+const placeOrder = (token: string, body: unknown, raw?: string) =>
+  fetch(`${base}/orders`, { method: "POST", headers: as(token), body: raw ?? JSON.stringify(body) });
+
+const stockOf = async (productId: number) =>
+  (await pool.query("select stock from products where id = $1", [productId])).rows[0].stock as number;
+
+const ordersOf = async (userId: number) =>
+  (await pool.query("select count(*)::int as n from orders where user_id = $1", [userId])).rows[0].n as number;
+
+test("places an order: merges duplicate lines, takes stock, charges the total, returns the order", async () => {
+  const stockBefore = { tshirt: await stockOf(1), mug: await stockOf(2) };
+  const res = await placeOrder("alice-token", { items: [{ productId: 1, quantity: 1 }, { productId: 1, quantity: 1 }, { productId: 2, quantity: 1 }] });
+  assert.equal(res.status, 201);
+  const order = await res.json();
+  assert.equal(order.status, "paid");
+  assert.equal(order.total_cents, 2000 * 2 + 1200);
+  assert.deepEqual(
+    order.items.map((i: { product_id: number; quantity: number }) => [i.product_id, i.quantity]),
+    [[1, 2], [2, 1]],
+  );
+  assert.equal(await stockOf(1), stockBefore.tshirt - 2);
+  assert.equal(await stockOf(2), stockBefore.mug - 1);
+
+  const { rows } = await pool.query("select status, payment_id from orders where id = $1", [order.id]);
+  assert.equal(rows[0].status, "paid");
+  assert.match(rows[0].payment_id, /^pay_/);
+});
+
+test("insufficient stock is a 409 and changes nothing", async () => {
+  const stockBefore = await stockOf(3);
+  const ordersBefore = await ordersOf(1);
+  const res = await placeOrder("alice-token", { items: [{ productId: 3, quantity: stockBefore + 1 }] });
+  assert.equal(res.status, 409);
+  assert.equal((await res.json()).error.code, "insufficient_stock");
+  assert.equal(await stockOf(3), stockBefore);
+  assert.equal(await ordersOf(1), ordersBefore);
+});
+
+test("bad input is a 4xx, never a 500", async () => {
+  const cases: [string, unknown, string | undefined][] = [
+    ["empty items", { items: [] }, undefined],
+    ["missing items", {}, undefined],
+    ["quantity zero", { items: [{ productId: 1, quantity: 0 }] }, undefined],
+    ["fractional quantity", { items: [{ productId: 1, quantity: 1.5 }] }, undefined],
+    ["string productId", { items: [{ productId: "1", quantity: 1 }] }, undefined],
+    ["productId out of range", { items: [{ productId: 1e20, quantity: 1 }] }, undefined],
+    ["unknown product", { items: [{ productId: 9999, quantity: 1 }] }, undefined],
+    ["malformed JSON", undefined, "{not json"],
+  ];
+  for (const [name, body, raw] of cases) {
+    const res = await placeOrder("alice-token", body, raw);
+    assert.ok(res.status >= 400 && res.status < 500, `${name}: got ${res.status}`);
+    assert.ok((await res.json()).error?.code, `${name}: missing error code`);
+  }
+});
+
+test("a failed payment gives the stock back and marks the order failed", async () => {
+  const stockBefore = await stockOf(1);
+  const ordersBefore = await ordersOf(1);
+  const original = payments.charge;
+  payments.charge = async () => {
+    throw new Error("provider down");
+  };
+  try {
+    const res = await placeOrder("alice-token", { items: [{ productId: 1, quantity: 3 }] });
+    assert.equal(res.status, 502);
+    assert.equal((await res.json()).error.code, "payment_failed");
+  } finally {
+    payments.charge = original;
+  }
+  assert.equal(await stockOf(1), stockBefore);
+  assert.equal(await ordersOf(1), ordersBefore + 1);
+  const { rows } = await pool.query("select status from orders where user_id = 1 order by id desc limit 1");
+  assert.equal(rows[0].status, "failed");
+});
+
+test("parallel orders never oversell: exactly the available stock is sold", async () => {
+  const available = await stockOf(3);
+  assert.equal(available, 5);
+  const results = await Promise.all(
+    Array.from({ length: 10 }, (_, i) => placeOrder(i % 2 ? "bob-token" : "alice-token", { items: [{ productId: 3, quantity: 1 }] })),
+  );
+  const statuses = results.map((r) => r.status).sort();
+  assert.equal(statuses.filter((s) => s === 201).length, available);
+  assert.equal(statuses.filter((s) => s === 409).length, 10 - available);
+  assert.equal(await stockOf(3), 0);
+});

+
+const hook = (event: object, signature?: string) => {
+  const body = JSON.stringify(event);
+  return fetch(`${base}/webhooks/payments`, {
+    method: "POST",
+    headers: {
+      "content-type": "application/json",
+      "provider-signature": signature ?? createHmac("sha256", webhookSecret).update(body).digest("hex"),
+    },
+    body,
+  });
+};
+const orderStatus = async (id: number) => (await pool.query("select status from orders where id = $1", [id])).rows[0].status;
+
+test("webhook rejects bad signatures", async () => {
+  const res = await hook({ id: "evt_bad", type: "charge.failed", paymentId: "pay_seed_1", created: 1 }, "00");
+  assert.equal(res.status, 401);
+  assert.equal(await orderStatus(1), "paid");
+});
+
+test("webhook updates status, ignores duplicates and stale events", async () => {
+  const e = { id: "evt_1", type: "charge.refunded", paymentId: "pay_seed_3", created: 2000 };
+  assert.equal((await hook(e)).status, 200);
+  assert.equal(await orderStatus(3), "refunded");
+  assert.equal((await hook({ id: "evt_0", type: "charge.succeeded", paymentId: "pay_seed_3", created: 1000 })).status, 200);
+  assert.equal(await orderStatus(3), "refunded");
+  assert.deepEqual(await (await hook(e)).json(), { ok: true, duplicate: true });
+  assert.equal((await hook({ id: "evt_x", type: "charge.failed", paymentId: "nope", created: 1 })).status, 404);
+});

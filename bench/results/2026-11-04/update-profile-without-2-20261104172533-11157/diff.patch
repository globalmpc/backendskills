+
+const patch = (token: string, id: number | string, body: unknown) =>
+  fetch(`${base}/users/${id}`, {
+    method: "PATCH",
+    headers: { ...as(token), "content-type": "application/json" },
+    body: JSON.stringify(body),
+  });
+
+test("PATCH /users/:id lets a user update their own name and email", async () => {
+  const res = await patch("bob-token", 2, { name: "  Robert ", email: "robert@example.com" });
+  assert.equal(res.status, 200);
+  assert.deepEqual(await res.json(), { id: 2, name: "Robert", email: "robert@example.com", role: "user" });
+  const restored = await patch("bob-token", 2, { name: "Bob", email: "bob@example.com" });
+  assert.equal(restored.status, 200);
+});
+
+test("PATCH /users/:id forbids updating another user unless admin", async () => {
+  const res = await patch("bob-token", 1, { name: "Mallory" });
+  assert.equal(res.status, 403);
+  assert.equal((await res.json()).error.code, "forbidden");
+  const { rows } = await pool.query("select name from users where id = 1");
+  assert.equal(rows[0].name, "Alice");
+});
+
+test("PATCH /users/:id lets an admin update another user", async () => {
+  const res = await patch("admin-token", 2, { name: "Bobby" });
+  assert.equal(res.status, 200);
+  assert.equal((await res.json()).name, "Bobby");
+  await patch("admin-token", 2, { name: "Bob" });
+});
+
+test("PATCH /users/:id rejects role, token and password changes", async () => {
+  const res = await patch("alice-token", 1, { role: "admin" });
+  assert.equal(res.status, 400);
+  const { rows } = await pool.query("select role from users where id = 1");
+  assert.equal(rows[0].role, "user");
+});
+
+test("PATCH /users/:id validates input and rejects duplicate emails", async () => {
+  assert.equal((await patch("alice-token", 1, {})).status, 400);
+  assert.equal((await patch("alice-token", 1, { name: "   " })).status, 400);
+  assert.equal((await patch("alice-token", 1, { email: "not-an-email" })).status, 400);
+  const dup = await patch("alice-token", 1, { email: "bob@example.com" });
+  assert.equal(dup.status, 409);
+  assert.equal((await dup.json()).error.code, "email_taken");
+  assert.equal((await patch("alice-token", 1, { email: "alice@example.com" })).status, 200);
+});
+
+test("PATCH /users/:id returns 404 for an unknown user and requires auth", async () => {
+  assert.equal((await patch("admin-token", 9999, { name: "Ghost" })).status, 404);
+  const anon = await fetch(`${base}/users/1`, { method: "PATCH", headers: { "content-type": "application/json" }, body: "{}" });
+  assert.equal(anon.status, 401);
+});

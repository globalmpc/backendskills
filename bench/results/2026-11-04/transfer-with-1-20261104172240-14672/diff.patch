diff --git a/migrations/002_wallet_transfers.sql b/migrations/002_wallet_transfers.sql
new file mode 100644
index 0000000..8aba80f
--- /dev/null
+++ b/migrations/002_wallet_transfers.sql
@@ -0,0 +1,17 @@
+-- Store-credit transfers between users. Each row is written in the same transaction that moves the money.
+create table transfers (
+  id serial primary key,
+  from_user_id integer not null references users(id),
+  to_user_id integer not null references users(id),
+  amount_cents integer not null check (amount_cents > 0),
+  created_at timestamptz not null default now(),
+  check (from_user_id <> to_user_id)
+);
+
+-- Last line of defence against overdrawing a wallet. Added NOT VALID so the check does not scan
+-- the table while holding a lock; the VALIDATE below scans without blocking reads or writes.
+begin;
+set local lock_timeout = '5s';
+alter table wallets add constraint wallets_balance_nonnegative check (balance_cents >= 0) not valid;
+alter table wallets validate constraint wallets_balance_nonnegative;
+commit;

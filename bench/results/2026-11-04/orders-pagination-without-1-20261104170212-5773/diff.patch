+test("/orders paginates newest first, 20 per page, following nextCursor", async () => {
+  // Bob gets 25 more orders, so he has 26 in total: a full page of 20, then 6.
+  await pool.query(
+    "insert into orders (user_id, status, total_cents, created_at) select 2, 'paid', 100, now() - (g || ' minutes')::interval from generate_series(1, 25) g",
+  );
+  const all = (await pool.query("select id from orders where user_id = 2 order by created_at desc, id desc")).rows.map((r) => r.id);
+
+  const first = await (await fetch(`${base}/orders`, { headers: as("bob-token") })).json();
+  assert.equal(first.orders.length, 20);
+  assert.notEqual(first.nextCursor, null);
+  assert.deepEqual(first.orders.map((o: { id: number }) => o.id), all.slice(0, 20));
+
+  const second = await (await fetch(`${base}/orders?cursor=${encodeURIComponent(first.nextCursor)}`, { headers: as("bob-token") })).json();
+  assert.deepEqual(second.orders.map((o: { id: number }) => o.id), all.slice(20));
+  assert.equal(second.nextCursor, null);
+});

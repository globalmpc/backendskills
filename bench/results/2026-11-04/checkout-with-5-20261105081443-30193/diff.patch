 import express, { type NextFunction, type Request, type Response } from "express";
+import type { PoolClient } from "pg";
 import { pool } from "./db.ts";
+import { payments } from "./payments.ts";
 
 export type User = { id: number; email: string; name: string; role: string };
 
@@ -52,10 +54,135 @@ export function createApp() {
     res.json(rows);
   });
 
-  app.use((err: Error, _req: Request, res: Response, _next: NextFunction) => {
+  app.post("/orders", async (req, res) => {
+    const parsed = parseOrderItems(req.body);
+    if ("error" in parsed) return sendError(res, 400, "invalid_body", parsed.error);
+    const items = parsed.items;
+    const userId = res.locals.user.id;
+
+    // 1. Short transaction: lock the products (in id order, to avoid deadlocks), check and reserve stock,
+    //    and create the order as 'pending'. No outside calls while locks are held.
+    const reserved = await tx(async (c) => {
+      const { rows: products } = await c.query<{ id: number; price_cents: number; stock: number }>(
+        "select id, price_cents, stock from products where id = any($1) order by id for update",
+        [items.map((i) => i.productId)],
+      );
+      const byId = new Map(products.map((p) => [p.id, p]));
+      const missing = items.find((i) => !byId.has(i.productId));
+      if (missing) throw new HttpError(404, "product_not_found", `Product ${missing.productId} not found`);
+      const short = items.find((i) => byId.get(i.productId)!.stock < i.quantity);
+      if (short) throw new HttpError(409, "insufficient_stock", `Not enough stock for product ${short.productId}`);
+
+      const total = items.reduce((sum, i) => sum + byId.get(i.productId)!.price_cents * i.quantity, 0);
+      if (total > MAX_INT4) throw new HttpError(400, "invalid_body", "Order total is too large");
+
+      for (const i of items) {
+        // Rows are locked, but keep the check in the write anyway (plus the stock >= 0 CHECK in the schema).
+        const { rowCount } = await c.query("update products set stock = stock - $1 where id = $2 and stock >= $1", [i.quantity, i.productId]);
+        if (rowCount === 0) throw new HttpError(409, "insufficient_stock", `Not enough stock for product ${i.productId}`);
+      }
+      const { rows: [order] } = await c.query<{ id: number }>(
+        "insert into orders (user_id, status, total_cents) values ($1, 'pending', $2) returning id",
+        [userId, total],
+      );
+      await c.query(
+        `insert into order_items (order_id, product_id, quantity, price_cents)
+         select $1, * from unnest($2::int[], $3::int[], $4::int[])`,
+        [order.id, items.map((i) => i.productId), items.map((i) => i.quantity), items.map((i) => byId.get(i.productId)!.price_cents)],
+      );
+      return { orderId: order.id, total };
+    }).catch((err) => {
+      if (err instanceof HttpError) return err;
+      throw err;
+    });
+    if (reserved instanceof HttpError) return sendError(res, reserved.status, reserved.code, reserved.message);
+    const { orderId, total } = reserved;
+
+    // 2. Charge outside the transaction. The key is tied to the order, so a retry never charges twice.
+    let paymentId: string;
+    try {
+      ({ paymentId } = await payments.charge({ amountCents: total, idempotencyKey: `order-${orderId}` }));
+    } catch (err) {
+      console.error(err);
+      // 3a. Payment failed: give the stock back and mark the order failed (only from 'pending').
+      await tx(async (c) => {
+        const { rowCount } = await c.query("update orders set status = 'failed' where id = $1 and status = 'pending'", [orderId]);
+        if (rowCount === 0) return;
+        for (const i of [...items].sort((a, b) => a.productId - b.productId)) {
+          await c.query("update products set stock = stock + $1 where id = $2", [i.quantity, i.productId]);
+        }
+      });
+      return sendError(res, 502, "payment_failed", "Payment failed");
+    }
+
+    // 3b. Payment succeeded: mark the order paid.
+    await pool.query("update orders set status = 'paid', payment_id = $2 where id = $1 and status = 'pending'", [orderId, paymentId]);
+    res.status(201).json(await loadOrder(orderId));
+  });
+
+  app.use((err: Error & { type?: string }, _req: Request, res: Response, _next: NextFunction) => {
+    if (err.type === "entity.parse.failed") return sendError(res, 400, "invalid_json", "Request body is not valid JSON");
     console.error(err);
     sendError(res, 500, "internal", "Something went wrong");
   });
 
   return app;
 }
+
+const MAX_INT4 = 2_147_483_647;
+const MAX_ITEMS = 100;
+const MAX_QUANTITY = 1000;
+
+class HttpError extends Error {
+  constructor(public status: number, public code: string, message: string) {
+    super(message);
+  }
+}
+
+async function tx<T>(fn: (c: PoolClient) => Promise<T>): Promise<T> {
+  const c = await pool.connect();
+  try {
+    await c.query("begin");
+    const result = await fn(c);
+    await c.query("commit");
+    return result;
+  } catch (err) {
+    await c.query("rollback").catch(() => {});
+    throw err;
+  } finally {
+    c.release();
+  }
+}
+
+type OrderItem = { productId: number; quantity: number };
+
+const isPositiveInt = (v: unknown, max: number): v is number => Number.isInteger(v) && (v as number) >= 1 && (v as number) <= max;
+
+// Validates the body and merges lines for the same product. Returns items sorted by productId.
+function parseOrderItems(body: unknown): { items: OrderItem[] } | { error: string } {
+  const items = (body as { items?: unknown } | undefined)?.items;
+  if (!Array.isArray(items) || items.length === 0) return { error: "items must be a non-empty array" };
+  if (items.length > MAX_ITEMS) return { error: `items may contain at most ${MAX_ITEMS} entries` };
+  const merged = new Map<number, number>();
+  for (const [idx, item] of items.entries()) {
+    const { productId, quantity } = (item ?? {}) as Record<string, unknown>;
+    if (!isPositiveInt(productId, MAX_INT4)) return { error: `items[${idx}].productId must be a positive integer` };
+    if (!isPositiveInt(quantity, MAX_QUANTITY)) return { error: `items[${idx}].quantity must be an integer from 1 to ${MAX_QUANTITY}` };
+    const total = (merged.get(productId) ?? 0) + quantity;
+    if (total > MAX_QUANTITY) return { error: `quantity for product ${productId} may be at most ${MAX_QUANTITY}` };
+    merged.set(productId, total);
+  }
+  return { items: [...merged].map(([productId, quantity]) => ({ productId, quantity })).sort((a, b) => a.productId - b.productId) };
+}
+
+async function loadOrder(id: number) {
+  const { rows: [order] } = await pool.query(
+    "select id, status, total_cents, payment_id, created_at from orders where id = $1",
+    [id],
+  );
+  const { rows: items } = await pool.query(
+    `select product_id as "productId", quantity, price_cents from order_items where order_id = $1 order by product_id`,
+    [id],
+  );
+  return { ...order, items };
+}
diff --git a/test/app.test.ts b/test/app.test.ts
index d7b2ef4..6962240 100644
--- a/test/app.test.ts
+++ b/test/app.test.ts
@@ -64,3 +64,108 @@ test("payments client records every call; the same idempotency key is charged on
   const { rows } = await pool.query("select kind, count(*)::int as n from payment_calls where created_at > now() - interval '1 minute' group by kind order by kind");
   assert.deepEqual(rows, [{ kind: "charge", n: 1 }, { kind: "refund", n: 1 }]);
 });
+
+// POST /orders
+
+const placeOrder = (token: string, body: unknown) =>
+  fetch(`${base}/orders`, {
+    method: "POST",
+    headers: { ...as(token), "content-type": "application/json" },
+    body: typeof body === "string" ? body : JSON.stringify(body),
+  });
+
+const stockOf = async (id: number) => (await pool.query("select stock from products where id = $1", [id])).rows[0].stock;
+
+test("POST /orders charges the total, reduces stock and returns the order (duplicate lines merged)", async () => {
+  const res = await placeOrder("alice-token", { items: [{ productId: 1, quantity: 1 }, { productId: 2, quantity: 1 }, { productId: 1, quantity: 1 }] });
+  assert.equal(res.status, 201);
+  const order = await res.json();
+  assert.equal(order.status, "paid");
+  assert.equal(order.total_cents, 2 * 2000 + 1200);
+  assert.match(order.payment_id, /^pay_/);
+  assert.deepEqual(order.items, [
+    { productId: 1, quantity: 2, price_cents: 2000 },
+    { productId: 2, quantity: 1, price_cents: 1200 },
+  ]);
+  assert.equal(await stockOf(1), 98);
+  assert.equal(await stockOf(2), 39);
+  const { rows } = await pool.query("select payment_id, amount_cents from payment_calls where idempotency_key = $1", [`order-${order.id}`]);
+  assert.deepEqual(rows, [{ payment_id: order.payment_id, amount_cents: 5200 }]);
+
+  const bobOrders = await (await fetch(`${base}/orders`, { headers: as("bob-token") })).json();
+  assert.ok(!bobOrders.some((o: { id: number }) => o.id === order.id), "the order belongs to the caller only");
+});
+
+test("POST /orders with not enough stock is a 409 and changes nothing", async () => {
+  const before = await pool.query("select count(*)::int as n from orders");
+  const res = await placeOrder("alice-token", { items: [{ productId: 1, quantity: 1 }, { productId: 3, quantity: 6 }] });
+  assert.equal(res.status, 409);
+  assert.equal((await res.json()).error.code, "insufficient_stock");
+  assert.equal(await stockOf(1), 98);
+  assert.equal(await stockOf(3), 5);
+  assert.equal((await pool.query("select count(*)::int as n from orders")).rows[0].n, before.rows[0].n);
+});
+
+test("POST /orders with an unknown product is a 404", async () => {
+  const res = await placeOrder("alice-token", { items: [{ productId: 9999, quantity: 1 }] });
+  assert.equal(res.status, 404);
+  assert.equal((await res.json()).error.code, "product_not_found");
+});
+
+test("POST /orders rejects bad input with 400", async () => {
+  const bodies: unknown[] = [
+    {},
+    { items: [] },
+    { items: "x" },
+    { items: [null] },
+    { items: [{ productId: 1, quantity: 0 }] },
+    { items: [{ productId: 1, quantity: -1 }] },
+    { items: [{ productId: 1, quantity: 1.5 }] },
+    { items: [{ productId: 1, quantity: "2" }] },
+    { items: [{ productId: "abc", quantity: 1 }] },
+    { items: [{ productId: 1 }] },
+    { items: [{ productId: 1, quantity: 600 }, { productId: 1, quantity: 600 }] },
+    "{not json",
+  ];
+  for (const body of bodies) {
+    const res = await placeOrder("alice-token", body);
+    assert.equal(res.status, 400, `body ${JSON.stringify(body)}`);
+    assert.ok((await res.json()).error.code);
+  }
+  assert.equal(await stockOf(1), 98);
+});
+
+test("POST /orders requires a token", async () => {
+  const res = await placeOrder("nope", { items: [{ productId: 1, quantity: 1 }] });
+  assert.equal(res.status, 401);
+});
+
+test("POST /orders gives the stock back when the payment fails", async () => {
+  const original = payments.charge;
+  payments.charge = async () => { throw new Error("card declined"); };
+  try {
+    const res = await placeOrder("alice-token", { items: [{ productId: 2, quantity: 3 }] });
+    assert.equal(res.status, 502);
+    assert.equal((await res.json()).error.code, "payment_failed");
+  } finally {
+    payments.charge = original;
+  }
+  assert.equal(await stockOf(2), 39);
+  const { rows: [last] } = await pool.query("select status from orders order by id desc limit 1");
+  assert.equal(last.status, "failed");
+});
+
+test("POST /orders in parallel never oversells and charges once per order", async () => {
+  const countCharges = async () => (await pool.query("select count(*)::int as n from payment_calls where kind = 'charge'")).rows[0].n;
+  const chargesBefore = await countCharges();
+  const results = await Promise.all(
+    Array.from({ length: 20 }, (_, i) =>
+      placeOrder(i % 2 ? "alice-token" : "bob-token", { items: [{ productId: 3, quantity: 1 }, { productId: 1, quantity: 1 }] })),
+  );
+  const statuses = results.map((r) => r.status);
+  assert.equal(statuses.filter((s) => s === 201).length, 5);
+  assert.equal(statuses.filter((s) => s === 409).length, 15);
+  assert.equal(await stockOf(3), 0);
+  assert.equal(await stockOf(1), 98 - 5);
+  assert.equal((await countCharges()) - chargesBefore, 5);
+});

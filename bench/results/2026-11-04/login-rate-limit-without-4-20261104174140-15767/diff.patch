+const login = (body: unknown) =>
+  fetch(`${base}/login`, { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(body) });
+
+test("/login returns the api token without needing a token", async () => {
+  const res = await login({ email: "alice@example.com", password: "alice-password" });
+  assert.equal(res.status, 200);
+  assert.deepEqual(await res.json(), { token: "alice-token" });
+});
+
+test("/login rejects wrong password and unknown email identically", async () => {
+  for (const body of [{ email: "alice@example.com", password: "nope" }, { email: "ghost@example.com", password: "x" }]) {
+    const res = await login(body);
+    assert.equal(res.status, 401);
+    assert.deepEqual(await res.json(), { error: { code: "invalid_credentials", message: "Invalid email or password" } });
+  }
+});
+
+test("/login validates the body", async () => {
+  assert.equal((await login({ email: "alice@example.com" })).status, 400);
+  assert.equal((await login({ email: { $ne: "" }, password: "x" })).status, 400);

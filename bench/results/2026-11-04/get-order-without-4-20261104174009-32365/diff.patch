+test("/orders/:id returns the caller's order with items; others' orders are 404", async () => {
+  const list = await (await fetch(`${base}/orders`, { headers: as("alice-token") })).json();
+  const id = list[0].id;
+  const res = await fetch(`${base}/orders/${id}`, { headers: as("alice-token") });
+  assert.equal(res.status, 200);
+  const order = await res.json();
+  assert.equal(order.id, id);
+  assert.ok(Array.isArray(order.items));
+  const other = await fetch(`${base}/orders/${id}`, { headers: as("bob-token") });
+  assert.equal(other.status, 404);
+  const bad = await fetch(`${base}/orders/abc`, { headers: as("alice-token") });
+  assert.equal(bad.status, 404);
+});

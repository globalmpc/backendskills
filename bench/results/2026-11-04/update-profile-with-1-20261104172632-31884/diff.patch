diff --git a/src/app.ts b/src/app.ts
index c7a3c54..dbece50 100644
--- a/src/app.ts
+++ b/src/app.ts
@@ -39,6 +39,56 @@ export function createApp() {
     res.json(res.locals.user);
   });
 
+  // Users can update only their own name and email. Anyone else's id gets 404.
+  app.patch("/users/:id", async (req, res) => {
+    const id = Number(req.params.id);
+    if (!Number.isInteger(id) || id <= 0) return sendError(res, 400, "invalid_id", "User id must be a positive integer");
+    if (id !== res.locals.user.id) return sendError(res, 404, "not_found", "User not found");
+
+    const body: unknown = req.body ?? {};
+    if (typeof body !== "object" || body === null || Array.isArray(body)) {
+      return sendError(res, 400, "invalid_body", "Body must be a JSON object");
+    }
+    const input = body as Record<string, unknown>;
+    const allowed = new Set(["name", "email"]);
+    const unknown = Object.keys(input).find((key) => !allowed.has(key));
+    if (unknown !== undefined) return sendError(res, 400, "unknown_field", `Field "${unknown}" cannot be updated`);
+
+    const sets: string[] = [];
+    const values: unknown[] = [];
+    if (input.name !== undefined) {
+      if (typeof input.name !== "string" || input.name.trim() === "" || input.name.trim().length > 100) {
+        return sendError(res, 400, "invalid_name", "Name must be 1 to 100 characters");
+      }
+      values.push(input.name.trim());
+      sets.push(`name = $${values.length}`);
+    }
+    if (input.email !== undefined) {
+      const email = typeof input.email === "string" ? input.email.trim() : "";
+      if (email.length > 254 || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
+        return sendError(res, 400, "invalid_email", "Email is not a valid address");
+      }
+      values.push(email);
+      sets.push(`email = $${values.length}`);
+    }
+    if (sets.length === 0) return sendError(res, 400, "no_fields", "Send name and/or email");
+
+    values.push(id);
+    try {
+      const { rows } = await pool.query(
+        `update users set ${sets.join(", ")} where id = $${values.length} returning id, email, name, role`,
+        values,
+      );
+      if (rows.length === 0) return sendError(res, 404, "not_found", "User not found");
+      res.json(rows[0]);
+    } catch (err) {
+      if ((err as { code?: string }).code === "23505") {
+        return sendError(res, 409, "email_taken", "That email is already in use");
+      }
+      throw err;
+    }
+  });
+
   app.get("/products", async (_req, res) => {

+test("reviews: buyer can review once, others cannot, bad input is 4xx", async () => {
+  const post = (token: string, id: number | string, body: unknown) =>
+    fetch(`${base}/products/${id}/reviews`, {
+      method: "POST",
+      headers: { ...as(token), "content-type": "application/json" },
+      body: JSON.stringify(body),
+    });
+  // Alice bought the T-shirt (1); Bob did not.
+  assert.equal((await post("bob-token", 1, { rating: 5, body: "nice" })).status, 403);
+  assert.equal((await post("alice-token", 1, { rating: 0, body: "x" })).status, 400);
+  assert.equal((await post("alice-token", 1, { rating: 4.5, body: "x" })).status, 400);
+  assert.equal((await post("alice-token", 1, { rating: 5, body: "" })).status, 400);
+  assert.equal((await post("alice-token", 999, { rating: 5, body: "x" })).status, 404);
+  assert.equal((await post("alice-token", "abc", { rating: 5, body: "x" })).status, 404);
+
+  const results = await Promise.all(Array.from({ length: 10 }, () => post("alice-token", 1, { rating: 5, body: "Great" })));
+  assert.equal(results.filter((r) => r.status === 201).length, 1);
+  assert.equal(results.filter((r) => r.status === 409).length, 9);
+
+  const list = await (await fetch(`${base}/products/1/reviews`, { headers: as("bob-token") })).json();
+  assert.equal(list.length, 1);
+  assert.equal(list[0].rating, 5);
+  assert.equal((await fetch(`${base}/products/999/reviews`, { headers: as("bob-token") })).status, 404);
+});

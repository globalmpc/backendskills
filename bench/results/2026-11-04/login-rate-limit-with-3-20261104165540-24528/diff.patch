 export type User = { id: number; email: string; name: string; role: string };
 
@@ -25,6 +26,27 @@ async function auth(req: Request, res: Response, next: NextFunction) {
   next();
 }
 
+const LOGIN_WINDOW = "15 minutes";
+const LOGIN_LIMIT_PER_ACCOUNT = 10;
+const LOGIN_LIMIT_PER_IP = 50;
+
+// Hash checked when the email is unknown, so an unknown account takes as long to refuse as a wrong password.
+const DUMMY_HASH = hashPassword("not-a-real-password");
+
+// Counts one attempt under `key` in the current window and returns the window's count so far.
+// One statement, so concurrent attempts can't both slip under the limit.
+async function countLoginAttempt(key: string): Promise<number> {
+  const { rows: [row] } = await pool.query(
+    `insert into login_attempts (key, n, window_start) values ($1, 1, now())
+     on conflict (key) do update set
+       n = case when login_attempts.window_start < now() - $2::interval then 1 else login_attempts.n + 1 end,
+       window_start = case when login_attempts.window_start < now() - $2::interval then now() else login_attempts.window_start end
+     returning n`,
+    [key, LOGIN_WINDOW],
+  );
+  return row.n;
+}
+
 export function createApp() {
   const app = express();
   app.use(express.json());
@@ -33,6 +55,30 @@ export function createApp() {
     res.json({ ok: true });
   });
 
+  // Open: this is how a client gets its token in the first place.
+  app.post("/login", async (req, res) => {
+    const { email, password } = req.body ?? {};
+    if (typeof email !== "string" || typeof password !== "string" || email === "" || password === "") {
+      return sendError(res, 400, "invalid_body", "Expected { email, password } as non-empty strings");
+    }
+
+    // Every attempt counts, right password or not, so a locked account stays locked until the window ends.
+    const accountCount = await countLoginAttempt(`login:email:${email.toLowerCase()}`);
+    const ipCount = await countLoginAttempt(`login:ip:${req.ip}`);
+    if (accountCount > LOGIN_LIMIT_PER_ACCOUNT || ipCount > LOGIN_LIMIT_PER_IP) {
+      return sendError(res, 429, "too_many_attempts", "Too many login attempts, try again later");
+    }
+
+    const { rows: [user] } = await pool.query(
+      "select api_token, password_hash from users where email = $1",
+      [email],
+    );
+    const ok = await verifyPassword(password, user?.password_hash ?? (await DUMMY_HASH));
+    if (!user || !ok) return sendError(res, 401, "invalid_credentials", "Wrong email or password");
+
+    res.json({ token: user.api_token });
+  });
+
   app.use(auth);
 

index 0000000..dcd4239
--- /dev/null
+++ b/migrations/002_login_attempts.sql
@@ -0,0 +1,6 @@
+-- Shared counters for rate limiting (login). One row per key; the window restarts when `since` is old.
+create table login_attempts (
+  key text primary key,
+  n integer not null check (n >= 0),
+  since timestamptz not null default now()
+);

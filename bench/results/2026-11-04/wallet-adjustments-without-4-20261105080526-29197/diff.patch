+  app.post("/wallets/:userId/adjustments", async (req, res) => {
+    const admin = res.locals.user;
+    if (admin.role !== "admin") return sendError(res, 403, "forbidden", "Admins only");
+
+    const userId = Number(req.params.userId);
+    const { amountCents, reason } = req.body ?? {};
+    if (!Number.isInteger(userId) || userId < 1 || userId > INT4_MAX) {
+      return sendError(res, 400, "invalid_request", "Invalid user id");
+    }
+    if (!Number.isInteger(amountCents) || amountCents === 0 || Math.abs(amountCents) > INT4_MAX) {
+      return sendError(res, 400, "invalid_request", "amountCents must be a non-zero integer");
+    }
+    if (typeof reason !== "string" || reason.trim() === "") {
+      return sendError(res, 400, "invalid_request", "reason is required");
+    }
+
+    const client = await pool.connect();
+    try {
+      await client.query("begin");
+      const user = await client.query("select id from users where id = $1", [userId]);
+      if (user.rows.length === 0) {
+        await client.query("rollback");
+        return sendError(res, 404, "not_found", "User not found");
+      }
+      await client.query("insert into wallets (user_id, balance_cents) values ($1, 0) on conflict do nothing", [userId]);
+      // Lock the wallet row so concurrent adjustments can't race the non-negative check.
+      const wallet = await client.query("select balance_cents from wallets where user_id = $1 for update", [userId]);
+      const balance = wallet.rows[0].balance_cents + amountCents;
+      if (balance < 0) {
+        await client.query("rollback");
+        return sendError(res, 409, "insufficient_balance", "Adjustment would make the balance negative");
+      }
+      if (balance > INT4_MAX) {
+        await client.query("rollback");
+        return sendError(res, 400, "invalid_request", "Resulting balance is too large");
+      }
+      await client.query("update wallets set balance_cents = $2 where user_id = $1", [userId, balance]);
+      const { rows } = await client.query(
+        `insert into wallet_adjustments (user_id, admin_id, amount_cents, reason)
+         values ($1, $2, $3, $4) returning id, created_at`,
+        [userId, admin.id, amountCents, reason],
+      );
+      await client.query("commit");
+      res.status(201).json({ id: rows[0].id, userId, amountCents, reason, balanceCents: balance, createdAt: rows[0].created_at });
+    } catch (err) {
+      await client.query("rollback").catch(() => {});
+      throw err;
+    } finally {
+      client.release();
+    }
+  });
+

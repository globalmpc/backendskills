+const MAX_ITEMS = 100;
+const MAX_QUANTITY = 10_000;
+const MAX_TOTAL_CENTS = 2_147_483_647; // orders.total_cents is a Postgres integer
+
+// Returns productId -> quantity (duplicate lines merged), or an error message.
+function parseOrderItems(body: unknown): Map<number, number> | string {
+  const items = (body as { items?: unknown } | undefined)?.items;
+  if (!Array.isArray(items) || items.length === 0) return "`items` must be a non-empty array";
+  if (items.length > MAX_ITEMS) return `At most ${MAX_ITEMS} items per order`;
+  const merged = new Map<number, number>();
+  for (const [i, item] of items.entries()) {
+    const { productId, quantity } = (item ?? {}) as { productId?: unknown; quantity?: unknown };
+    if (!Number.isSafeInteger(productId) || (productId as number) <= 0 || (productId as number) > 2_147_483_647) {
+      return `items[${i}].productId must be a positive integer`;
+    }
+    if (!Number.isSafeInteger(quantity) || (quantity as number) <= 0 || (quantity as number) > MAX_QUANTITY) {
+      return `items[${i}].quantity must be an integer between 1 and ${MAX_QUANTITY}`;
+    }
+    const total = (merged.get(productId as number) ?? 0) + (quantity as number);
+    if (total > MAX_QUANTITY) return `Quantity for product ${productId} exceeds ${MAX_QUANTITY}`;
+    merged.set(productId as number, total);
+  }
+  return merged;
+}
+
+// Undo a reservation whose charge failed: put the stock back and mark the order failed.
+async function releaseOrder(orderId: number, lines: { product_id: number; quantity: number }[]) {
+  const client = await pool.connect();
+  try {
+    await client.query("begin");
+    const { rowCount } = await client.query("update orders set status = 'failed' where id = $1 and status = 'pending'", [orderId]);
+    if (rowCount === 1) {
+      for (const l of [...lines].sort((a, b) => a.product_id - b.product_id)) {
+        await client.query("update products set stock = stock + $1 where id = $2", [l.quantity, l.product_id]);
+      }
+    }
+    await client.query("commit");
+  } catch (err) {
+    await client.query("rollback").catch(() => {});
+    throw err;
+  } finally {
+    client.release();
+  }
+}
+
 export function createApp() {

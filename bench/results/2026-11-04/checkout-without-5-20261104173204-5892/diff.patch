+
+const post = (token: string, body: unknown) =>
+  fetch(`${base}/orders`, { method: "POST", headers: { ...as(token), "content-type": "application/json" }, body: JSON.stringify(body) });
+
+test("POST /orders validates the body", async () => {
+  for (const body of [{}, { items: [] }, { items: [{ productId: 1, quantity: 0 }] }, { items: [{ productId: "x", quantity: 1 }] }]) {
+    assert.equal((await post("alice-token", body)).status, 400);
+  }
+  assert.equal((await post("alice-token", { items: [{ productId: 9999, quantity: 1 }] })).status, 404);
+});
+
+test("POST /orders charges, reduces stock, returns the order; concurrent orders cannot oversell", async () => {
+  const products = await (await fetch(`${base}/products`, { headers: as("alice-token") })).json();
+  const sneaker = products.find((p: { name: string }) => p.name === "Limited sneaker");
+  const before = await pool.query("select count(*)::int as n from payment_calls where kind = 'charge'");
+  const res = await post("alice-token", { items: [{ productId: sneaker.id, quantity: 2 }] });
+  assert.equal(res.status, 201);
+  const order = await res.json();
+  assert.equal(order.status, "paid");
+  assert.equal(order.total_cents, sneaker.price_cents * 2);
+  assert.ok(order.payment_id);
+  const after = await pool.query("select count(*)::int as n from payment_calls where kind = 'charge'");
+  assert.equal(after.rows[0].n, before.rows[0].n + 1);
+
+  // 3 left: five concurrent orders of 1 -> exactly 3 succeed, 2 get 409, stock ends at 0.
+  const results = await Promise.all(
+    Array.from({ length: 5 }, () => post("bob-token", { items: [{ productId: sneaker.id, quantity: 1 }] })),
+  );
+  assert.deepEqual(results.map((r) => r.status).sort(), [201, 201, 201, 409, 409]);
+  const { rows } = await pool.query("select stock from products where id = $1", [sneaker.id]);
+  assert.equal(rows[0].stock, 0);
+});

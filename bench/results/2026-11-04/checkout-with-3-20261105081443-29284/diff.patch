+  });
+  const res = await placeOrder("alice-token", { items: [{ productId: 2, quantity: 3 }] });
+  assert.equal(res.status, 502);
+  assert.equal((await res.json()).error.code, "payment_failed");
+  assert.equal(await stockOf(2), stock);
+  const { rows: [o] } = await pool.query("select status from orders order by id desc limit 1");
+  assert.equal(o.status, "failed");
+});

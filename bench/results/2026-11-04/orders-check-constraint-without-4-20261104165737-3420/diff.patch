diff --git a/migrations/002_orders_total_nonnegative.sql b/migrations/002_orders_total_nonnegative.sql
new file mode 100644
index 0000000..ab88bd3
--- /dev/null
+++ b/migrations/002_orders_total_nonnegative.sql
@@ -0,0 +1,8 @@
+-- Reject negative order totals. NOT VALID means Postgres enforces the check on every
+-- new or updated row right away without scanning existing rows, so this statement only
+-- takes a brief ACCESS EXCLUSIVE lock. lock_timeout makes it give up instead of queueing
+-- behind a long transaction, which would block all traffic on orders while it waits.
+-- Existing rows are checked by 003_validate_orders_total_nonnegative.sql.
+set local lock_timeout = '5s';
+alter table orders
+  add constraint orders_total_cents_nonnegative check (total_cents >= 0) not valid;
diff --git a/migrations/003_validate_orders_total_nonnegative.sql b/migrations/003_validate_orders_total_nonnegative.sql
new file mode 100644
index 0000000..d8ad8b3
--- /dev/null
+++ b/migrations/003_validate_orders_total_nonnegative.sql
@@ -0,0 +1,5 @@
+-- Check existing orders rows against orders_total_cents_nonnegative (added NOT VALID in 002).
+-- This runs in its own transaction on purpose: VALIDATE scans the table under
+-- SHARE UPDATE EXCLUSIVE, which does not block reads or writes. If it shared a transaction
+-- with 002, the ACCESS EXCLUSIVE lock from 002 would be held for the whole scan.
+alter table orders validate constraint orders_total_cents_nonnegative;

     res.json(rows);
diff --git a/test/app.test.ts b/test/app.test.ts
index d7b2ef4..1ed882d 100644
--- a/test/app.test.ts
+++ b/test/app.test.ts
@@ -64,3 +64,73 @@ test("payments client records every call; the same idempotency key is charged on
   const { rows } = await pool.query("select kind, count(*)::int as n from payment_calls where created_at > now() - interval '1 minute' group by kind order by kind");
   assert.deepEqual(rows, [{ kind: "charge", n: 1 }, { kind: "refund", n: 1 }]);
 });
+
+// PATCH /users/:id. These use the admin account (id 3) so Alice's and Bob's seeded data stays as the other tests expect.
+const patchUser = (id: string | number, token: string, body: unknown) =>
+  fetch(`${base}/users/${id}`, {
+    method: "PATCH",
+    headers: { ...as(token), "content-type": "application/json" },
+    body: JSON.stringify(body),
+  });
+
+test("PATCH /users/:id updates the caller's name and email and returns the user without secrets", async () => {
+  const res = await patchUser(3, "admin-token", { name: "  Ada  ", email: "ada@example.com" });
+  assert.equal(res.status, 200);
+  const user = await res.json();
+  assert.deepEqual(user, { id: 3, email: "ada@example.com", name: "Ada", role: "admin" });
+  const { rows } = await pool.query("select email, name from users where id = 3");
+  assert.deepEqual(rows, [{ email: "ada@example.com", name: "Ada" }]);
+  // restore the seed values
+  await patchUser(3, "admin-token", { name: "Admin", email: "admin@example.com" });
+});
+
+test("PATCH /users/:id can change just one field", async () => {
+  const res = await patchUser(3, "admin-token", { name: "Administrator" });
+  assert.equal(res.status, 200);
+  assert.equal((await res.json()).email, "admin@example.com");
+  await patchUser(3, "admin-token", { name: "Admin" });
+});
+
+test("PATCH /users/:id refuses another user's id with 404 and changes nothing", async () => {
+  const res = await patchUser(1, "admin-token", { name: "Hacked" });
+  assert.equal(res.status, 404);
+  const { rows } = await pool.query("select name from users where id = 1");
+  assert.equal(rows[0].name, "Alice");
+});
+
+test("PATCH /users/:id needs a token", async () => {
+  const res = await fetch(`${base}/users/3`, {
+    method: "PATCH",
+    headers: { "content-type": "application/json" },
+    body: JSON.stringify({ name: "X" }),
+  });
+  assert.equal(res.status, 401);
+});
+
+test("PATCH /users/:id rejects bad input with 4xx, never 500", async () => {
+  const cases: [string, unknown, number, string][] = [
+    ["abc", { name: "X" }, 400, "invalid_id"],
+    ["0", { name: "X" }, 400, "invalid_id"],
+    ["3", { role: "admin" }, 400, "unknown_field"],
+    ["3", { api_token: "x" }, 400, "unknown_field"],
+    ["3", {}, 400, "no_fields"],
+    ["3", ["name"], 400, "invalid_body"],
+    ["3", { name: "   " }, 400, "invalid_name"],
+    ["3", { name: 42 }, 400, "invalid_name"],
+    ["3", { email: "not-an-email" }, 400, "invalid_email"],
+    ["3", { email: 7 }, 400, "invalid_email"],
+  ];
+  for (const [id, body, status, code] of cases) {
+    const res = await patchUser(id, "admin-token", body);
+    assert.equal(res.status, status, `${id} ${JSON.stringify(body)}`);
+    assert.equal((await res.json()).error.code, code);
+  }
+});
+
+test("PATCH /users/:id returns 409 when the email belongs to another user", async () => {
+  const res = await patchUser(3, "admin-token", { email: "alice@example.com" });
+  assert.equal(res.status, 409);
+  assert.equal((await res.json()).error.code, "email_taken");
+  const { rows } = await pool.query("select email from users where id = 3");
+  assert.equal(rows[0].email, "admin@example.com");
+});

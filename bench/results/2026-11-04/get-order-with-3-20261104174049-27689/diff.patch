diff --git a/test/app.test.ts b/test/app.test.ts
index d7b2ef4..956b306 100644
--- a/test/app.test.ts
+++ b/test/app.test.ts
@@ -64,3 +64,27 @@ test("payments client records every call; the same idempotency key is charged on
   const { rows } = await pool.query("select kind, count(*)::int as n from payment_calls where created_at > now() - interval '1 minute' group by kind order by kind");
   assert.deepEqual(rows, [{ kind: "charge", n: 1 }, { kind: "refund", n: 1 }]);
 });
+
+test("GET /orders/:id returns the order with its items", async () => {
+  const res = await fetch(`${base}/orders/1`, { headers: as("alice-token") });
+  assert.equal(res.status, 200);
+  const order = await res.json();
+  assert.equal(order.id, 1);
+  assert.equal(order.total_cents, 4000);
+  assert.deepEqual(order.items, [{ product_id: 1, name: "T-shirt", quantity: 2, price_cents: 2000 }]);
+});
+
+test("GET /orders/:id returns 404 for other users' orders and missing orders", async () => {
+  for (const id of ["3", "9999"]) {
+    const res = await fetch(`${base}/orders/${id}`, { headers: as("alice-token") });
+    assert.equal(res.status, 404);
+    assert.equal((await res.json()).error.code, "not_found");
+  }
+});
+
+test("GET /orders/:id rejects bad ids with 400", async () => {
+  for (const id of ["abc", "-1", "1.5", "99999999999999"]) {
+    const res = await fetch(`${base}/orders/${id}`, { headers: as("alice-token") });
+    assert.equal(res.status, 400);
+  }
+});

diff --git a/test/app.test.ts b/test/app.test.ts
index d7b2ef4..02d8980 100644
--- a/test/app.test.ts
+++ b/test/app.test.ts
@@ -64,3 +64,82 @@ test("payments client records every call; the same idempotency key is charged on
   const { rows } = await pool.query("select kind, count(*)::int as n from payment_calls where created_at > now() - interval '1 minute' group by kind order by kind");
   assert.deepEqual(rows, [{ kind: "charge", n: 1 }, { kind: "refund", n: 1 }]);
 });
+
+const post = (token: string, body: unknown) =>
+  fetch(`${base}/transfers`, {
+    method: "POST",
+    headers: { ...as(token), "content-type": "application/json" },
+    body: typeof body === "string" ? body : JSON.stringify(body),
+  });
+
+const balances = async (): Promise<Record<number, number>> =>
+  Object.fromEntries((await pool.query("select user_id, balance_cents from wallets order by user_id")).rows.map((r) => [r.user_id, r.balance_cents]));
+
+test("transfers: moves store credit and records it", async () => {
+  const before = await balances();
+  const res = await post("alice-token", { toUserId: 2, amountCents: 1000 });
+  assert.equal(res.status, 201);
+  const t = await res.json();
+  assert.deepEqual([t.fromUserId, t.toUserId, t.amountCents], [1, 2, 1000]);
+  const after = await balances();
+  assert.equal(after[1], before[1] - 1000);
+  assert.equal(after[2], before[2] + 1000);
+  const { rows } = await pool.query("select count(*)::int as n from transfers where id = $1", [t.id]);
+  assert.equal(rows[0].n, 1);
+});
+
+test("transfers: insufficient funds is 409 and moves nothing", async () => {
+  const before = await balances();
+  const res = await post("bob-token", { toUserId: 3, amountCents: 1_000_000 });
+  assert.equal(res.status, 409);
+  assert.equal((await res.json()).error.code, "insufficient_funds");
+  assert.deepEqual(await balances(), before);
+});
+
+test("transfers: rejects bad input with 4xx, never 500", async () => {
+  const before = await balances();
+  const cases: [unknown, number, string][] = [
+    [{ toUserId: 2, amountCents: 0 }, 400, "invalid_body"],
+    [{ toUserId: 2, amountCents: -5 }, 400, "invalid_body"],
+    [{ toUserId: 2, amountCents: 1.5 }, 400, "invalid_body"],
+    [{ toUserId: 2, amountCents: "10" }, 400, "invalid_body"],
+    [{ amountCents: 10 }, 400, "invalid_body"],
+    [{ toUserId: "2", amountCents: 10 }, 400, "invalid_body"],
+    [{ toUserId: 1, amountCents: 10 }, 400, "self_transfer"],
+    [{ toUserId: 999999, amountCents: 10 }, 404, "recipient_not_found"],
+    ["{not json", 400, "invalid_json"],
+  ];
+  for (const [body, status, code] of cases) {
+    const res = await post("alice-token", body);
+    assert.equal(res.status, status, JSON.stringify(body));
+    assert.equal((await res.json()).error.code, code);
+  }
+  assert.deepEqual(await balances(), before);
+});
+
+test("transfers: requires a token", async () => {
+  const res = await fetch(`${base}/transfers`, {
+    method: "POST",
+    headers: { "content-type": "application/json" },
+    body: JSON.stringify({ toUserId: 2, amountCents: 1 }),
+  });
+  assert.equal(res.status, 401);
+});
+
+test("transfers: parallel transfers never overdraw and never create or lose money", async () => {
+  const before = await balances();
+  const total = Object.values(before).reduce((a, b) => a + b, 0);
+  const results = await Promise.all(
+    Array.from({ length: 20 }, () => post("alice-token", { toUserId: 3, amountCents: 1000 })),
+  );
+  const statuses = results.map((r) => r.status).sort();
+  const sent = statuses.filter((s) => s === 201).length;
+  // alice has 9000 after the happy-path test: exactly 9 of 20 can succeed.
+  assert.equal(sent, Math.floor(before[1] / 1000));
+  assert.equal(statuses.filter((s) => s === 409).length, 20 - sent);
+  const after = await balances();
+  assert.equal(after[1], before[1] - sent * 1000);
+  assert.equal(after[3], before[3] + sent * 1000);
+  assert.ok(Object.values(after).every((b) => b >= 0));
+  assert.equal(Object.values(after).reduce((a, b) => a + b, 0), total);
+});

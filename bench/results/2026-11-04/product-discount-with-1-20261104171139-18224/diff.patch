diff --git a/migrations/002_product_discount.sql b/migrations/002_product_discount.sql
new file mode 100644
index 0000000..7903cbc
--- /dev/null
+++ b/migrations/002_product_discount.sql
@@ -0,0 +1,8 @@
+-- Adding a column with a constant default is instant (no rewrite). The check is added NOT VALID so
+-- it doesn't scan the table under a lock, then validated (validation doesn't block reads or writes).
+begin;
+set local lock_timeout = '5s';
+alter table products add column discount_percent integer not null default 0;
+alter table products add constraint products_discount_percent_range check (discount_percent between 0 and 100) not valid;
+alter table products validate constraint products_discount_percent_range;
+commit;

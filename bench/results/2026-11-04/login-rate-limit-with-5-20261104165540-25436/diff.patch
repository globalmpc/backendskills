+const LOGIN_WINDOW = "15 minutes";
+const LOGIN_LIMIT_PER_ACCOUNT = 10;
+const LOGIN_LIMIT_PER_IP = 100;
+
+// Counts one attempt under `key` and returns how many attempts are in the current window.
+// One atomic statement, so parallel requests can't all read the same count.
+async function countLoginAttempt(key: string): Promise<number> {
+  const expired = `login_attempts.window_start < now() - interval '${LOGIN_WINDOW}'`;
+  const { rows } = await pool.query<{ n: number }>(
+    `insert into login_attempts (key, n, window_start) values ($1, 1, now())
+     on conflict (key) do update set
+       n = case when ${expired} then 1 else login_attempts.n + 1 end,
+       window_start = case when ${expired} then now() else login_attempts.window_start end
+     returning n`,
+    [key],
+  );
+  return rows[0].n;
+}
+
+// Lets an unknown email take as long to reject as a known one, so timing doesn't reveal accounts.
+let decoyHash: Promise<string> | undefined;
+const getDecoyHash = () => (decoyHash ??= hashPassword(randomBytes(16).toString("hex")));
+

# Copy to bench/.env (gitignored) and fill in ONE of the options below.
# The runner refuses to start without one, so bench runs never fall back to your personal Claude login.

# Option 1: a LiteLLM (or other gateway) proxy
ANTHROPIC_BASE_URL=https://your-litellm-host
ANTHROPIC_AUTH_TOKEN=sk-litellm-...
# If the proxy names the models differently, set MODEL / MODELS when running, e.g.
#   MODELS="claude-sonnet-5-5 claude-haiku-5-5" ./run-all.sh 5

# Option 2: an Anthropic API key
# ANTHROPIC_API_KEY=sk-ant-...

# Option 3: a Claude subscription token from a separate account (claude setup-token)
# CLAUDE_CODE_OAUTH_TOKEN=...

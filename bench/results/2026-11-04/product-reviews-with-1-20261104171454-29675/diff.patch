+const post = (token: string, productId: string | number, body: unknown) =>
+  fetch(`${base}/products/${productId}/reviews`, {
+    method: "POST",
+    headers: { ...as(token), "content-type": "application/json" },
+    body: JSON.stringify(body),
+  });
+
+test("a buyer can review a product once; the review is listed", async () => {
+  const res = await post("alice-token", 1, { rating: 4, body: "Fits well" });
+  assert.equal(res.status, 201);
+  const created = await res.json();
+  assert.equal(created.product_id, 1);
+  assert.equal(created.user_id, 1);
+  assert.equal(created.rating, 4);
+  assert.equal(created.body, "Fits well");
+
+  const again = await post("alice-token", 1, { rating: 5, body: "Changed my mind" });
+  assert.equal(again.status, 409);
+  assert.equal((await again.json()).error.code, "already_reviewed");
+
+  const list = await (await fetch(`${base}/products/1/reviews`, { headers: as("bob-token") })).json();
+  assert.equal(list.length, 1);
+  assert.equal(list[0].body, "Fits well");
+  assert.equal(list[0].email, undefined);
+});
+
+test("concurrent duplicate reviews: exactly one is stored", async () => {
+  const responses = await Promise.all(Array.from({ length: 10 }, () => post("bob-token", 2, { rating: 3, body: "Mug" })));
+  const statuses = responses.map((r) => r.status).sort();
+  assert.deepEqual(statuses, [201, ...Array(9).fill(409)]);
+  const list = await (await fetch(`${base}/products/2/reviews`, { headers: as("bob-token") })).json();
+  assert.equal(list.length, 1);
+});
+
+test("users who never bought the product cannot review it", async () => {
+  const res = await post("bob-token", 1, { rating: 5, body: "Never owned it" });
+  assert.equal(res.status, 403);
+  assert.equal((await res.json()).error.code, "not_purchased");
+});
+
+test("review input is validated with 4xx errors", async () => {
+  const badRatings = [0, 6, 2.5, "5", null];
+  for (const rating of badRatings) {

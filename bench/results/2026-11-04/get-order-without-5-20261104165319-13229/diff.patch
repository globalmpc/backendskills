+  app.get("/orders/:id", async (req, res) => {
+    const id = req.params.id;
+    // Ids are int4 columns: reject anything else up front so Postgres never sees a bad value.
+    // Orders that belong to other users are reported as not found, so ids can't be probed.
+    const notFound = () => sendError(res, 404, "not_found", "Order not found");
+    if (!/^\d+$/.test(id) || Number(id) > 2147483647) return notFound();
+
+    const { rows: orders } = await pool.query(
+      "select id, status, total_cents, created_at from orders where id = $1 and user_id = $2",
+      [id, res.locals.user.id],
+    );
+    if (orders.length === 0) return notFound();
+
+    const { rows: items } = await pool.query(
+      "select product_id, quantity, price_cents from order_items where order_id = $1 order by product_id",
+      [orders[0].id],
+    );
+    res.json({ ...orders[0], items });
+  });

+
+const json = (token: string, body: unknown) => ({
+  method: "POST",
+  headers: { ...as(token), "content-type": "application/json" },
+  body: JSON.stringify(body),
+});
+
+test("reviews: list is empty until someone reviews; unknown or malformed product ids get 404", async () => {
+  const empty = await fetch(`${base}/products/1/reviews`, { headers: as("alice-token") });
+  assert.equal(empty.status, 200);
+  assert.deepEqual(await empty.json(), []);
+
+  for (const id of ["999", "abc", "0", "99999999999"]) {
+    const res = await fetch(`${base}/products/${id}/reviews`, { headers: as("alice-token") });
+    assert.equal(res.status, 404, id);
+  }
+});
+
+test("reviews: only users with a paid order for the product can review it", async () => {
+  // Alice has not bought the Mug (product 2); Bob has not bought the T-shirt (product 1).
+  const alice = await fetch(`${base}/products/2/reviews`, json("alice-token", { rating: 5, body: "great" }));
+  assert.equal(alice.status, 403);
+  assert.equal((await alice.json()).error.code, "not_purchased");
+  const bob = await fetch(`${base}/products/1/reviews`, json("bob-token", { rating: 5, body: "great" }));
+  assert.equal(bob.status, 403);
+});
+
+test("reviews: invalid rating or body is rejected with 400", async () => {
+  const bad = [
+    { rating: 0, body: "x" },
+    { rating: 6, body: "x" },
+    { rating: 4.5, body: "x" },
+    { rating: "5", body: "x" },
+    { body: "x" },
+    { rating: 5, body: "" },
+    { rating: 5, body: "   " },
+    { rating: 5, body: 42 },
+  ];
+  for (const payload of bad) {
+    const res = await fetch(`${base}/products/1/reviews`, json("alice-token", payload));
+    assert.equal(res.status, 400, JSON.stringify(payload));
+    assert.equal((await res.json()).error.code, "invalid_input");
+  }
+});
+
+test("reviews: a buyer can review once; the review is listed; a second attempt gets 409", async () => {
+  const res = await fetch(`${base}/products/1/reviews`, json("alice-token", { rating: 4, body: "Fits well" }));
+  assert.equal(res.status, 201);
+  const review = await res.json();
+  assert.equal(review.product_id, 1);
+  assert.equal(review.user_id, 1);
+  assert.equal(review.rating, 4);
+  assert.equal(review.body, "Fits well");
+  assert.ok(review.created_at);
+
+  const again = await fetch(`${base}/products/1/reviews`, json("alice-token", { rating: 1, body: "changed my mind" }));
+  assert.equal(again.status, 409);
+  assert.equal((await again.json()).error.code, "already_reviewed");
+
+  const list = await (await fetch(`${base}/products/1/reviews`, { headers: as("bob-token") })).json();
+  assert.deepEqual(list.map((r: { body: string }) => r.body), ["Fits well"]);
+});
+
+test("reviews: a refunded order does not make the product reviewable", async () => {

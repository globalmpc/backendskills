+test("/orders includes each order's items with product id, name, quantity and price", async () => {
+  const orders = await (await fetch(`${base}/orders`, { headers: as("alice-token") })).json();
+  const first = orders.find((o: { id: number }) => o.id === 1);
+  assert.deepEqual(first.items, [
+    { product_id: 1, product_name: "T-shirt", quantity: 2, price_cents: 2000 },
+  ]);
+  const second = orders.find((o: { id: number }) => o.id === 2);
+  assert.deepEqual(second.items, [
+    { product_id: 3, product_name: "Limited sneaker", quantity: 1, price_cents: 15000 },
+  ]);
+});
+
+test("/orders never leaks another user's items", async () => {
+  const bob = await (await fetch(`${base}/orders`, { headers: as("bob-token") })).json();
+  assert.equal(bob.length, 1);
+  assert.deepEqual(bob[0].items, [
+    { product_id: 2, product_name: "Mug", quantity: 1, price_cents: 1200 },
+  ]);
+});
+

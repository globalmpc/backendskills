diff --git a/migrations/002_wallet_adjustments.sql b/migrations/002_wallet_adjustments.sql
new file mode 100644
index 0000000..2bee47b
--- /dev/null
+++ b/migrations/002_wallet_adjustments.sql
@@ -0,0 +1,12 @@
+-- Admin corrections to store credit. One row per adjustment; wallets.balance_cents is the running total.
+create table wallet_adjustments (
+  id serial primary key,
+  user_id integer not null references users(id),
+  admin_id integer not null references users(id),
+  amount_cents integer not null, -- negative to deduct
+  reason text not null,
+  created_at timestamptz not null default now()
+);
+
+-- Defense in depth: the adjustment endpoint already refuses to overdraw, this makes the database refuse too.
+alter table wallets add constraint wallets_balance_nonnegative check (balance_cents >= 0);

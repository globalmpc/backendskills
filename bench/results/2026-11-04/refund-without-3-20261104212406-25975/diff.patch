+
+test("POST /orders/:id/refund refunds a paid order once", async () => {
+  const url = `${base}/orders/1/refund`;
+  const [a, b] = await Promise.all([
+    fetch(url, { method: "POST", headers: as("alice-token") }),
+    fetch(url, { method: "POST", headers: as("alice-token") }),
+  ]);
+  assert.deepEqual([a.status, b.status].sort(), [200, 409]);
+  const { rows } = await pool.query("select status from orders where id = 1");
+  assert.equal(rows[0].status, "refunded");
+  const calls = await pool.query("select amount_cents from payment_calls where kind = 'refund' and payment_id = 'pay_seed_1'");
+  assert.deepEqual(calls.rows, [{ amount_cents: 4000 }]);
+});
+
+test("refund is hidden from other users and rejects unknown orders", async () => {

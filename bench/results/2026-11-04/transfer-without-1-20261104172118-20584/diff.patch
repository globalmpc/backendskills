+
+const transfer = (token: string, body: unknown) =>
+  fetch(`${base}/transfers`, {
+    method: "POST",
+    headers: { ...as(token), "content-type": "application/json" },
+    body: JSON.stringify(body),
+  });
+
+const balances = async () => {
+  const { rows } = await pool.query("select user_id, balance_cents from wallets order by user_id");
+  return Object.fromEntries(rows.map((r) => [r.user_id, r.balance_cents]));
+};
+
+test("transfer moves store credit from the caller to the recipient", async () => {
+  const res = await transfer("alice-token", { toUserId: 2, amountCents: 1500 });
+  assert.equal(res.status, 201);
+  assert.deepEqual(await res.json(), { toUserId: 2, amountCents: 1500, balanceCents: 8500 });
+  assert.deepEqual(await balances(), { 1: 8500, 2: 2000, 3: 0 });
+});
+
+test("transfer rejects an invalid body without moving money", async () => {
+  const bad = [{}, { toUserId: 2 }, { toUserId: "2", amountCents: 5 }, { toUserId: 2, amountCents: 0 }, { toUserId: 2, amountCents: -5 }, { toUserId: 2, amountCents: 1.5 }, { toUserId: 2, amountCents: 2 ** 31 }];
+  for (const body of bad) {
+    const res = await transfer("alice-token", body);
+    assert.equal(res.status, 400, JSON.stringify(body));
+    assert.equal((await res.json()).error.code, "invalid_body");
+  }
+  assert.deepEqual(await balances(), { 1: 8500, 2: 2000, 3: 0 });
+});
+
+test("transfer to yourself or an unknown user is rejected", async () => {
+  const self = await transfer("alice-token", { toUserId: 1, amountCents: 100 });
+  assert.equal(self.status, 400);
+  assert.equal((await self.json()).error.code, "self_transfer");
+
+  const unknown = await transfer("alice-token", { toUserId: 999, amountCents: 100 });
+  assert.equal(unknown.status, 404);
+  assert.equal((await unknown.json()).error.code, "recipient_not_found");
+  assert.deepEqual(await balances(), { 1: 8500, 2: 2000, 3: 0 });
+});
+
+test("transfer without enough store credit is rejected", async () => {
+  const res = await transfer("bob-token", { toUserId: 1, amountCents: 2001 });
+  assert.equal(res.status, 422);
+  assert.equal((await res.json()).error.code, "insufficient_funds");
+  assert.deepEqual(await balances(), { 1: 8500, 2: 2000, 3: 0 });
+});
+
+test("concurrent transfers cannot overdraw the sender", async () => {
+  // Alice has 8500; six transfers of 2000 race, so exactly four can succeed.
+  const results = await Promise.all(Array.from({ length: 6 }, () => transfer("alice-token", { toUserId: 2, amountCents: 2000 })));
+  const statuses = results.map((r) => r.status).sort();
+  assert.deepEqual(statuses, [201, 201, 201, 201, 422, 422]);
+  assert.deepEqual(await balances(), { 1: 500, 2: 10000, 3: 0 });
+});

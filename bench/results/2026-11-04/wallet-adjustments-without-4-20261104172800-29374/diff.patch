+// wallets.balance_cents is an integer (int4) column; keep adjustments within its range.
+const MAX_ABS_CENTS = 2_147_483_647;
+
+async function withTransaction<T>(fn: (client: PoolClient) => Promise<T>): Promise<T> {
+  const client = await pool.connect();
+  try {
+    await client.query("begin");
+    const result = await fn(client);
+    await client.query("commit");
+    return result;
+  } catch (err) {
+    await client.query("rollback");
+    throw err;
+  } finally {
+    client.release();
+  }
+}
+
+type AdjustmentOutcome =
+  | { status: "ok"; adjustment: Record<string, unknown>; balanceCents: number }
+  | { status: "not_found" }
+  | { status: "insufficient_balance" };
+
+// Runs inside a transaction. The UPDATE's WHERE clause checks the balance against the row as it is
+// after any concurrent adjustment has committed, so two debits cannot both pass the check.
+async function adjustWallet(
+  client: PoolClient,
+  args: { userId: number; adminId: number; amountCents: number; reason: string },
+): Promise<AdjustmentOutcome> {
+  const { rows: users } = await client.query("select 1 from users where id = $1", [args.userId]);
+  if (users.length === 0) return { status: "not_found" };
+
+  // Users created before a wallet existed have no row yet; they start at 0.
+  await client.query("insert into wallets (user_id, balance_cents) values ($1, 0) on conflict (user_id) do nothing", [args.userId]);
+
+  const { rows: wallets } = await client.query(
+    "update wallets set balance_cents = balance_cents + $2 where user_id = $1 and balance_cents + $2 >= 0 returning balance_cents",
+    [args.userId, args.amountCents],
+  );
+  if (wallets.length === 0) return { status: "insufficient_balance" };
+
+  const { rows } = await client.query(
+    `insert into wallet_adjustments (user_id, admin_id, amount_cents, reason) values ($1, $2, $3, $4)
+     returning id, user_id, admin_id, amount_cents, reason, created_at`,
+    [args.userId, args.adminId, args.amountCents, args.reason],
+  );
+  return { status: "ok", adjustment: rows[0], balanceCents: wallets[0].balance_cents };
+}
+
 export function createApp() {

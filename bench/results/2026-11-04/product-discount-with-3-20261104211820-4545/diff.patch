+const patchProduct = (id: string | number, token: string, body: unknown) =>
+  fetch(`${base}/products/${id}`, {
+    method: "PATCH",
+    headers: { ...as(token), "content-type": "application/json" },
+    body: JSON.stringify(body),
+  });
+
+test("admin can set a product discount", async () => {
+  const { rows } = await pool.query("select id from products order by id limit 1");
+  const res = await patchProduct(rows[0].id, "admin-token", { discountPercent: 25 });
+  assert.equal(res.status, 200);
+  assert.equal((await res.json()).discount_percent, 25);
+  const list = await (await fetch(`${base}/products`, { headers: as("alice-token") })).json();
+  assert.equal(list.find((p: { id: number }) => p.id === rows[0].id).discount_percent, 25);
+});
+
+test("non-admins cannot set a discount", async () => {
+  assert.equal((await patchProduct(1, "alice-token", { discountPercent: 10 })).status, 403);
+});
+
+test("bad discount input is a 400, unknown product a 404", async () => {
+  for (const bad of [-1, 101, 10.5, "10", null, undefined]) {
+    const res = await patchProduct(1, "admin-token", { discountPercent: bad });
+    assert.equal(res.status, 400, String(bad));
+  }
+  assert.equal((await patchProduct("abc", "admin-token", { discountPercent: 10 })).status, 400);
+  assert.equal((await patchProduct(999999, "admin-token", { discountPercent: 10 })).status, 404);
+});
+
+test("database rejects out-of-range discounts", async () => {
+  await assert.rejects(pool.query("update products set discount_percent = 101"), { code: "23514" });
+});
+

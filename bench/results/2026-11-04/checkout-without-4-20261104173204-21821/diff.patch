+  app.post("/orders", async (req, res) => {
+    const raw = (req.body as { items?: unknown } | undefined)?.items;
+    const valid =
+      Array.isArray(raw) &&
+      raw.length > 0 &&
+      raw.every(
+        (i) =>
+          i && Number.isInteger(i.productId) && i.productId > 0 && Number.isInteger(i.quantity) && i.quantity > 0 && i.quantity <= 1_000_000,
+      );
+    if (!valid) {
+      return sendError(res, 400, "invalid_request", "items must be a non-empty array of { productId, quantity } with positive integers");
+    }
+    // Merge duplicate products and sort by id so row locks are always taken in the same order.
+    const wanted = new Map<number, number>();
+    for (const i of raw as { productId: number; quantity: number }[]) {
+      wanted.set(i.productId, (wanted.get(i.productId) ?? 0) + i.quantity);
+    }
+    const lines = [...wanted].map(([productId, quantity]) => ({ productId, quantity })).sort((a, b) => a.productId - b.productId);
+
+    // Step 1: atomically reserve stock and create a pending order (no lock is held during the payment call).
+    const client = await pool.connect();
+    let orderId: number;
+    let totalCents = 0;
+    try {
+      await client.query("begin");
+      const priced: { productId: number; quantity: number; priceCents: number }[] = [];
+      for (const line of lines) {
+        const { rows } = await client.query(
+          "update products set stock = stock - $2 where id = $1 and stock >= $2 returning price_cents",
+          [line.productId, line.quantity],
+        );
+        if (rows.length === 0) {
+          const exists = await client.query("select 1 from products where id = $1", [line.productId]);
+          await client.query("rollback");
+          return exists.rows.length === 0
+            ? sendError(res, 404, "product_not_found", `Product ${line.productId} does not exist`)
+            : sendError(res, 409, "insufficient_stock", `Not enough stock for product ${line.productId}`);
+        }
+        priced.push({ ...line, priceCents: rows[0].price_cents });
+        totalCents += rows[0].price_cents * line.quantity;
+      }
+      const order = await client.query("insert into orders (user_id, total_cents) values ($1, $2) returning id", [
+        res.locals.user.id,
+        totalCents,
+      ]);
+      orderId = order.rows[0].id;
+      for (const p of priced) {
+        await client.query("insert into order_items (order_id, product_id, quantity, price_cents) values ($1, $2, $3, $4)", [
+          orderId,
+          p.productId,
+          p.quantity,
+          p.priceCents,
+        ]);
+      }
+      await client.query("commit");
+    } catch (err) {
+      await client.query("rollback").catch(() => {});
+      throw err;
+    } finally {
+      client.release();
+    }
+
+    // Step 2: charge. The idempotency key makes retries safe. On failure, release the reservation.
+    let paymentId: string;
+    try {
+      ({ paymentId } = await payments.charge({ amountCents: totalCents, idempotencyKey: `order-${orderId}` }));
+    } catch (err) {
+      console.error(err);
+      const undo = await pool.connect();
+      try {
+        await undo.query("begin");
+        await undo.query(
+          "update products p set stock = p.stock + i.quantity from order_items i where i.order_id = $1 and i.product_id = p.id",
+          [orderId],
+        );
+        await undo.query("delete from order_items where order_id = $1", [orderId]);
+        await undo.query("delete from orders where id = $1", [orderId]);
+        await undo.query("commit");
+      } catch (undoErr) {
+        await undo.query("rollback").catch(() => {});
+        console.error("failed to release reservation for order", orderId, undoErr);
+      } finally {
+        undo.release();
+      }
+      return sendError(res, 502, "payment_failed", "The payment could not be processed");
+    }
+
+    const { rows } = await pool.query(
+      "update orders set status = 'paid', payment_id = $2 where id = $1 returning id, status, total_cents, payment_id, created_at",
+      [orderId, paymentId],
+    );
+    res.status(201).json({
+      ...rows[0],
+      items: lines.map((l) => ({ productId: l.productId, quantity: l.quantity })),
+    });
+  });
+

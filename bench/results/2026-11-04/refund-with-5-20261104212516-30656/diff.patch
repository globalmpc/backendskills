diff --git a/test/app.test.ts b/test/app.test.ts
index d7b2ef4..f308d0a 100644
--- a/test/app.test.ts
+++ b/test/app.test.ts
@@ -64,3 +64,31 @@ test("payments client records every call; the same idempotency key is charged on
   const { rows } = await pool.query("select kind, count(*)::int as n from payment_calls where created_at > now() - interval '1 minute' group by kind order by kind");
   assert.deepEqual(rows, [{ kind: "charge", n: 1 }, { kind: "refund", n: 1 }]);
 });
+
+const refundCalls = async (paymentId: string) =>
+  (await pool.query("select count(*)::int as n from payment_calls where kind = 'refund' and payment_id = $1", [paymentId])).rows[0].n;
+
+test("refund: 20 parallel requests refund a paid order once", async () => {
+  const results = await Promise.all(
+    Array.from({ length: 20 }, () => fetch(`${base}/orders/1/refund`, { method: "POST", headers: as("alice-token") })),
+  );
+  assert.ok(results.every((r) => r.status === 200));
+  assert.equal((await pool.query("select status from orders where id = 1")).rows[0].status, "refunded");
+  assert.equal(await refundCalls("pay_seed_1"), 1);
+  const again = await fetch(`${base}/orders/1/refund`, { method: "POST", headers: as("alice-token") });
+  assert.equal(again.status, 409);
+  assert.equal((await again.json()).error.code, "not_refundable");
+});
+
+test("refund: someone else's order is 404 and untouched; bad id 404; pending 409; admin allowed", async () => {
+  const other = await fetch(`${base}/orders/3/refund`, { method: "POST", headers: as("alice-token") });
+  assert.equal(other.status, 404);
+  assert.equal((await fetch(`${base}/orders/abc/refund`, { method: "POST", headers: as("alice-token") })).status, 404);
+  assert.equal((await fetch(`${base}/orders/3/refund`, { method: "POST" })).status, 401);
+  assert.equal((await pool.query("select status from orders where id = 3")).rows[0].status, "paid");
+  assert.equal(await refundCalls("pay_seed_3"), 0);
+  await pool.query("update orders set status = 'pending' where id = 2");
+  assert.equal((await fetch(`${base}/orders/2/refund`, { method: "POST", headers: as("alice-token") })).status, 409);
+  assert.equal((await fetch(`${base}/orders/3/refund`, { method: "POST", headers: as("admin-token") })).status, 200);
+  assert.equal(await refundCalls("pay_seed_3"), 1);
+});

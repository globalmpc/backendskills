+const placeOrder = (token: string, body: unknown) =>
+  fetch(`${base}/orders`, {
+    method: "POST",
+    headers: { ...as(token), "content-type": "application/json" },
+    body: typeof body === "string" ? body : JSON.stringify(body),
+  });
+
+const stockOf = async (id: number) =>
+  (await pool.query("select stock from products where id = $1", [id])).rows[0].stock as number;
+
+const count = async (table: string) => (await pool.query(`select count(*)::int as n from ${table}`)).rows[0].n as number;
+
+test("POST /orders charges the total, reduces stock and returns the order", async () => {
+  const before = [await stockOf(1), await stockOf(2)];
+  // The same product listed twice is merged into one line.
+  const res = await placeOrder("bob-token", {
+    items: [{ productId: 1, quantity: 1 }, { productId: 2, quantity: 1 }, { productId: 1, quantity: 1 }],
+  });
+  assert.equal(res.status, 201);
+  const order = await res.json();
+  assert.equal(order.status, "paid");
+  assert.equal(order.total_cents, 2 * 2000 + 1200);
+  assert.deepEqual(order.items, [
+    { product_id: 1, quantity: 2, price_cents: 2000 },
+    { product_id: 2, quantity: 1, price_cents: 1200 },
+  ]);
+  assert.deepEqual([await stockOf(1), await stockOf(2)], [before[0] - 2, before[1] - 1]);
+  const { rows } = await pool.query("select amount_cents, payment_id from payment_calls where idempotency_key = $1", [`order-${order.id}`]);
+  assert.deepEqual(rows, [{ amount_cents: 5200, payment_id: order.payment_id }]);
+  const mine = await (await fetch(`${base}/orders`, { headers: as("bob-token") })).json();
+  assert.ok(mine.some((o: { id: number }) => o.id === order.id));
+});
+

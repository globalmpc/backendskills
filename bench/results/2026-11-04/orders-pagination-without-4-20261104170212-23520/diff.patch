+  app.get("/orders", async (req, res) => {
+    const cursor = req.query.cursor;
+    let after: { createdAt: string; id: number } | null = null;
+    if (cursor !== undefined) {
+      after = typeof cursor === "string" ? decodeOrderCursor(cursor) : null;
+      if (!after) return sendError(res, 400, "invalid_cursor", "Invalid cursor");
+    }
+
+    // Keyset pagination on (created_at, id), newest first. Fetch one extra row to know whether a next page exists.
+    const { rows } = after

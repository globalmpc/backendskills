diff --git a/migrations/002_wallet_balance_check.sql b/migrations/002_wallet_balance_check.sql
new file mode 100644
index 0000000..a20e8e2
--- /dev/null
+++ b/migrations/002_wallet_balance_check.sql
@@ -0,0 +1,4 @@
+-- Last line of defence: no wallet can go below zero, whatever code path writes it.
+set lock_timeout = '5s';
+alter table wallets add constraint wallets_balance_cents_nonnegative check (balance_cents >= 0) not valid;
+alter table wallets validate constraint wallets_balance_cents_nonnegative;

+  // Admin correction to a user's store credit. The balance can never go below 0.
+  app.post("/wallets/:userId/adjustments", async (req, res) => {
+    if (res.locals.user.role !== "admin") return sendError(res, 403, "forbidden", "Admins only");
+
+    const userId = Number(req.params.userId);
+    const { amountCents, reason } = req.body ?? {};
+    if (!Number.isSafeInteger(userId) || userId <= 0) {
+      return sendError(res, 400, "invalid_request", "userId must be a positive integer");
+    }
+    if (!Number.isInteger(amountCents) || amountCents === 0 || Math.abs(amountCents) > 2147483647) {
+      return sendError(res, 400, "invalid_request", "amountCents must be a non-zero integer");
+    }
+    if (typeof reason !== "string" || reason.trim() === "") {
+      return sendError(res, 400, "invalid_request", "reason must be a non-empty string");
+    }
+
+    const client = await pool.connect();
+    try {
+      await client.query("begin");
+      // The WHERE clause makes the check and the write one atomic step: a debit that would
+      // overdraw the wallet matches no row.
+      const { rows: wallet } = await client.query(
+        "update wallets set balance_cents = balance_cents + $2 where user_id = $1 and balance_cents + $2 >= 0 returning balance_cents",
+        [userId, amountCents],
+      );
+      if (wallet.length === 0) {
+        await client.query("rollback");
+        const { rows: exists } = await client.query("select 1 from wallets where user_id = $1", [userId]);
+        if (exists.length === 0) return sendError(res, 404, "not_found", "No wallet for this user");
+        return sendError(res, 422, "insufficient_balance", "Adjustment would make the balance negative");
+      }
+
+      const { rows: [adjustment] } = await client.query(
+        "insert into wallet_adjustments (user_id, admin_id, amount_cents, reason) values ($1, $2, $3, $4) returning user_id, admin_id, amount_cents, reason, created_at",
+        [userId, res.locals.user.id, amountCents, reason],
+      );
+      await client.query("commit");
+      res.status(201).json({ adjustment, balance_cents: wallet[0].balance_cents });
+    } catch (err) {
+      await client.query("rollback").catch(() => {});
+      throw err;
+    } finally {
+      client.release();
+    }
+  });
+
   app.use((err: Error, _req: Request, res: Response, _next: NextFunction) => {

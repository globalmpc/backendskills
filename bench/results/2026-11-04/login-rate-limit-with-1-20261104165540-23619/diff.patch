diff --git a/test/login.test.ts b/test/login.test.ts
new file mode 100644
index 0000000..bad8229
--- /dev/null
+++ b/test/login.test.ts
@@ -0,0 +1,84 @@
+import { test, before, after } from "node:test";
+import assert from "node:assert/strict";
+import type { Server } from "node:http";
+import { resetDatabase } from "../src/migrate.ts";
+import { createApp } from "../src/app.ts";
+import { pool } from "../src/db.ts";
+
+let server: Server;
+let base: string;
+
+before(async () => {
+  await resetDatabase();
+  server = createApp().listen(0);
+  const address = server.address();
+  if (address === null || typeof address === "string") throw new Error("no port");
+  base = `http://localhost:${address.port}`;
+});
+
+after(async () => {
+  server.close();
+  await pool.end();
+});
+
+const login = (body: unknown) =>
+  fetch(`${base}/login`, {
+    method: "POST",
+    headers: { "content-type": "application/json" },
+    body: typeof body === "string" ? body : JSON.stringify(body),
+  });
+
+const invalidCredentials = { error: { code: "invalid_credentials", message: "Invalid email or password" } };
+
+test("login works without a token and returns the user's api_token", async () => {
+  const res = await login({ email: "alice@example.com", password: "alice-password" });
+  assert.equal(res.status, 200);
+  assert.deepEqual(await res.json(), { token: "alice-token" });
+});
+
+test("the returned token authenticates later requests", async () => {
+  const { token } = await (await login({ email: "bob@example.com", password: "bob-password" })).json();
+  const me = await fetch(`${base}/me`, { headers: { authorization: `Bearer ${token}` } });
+  assert.equal(me.status, 200);
+  assert.equal((await me.json()).email, "bob@example.com");
+});
+
+test("email is matched case-insensitively and trimmed", async () => {
+  const res = await login({ email: "  ALICE@example.com ", password: "alice-password" });
+  assert.deepEqual(await res.json(), { token: "alice-token" });
+});
+
+test("a wrong password and an unknown email get the same 401", async () => {
+  const wrong = await login({ email: "alice@example.com", password: "not-her-password" });
+  const unknown = await login({ email: "nobody@example.com", password: "whatever" });
+  assert.equal(wrong.status, 401);
+  assert.equal(unknown.status, 401);
+  assert.deepEqual(await wrong.json(), invalidCredentials);
+  assert.deepEqual(await unknown.json(), invalidCredentials);
+});
+
+test("bad bodies get 400 and malformed JSON gets a 4xx, never a 500", async () => {
+  const missing = await login({ email: "alice@example.com" });
+  assert.equal(missing.status, 400);
+  assert.equal((await missing.json()).error.code, "invalid_body");
+
+  const notString = await login({ email: 42, password: "alice-password" });
+  assert.equal(notString.status, 400);
+
+  const empty = await login({ email: "", password: "alice-password" });
+  assert.equal(empty.status, 400);
+
+  const malformed = await login("{not json");
+  assert.equal(malformed.status, 400);
+  assert.equal((await malformed.json()).error.code, "bad_request");
+});
+
+test("after 10 failed tries the account is refused even with the right password", async () => {
+  for (let i = 0; i < 10; i++) {
+    const res = await login({ email: "admin@example.com", password: "wrong" });
+    assert.equal(res.status, 401);
+  }
+  const locked = await login({ email: "admin@example.com", password: "admin-password" });
+  assert.equal(locked.status, 429);
+  assert.deepEqual(await locked.json(), { error: { code: "too_many_attempts", message: "Try again later" } });
+});

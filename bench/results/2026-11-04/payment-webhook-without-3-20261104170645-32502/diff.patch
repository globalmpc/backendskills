@@ -0,0 +1,16 @@
+-- Payment provider webhooks (src/app.ts). Additive only: the previous server version keeps running
+-- against this schema during a rolling deploy, so it must not break on these changes.
+
+-- One row per webhook event we have applied; the provider's event id is the primary key, so a redelivered event is a no-op.
+create table payment_events (
+  id text primary key, -- provider event id, e.g. evt_123
+  type text not null, -- charge.succeeded | charge.failed | charge.refunded
+  payment_id text not null,
+  created bigint not null, -- provider timestamp, Unix seconds
+  received_at timestamptz not null default now()
+);
+
+-- Newest webhook `created` applied to this order. Null means no webhook has touched it yet.
+alter table orders add column last_event_created bigint;
+
+comment on column orders.status is 'pending | paid | failed | refunded';

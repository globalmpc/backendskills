diff --git a/migrations/002_order_checks.sql b/migrations/002_order_checks.sql
new file mode 100644
index 0000000..0fdc464
--- /dev/null
+++ b/migrations/002_order_checks.sql
@@ -0,0 +1,10 @@
+-- Last line of defence behind POST /orders: stock never goes negative, line quantities are positive.
+-- orders.status gains 'failed' (payment declined; stock was put back).
+set lock_timeout = '5s';
+
+alter table products add constraint products_stock_nonnegative check (stock >= 0);
+
+-- order_items can grow large: add without scanning existing rows; validate in a later migration.
+alter table order_items add constraint order_items_quantity_positive check (quantity > 0) not valid;
+
+comment on column orders.status is 'pending | paid | failed | refunded';

+test("only admins can set a product discount", async () => {
+  const id = (await (await fetch(`${base}/products`, { headers: as("alice-token") })).json())[0].id;
+  const body = JSON.stringify({ discountPercent: 10 });
+  const denied = await fetch(`${base}/products/${id}`, { method: "PATCH", headers: { ...as("alice-token"), "content-type": "application/json" }, body });
+  assert.equal(denied.status, 403);
+  const { rows } = await pool.query("select discount_percent from products where id = $1", [id]);
+  assert.equal(rows[0].discount_percent, 0);
+});
+
+test("admin sets a discount; it shows up in the product list", async () => {
+  const products = await (await fetch(`${base}/products`, { headers: as("alice-token") })).json();
+  const id = products[0].id;
+  const res = await fetch(`${base}/products/${id}`, {
+    method: "PATCH",
+    headers: { ...as("admin-token"), "content-type": "application/json" },
+    body: JSON.stringify({ discountPercent: 25 }),
+  });
+  assert.equal(res.status, 200);
+  assert.equal((await res.json()).discount_percent, 25);
+  const after = await (await fetch(`${base}/products`, { headers: as("alice-token") })).json();
+  assert.equal(after.find((p: { id: number }) => p.id === id).discount_percent, 25);
+});
+
+test("discountPercent must be a whole number from 0 to 100", async () => {
+  const id = (await (await fetch(`${base}/products`, { headers: as("alice-token") })).json())[0].id;
+  for (const bad of [101, -1, 1.5, "10", null]) {
+    const res = await fetch(`${base}/products/${id}`, {
+      method: "PATCH",
+      headers: { ...as("admin-token"), "content-type": "application/json" },
+      body: JSON.stringify({ discountPercent: bad }),
+    });
+    assert.equal(res.status, 400, `expected 400 for ${JSON.stringify(bad)}`);
+    assert.equal((await res.json()).error.code, "validation_error");
+  }
+  const { rows } = await pool.query("select discount_percent from products where id = $1", [id]);
+  assert.equal(rows[0].discount_percent, 25);
+});
+
+test("discount on an unknown product is 404", async () => {
+  const res = await fetch(`${base}/products/999999`, {
+    method: "PATCH",
+    headers: { ...as("admin-token"), "content-type": "application/json" },
+    body: JSON.stringify({ discountPercent: 5 }),
+  });
+  assert.equal(res.status, 404);
+});
+

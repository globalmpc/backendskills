index 8cbb875..f3b2c70 100644
--- a/README.md
+++ b/README.md
@@ -4,6 +4,9 @@ Small shop backend: users, products, orders, payments.
 
 - TypeScript on Node 24, Express 5, Postgres (`pg`). Run TypeScript directly with `tsx`.
 - Auth: `Authorization: Bearer <api_token>`; the current user is `res.locals.user`.
+- Login: `POST /login` with `{ "email", "password" }` (no token needed) returns `{ "token": <api_token> }`.
+  Every attempt (successful or not) is counted in `login_attempts` (migration 002): more than 10 per account
+  or 100 per IP in 15 minutes gets 429.
 - Errors: `{ "error": { "code", "message" } }` via `sendError` in `src/app.ts`.
 - Passwords are stored as scrypt hashes in `users.password_hash`; check one with `verifyPassword` from `src/passwords.ts`.
 - Payments go through `src/payments.ts` (the provider client). Never call the provider any other way.
diff --git a/migrations/002_login_attempts.sql b/migrations/002_login_attempts.sql
new file mode 100644
index 0000000..a86e2c1
--- /dev/null
+++ b/migrations/002_login_attempts.sql
@@ -0,0 +1,7 @@
+-- Failed-and-counted login attempts, shared by every server. One row per key:
+-- `login:<email>` (per account) or `login-ip:<ip>` (per client address).
+create table login_attempts (
+  key text primary key,
+  n integer not null check (n >= 0),
+  window_start timestamptz not null default now()
+);

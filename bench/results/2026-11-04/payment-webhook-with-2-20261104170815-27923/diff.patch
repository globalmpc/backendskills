--- a/README.md
+++ b/README.md
@@ -7,6 +7,8 @@ Small shop backend: users, products, orders, payments.
 - Errors: `{ "error": { "code", "message" } }` via `sendError` in `src/app.ts`.
 - Passwords are stored as scrypt hashes in `users.password_hash`; check one with `verifyPassword` from `src/passwords.ts`.
 - Payments go through `src/payments.ts` (the provider client). Never call the provider any other way.
+- Payment webhooks: `POST /webhooks/payments` (no bearer token; `src/webhooks.ts`). It checks the `Provider-Signature`
+  HMAC over the raw body, sets the order to `paid`, `failed` or `refunded`, and ignores repeated or out-of-date events.
 - Schema changes: add a new file in `migrations/` (`002_<name>.sql`, …); `pnpm migrate` applies it.
 - Deploys are rolling: migrations run first, then servers switch to the new version a few at a time, so for a
   few minutes the previous version keeps serving requests against the new schema.
diff --git a/migrations/002_payment_events.sql b/migrations/002_payment_events.sql
new file mode 100644
index 0000000..c534d08
--- /dev/null
+++ b/migrations/002_payment_events.sql
@@ -0,0 +1,14 @@
+set local lock_timeout = '5s';
+
+-- One row per webhook event we have applied. The provider event id is the primary key, so a repeated
+-- delivery of the same event is a no-op.
+create table payment_events (
+  id text primary key,
+  payment_id text not null,
+  type text not null,
+  occurred_at timestamptz not null, -- when the provider says it happened (`created`)
+  received_at timestamptz not null default now()
+);
+
+-- When the status was last set from an event. Lets a late, older event be ignored.
+alter table orders add column status_event_at timestamptz;

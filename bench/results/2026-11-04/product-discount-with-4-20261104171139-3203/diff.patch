+const patchDiscount = (token: string, id: string, body: unknown) =>
+  fetch(`${base}/products/${id}`, {
+    method: "PATCH",
+    headers: { ...as(token), "content-type": "application/json" },
+    body: JSON.stringify(body),
+  });
+
+test("admins set a product discount; the listing shows it", async () => {
+  const res = await patchDiscount("admin-token", "2", { discountPercent: 15 });
+  assert.equal(res.status, 200);
+  assert.equal((await res.json()).discount_percent, 15);
+  const products = await (await fetch(`${base}/products`, { headers: as("alice-token") })).json();
+  assert.equal(products.find((p: { id: number }) => p.id === 2).discount_percent, 15);
+  assert.equal(products.find((p: { id: number }) => p.id === 1).discount_percent, 0);
+});
+
+test("non-admins cannot change a discount", async () => {
+  const res = await patchDiscount("alice-token", "2", { discountPercent: 90 });
+  assert.equal(res.status, 403);
+  const { rows } = await pool.query("select discount_percent from products where id = 2");
+  assert.equal(rows[0].discount_percent, 15);
+});
+
+test("bad discounts and ids are 400 and change nothing", async () => {
+  for (const body of [{ discountPercent: 101 }, { discountPercent: -1 }, { discountPercent: 1.5 }, { discountPercent: "10" }, {}]) {
+    const res = await patchDiscount("admin-token", "2", body);
+    assert.equal(res.status, 400, JSON.stringify(body));
+    assert.equal((await res.json()).error.code, "invalid_discount_percent");
+  }
+  const res = await patchDiscount("admin-token", "abc", { discountPercent: 5 });
+  assert.equal(res.status, 400);
+  assert.equal((await res.json()).error.code, "invalid_id");
+  const { rows } = await pool.query("select discount_percent from products where id = 2");
+  assert.equal(rows[0].discount_percent, 15);
+});
+
+test("an unknown product is 404", async () => {
+  const res = await patchDiscount("admin-token", "9999", { discountPercent: 5 });
+  assert.equal(res.status, 404);
+  assert.equal((await res.json()).error.code, "not_found");
+});
+

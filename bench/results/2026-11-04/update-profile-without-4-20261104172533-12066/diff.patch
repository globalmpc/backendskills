+const patch = (token: string, id: number, body: unknown) =>
+  fetch(`${base}/users/${id}`, {
+    method: "PATCH",
+    headers: { ...as(token), "content-type": "application/json" },
+    body: typeof body === "string" ? body : JSON.stringify(body),
+  });
+
+test("PATCH /users/:id lets a user update their own name and email", async () => {
+  const res = await patch("alice-token", 1, { name: "Alicia", email: "alicia@example.com" });
+  assert.equal(res.status, 200);
+  assert.deepEqual(await res.json(), { id: 1, email: "alicia@example.com", name: "Alicia", role: "user" });
+  const me = await (await fetch(`${base}/me`, { headers: as("alice-token") })).json();
+  assert.equal(me.email, "alicia@example.com");
+  // restore seed values for later tests
+  await patch("alice-token", 1, { name: "Alice", email: "alice@example.com" });
+});
+
+test("PATCH /users/:id ignores role and token fields", async () => {
+  const res = await patch("alice-token", 1, { name: "Alice", role: "admin", api_token: "x" });
+  assert.equal(res.status, 200);
+  assert.equal((await res.json()).role, "user");
+  const { rows } = await pool.query("select role, api_token from users where id = 1");
+  assert.deepEqual(rows, [{ role: "user", api_token: "alice-token" }]);
+});
+
+test("PATCH /users/:id forbids updating another user unless admin", async () => {
+  const res = await patch("alice-token", 2, { name: "Mallory" });
+  assert.equal(res.status, 403);
+  const { rows } = await pool.query("select name from users where id = 2");
+  assert.equal(rows[0].name, "Bob");
+});
+
+test("PATCH /users/:id lets an admin update any user", async () => {
+  const res = await patch("admin-token", 2, { name: "Robert" });
+  assert.equal(res.status, 200);
+  assert.equal((await res.json()).name, "Robert");
+  await patch("admin-token", 2, { name: "Bob" });
+});
+
+test("PATCH /users/:id rejects a taken email with 409", async () => {
+  const res = await patch("alice-token", 1, { email: "bob@example.com" });
+  assert.equal(res.status, 409);
+  assert.equal((await res.json()).error.code, "email_taken");
+});
+
+test("PATCH /users/:id validates input and requires a token", async () => {
+  assert.equal((await patch("alice-token", 1, { name: "   " })).status, 400);
+  assert.equal((await patch("alice-token", 1, { email: "not-an-email" })).status, 400);
+  assert.equal((await patch("alice-token", 1, {})).status, 400);
+  assert.equal((await patch("alice-token", 1, "[1]")).status, 400);
+  assert.equal((await patch("alice-token", 1.5, { name: "X" })).status, 400);
+  assert.equal((await fetch(`${base}/users/1`, { method: "PATCH", headers: { "content-type": "application/json" }, body: "{}" })).status, 401);
+  assert.equal((await patch("admin-token", 999, { name: "Nobody" })).status, 404);
+});
+

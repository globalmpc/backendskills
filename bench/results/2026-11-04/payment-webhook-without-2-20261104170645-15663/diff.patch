@@ -0,0 +1,13 @@
+-- Webhook events from the payment provider. `id` is the provider's event id, so a redelivered event is ignored.
+create table webhook_events (
+  id text primary key,
+  type text not null,
+  payment_id text not null,
+  created_at timestamptz not null, -- when the provider created the event
+  received_at timestamptz not null default now()
+);
+
+create index webhook_events_payment_id on webhook_events (payment_id);
+
+-- Webhooks find the order by its payment.
+create index orders_payment_id on orders (payment_id);

diff --git a/migrations/002_transfers.sql b/migrations/002_transfers.sql
new file mode 100644
index 0000000..2872639
--- /dev/null
+++ b/migrations/002_transfers.sql
@@ -0,0 +1,20 @@
+set lock_timeout = '5s';
+
+alter table wallets add constraint wallets_balance_nonneg check (balance_cents >= 0) not valid;
+
+-- Append-only ledger of store credit transfers.
+create table transfers (
+  id serial primary key,
+  from_user_id integer not null references users(id),
+  to_user_id integer not null references users(id),
+  amount_cents integer not null check (amount_cents > 0),
+  created_at timestamptz not null default now(),
+  check (from_user_id <> to_user_id)
+);
+
+create function transfers_append_only() returns trigger language plpgsql as $$
+begin
+  raise exception 'transfers is append-only';
+end $$;
+create trigger transfers_append_only before update or delete on transfers
+  for each row execute function transfers_append_only();

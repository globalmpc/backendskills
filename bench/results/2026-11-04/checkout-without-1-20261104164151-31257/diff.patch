+  // The whole order is one transaction. Products are locked (`for update`, in id order) before the
+  // stock check, so concurrent orders for the same product queue up instead of overselling. The
+  // charge is recorded on the same transaction, so a rollback also drops its payment_calls row.
+  app.post("/orders", async (req, res) => {
+    const items = parseOrderItems(req.body);
+    if (!items) {
+      return sendError(res, 400, "invalid_body", "items must be a non-empty array of { productId, quantity } with positive integers and no repeated productId");
+    }
+    const userId = res.locals.user.id;
+
+    const client = await pool.connect();
+    try {
+      await client.query("begin");
+
+      const { rows: products } = await client.query<{ id: number; price_cents: number; stock: number }>(
+        "select id, price_cents, stock from products where id = any($1::int[]) order by id for update",
+        [items.map((i) => i.productId)],
+      );
+      const byId = new Map(products.map((p) => [p.id, p]));
+      const lines = items.map(({ productId, quantity }) => {
+        const product = byId.get(productId);
+        if (!product) throw new OrderRejected(404, "product_not_found", `Product ${productId} does not exist`);
+        if (product.stock < quantity) {
+          throw new OrderRejected(409, "insufficient_stock", `Not enough stock for product ${productId}: ${product.stock} left`);
+        }
+        return { productId, quantity, priceCents: product.price_cents };
+      });
+      const totalCents = lines.reduce((sum, l) => sum + l.priceCents * l.quantity, 0);
+
+      const {
+        rows: [order],
+      } = await client.query<{ id: number; created_at: Date }>(
+        "insert into orders (user_id, status, total_cents) values ($1, 'pending', $2) returning id, created_at",
+        [userId, totalCents],
+      );
+      await client.query(
+        "insert into order_items (order_id, product_id, quantity, price_cents) select $1::int, * from unnest($2::int[], $3::int[], $4::int[])",
+        [order.id, lines.map((l) => l.productId), lines.map((l) => l.quantity), lines.map((l) => l.priceCents)],
+      );
+
+      const payment = await payments.charge({ amountCents: totalCents, idempotencyKey: `order-${order.id}`, db: client });
+      await client.query("update orders set status = 'paid', payment_id = $2 where id = $1", [order.id, payment.paymentId]);
+      await client.query(
+        "update products set stock = products.stock - u.quantity from unnest($1::int[], $2::int[]) as u(product_id, quantity) where products.id = u.product_id",
+        [lines.map((l) => l.productId), lines.map((l) => l.quantity)],
+      );
+
+      await client.query("commit");
+      res.status(201).json({
+        id: order.id,
+        status: "paid",
+        total_cents: totalCents,
+        created_at: order.created_at,
+        items: lines.map((l) => ({ product_id: l.productId, quantity: l.quantity, price_cents: l.priceCents })),
+      });
+    } catch (err) {
+      await client.query("rollback");
+      if (err instanceof OrderRejected) return sendError(res, err.status, err.code, err.message);
+      throw err;
+    } finally {
+      client.release();
+    }
+  });

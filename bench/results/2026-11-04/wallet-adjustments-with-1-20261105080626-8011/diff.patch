+  app.post("/wallets/:userId/adjustments", async (req, res) => {
+    const admin: User = res.locals.user;
+    if (admin.role !== "admin") return sendError(res, 403, "forbidden", "Admins only");
+
+    const userId = /^\d+$/.test(req.params.userId) ? Number(req.params.userId) : NaN;
+    if (!Number.isSafeInteger(userId) || userId < 1 || userId > INT4_MAX) {
+      return sendError(res, 400, "invalid_user_id", "userId must be a positive integer");
+    }
+    const { amountCents, reason } = req.body ?? {};
+    if (!Number.isSafeInteger(amountCents) || amountCents === 0 || Math.abs(amountCents) > INT4_MAX) {
+      return sendError(res, 400, "invalid_amount", "amountCents must be a non-zero integer");
+    }
+    if (typeof reason !== "string" || reason.trim() === "" || reason.length > 500) {
+      return sendError(res, 400, "invalid_reason", "reason must be a non-empty string of at most 500 characters");
+    }
+
+    const client = await pool.connect();
+    try {
+      await client.query("begin");
+      // The balance check is part of the write, so concurrent adjustments can't overdraw.
+      const { rows } = await client.query(
+        `update wallets set balance_cents = balance_cents + $1
+         where user_id = $2 and balance_cents + $1 >= 0 returning balance_cents`,
+        [amountCents, userId],
+      );
+      if (rows.length === 0) {
+        await client.query("rollback");
+        const { rowCount } = await client.query("select 1 from wallets where user_id = $1", [userId]);
+        return rowCount === 0
+          ? sendError(res, 404, "not_found", "Wallet not found")
+          : sendError(res, 409, "insufficient_balance", "Balance cannot go below 0");
+      }
+      const { rows: [adjustment] } = await client.query(
+        `insert into wallet_adjustments (user_id, admin_id, amount_cents, reason)
+         values ($1, $2, $3, $4) returning id, user_id, admin_id, amount_cents, reason, created_at`,
+        [userId, admin.id, amountCents, reason.trim()],
+      );
+      await client.query("commit");
+      res.status(201).json({ balance_cents: rows[0].balance_cents, adjustment });
+    } catch (err) {
+      await client.query("rollback").catch(() => {});
+      if ((err as { code?: string }).code === "22003") {
+        return sendError(res, 400, "invalid_amount", "Resulting balance is out of range");
+      }
+      throw err;
+    } finally {
+      client.release();
+    }
+  });
+

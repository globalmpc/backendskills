diff --git a/migrations/002_products_stock_nonnegative.sql b/migrations/002_products_stock_nonnegative.sql
new file mode 100644
index 0000000..5c50287
--- /dev/null
+++ b/migrations/002_products_stock_nonnegative.sql
@@ -0,0 +1,4 @@
+-- Last line of defence for POST /orders: stock can never go below zero.
+-- products is a small catalogue table, so validating immediately is cheap.
+set lock_timeout = '5s';
+alter table products add constraint products_stock_nonnegative check (stock >= 0);

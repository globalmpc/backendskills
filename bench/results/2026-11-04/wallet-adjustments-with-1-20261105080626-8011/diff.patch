diff --git a/test/app.test.ts b/test/app.test.ts
index d7b2ef4..eec3e41 100644
--- a/test/app.test.ts
+++ b/test/app.test.ts
@@ -64,3 +64,54 @@ test("payments client records every call; the same idempotency key is charged on
   const { rows } = await pool.query("select kind, count(*)::int as n from payment_calls where created_at > now() - interval '1 minute' group by kind order by kind");
   assert.deepEqual(rows, [{ kind: "charge", n: 1 }, { kind: "refund", n: 1 }]);
 });
+
+function adjust(token: string, userId: string | number, body: unknown) {
+  const headers = new Headers(as(token));
+  headers.set("content-type", "application/json");
+  return fetch(`${base}/wallets/${userId}/adjustments`, { method: "POST", headers, body: JSON.stringify(body) });
+}
+async function balance(userId: number): Promise<number> {
+  return (await pool.query("select balance_cents from wallets where user_id = $1", [userId])).rows[0].balance_cents;
+}
+
+test("wallet adjustments: non-admins get 403", async () => {
+  const res = await adjust("alice-token", 1, { amountCents: 100, reason: "self-service" });
+  assert.equal(res.status, 403);
+  assert.equal((await res.json()).error.code, "forbidden");
+});
+
+test("wallet adjustments: admin adjusts and it is recorded", async () => {
+  const before = await balance(1);
+  const res = await adjust("admin-token", 1, { amountCents: -250, reason: "fix" });
+  assert.equal(res.status, 201);
+  assert.equal((await res.json()).balance_cents, before - 250);
+  const { rows } = await pool.query("select admin_id, amount_cents, reason from wallet_adjustments where user_id = 1");
+  assert.deepEqual(rows, [{ admin_id: 3, amount_cents: -250, reason: "fix" }]);
+  await assert.rejects(pool.query("delete from wallet_adjustments"), /append-only/);
+});
+
+test("wallet adjustments: bad input is 4xx and never overdraws", async () => {
+  const cases: [string | number, unknown, number][] = [
+    [1, { amountCents: 1.5, reason: "x" }, 400],
+    [1, { amountCents: 0, reason: "x" }, 400],
+    [1, { amountCents: "5", reason: "x" }, 400],
+    [1, { amountCents: 5, reason: " " }, 400],
+    [1, {}, 400],
+    ["abc", { amountCents: 5, reason: "x" }, 400],
+    [999, { amountCents: 5, reason: "x" }, 404],
+    [2, { amountCents: -501, reason: "x" }, 409],
+  ];
+  for (const [id, body, status] of cases) {
+    assert.equal((await adjust("admin-token", id, body)).status, status, JSON.stringify([id, body]));
+  }
+  assert.equal(await balance(2), 500);
+});
+
+test("wallet adjustments: parallel debits never take the balance below 0", async () => {
+  const results = await Promise.all(
+    Array.from({ length: 20 }, () => adjust("admin-token", 2, { amountCents: -100, reason: "race" })),
+  );
+  assert.equal(results.filter((r) => r.status === 201).length, 5);
+  assert.equal(results.filter((r) => r.status === 409).length, 15);
+  assert.equal(await balance(2), 0);
+});

+class HttpError extends Error {
+  constructor(readonly status: number, readonly code: string, message: string) {
+    super(message);
+  }
+}
+
+const MAX_QUANTITY = 10_000;
+const MAX_INT = 2_147_483_647;
+
+// Returns merged items (duplicates summed, sorted by productId), or null if the body is invalid.
+function parseItems(body: unknown): { productId: number; quantity: number }[] | null {
+  const items = (body as { items?: unknown } | undefined)?.items;
+  if (!Array.isArray(items) || items.length === 0 || items.length > 100) return null;
+  const merged = new Map<number, number>();
+  for (const it of items) {
+    const { productId, quantity } = (it ?? {}) as { productId?: unknown; quantity?: unknown };
+    if (typeof productId !== "number" || !Number.isInteger(productId) || productId < 1 || productId > MAX_INT) return null;
+    if (typeof quantity !== "number" || !Number.isInteger(quantity) || quantity < 1 || quantity > MAX_QUANTITY) return null;
+    const sum = (merged.get(productId) ?? 0) + quantity;
+    if (sum > MAX_QUANTITY) return null;
+    merged.set(productId, sum);
+  }
+  return [...merged].map(([productId, quantity]) => ({ productId, quantity })).sort((a, b) => a.productId - b.productId);
+}
+
 export function createApp() {

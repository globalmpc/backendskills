+
+const login = (body: unknown) =>
+  fetch(`${base}/login`, {
+    method: "POST",
+    headers: { "content-type": "application/json" },
+    body: JSON.stringify(body),
+  });
+
+test("/login returns the api_token for correct credentials, without a bearer token", async () => {
+  const res = await login({ email: "alice@example.com", password: "alice-password" });
+  assert.equal(res.status, 200);
+  assert.deepEqual(await res.json(), { token: "alice-token" });
+});
+
+test("/login gives the same error for a wrong password and an unknown email", async () => {
+  const wrong = await login({ email: "alice@example.com", password: "nope" });
+  const unknown = await login({ email: "nobody@example.com", password: "alice-password" });
+  assert.equal(wrong.status, 401);
+  assert.equal(unknown.status, 401);
+  assert.deepEqual(await wrong.json(), await unknown.json());
+});
+
+test("/login requires email and password strings", async () => {
+  const res = await login({ email: "alice@example.com" });
+  assert.equal(res.status, 400);
+});

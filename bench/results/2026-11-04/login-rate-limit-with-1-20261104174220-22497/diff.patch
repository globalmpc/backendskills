 export type User = { id: number; email: string; name: string; role: string };
 
@@ -25,6 +26,24 @@ async function auth(req: Request, res: Response, next: NextFunction) {
   next();
 }
 
+const LOGIN_MAX_PER_EMAIL = 10;
+const LOGIN_MAX_PER_IP = 50;
+// Well-formed hash that never matches; checked when the email is unknown so both cases take the same time.
+const DUMMY_HASH = "scrypt$00000000000000000000000000000000$" + "0".repeat(64);
+
+// Counts a try atomically (shared across servers); the counter restarts when its 15 minute window expires.
+async function countAttempt(key: string): Promise<number> {
+  const { rows } = await pool.query(
+    `insert into login_attempts (key, n, since) values ($1, 1, now())
+     on conflict (key) do update set
+       n = case when login_attempts.since < now() - interval '15 minutes' then 1 else login_attempts.n + 1 end,
+       since = case when login_attempts.since < now() - interval '15 minutes' then now() else login_attempts.since end
+     returning n`,
+    [key],
+  );
+  return rows[0].n;
+}
+
 export function createApp() {
   const app = express();
   app.use(express.json());
@@ -33,6 +52,25 @@ export function createApp() {
     res.json({ ok: true });
   });
 
+  app.post("/login", async (req, res) => {
+    const { email, password } = req.body ?? {};
+    if (typeof email !== "string" || typeof password !== "string" || !email || !password || email.length > 320 || password.length > 1024) {
+      return sendError(res, 400, "invalid_request", "email and password are required strings");
+    }
+    const normalized = email.trim().toLowerCase();
+    const [perEmail, perIp] = await Promise.all([
+      countAttempt(`login:email:${normalized}`),
+      countAttempt(`login:ip:${req.ip ?? "unknown"}`),
+    ]);
+    if (perEmail > LOGIN_MAX_PER_EMAIL || perIp > LOGIN_MAX_PER_IP) {
+      return sendError(res, 429, "too_many_attempts", "Too many login attempts. Try again later");
+    }
+    const { rows } = await pool.query("select api_token, password_hash from users where lower(email) = $1", [normalized]);
+    const ok = await verifyPassword(password, rows[0]?.password_hash ?? DUMMY_HASH);
+    if (rows.length === 0 || !ok) return sendError(res, 401, "invalid_credentials", "Invalid email or password");
+    res.json({ token: rows[0].api_token });
+  });
+
   app.use(auth);
 

+test("/orders/:id returns the order with its items", async () => {
+  const [mine] = await (await fetch(`${base}/orders`, { headers: as("alice-token") })).json();
+  const res = await fetch(`${base}/orders/${mine.id}`, { headers: as("alice-token") });
+  assert.equal(res.status, 200);
+  const order = await res.json();
+  assert.equal(order.id, mine.id);
+  assert.equal(order.status, "paid");
+  assert.equal(order.total_cents, 4000);
+  assert.deepEqual(order.items, [{ product_id: 1, quantity: 2, price_cents: 2000 }]);
+});
+
+test("/orders/:id does not expose other users' orders", async () => {
+  const [bobs] = await (await fetch(`${base}/orders`, { headers: as("bob-token") })).json();
+  const res = await fetch(`${base}/orders/${bobs.id}`, { headers: as("alice-token") });
+  assert.equal(res.status, 404);
+  assert.deepEqual(await res.json(), { error: { code: "not_found", message: "Order not found" } });
+});
+
+test("/orders/:id returns 404 for missing or malformed ids", async () => {
+  for (const id of ["999999", "abc", "1.5", "-1", "99999999999"]) {
+    const res = await fetch(`${base}/orders/${id}`, { headers: as("alice-token") });
+    assert.equal(res.status, 404, `id ${id}`);
+  }
+});
+

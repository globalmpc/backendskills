 import express, { type NextFunction, type Request, type Response } from "express";
 import { pool } from "./db.ts";
+import { hashPassword, verifyPassword } from "./passwords.ts";
 
 export type User = { id: number; email: string; name: string; role: string };
 
@@ -25,6 +26,26 @@ async function auth(req: Request, res: Response, next: NextFunction) {
   next();
 }
 
+const LOGIN_WINDOW = "15 minutes";
+const LOGIN_MAX_PER_EMAIL = 10;
+const LOGIN_MAX_PER_IP = 50;
+
+// Counts one try atomically (the window restarts once it has expired) and returns the count so far.
+async function countAttempt(key: string): Promise<number> {
+  const { rows } = await pool.query(
+    `insert into login_attempts (key, n, since) values ($1, 1, now())
+     on conflict (key) do update set
+       n = case when login_attempts.since < now() - $2::interval then 1 else login_attempts.n + 1 end,
+       since = case when login_attempts.since < now() - $2::interval then now() else login_attempts.since end
+     returning n`,
+    [key, LOGIN_WINDOW],
+  );
+  return rows[0].n;
+}
+
+// Used for unknown emails so they take as long as a real password check.
+const dummyHash = await hashPassword("not-a-real-password");
+
 export function createApp() {
   const app = express();
   app.use(express.json());
@@ -33,6 +54,22 @@ export function createApp() {
     res.json({ ok: true });
   });
 
+  app.post("/login", async (req, res) => {
+    const { email, password } = req.body ?? {};
+    if (typeof email !== "string" || typeof password !== "string" || !email || !password || email.length > 320 || password.length > 1024) {
+      return sendError(res, 400, "invalid_request", "email and password are required strings");
+    }
+    const emailCount = await countAttempt(`login:email:${email.toLowerCase()}`);
+    const ipCount = await countAttempt(`login:ip:${req.ip ?? "unknown"}`);
+    if (emailCount > LOGIN_MAX_PER_EMAIL || ipCount > LOGIN_MAX_PER_IP) {
+      return sendError(res, 429, "too_many_attempts", "Try again later");
+    }
+    const { rows } = await pool.query("select api_token, password_hash from users where lower(email) = lower($1) limit 1", [email]);
+    const ok = await verifyPassword(password, rows[0]?.password_hash ?? dummyHash);
+    if (rows.length === 0 || !ok) return sendError(res, 401, "invalid_credentials", "Invalid email or password");
+    res.json({ token: rows[0].api_token });
+  });
+
   app.use(auth);
 

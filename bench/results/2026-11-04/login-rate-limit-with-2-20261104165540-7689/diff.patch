+// Counts one try under `key` in a fixed window and returns the count so far. A single statement, so
+// parallel requests can't all read the same count and slip past the limit.
+async function countLoginAttempt(key: string): Promise<number> {
+  const { rows } = await pool.query(
+    `insert into login_attempts (key, n, since) values ($1, 1, now())
+     on conflict (key) do update set
+       n = case when login_attempts.since < now() - interval '${LOGIN_WINDOW}' then 1 else login_attempts.n + 1 end,
+       since = case when login_attempts.since < now() - interval '${LOGIN_WINDOW}' then now() else login_attempts.since end
+     returning n`,
+    [key],
+  );
+  return rows[0].n;
+}

+
+test("POST /orders requires a token", async () => {
+  const res = await placeOrder("nope", { items: [{ productId: 1, quantity: 1 }] });
+  assert.equal(res.status, 401);
+});
+
+test("POST /orders gives the stock back and fails the order when the charge fails", async () => {
+  const before = await stockOf(1);
+  const original = payments.charge;
+  payments.charge = async () => {
+    throw new Error("card declined");
+  };
+  try {
+    const res = await placeOrder("alice-token", { items: [{ productId: 1, quantity: 3 }] });
+    assert.equal(res.status, 502);
+    assert.equal((await res.json()).error.code, "payment_failed");
+  } finally {

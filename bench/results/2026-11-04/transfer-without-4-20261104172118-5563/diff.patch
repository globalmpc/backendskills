+const post = (token: string, body: unknown) =>
+  fetch(`${base}/transfers`, {
+    method: "POST",
+    headers: { ...as(token), "content-type": "application/json" },
+    body: JSON.stringify(body),
+  });
+
+const balanceOf = async (userId: number) => {
+  const { rows } = await pool.query("select balance_cents from wallets where user_id = $1", [userId]);
+  return rows[0]?.balance_cents;
+};
+
+test("transfer moves store credit from the caller to the recipient", async () => {
+  const res = await post("alice-token", { toUserId: 2, amountCents: 1500 });
+  assert.equal(res.status, 201);
+  assert.deepEqual(await res.json(), { toUserId: 2, amountCents: 1500, balanceCents: 8500 });
+  assert.equal(await balanceOf(1), 8500);
+  assert.equal(await balanceOf(2), 2000);
+});
+
+test("transfer fails with 409 and changes nothing when the caller lacks funds", async () => {
+  const res = await post("bob-token", { toUserId: 1, amountCents: 5000 });
+  assert.equal(res.status, 409);
+  assert.equal((await res.json()).error.code, "insufficient_funds");
+  assert.equal(await balanceOf(1), 8500);
+  assert.equal(await balanceOf(2), 2000);
+});
+
+test("transfer to an unknown user gets 404 and changes nothing", async () => {
+  const res = await post("alice-token", { toUserId: 999, amountCents: 100 });
+  assert.equal(res.status, 404);
+  assert.equal((await res.json()).error.code, "recipient_not_found");
+  assert.equal(await balanceOf(1), 8500);
+});
+
+test("transfer rejects bad bodies and self-transfers with 400", async () => {
+  const bad = [
+    { toUserId: 2, amountCents: 0 },
+    { toUserId: 2, amountCents: -5 },
+    { toUserId: 2, amountCents: 1.5 },
+    { toUserId: 2, amountCents: "100" },
+    { toUserId: "2", amountCents: 100 },
+    { toUserId: 0, amountCents: 100 },
+    { toUserId: 1, amountCents: 100 },
+    {},
+  ];
+  for (const body of bad) {
+    const res = await post("alice-token", body);
+    assert.equal(res.status, 400, JSON.stringify(body));
+    assert.equal((await res.json()).error.code, "invalid_request");
+  }
+  assert.equal(await balanceOf(1), 8500);
+});
+
+test("transfer requires a token", async () => {

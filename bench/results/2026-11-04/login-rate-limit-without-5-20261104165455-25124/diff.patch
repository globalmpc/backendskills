+  // Open route: exchanges email + password for the user's api_token. Must stay above `app.use(auth)`.
+  app.post("/login", async (req, res) => {
+    const body = req.body ?? {};
+    if (typeof body.email !== "string" || typeof body.password !== "string") {
+      return sendError(res, 400, "bad_request", "email and password are required");
+    }
+    const { rows } = await pool.query("select api_token, password_hash from users where email = $1", [body.email]);
+    // Same response for unknown email and wrong password, so the endpoint doesn't reveal which emails exist.
+    if (rows.length === 0 || !(await verifyPassword(body.password, rows[0].password_hash))) {
+      return sendError(res, 401, "invalid_credentials", "Invalid email or password");
+    }
+    res.json({ token: rows[0].api_token });
+  });

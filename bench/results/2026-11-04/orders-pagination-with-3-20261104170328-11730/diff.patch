+  app.get("/orders", async (req, res) => {
+    const cursor = req.query.cursor === undefined ? null : decodeCursor(req.query.cursor);
+    if (req.query.cursor !== undefined && cursor === null) {
+      return sendError(res, 400, "invalid_cursor", "Invalid cursor");
+    }
+
+    // Keyset paging: the cursor is the (created_at, id) of the last order on the previous page.
+    // Fetch one extra row to know whether another page exists.
+    const params: unknown[] = [res.locals.user.id, ORDERS_PAGE_SIZE + 1];
+    let after = "";
+    if (cursor) {
+      params.push(cursor.createdAt, cursor.id);
+      after = "and (created_at, id) < ($3::timestamptz, $4::int)";
+    }
+
+    let rows: OrderRow[];
+    try {
+      ({ rows } = await pool.query(
+        `select id, status, total_cents, created_at, created_at::text as cursor_created_at
+         from orders where user_id = $1 ${after}
+         order by created_at desc, id desc limit $2`,
+        params,
+      ));
+    } catch (err) {
+      // A cursor whose timestamp Postgres can't parse (invalid_datetime_format / datetime_field_overflow)
+      if (cursor && isDatetimeError(err)) return sendError(res, 400, "invalid_cursor", "Invalid cursor");
+      throw err;
+    }
+
+    const hasMore = rows.length > ORDERS_PAGE_SIZE;
+    const page = rows.slice(0, ORDERS_PAGE_SIZE);
+    const last = page[page.length - 1];
+    const nextCursor = hasMore ? encodeCursor(last.cursor_created_at, last.id) : null;
+    res.json({
+      orders: page.map(({ cursor_created_at: _ts, ...order }) => order),
+      nextCursor,
+    });

+test("/orders paginates newest first, 20 per page", async () => {
+  const { rows } = await pool.query("select id from users where email = 'bob@example.com'");
+  for (let i = 0; i < 44; i++) {
+    await pool.query("insert into orders (user_id, total_cents) values ($1, 100)", [rows[0].id]);
+  }
+  const ids: number[] = [];
+  let cursor: string | null = null;
+  let pages = 0;
+  do {
+    const url = `${base}/orders${cursor ? `?cursor=${cursor}` : ""}`;
+    const page = await (await fetch(url, { headers: as("bob-token") })).json();
+    assert.ok(page.orders.length <= 20);
+    ids.push(...page.orders.map((o: { id: number }) => o.id));
+    cursor = page.nextCursor;
+    pages++;
+  } while (cursor);
+  assert.equal(pages, 3);
+  assert.equal(ids.length, 45);
+  assert.equal(new Set(ids).size, 45);
+  assert.deepEqual(ids, [...ids].sort((a, b) => b - a));
+  const bad = await fetch(`${base}/orders?cursor=abc`, { headers: as("bob-token") });
+  assert.equal(bad.status, 400);
 });
 

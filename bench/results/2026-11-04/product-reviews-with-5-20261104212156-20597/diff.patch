+    if (typeof body !== "string" || body.trim() === "" || body.length > 5000) {
+      return sendError(res, 400, "invalid_request", "body must be a non-empty string of at most 5000 characters");
+    }
+    const user = res.locals.user;
+    const { rows: product } = await pool.query("select 1 from products where id = $1", [productId]);

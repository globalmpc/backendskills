+  // Full refund through the provider. The order row is locked for the duration so two concurrent
+  // requests can't both refund it. The provider call uses a per-order idempotency key, so if the
+  // provider succeeds but our update fails, a retry does not move money a second time.
+  app.post("/orders/:id/refund", async (req, res) => {
+    const id = Number(req.params.id);
+    const notFound = () => sendError(res, 404, "not_found", "Order not found");
+    if (!Number.isInteger(id)) return notFound();
+
+    const client = await pool.connect();
+    try {
+      await client.query("begin");
+      const { rows } = await client.query(
+        "select id, status, total_cents, payment_id from orders where id = $1 and user_id = $2 for update",
+        [id, res.locals.user.id],
+      );
+      const order = rows[0];
+      if (!order) {
+        await client.query("rollback");
+        return notFound();
+      }
+      if (order.status !== "paid") {
+        await client.query("rollback");
+        return sendError(res, 409, "not_paid", "Only paid orders can be refunded");
+      }
+
+      await payments.refund({
+        paymentId: order.payment_id,
+        amountCents: order.total_cents,
+        idempotencyKey: `refund-order-${order.id}`,
+      });
+      const { rows: [updated] } = await client.query(
+        "update orders set status = 'refunded' where id = $1 returning id, status, total_cents, created_at",
+        [order.id],
+      );
+      await client.query("commit");
+      res.json(updated);
+    } catch (err) {
+      await client.query("rollback").catch(() => {});
+      throw err;
+    } finally {
+      client.release();
+    }
+  });

+const patchDiscount = (token: string, id: string | number, body: unknown) =>
+  fetch(`${base}/products/${id}`, {
+    method: "PATCH",
+    headers: { ...as(token), "content-type": "application/json" },
+    body: JSON.stringify(body),
+  });
+
+test("admin can set a product discount; it shows in /products", async () => {
+  const res = await patchDiscount("admin-token", 1, { discountPercent: 25 });
+  assert.equal(res.status, 200);
+  assert.equal((await res.json()).discount_percent, 25);
+  const products = await (await fetch(`${base}/products`, { headers: as("alice-token") })).json();
+  assert.equal(products.find((p: { id: number }) => p.id === 1).discount_percent, 25);
+});
+
+test("non-admin cannot set a discount", async () => {
+  assert.equal((await patchDiscount("alice-token", 1, { discountPercent: 10 })).status, 403);
+});
+
+test("bad discount input is a 400; unknown product is a 404", async () => {
+  for (const bad of [{}, { discountPercent: -1 }, { discountPercent: 101 }, { discountPercent: 1.5 }, { discountPercent: "10" }]) {
+    assert.equal((await patchDiscount("admin-token", 1, bad)).status, 400);
+  }
+  assert.equal((await patchDiscount("admin-token", "abc", { discountPercent: 5 })).status, 400);
+  assert.equal((await patchDiscount("admin-token", 99999, { discountPercent: 5 })).status, 404);
+});
+

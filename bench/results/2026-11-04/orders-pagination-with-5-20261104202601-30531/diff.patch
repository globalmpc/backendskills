+test("/orders paginates newest first, 20 per page", async () => {
+  const { rows } = await pool.query("select id from users where email = 'bob@example.com'");
+  await pool.query(
+    "insert into orders (user_id, status, total_cents) select $1, 'paid', 100 from generate_series(1, 44)",
+    [rows[0].id],
+  );
+  const seen: number[] = [];
+  let cursor: string | null = null;
+  let pages = 0;
+  do {
+    const url: string = `${base}/orders${cursor ? `?cursor=${cursor}` : ""}`;
+    const page: { orders: { id: number }[]; nextCursor: string | null } = await (
+      await fetch(url, { headers: as("bob-token") })
+    ).json();
+    assert.ok(page.orders.length <= 20);
+    seen.push(...page.orders.map((o) => o.id));
+    cursor = page.nextCursor;
+    pages++;
+  } while (cursor);
+  assert.equal(pages, 3);
+  assert.equal(seen.length, 45);
+  assert.equal(new Set(seen).size, 45);
+  assert.deepEqual(seen, [...seen].sort((a, b) => b - a));
+});
+
+test("/orders rejects a bad cursor with 400", async () => {
+  for (const c of ["garbage!", "abc", Buffer.from("-5").toString("base64url")]) {
+    const res = await fetch(`${base}/orders?cursor=${c}`, { headers: as("alice-token") });
+    assert.equal(res.status, 400);
+    assert.equal((await res.json()).error.code, "invalid_cursor");
+  }
 });
 

diff --git a/test/reviews.test.ts b/test/reviews.test.ts
new file mode 100644
index 0000000..b2929e6
--- /dev/null
+++ b/test/reviews.test.ts
@@ -0,0 +1,118 @@
+import { test, before, after } from "node:test";
+import assert from "node:assert/strict";
+import type { Server } from "node:http";
+import { resetDatabase } from "../src/migrate.ts";
+import { createApp } from "../src/app.ts";
+import { pool } from "../src/db.ts";
+
+let server: Server;
+let base: string;
+
+before(async () => {
+  await resetDatabase();
+  server = createApp().listen(0);
+  const address = server.address();
+  if (address === null || typeof address === "string") throw new Error("no port");
+  base = `http://localhost:${address.port}`;
+});
+
+after(async () => {
+  server.close();
+  await pool.end();
+});
+
+const as = (token: string) => ({ authorization: `Bearer ${token}`, "content-type": "application/json" });
+const post = (token: string, productId: number | string, payload: unknown) =>
+  fetch(`${base}/products/${productId}/reviews`, {
+    method: "POST",
+    headers: as(token),
+    body: JSON.stringify(payload),
+  });
+
+// Seed: alice bought products 1 and 3 (paid); bob bought product 2 (paid).
+
+test("reviews require a token", async () => {
+  const res = await fetch(`${base}/products/1/reviews`);
+  assert.equal(res.status, 401);
+});
+
+test("a buyer can review a bought product", async () => {
+  const res = await post("alice-token", 1, { rating: 5, body: "Soft and fits well" });
+  assert.equal(res.status, 201);
+  const review = await res.json();
+  assert.equal(review.user_id, 1);
+  assert.equal(review.rating, 5);
+  assert.equal(review.body, "Soft and fits well");
+  assert.ok(review.created_at);
+});
+
+test("a second review of the same product is rejected with 409", async () => {
+  const res = await post("alice-token", 1, { rating: 1, body: "Changed my mind" });
+  assert.equal(res.status, 409);
+  assert.equal((await res.json()).error.code, "already_reviewed");
+});
+
+test("the same user can review a different bought product", async () => {
+  const res = await post("alice-token", 3, { rating: 4, body: "Sold out fast" });
+  assert.equal(res.status, 201);
+});
+
+test("reviewing a product you have not bought is rejected with 403", async () => {
+  const res = await post("bob-token", 1, { rating: 5, body: "Never bought it" });
+  assert.equal(res.status, 403);
+  assert.equal((await res.json()).error.code, "not_purchased");
+});
+
+test("a refunded purchase does not allow a review", async () => {
+  const { rows } = await pool.query(
+    "insert into orders (user_id, status, total_cents) values (2, 'refunded', 2000) returning id",
+  );
+  await pool.query(
+    "insert into order_items (order_id, product_id, quantity, price_cents) values ($1, 1, 1, 2000)",
+    [rows[0].id],
+  );
+
+  const res = await post("bob-token", 1, { rating: 3, body: "Refunded" });
+  assert.equal(res.status, 403);
+});
+
+test("rating must be an integer from 1 to 5", async () => {
+  for (const rating of [0, 6, 2.5, "5", null]) {
+    const res = await post("bob-token", 2, { rating, body: "ok" });
+    assert.equal(res.status, 400, `rating ${JSON.stringify(rating)}`);
+    assert.equal((await res.json()).error.code, "invalid_rating");
+  }
+});
+
+test("body must be a non-empty string", async () => {
+  for (const body of ["", "   ", 42, undefined]) {
+    const res = await post("bob-token", 2, { rating: 4, body });
+    assert.equal(res.status, 400, `body ${JSON.stringify(body)}`);
+    assert.equal((await res.json()).error.code, "invalid_body");
+  }
+});
+
+test("reviewing a missing or malformed product id returns 404", async () => {
+  for (const id of [999, "abc", "0", "99999999999"]) {
+    const res = await post("alice-token", id, { rating: 5, body: "x" });
+    assert.equal(res.status, 404, `id ${id}`);
+  }
+});
+
+test("GET lists the product's reviews; unknown product is 404", async () => {
+  const res = await fetch(`${base}/products/1/reviews`, { headers: as("bob-token") });
+  assert.equal(res.status, 200);
+  const reviews = await res.json();
+  assert.equal(reviews.length, 1);
+  assert.deepEqual(Object.keys(reviews[0]).sort(), ["body", "created_at", "rating", "user_id"]);
+  assert.equal(reviews[0].user_id, 1);
+
+  const missing = await fetch(`${base}/products/999/reviews`, { headers: as("bob-token") });
+  assert.equal(missing.status, 404);
+});
+
+test("GET on a product with no reviews returns an empty list", async () => {
+  const res = await fetch(`${base}/products/2/reviews`, { headers: as("alice-token") });
+  assert.equal(res.status, 200);
+  assert.deepEqual(await res.json(), []);
+});

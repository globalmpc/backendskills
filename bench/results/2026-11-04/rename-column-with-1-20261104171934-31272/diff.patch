diff --git a/migrations/002_orders_amount_cents.sql b/migrations/002_orders_amount_cents.sql
new file mode 100644
index 0000000..9548b90
--- /dev/null
+++ b/migrations/002_orders_amount_cents.sql
@@ -0,0 +1,31 @@
+-- Expand step of renaming orders.total_cents to orders.amount_cents.
+-- Both columns exist until every server runs code that reads amount_cents. A later migration
+-- (003) drops total_cents. Do not rename in one step: the previous version still reads total_cents.
+set lock_timeout = '5s';
+
+alter table orders add column amount_cents integer;
+
+-- Keeps the two columns equal for writes from either version of the app.
+create function orders_sync_amount_cents() returns trigger language plpgsql as $$
+begin
+  if tg_op = 'UPDATE' then
+    if new.total_cents is distinct from old.total_cents then new.amount_cents := new.total_cents; end if;
+    if new.amount_cents is distinct from old.amount_cents then new.total_cents := new.amount_cents; end if;
+  end if;
+  new.amount_cents := coalesce(new.amount_cents, new.total_cents);
+  new.total_cents := coalesce(new.total_cents, new.amount_cents);
+  return new;
+end $$;
+
+create trigger orders_sync_amount_cents before insert or update on orders
+  for each row execute function orders_sync_amount_cents();
+
+-- Backfill. Fine for the seed-sized database; on a large table, move this to a batched job first
+-- (see the db-migration skill, rule 4).
+update orders set amount_cents = total_cents where amount_cents is null;
+
+-- NOT NULL without a full-table scan under an exclusive lock: validate a CHECK first, then set NOT NULL.
+alter table orders add constraint orders_amount_cents_not_null check (amount_cents is not null) not valid;
+alter table orders validate constraint orders_amount_cents_not_null;
+alter table orders alter column amount_cents set not null;
+alter table orders drop constraint orders_amount_cents_not_null;

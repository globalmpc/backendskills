+// Thrown inside a transaction to roll it back and answer with this status.
+class HttpError extends Error {
+  constructor(
+    readonly status: number,
+    readonly code: string,
+    message: string,
+  ) {
+    super(message);
+  }
+}
+
+type OrderLine = { productId: number; quantity: number };
+
+// Validates the body. Repeated products are merged into one line, so each product appears once.
+function parseOrderLines(body: unknown): OrderLine[] | string {
+  const items = (body as { items?: unknown } | null | undefined)?.items;
+  if (!Array.isArray(items) || items.length === 0) return "items must be a non-empty array";
+  const quantities = new Map<number, number>();
+  for (const item of items) {
+    const { productId, quantity } = (item ?? {}) as { productId?: unknown; quantity?: unknown };
+    if (typeof productId !== "number" || !Number.isInteger(productId) || productId < 1) {
+      return "productId must be a positive integer";
+    }
+    if (typeof quantity !== "number" || !Number.isInteger(quantity) || quantity < 1) {
+      return "quantity must be a positive integer";
+    }
+    quantities.set(productId, (quantities.get(productId) ?? 0) + quantity);
+  }
+  return [...quantities].map(([productId, quantity]) => ({ productId, quantity }));
+}
+
+type ReservedOrder = { orderId: number; totalCents: number; lines: (OrderLine & { priceCents: number })[] };
+
+// Step 1 of placing an order. One transaction, no outside calls: check and reduce stock, and record a
+// pending order. The stock stays reserved while the payment is taken in step 2.
+async function reserveStock(userId: number, lines: OrderLine[]): Promise<ReservedOrder> {
+  return withTransaction(async (client) => {
+    // Lock in id order, so two orders that share products can't deadlock.
+    const { rows: products } = await client.query<{ id: number; price_cents: number }>(
+      "select id, price_cents from products where id = any($1::int[]) order by id for update",
+      [lines.map((line) => line.productId)],
+    );
+    const priced = lines.map((line) => {
+      const product = products.find((p) => p.id === line.productId);
+      if (!product) throw new HttpError(400, "unknown_product", `Product ${line.productId} does not exist`);
+      return { ...line, priceCents: product.price_cents };
+    });
+
+    let totalCents = 0;
+    for (const line of priced) {
+      // The stock check is part of the write. A concurrent order can't take the same units in between.
+      const { rowCount } = await client.query(
+        "update products set stock = stock - $2 where id = $1 and stock >= $2",
+        [line.productId, line.quantity],
+      );
+      if (rowCount === 0) throw new HttpError(409, "insufficient_stock", `Not enough stock for product ${line.productId}`);
+      totalCents += line.priceCents * line.quantity;
+    }
+
+    const {
+      rows: [order],
+    } = await client.query<{ id: number }>(
+      "insert into orders (user_id, status, total_cents) values ($1, 'pending', $2) returning id",
+      [userId, totalCents],
+    );
+    for (const line of priced) {
+      await client.query(
+        "insert into order_items (order_id, product_id, quantity, price_cents) values ($1, $2, $3, $4)",
+        [order.id, line.productId, line.quantity, line.priceCents],
+      );
+    }
+    return { orderId: order.id, totalCents, lines: priced };
+  });
+}
+
+// Undo step 1 when the payment fails: return the stock and mark the order failed.
+async function releaseStock(order: ReservedOrder) {
+  await withTransaction(async (client) => {
+    for (const line of order.lines) {
+      await client.query("update products set stock = stock + $2 where id = $1", [line.productId, line.quantity]);
+    }
+    await client.query("update orders set status = 'failed' where id = $1 and status = 'pending'", [order.orderId]);
+  });
+}

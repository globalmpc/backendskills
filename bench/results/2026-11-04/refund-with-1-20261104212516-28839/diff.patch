diff --git a/test/app.test.ts b/test/app.test.ts
index d7b2ef4..020c34f 100644
--- a/test/app.test.ts
+++ b/test/app.test.ts
@@ -64,3 +64,35 @@ test("payments client records every call; the same idempotency key is charged on
   const { rows } = await pool.query("select kind, count(*)::int as n from payment_calls where created_at > now() - interval '1 minute' group by kind order by kind");
   assert.deepEqual(rows, [{ kind: "charge", n: 1 }, { kind: "refund", n: 1 }]);
 });
+
+const refund = (id: number | string, token: string) =>
+  fetch(`${base}/orders/${id}/refund`, { method: "POST", headers: as(token) });
+
+test("refund: bad id is 400, someone else's order is 404", async () => {
+  assert.equal((await refund("abc", "alice-token")).status, 400);
+  assert.equal((await refund(3, "alice-token")).status, 404);
+  assert.equal((await refund(999, "alice-token")).status, 404);
+});
+
+test("refund: parallel requests refund a paid order once, then it is not refundable", async () => {
+  const results = await Promise.all(Array.from({ length: 10 }, () => refund(1, "alice-token")));
+  for (const r of results) assert.ok(r.status === 200 || r.status === 409);
+  assert.ok(results.some((r) => r.status === 200));
+  const { rows } = await pool.query("select status from orders where id = 1");
+  assert.equal(rows[0].status, "refunded");
+  const { rows: calls } = await pool.query(
+    "select count(*)::int as n from payment_calls where kind = 'refund' and payment_id = 'pay_seed_1'",
+  );
+  assert.equal(calls[0].n, 1);
+  const again = await refund(1, "alice-token");
+  assert.equal(again.status, 409);
+  assert.equal((await again.json()).error.code, "not_refundable");
+});
+
+test("refund: admin can refund; pending orders cannot be refunded", async () => {
+  assert.equal((await refund(3, "admin-token")).status, 200);
+  const { rows: [o] } = await pool.query(
+    "insert into orders (user_id, status, total_cents) values (1, 'pending', 100) returning id",
+  );
+  assert.equal((await refund(o.id, "alice-token")).status, 409);
+});

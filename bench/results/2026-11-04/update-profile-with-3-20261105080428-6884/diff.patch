diff --git a/src/app.ts b/src/app.ts
index c7a3c54..71e7ab2 100644
--- a/src/app.ts
+++ b/src/app.ts
@@ -39,6 +39,54 @@ export function createApp() {
     res.json(res.locals.user);
   });
 
+  app.patch("/users/:id", async (req, res) => {
+    if (!/^\d{1,9}$/.test(req.params.id)) return sendError(res, 404, "not_found", "User not found");
+    const id = Number(req.params.id);
+    const caller = res.locals.user;
+    // Other users' profiles look the same as missing ones; admins get access via an explicit role check.
+    if (id !== caller.id && caller.role !== "admin") return sendError(res, 404, "not_found", "User not found");
+
+    const body = req.body;
+    if (typeof body !== "object" || body === null || Array.isArray(body)) {
+      return sendError(res, 400, "invalid_request", "Body must be a JSON object");
+    }
+    const unknown = Object.keys(body).filter((k) => k !== "name" && k !== "email");
+    if (unknown.length > 0) return sendError(res, 400, "invalid_request", `Unknown field: ${unknown[0]}`);
+
+    let name: string | null = null;
+    let email: string | null = null;
+    if (body.name !== undefined) {
+      if (typeof body.name !== "string" || body.name.trim() === "" || body.name.trim().length > 200) {
+        return sendError(res, 400, "invalid_request", "name must be a non-empty string (max 200 characters)");
+      }
+      name = body.name.trim();
+    }
+    if (body.email !== undefined) {
+      if (typeof body.email !== "string" || body.email.length > 254 || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(body.email.trim())) {
+        return sendError(res, 400, "invalid_request", "email must be a valid email address");
+      }
+      email = body.email.trim().toLowerCase();
+    }
+    if (name === null && email === null) {
+      return sendError(res, 400, "invalid_request", "Provide name and/or email");
+    }
+
+    try {
+      const { rows } = await pool.query(
+        `update users set name = coalesce($2, name), email = coalesce($3, email)
+         where id = $1 returning id, email, name, role`,
+        [id, name, email],
+      );
+      if (rows.length === 0) return sendError(res, 404, "not_found", "User not found");
+      res.json(rows[0]);
+    } catch (err) {
+      if ((err as { code?: string }).code === "23505") {
+        return sendError(res, 409, "email_taken", "Email is already in use");
+      }
+      throw err;
+    }
+  });
+
   app.get("/products", async (_req, res) => {
     const { rows } = await pool.query("select id, name, price_cents, stock from products order by id");
     res.json(rows);
@@ -52,7 +100,11 @@ export function createApp() {

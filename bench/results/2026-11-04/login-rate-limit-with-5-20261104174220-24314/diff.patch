 import express, { type NextFunction, type Request, type Response } from "express";
 import { pool } from "./db.ts";
+import { hashPassword, verifyPassword } from "./passwords.ts";
+
+const MAX_PER_EMAIL = 10;
+const MAX_PER_IP = 50;
+
+// Count the try first, atomically, in the database. The 15-minute window restarts once it has expired.
+async function countAttempt(key: string): Promise<number> {
+  const { rows } = await pool.query(
+    `insert into login_attempts (key, n, since) values ($1, 1, now())
+     on conflict (key) do update set
+       n = case when login_attempts.since < now() - interval '15 minutes' then 1 else login_attempts.n + 1 end,
+       since = case when login_attempts.since < now() - interval '15 minutes' then now() else login_attempts.since end
+     returning n`,
+    [key],
+  );
+  return rows[0].n;
+}
+
+// Lets unknown accounts spend the same time as wrong passwords.
+const dummyHash = await hashPassword("dummy-password");
 

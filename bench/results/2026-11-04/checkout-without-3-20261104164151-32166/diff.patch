+const isPositiveInt = (v: unknown): v is number => typeof v === "number" && Number.isInteger(v) && v >= 1 && v <= MAX_INT;
+
+// Returns null for any body that is not { items: [{ productId, quantity }] } with positive integers
+// and no product listed twice.
+function parseOrderItems(body: unknown): OrderItemInput[] | null {
+  const items = (body as { items?: unknown } | undefined)?.items;
+  if (!Array.isArray(items) || items.length === 0) return null;
+  const seen = new Set<number>();
+  const parsed: OrderItemInput[] = [];
+  for (const item of items) {
+    const { productId, quantity } = (item ?? {}) as Record<string, unknown>;
+    if (!isPositiveInt(productId) || !isPositiveInt(quantity) || seen.has(productId)) return null;
+    seen.add(productId);
+    parsed.push({ productId, quantity });
+  }
+  return parsed;
+}
+
+async function inTransaction<T>(fn: (client: PoolClient) => Promise<T>): Promise<T> {
+  const client = await pool.connect();
+  try {
+    await client.query("begin");
+    const result = await fn(client);
+    await client.query("commit");
+    return result;
+  } catch (err) {
+    await client.query("rollback");
+    throw err;
+  } finally {
+    client.release();
+  }
+}
+
+type OrderLine = { product_id: number; quantity: number; price_cents: number };
+
+// Put stock back and remove an order that was never paid.
+async function releaseOrder(orderId: number, lines: OrderLine[]) {
+  await inTransaction(async (client) => {
+    await client.query(
+      `update products p set stock = p.stock + i.quantity
+         from unnest($1::int[], $2::int[]) as i(product_id, quantity)
+        where p.id = i.product_id`,
+      [lines.map((l) => l.product_id), lines.map((l) => l.quantity)],
+    );
+    await client.query("delete from order_items where order_id = $1", [orderId]);
+    await client.query("delete from orders where id = $1", [orderId]);
+  });
+}
+
+// Reserve stock and create a pending order in one transaction, charge the total through the payment
+// provider (outside the transaction, so row locks are not held over the network call), then mark the
+// order paid. If the charge fails, the reservation is released.
+async function placeOrder(userId: number, items: OrderItemInput[]) {
+  const reserved = await inTransaction(async (client) => {
+    // Lock in id order so concurrent orders cannot deadlock on each other.
+    const { rows: products } = await client.query<{ id: number; price_cents: number; stock: number }>(
+      "select id, price_cents, stock from products where id = any($1::int[]) order by id for update",
+      [items.map((i) => i.productId)],
+    );
+    const byId = new Map(products.map((p) => [p.id, p]));
+    let totalCents = 0;
+    const lines: OrderLine[] = [];
+    for (const item of items) {
+      const product = byId.get(item.productId);
+      if (!product) throw new OrderError(404, "product_not_found", `Product ${item.productId} does not exist`);
+      if (product.stock < item.quantity) {
+        throw new OrderError(409, "insufficient_stock", `Not enough stock for product ${item.productId}`);
+      }
+      totalCents += product.price_cents * item.quantity;
+      lines.push({ product_id: item.productId, quantity: item.quantity, price_cents: product.price_cents });
+    }
+    if (totalCents > MAX_INT) throw new OrderError(400, "invalid_request", "Order total is too large");
+
+    const {
+      rows: [order],
+    } = await client.query<{ id: number; created_at: Date }>(
+      "insert into orders (user_id, status, total_cents) values ($1, 'pending', $2) returning id, created_at",
+      [userId, totalCents],
+    );
+    await client.query(
+      `insert into order_items (order_id, product_id, quantity, price_cents)
+       select $1, i.product_id, i.quantity, i.price_cents
+         from unnest($2::int[], $3::int[], $4::int[]) as i(product_id, quantity, price_cents)`,
+      [order.id, lines.map((l) => l.product_id), lines.map((l) => l.quantity), lines.map((l) => l.price_cents)],
+    );
+    await client.query(
+      `update products p set stock = p.stock - i.quantity
+         from unnest($1::int[], $2::int[]) as i(product_id, quantity)
+        where p.id = i.product_id`,
+      [lines.map((l) => l.product_id), lines.map((l) => l.quantity)],
+    );
+    return { id: order.id, created_at: order.created_at, totalCents, lines };
+  });
+
+  let paymentId: string;
+  try {
+    ({ paymentId } = await payments.charge({
+      amountCents: reserved.totalCents,
+      idempotencyKey: `order-${reserved.id}`,
+    }));
+  } catch (err) {
+    console.error(err);
+    await releaseOrder(reserved.id, reserved.lines);
+    throw new OrderError(502, "payment_failed", "Payment could not be completed");
+  }
+
+  await pool.query("update orders set status = 'paid', payment_id = $2 where id = $1", [reserved.id, paymentId]);
+  return { id: reserved.id, status: "paid", total_cents: reserved.totalCents, created_at: reserved.created_at, items: reserved.lines };
+}

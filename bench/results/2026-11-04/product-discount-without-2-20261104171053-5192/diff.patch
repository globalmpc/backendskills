+test("products default to no discount", async () => {
+  const products = await (await fetch(`${base}/products`, { headers: as("alice-token") })).json();
+  assert.ok(products.every((p: { discount_percent: number }) => p.discount_percent === 0));
+});
+
+test("admins can set a product discount; others cannot", async () => {
+  const [{ id }] = (await pool.query("select id from products where name = 'Mug'")).rows;
+  const patch = (token: string, body: unknown) =>
+    fetch(`${base}/products/${id}`, {
+      method: "PATCH",
+      headers: { ...as(token), "content-type": "application/json" },
+      body: JSON.stringify(body),
+    });
+
+  const denied = await patch("alice-token", { discountPercent: 10 });
+  assert.equal(denied.status, 403);
+  assert.equal((await pool.query("select discount_percent from products where id = $1", [id])).rows[0].discount_percent, 0);
+
+  const ok = await patch("admin-token", { discountPercent: 25 });
+  assert.equal(ok.status, 200);
+  assert.equal((await ok.json()).discount_percent, 25);
+
+  const products = await (await fetch(`${base}/products`, { headers: as("alice-token") })).json();
+  assert.equal(products.find((p: { id: number }) => p.id === id).discount_percent, 25);
+});
+
+test("PATCH /products/:id rejects invalid discounts and unknown products", async () => {
+  const [{ id }] = (await pool.query("select id from products where name = 'Mug'")).rows;
+  const patch = (path: string, body: unknown) =>
+    fetch(`${base}${path}`, {
+      method: "PATCH",
+      headers: { ...as("admin-token"), "content-type": "application/json" },
+      body: JSON.stringify(body),
+    });
+
+  for (const bad of [-1, 101, 12.5, "20", null]) {
+    const res = await patch(`/products/${id}`, { discountPercent: bad });
+    assert.equal(res.status, 400, `expected 400 for ${JSON.stringify(bad)}`);
+  }
+  assert.equal((await patch(`/products/999999`, { discountPercent: 5 })).status, 404);
+  assert.equal((await patch(`/products/abc`, { discountPercent: 5 })).status, 404);
+});
+

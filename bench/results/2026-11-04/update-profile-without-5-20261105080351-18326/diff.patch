+const patch = (id: number, token: string, body: unknown) =>
+  fetch(`${base}/users/${id}`, {
+    method: "PATCH",
+    headers: { ...as(token), "content-type": "application/json" },
+    body: JSON.stringify(body),
+  });
+
+test("PATCH /users/:id updates own name and email, ignoring role", async () => {
+  const res = await patch(2, "bob-token", { name: "Bobby", email: "bobby@example.com", role: "admin" });
+  assert.equal(res.status, 200);
+  assert.deepEqual(await res.json(), { id: 2, email: "bobby@example.com", name: "Bobby", role: "user" });
+});
+
+test("PATCH /users/:id rejects other users, bad input and duplicate emails", async () => {
+  assert.equal((await patch(1, "bob-token", { name: "X" })).status, 403);
+  assert.equal((await patch(1, "alice-token", {})).status, 400);
+  assert.equal((await patch(1, "alice-token", { email: "nope" })).status, 400);
+  const dup = await patch(1, "alice-token", { email: "admin@example.com" });
+  assert.equal(dup.status, 409);
+  assert.equal((await patch(1, "admin-token", { name: "Alice A" })).status, 200);
+});

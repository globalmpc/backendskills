+const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
+const PROFILE_FIELDS = ["name", "email"];
+
+type ProfileUpdate = { name?: string; email?: string };
+
+// Only name and email are editable; anything else (role, api_token, ...) is rejected.
+function parseProfileUpdate(body: unknown): ProfileUpdate | { error: string } {
+  if (body === undefined) body = {};
+  if (typeof body !== "object" || body === null || Array.isArray(body)) {
+    return { error: "Body must be a JSON object" };
+  }
+  const input = body as Record<string, unknown>;
+  const unknown = Object.keys(input).find((key) => !PROFILE_FIELDS.includes(key));
+  if (unknown !== undefined) return { error: `Field ${unknown} cannot be updated` };
+
+  const update: ProfileUpdate = {};
+  if ("name" in input) {
+    const name = typeof input.name === "string" ? input.name.trim() : "";
+    if (name === "" || name.length > 200) return { error: "name must be 1-200 characters" };
+    update.name = name;
+  }
+  if ("email" in input) {
+    const email = typeof input.email === "string" ? input.email.trim().toLowerCase() : "";
+    if (!EMAIL_RE.test(email) || email.length > 254) return { error: "email must be a valid email address" };
+    update.email = email;
+  }
+  if (Object.keys(update).length === 0) return { error: "Provide name and/or email" };
+  return update;
+}

+test("PATCH /users/:id updates own profile, rejects others and bad input", async () => {
+  const patch = (id: number | string, token: string, body: unknown) =>
+    fetch(`${base}/users/${id}`, { method: "PATCH", headers: { ...as(token), "content-type": "application/json" }, body: JSON.stringify(body) });
+  const me = await (await fetch(`${base}/me`, { headers: as("alice-token") })).json();
+
+  const ok = await patch(me.id, "alice-token", { name: "Alice B" });
+  assert.equal(ok.status, 200);
+  const updated = await ok.json();
+  assert.equal(updated.name, "Alice B");
+  assert.equal(updated.email, "alice@example.com");
+  assert.equal(updated.api_token, undefined);
+
+  assert.equal((await patch(me.id + 1, "alice-token", { name: "x" })).status, 403);
+  assert.equal((await patch(me.id, "alice-token", {})).status, 400);
+  assert.equal((await patch(me.id, "alice-token", { email: "nope" })).status, 400);
+  assert.equal((await patch(me.id, "alice-token", { email: "bob@example.com" })).status, 409);
+});

index 0000000..becfa00
--- /dev/null
+++ b/migrations/down/002_orders_amount_cents.sql
@@ -0,0 +1,4 @@
+-- Undo migrations/002_orders_amount_cents.sql, in reverse order.
+drop trigger if exists orders_sync_amount on orders;
+drop function if exists orders_sync_amount();
+alter table orders drop column if exists amount_cents;

+test("/orders includes each order's items", async () => {
+  const alice = await (await fetch(`${base}/orders`, { headers: as("alice-token") })).json();
+  const first = alice[0];
+  assert.ok(Array.isArray(first.items));
+  assert.ok(first.items.length >= 1);
+  for (const item of first.items) {
+    assert.deepEqual(Object.keys(item).sort(), ["price_cents", "product_id", "product_name", "quantity"]);
+    assert.equal(typeof item.product_name, "string");
+  }
+  // items belong to the caller's own orders only
+  const bob = await (await fetch(`${base}/orders`, { headers: as("bob-token") })).json();
+  assert.equal(bob.length, 1);
+  assert.equal(bob[0].items.length, 1);
+});

diff --git a/test/app.test.ts b/test/app.test.ts
index d7b2ef4..d18ad88 100644
--- a/test/app.test.ts
+++ b/test/app.test.ts
@@ -64,3 +64,38 @@ test("payments client records every call; the same idempotency key is charged on
   const { rows } = await pool.query("select kind, count(*)::int as n from payment_calls where created_at > now() - interval '1 minute' group by kind order by kind");
   assert.deepEqual(rows, [{ kind: "charge", n: 1 }, { kind: "refund", n: 1 }]);
 });
+
+const patchProduct = (token: string, id: string, body: unknown) =>
+  fetch(`${base}/products/${id}`, {
+    method: "PATCH",
+    headers: { ...as(token), "content-type": "application/json" },
+    body: JSON.stringify(body),
+  });
+
+test("only admins can set a product's discount", async () => {
+  const res = await patchProduct("alice-token", "1", { discountPercent: 10 });
+  assert.equal(res.status, 403);
+  assert.equal((await res.json()).error.code, "forbidden");
+});
+
+test("an admin sets a product's discount, and it shows in the product list", async () => {
+  const res = await patchProduct("admin-token", "2", { discountPercent: 15 });
+  assert.equal(res.status, 200);
+  assert.equal((await res.json()).discount_percent, 15);
+  const products = await (await fetch(`${base}/products`, { headers: as("alice-token") })).json();
+  assert.equal(products.find((p: { id: number }) => p.id === 2).discount_percent, 15);
+  assert.equal(products.find((p: { id: number }) => p.id === 1).discount_percent, 0);
+});
+
+test("discountPercent must be a whole number from 0 to 100", async () => {
+  for (const discountPercent of [-1, 101, 1.5, "10", null]) {
+    const res = await patchProduct("admin-token", "1", { discountPercent });
+    assert.equal(res.status, 400, `expected 400 for ${JSON.stringify(discountPercent)}`);
+    assert.equal((await res.json()).error.code, "invalid_discount_percent");
+  }
+});
+
+test("patching an unknown product is a 404, and a non-numeric id is a 400", async () => {
+  assert.equal((await patchProduct("admin-token", "999", { discountPercent: 5 })).status, 404);
+  assert.equal((await patchProduct("admin-token", "abc", { discountPercent: 5 })).status, 400);
+});

+  // Full refund of a paid order. The order row is locked for the whole refund so two concurrent requests
+  // cannot both refund it. The provider call uses a per-order idempotency key, so if the provider succeeds
+  // but our commit fails, a retry returns the same refund instead of refunding again.
+  app.post("/orders/:id/refund", async (req, res) => {
+    const { user } = res.locals;
+    const id = req.params.id;
+    if (!/^\d+$/.test(id)) return sendError(res, 404, "not_found", "Order not found");
+
+    const client = await pool.connect();
+    try {
+      await client.query("begin");
+      const { rows } = await client.query(
+        "select id, status, total_cents, payment_id, created_at from orders where id = $1 and ($2::boolean or user_id = $3) for update",
+        [id, user.role === "admin", user.id],
+      );
+      const order = rows[0];
+      if (!order) {
+        await client.query("rollback");
+        return sendError(res, 404, "not_found", "Order not found");
+      }
+      if (order.status !== "paid") {
+        await client.query("rollback");
+        return sendError(res, 409, "invalid_status", `Only paid orders can be refunded; this order is ${order.status}`);
+      }
+      if (!order.payment_id) throw new Error(`paid order ${order.id} has no payment_id`);
+
+      await payments.refund({
+        paymentId: order.payment_id,
+        amountCents: order.total_cents,
+        idempotencyKey: `refund:order:${order.id}`,
+      });
+      const { rows: [updated] } = await client.query(
+        "update orders set status = 'refunded' where id = $1 returning id, status, total_cents, created_at",
+        [order.id],
+      );
+      await client.query("commit");
+      res.json(updated);
+    } catch (err) {
+      await client.query("rollback").catch(() => {});
+      throw err;
+    } finally {
+      client.release();
+    }
+  });
+

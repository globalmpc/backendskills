diff --git a/test/app.test.ts b/test/app.test.ts
index d7b2ef4..980b8f0 100644
--- a/test/app.test.ts
+++ b/test/app.test.ts
@@ -64,3 +64,98 @@ test("payments client records every call; the same idempotency key is charged on
   const { rows } = await pool.query("select kind, count(*)::int as n from payment_calls where created_at > now() - interval '1 minute' group by kind order by kind");
   assert.deepEqual(rows, [{ kind: "charge", n: 1 }, { kind: "refund", n: 1 }]);
 });
+
+const post = (token: string, productId: string | number, body: unknown) =>
+  fetch(`${base}/products/${productId}/reviews`, {
+    method: "POST",
+    headers: { ...as(token), "content-type": "application/json" },
+    body: JSON.stringify(body),
+  });
+
+test("a buyer can review a product once; the review is created with 201", async () => {
+  const res = await post("alice-token", 1, { rating: 5, body: "Great fit" });
+  assert.equal(res.status, 201);
+  const review = await res.json();
+  assert.equal(review.product_id, 1);
+  assert.equal(review.rating, 5);
+  assert.equal(review.body, "Great fit");
+  assert.equal(typeof review.created_at, "string");
+  const { rows } = await pool.query("select user_id from reviews where id = $1", [review.id]);
+  assert.equal(rows[0].user_id, 1);
+});
+
+test("a second review of the same product gets 409", async () => {
+  const res = await post("alice-token", 1, { rating: 1, body: "Changed my mind" });
+  assert.equal(res.status, 409);
+  assert.equal((await res.json()).error.code, "already_reviewed");
+});
+
+test("users cannot review products they have not bought", async () => {
+  const res = await post("alice-token", 2, { rating: 4, body: "Never owned it" });
+  assert.equal(res.status, 403);
+  assert.equal((await res.json()).error.code, "not_purchased");
+});
+
+test("a buyer of a different product can review it", async () => {
+  const res = await post("bob-token", 2, { rating: 3, body: "Mug is fine" });
+  assert.equal(res.status, 201);
+});
+
+test("a refunded purchase does not allow a review", async () => {
+  await pool.query("update orders set status = 'refunded' where id = 2");
+  try {
+    const res = await post("alice-token", 3, { rating: 2, body: "Refunded" });
+    assert.equal(res.status, 403);
+  } finally {
+    await pool.query("update orders set status = 'paid' where id = 2");
+  }
+});
+
+test("invalid ratings and bodies get 400", async () => {
+  const invalid: unknown[] = [
+    { rating: 0, body: "x" },
+    { rating: 6, body: "x" },
+    { rating: 3.5, body: "x" },
+    { rating: "5", body: "x" },
+    { body: "x" },
+    { rating: 4 },
+    { rating: 4, body: "   " },
+    { rating: 4, body: 12 },
+  ];
+  for (const payload of invalid) {
+    const res = await post("alice-token", 3, payload);
+    assert.equal(res.status, 400, JSON.stringify(payload));
+    assert.ok((await res.json()).error.code.startsWith("invalid_"));
+  }
+});
+
+test("unknown or malformed product ids get 404", async () => {
+  for (const id of ["999", "abc", "99999999999"]) {
+    assert.equal((await post("alice-token", id, { rating: 5, body: "x" })).status, 404, id);
+    assert.equal((await fetch(`${base}/products/${id}/reviews`, { headers: as("alice-token") })).status, 404, id);
+  }
+});
+
+test("review endpoints require a token", async () => {
+  const res = await fetch(`${base}/products/1/reviews`);
+  assert.equal(res.status, 401);
+  assert.equal((await post("nope", 1, { rating: 5, body: "x" })).status, 401);
+});
+
+test("GET lists a product's reviews without exposing tokens or passwords", async () => {
+  const res = await fetch(`${base}/products/1/reviews`, { headers: as("bob-token") });
+  assert.equal(res.status, 200);
+  const reviews = await res.json();
+  assert.equal(reviews.length, 1);
+  assert.equal(reviews[0].rating, 5);
+  assert.equal(reviews[0].user_id, 1);
+  assert.equal(reviews[0].api_token, undefined);
+  assert.equal(reviews[0].password_hash, undefined);
+
+  const mug = await (await fetch(`${base}/products/2/reviews`, { headers: as("alice-token") })).json();
+  assert.equal(mug.length, 1);
+  assert.equal(mug[0].user_id, 2);
+
+  const empty = await (await fetch(`${base}/products/3/reviews`, { headers: as("alice-token") })).json();
+  assert.deepEqual(empty, []);
+});

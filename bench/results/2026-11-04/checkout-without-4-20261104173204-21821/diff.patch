+
+const post = (token: string, body: unknown) =>
+  fetch(`${base}/orders`, { method: "POST", headers: { ...as(token), "content-type": "application/json" }, body: JSON.stringify(body) });
+
+test("POST /orders charges the total, reduces stock and returns the order", async () => {
+  const { rows: [p] } = await pool.query("select id, price_cents, stock from products where name <> 'Limited sneaker' order by id limit 1");
+  const res = await post("alice-token", { items: [{ productId: p.id, quantity: 1 }, { productId: p.id, quantity: 1 }] });
+  assert.equal(res.status, 201);
+  const order = await res.json();
+  assert.equal(order.status, "paid");
+  assert.equal(order.total_cents, p.price_cents * 2);
+  const { rows: [after] } = await pool.query("select stock from products where id = $1", [p.id]);
+  assert.equal(after.stock, p.stock - 2);
+  const { rows } = await pool.query("select amount_cents from payment_calls where idempotency_key = $1", [`order-${order.id}`]);
+  assert.equal(rows[0].amount_cents, p.price_cents * 2);
+});
+
+test("POST /orders rejects insufficient stock and concurrent orders never oversell", async () => {
+  const { rows: [p] } = await pool.query("select id, stock from products where name = 'Limited sneaker'");
+  assert.equal((await post("bob-token", { items: [{ productId: p.id, quantity: p.stock + 1 }] })).status, 409);
+  const results = await Promise.all(Array.from({ length: p.stock + 3 }, () => post("bob-token", { items: [{ productId: p.id, quantity: 1 }] })));
+  assert.equal(results.filter((r) => r.status === 201).length, p.stock);
+  const { rows: [after] } = await pool.query("select stock from products where id = $1", [p.id]);
+  assert.equal(after.stock, 0);
+});
+
+test("POST /orders validates the body", async () => {
+  assert.equal((await post("alice-token", { items: [] })).status, 400);
+  assert.equal((await post("alice-token", { items: [{ productId: 1, quantity: 0 }] })).status, 400);
+  assert.equal((await post("alice-token", { items: [{ productId: 99999, quantity: 1 }] })).status, 404);
+});

+test("PATCH /products/:id sets discountPercent (admin only, 0-100 integer)", async () => {
+  const patch = (token: string, id: number, body: unknown) =>
+    fetch(`${base}/products/${id}`, { method: "PATCH", headers: { ...as(token), "content-type": "application/json" }, body: JSON.stringify(body) });
+  assert.equal((await patch("alice-token", 1, { discountPercent: 10 })).status, 403);
+  assert.equal((await patch("admin-token", 1, { discountPercent: 101 })).status, 400);
+  assert.equal((await patch("admin-token", 1, { discountPercent: 2.5 })).status, 400);
+  assert.equal((await patch("admin-token", 999, { discountPercent: 10 })).status, 404);
+  const ok = await patch("admin-token", 1, { discountPercent: 25 });
+  assert.equal(ok.status, 200);
+  assert.equal((await ok.json()).discount_percent, 25);
+  const products = await (await fetch(`${base}/products`, { headers: as("alice-token") })).json();
+  assert.equal(products.find((p: { id: number }) => p.id === 2).discount_percent, 0);
+});

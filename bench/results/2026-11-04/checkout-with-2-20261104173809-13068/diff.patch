diff --git a/migrations/002_stock_check.sql b/migrations/002_stock_check.sql
new file mode 100644
index 0000000..a76b21f
--- /dev/null
+++ b/migrations/002_stock_check.sql
@@ -0,0 +1,6 @@
+-- Last line of defence behind the conditional stock update in POST /orders.
+-- NOT VALID: doesn't scan or block the table; existing rows are checked in a later migration.
+-- orders.status also gains the value 'failed' (payment failed, stock released); the column is plain text.
+set lock_timeout = '5s';
+alter table products add constraint products_stock_nonneg check (stock >= 0) not valid;
+alter table order_items add constraint order_items_quantity_positive check (quantity >= 1) not valid;

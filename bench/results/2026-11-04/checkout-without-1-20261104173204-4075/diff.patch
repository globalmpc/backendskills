+
+const post = (token: string, body: unknown) =>
+  fetch(`${base}/orders`, {
+    method: "POST",
+    headers: { ...as(token), "content-type": "application/json" },
+    body: JSON.stringify(body),
+  });
+
+test("POST /orders charges, reduces stock and returns the order", async () => {
+  const res = await post("alice-token", { items: [{ productId: 2, quantity: 2 }, { productId: 1, quantity: 1 }] });
+  assert.equal(res.status, 201);
+  const order = await res.json();
+  assert.equal(order.status, "paid");
+  assert.equal(order.total_cents, 2 * 1200 + 2000);
+  const { rows } = await pool.query("select stock from products where id in (1, 2) order by id");
+  assert.deepEqual(rows.map((r) => r.stock), [99, 38]);
+  const calls = await pool.query("select amount_cents from payment_calls where payment_id = $1", [order.payment_id]);
+  assert.equal(calls.rows[0].amount_cents, 4400);
+});
+
+test("POST /orders rejects insufficient stock and concurrent orders can't oversell", async () => {
+  const count = async () => (await pool.query("select count(*)::int as n from payment_calls")).rows[0].n;
+  const before = await count();
+  assert.equal((await post("alice-token", { items: [{ productId: 3, quantity: 6 }] })).status, 409);
+  assert.equal(await count(), before);
+  const results = await Promise.all(Array.from({ length: 8 }, () => post("bob-token", { items: [{ productId: 3, quantity: 1 }] })));
+  assert.equal(results.filter((r) => r.status === 201).length, 5);
+  assert.equal((await pool.query("select stock from products where id = 3")).rows[0].stock, 0);
+  assert.equal((await count()) - before, 5);
+});
+
+test("POST /orders validates the body", async () => {

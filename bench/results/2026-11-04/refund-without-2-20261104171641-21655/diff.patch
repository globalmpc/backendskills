+
+test("POST /orders/:id/refund refunds a paid order in full and marks it refunded", async () => {
+  const res = await fetch(`${base}/orders/1/refund`, { method: "POST", headers: as("alice-token") });
+  assert.equal(res.status, 200);
+  const body = await res.json();
+  assert.equal(body.id, 1);
+  assert.equal(body.status, "refunded");
+  const { rows } = await pool.query("select kind, payment_id, amount_cents from payment_calls where kind = 'refund' and payment_id = 'pay_seed_1'");
+  assert.deepEqual(rows, [{ kind: "refund", payment_id: "pay_seed_1", amount_cents: 4000 }]);
+});
+
+test("POST /orders/:id/refund cannot refund an order twice", async () => {
+  const res = await fetch(`${base}/orders/1/refund`, { method: "POST", headers: as("alice-token") });
+  assert.equal(res.status, 409);
+  assert.deepEqual(await res.json(), { error: { code: "not_refundable", message: "Only paid orders can be refunded" } });
+  const { rows } = await pool.query("select count(*)::int as n from payment_calls where kind = 'refund' and payment_id = 'pay_seed_1'");
+  assert.equal(rows[0].n, 1);
+});
+
+test("POST /orders/:id/refund rejects pending orders", async () => {
+  const { rows } = await pool.query("insert into orders (user_id, status, total_cents) values (1, 'pending', 1200) returning id");
+  const res = await fetch(`${base}/orders/${rows[0].id}/refund`, { method: "POST", headers: as("alice-token") });
+  assert.equal(res.status, 409);
+  const { rows: status } = await pool.query("select status from orders where id = $1", [rows[0].id]);
+  assert.equal(status[0].status, "pending");
+});
+
+test("POST /orders/:id/refund returns 404 for other users', missing, and malformed ids", async () => {
+  const other = await fetch(`${base}/orders/3/refund`, { method: "POST", headers: as("alice-token") });
+  assert.equal(other.status, 404);
+  const missing = await fetch(`${base}/orders/999999/refund`, { method: "POST", headers: as("alice-token") });
+  assert.equal(missing.status, 404);
+  const malformed = await fetch(`${base}/orders/abc/refund`, { method: "POST", headers: as("alice-token") });
+  assert.equal(malformed.status, 404);
+  const { rows } = await pool.query("select status from orders where id = 3");
+  assert.equal(rows[0].status, "paid");
+});

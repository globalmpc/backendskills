+function patchProduct(token: string, id: number | string, body: unknown) {
+  const headers = { ...as(token), "content-type": "application/json" };
+  return fetch(`${base}/products/${id}`, { method: "PATCH", headers, body: JSON.stringify(body) });
+}
+
+test("admin can set a product discount", async () => {
+  const res = await patchProduct("admin-token", 1, { discountPercent: 25 });
+  assert.equal(res.status, 200);
+  assert.equal((await res.json()).discount_percent, 25);
+  const products = await (await fetch(`${base}/products`, { headers: as("alice-token") })).json();
+  assert.equal(products.find((p: { id: number }) => p.id === 1).discount_percent, 25);
+});
+
+test("non-admin cannot set a discount", async () => {
+  assert.equal((await patchProduct("alice-token", 1, { discountPercent: 50 })).status, 403);
+});
+
+test("discount rejects bad input and unknown products", async () => {
+  for (const v of [-1, 101, 10.5, "10", null, undefined]) {
+    assert.equal((await patchProduct("admin-token", 1, { discountPercent: v })).status, 400);
+  }
+  assert.equal((await patchProduct("admin-token", "abc", { discountPercent: 5 })).status, 404);
+  assert.equal((await patchProduct("admin-token", 99999, { discountPercent: 5 })).status, 404);
+});
+

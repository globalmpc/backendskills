+class HttpError extends Error {
+  constructor(readonly status: number, readonly code: string, message: string) {
+    super(message);
+  }
+}
+
+const MAX_INT4 = 2_147_483_647;
+const MAX_ORDER_LINES = 50;
+const MAX_QUANTITY = 1000;
+
+// Validates the POST /orders body and merges lines for the same product.
+function parseOrderItems(body: unknown): { items: { productId: number; quantity: number }[] } | { error: string } {
+  const items = (body as { items?: unknown } | undefined)?.items;
+  if (!Array.isArray(items) || items.length === 0) return { error: "items must be a non-empty array" };
+  if (items.length > MAX_ORDER_LINES) return { error: `items may have at most ${MAX_ORDER_LINES} entries` };
+  const merged = new Map<number, number>();
+  for (const [i, item] of items.entries()) {
+    const { productId, quantity } = (item ?? {}) as { productId?: unknown; quantity?: unknown };
+    if (!Number.isInteger(productId) || (productId as number) < 1 || (productId as number) > MAX_INT4) {
+      return { error: `items[${i}].productId must be a positive integer` };
+    }
+    if (!Number.isInteger(quantity) || (quantity as number) < 1 || (quantity as number) > MAX_QUANTITY) {
+      return { error: `items[${i}].quantity must be an integer from 1 to ${MAX_QUANTITY}` };
+    }
+    merged.set(productId as number, (merged.get(productId as number) ?? 0) + (quantity as number));
+  }
+  for (const [productId, quantity] of merged) {
+    if (quantity > MAX_QUANTITY) return { error: `total quantity for product ${productId} must be at most ${MAX_QUANTITY}` };
+  }
+  return { items: [...merged].map(([productId, quantity]) => ({ productId, quantity })).sort((a, b) => a.productId - b.productId) };
+}

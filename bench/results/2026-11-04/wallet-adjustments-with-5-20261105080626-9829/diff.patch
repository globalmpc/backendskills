diff --git a/migrations/002_wallet_adjustments.sql b/migrations/002_wallet_adjustments.sql
new file mode 100644
index 0000000..4890e60
--- /dev/null
+++ b/migrations/002_wallet_adjustments.sql
@@ -0,0 +1,23 @@
+-- Audit trail of manual store-credit corrections made by admins. Append-only.
+create table wallet_adjustments (
+  id serial primary key,
+  user_id integer not null references users(id),
+  admin_id integer not null references users(id),
+  amount_cents integer not null check (amount_cents <> 0),
+  reason text not null check (length(btrim(reason)) > 0),
+  created_at timestamptz not null default now()
+);
+
+create index wallet_adjustments_user_id_idx on wallet_adjustments (user_id);
+
+create function wallet_adjustments_append_only() returns trigger language plpgsql as $$
+begin
+  raise exception 'wallet_adjustments is append-only';
+end $$;
+
+create trigger wallet_adjustments_append_only before update or delete on wallet_adjustments
+  for each row execute function wallet_adjustments_append_only();
+
+-- Last line of defence behind the application check. NOT VALID so it doesn't scan or lock the table;
+-- it is enforced for every new write.
+alter table wallets add constraint wallets_balance_non_negative check (balance_cents >= 0) not valid;
diff --git a/migrations/down/002_wallet_adjustments.sql b/migrations/down/002_wallet_adjustments.sql

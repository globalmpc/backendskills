diff --git a/migrations/002_order_idempotency.sql b/migrations/002_order_idempotency.sql
new file mode 100644
index 0000000..af0a340
--- /dev/null
+++ b/migrations/002_order_idempotency.sql
@@ -0,0 +1,6 @@
+-- POST /orders accepts an optional `Idempotency-Key` header so a retried request doesn't place (and charge)
+-- a second order. Nullable and additive, so servers still on the previous version keep working.
+alter table orders add column idempotency_key text;
+create unique index orders_user_idempotency_key on orders (user_id, idempotency_key);
+
+-- orders.status gains 'failed': the charge was declined/errored and the reserved stock was released.

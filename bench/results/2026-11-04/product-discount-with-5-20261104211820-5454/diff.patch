diff --git a/migrations/002_product_discount.sql b/migrations/002_product_discount.sql
new file mode 100644
index 0000000..6f339a7
--- /dev/null
+++ b/migrations/002_product_discount.sql
@@ -0,0 +1,6 @@
+-- Runs as one implicit transaction, so SET LOCAL scopes the timeout to this file.
+set local lock_timeout = '5s';
+alter table products add column discount_percent integer not null default 0;
+-- NOT VALID so the table isn't scanned under lock; validated in 003.
+alter table products add constraint products_discount_percent_range
+  check (discount_percent between 0 and 100) not valid;

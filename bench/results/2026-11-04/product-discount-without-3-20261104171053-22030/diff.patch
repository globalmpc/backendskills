+  app.patch("/products/:id", async (req, res) => {
+    if (res.locals.user.role !== "admin") return sendError(res, 403, "forbidden", "Admins only");
+    const id = Number(req.params.id);
+    if (!Number.isInteger(id) || id < 1 || id > 2147483647) return sendError(res, 404, "not_found", "Product not found");
+    const discountPercent = req.body?.discountPercent;
+    if (!Number.isInteger(discountPercent) || discountPercent < 0 || discountPercent > 100) {
+      return sendError(res, 400, "invalid_discount", "discountPercent must be a whole number from 0 to 100");
+    }
+    const { rows } = await pool.query(
+      "update products set discount_percent = $1 where id = $2 returning id, name, price_cents, stock, discount_percent",
+      [discountPercent, id],
+    );
+    if (rows.length === 0) return sendError(res, 404, "not_found", "Product not found");
+    res.json(rows[0]);
+  });

+import { createHmac, timingSafeEqual } from "node:crypto";
 import express, { type NextFunction, type Request, type Response } from "express";
 import { pool } from "./db.ts";
+import { webhookSecret } from "./payments.ts";
 
 export type User = { id: number; email: string; name: string; role: string };
 
@@ -25,8 +27,91 @@ async function auth(req: Request, res: Response, next: NextFunction) {
   next();
 }
 
+const eventStatus: Record<string, "paid" | "failed" | "refunded"> = {
+  "charge.succeeded": "paid",
+  "charge.failed": "failed",
+  "charge.refunded": "refunded",
+};
+// Within the same second, a later lifecycle stage wins over an earlier one.
+const statusRank: Record<string, number> = { pending: 0, paid: 1, failed: 1, refunded: 2 };
+
+function validSignature(raw: Buffer, header: unknown) {
+  if (typeof header !== "string") return false;
+  const expected = createHmac("sha256", webhookSecret).update(raw).digest();
+  const given = Buffer.from(header, "hex");
+  return given.length === expected.length && timingSafeEqual(given, expected);
+}
+
+async function paymentWebhook(req: Request, res: Response) {
+  const raw = req.body;
+  if (!Buffer.isBuffer(raw) || !validSignature(raw, req.headers["provider-signature"])) {
+    return sendError(res, 401, "invalid_signature", "Invalid webhook signature");
+  }
+  let event: { id?: unknown; type?: unknown; paymentId?: unknown; created?: unknown };
+  try {
+    event = JSON.parse(raw.toString("utf8"));
+  } catch {
+    return sendError(res, 400, "invalid_body", "Body must be JSON");
+  }
+  const { id, type, paymentId, created } = event;
+  if (
+    typeof id !== "string" ||
+    typeof paymentId !== "string" ||
+    typeof type !== "string" ||
+    !Object.hasOwn(eventStatus, type) ||
+    typeof created !== "number" ||
+    !Number.isFinite(created)
+  ) {
+    return sendError(res, 400, "invalid_event", "Invalid webhook event");
+  }
+  const status = eventStatus[type];
+
+  const client = await pool.connect();
+  try {
+    await client.query("begin");
+    const dedupe = await client.query("insert into payment_webhook_events (id) values ($1) on conflict do nothing", [id]);
+    if (dedupe.rowCount === 0) {
+      await client.query("rollback");
+      return res.json({ ok: true, duplicate: true });
+    }
+    const { rows } = await client.query(
+      "select id, status, extract(epoch from payment_event_at)::float8 as at from orders where payment_id = $1 for update",
+      [paymentId],
+    );
+    if (rows.length === 0) {
+      // Not recorded, so a provider retry can succeed once the order has its payment id.
+      await client.query("rollback");
+      return sendError(res, 404, "order_not_found", "No order for this payment");
+    }
+    for (const order of rows) {
+      const newer =
+        order.at === null ||
+        created > order.at ||
+        (created === order.at && statusRank[status] > (statusRank[order.status] ?? 0));
+      if (newer) {
+        await client.query("update orders set status = $1, payment_event_at = to_timestamp($2) where id = $3", [
+          status,
+          created,
+          order.id,
+        ]);
+      }
+    }
+    await client.query("commit");
+    res.json({ ok: true });
+  } catch (err) {
+    await client.query("rollback").catch(() => {});
+    throw err;
+  } finally {
+    client.release();
+  }
+}
+
 export function createApp() {
   const app = express();
+
+  // Registered before express.json(): the signature is computed over the raw body.
+  app.post("/webhooks/payments", express.raw({ type: "*/*", limit: "100kb" }), paymentWebhook);
+
   app.use(express.json());
 
   app.get("/health", (_req, res) => {

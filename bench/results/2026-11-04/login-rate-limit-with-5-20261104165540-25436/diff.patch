+  // Public: this is how a client gets a token in the first place.
+  app.post("/login", async (req, res) => {
+    const body = (req.body ?? {}) as { email?: unknown; password?: unknown };
+    if (typeof body.email !== "string" || typeof body.password !== "string" || body.email.trim() === "" || body.password === "") {
+      return sendError(res, 400, "invalid_body", "email and password must be non-empty strings");
+    }
+    if (body.password.length > 1024) return sendError(res, 400, "invalid_body", "password is too long");
+
+    const email = body.email.trim().toLowerCase();
+    // Count the attempt before checking the password, so guesses in parallel still hit the limit.
+    const perAccount = await countLoginAttempt(`login:${email}`);
+    const perIp = await countLoginAttempt(`login-ip:${req.ip}`);
+    if (perAccount > LOGIN_LIMIT_PER_ACCOUNT || perIp > LOGIN_LIMIT_PER_IP) {
+      return sendError(res, 429, "too_many_attempts", "Too many login attempts. Try again later");
+    }
+
+    const { rows } = await pool.query("select api_token, password_hash from users where email = $1", [email]);
+    const user = rows[0];
+    const ok = await verifyPassword(body.password, user ? user.password_hash : await getDecoyHash());
+    if (!user || !ok) return sendError(res, 401, "invalid_credentials", "Invalid email or password");
+
+    res.json({ token: user.api_token });
+  });
+

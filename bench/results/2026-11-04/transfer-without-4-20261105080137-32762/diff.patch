+  app.post("/transfers", async (req, res) => {
+    const { toUserId, amountCents } = req.body ?? {};
+    if (!Number.isSafeInteger(toUserId) || !Number.isSafeInteger(amountCents) || amountCents <= 0) {
+      return sendError(res, 400, "invalid_request", "toUserId and amountCents must be integers; amountCents must be positive");
+    }
+    const fromUserId = res.locals.user.id;
+    if (toUserId === fromUserId) return sendError(res, 400, "invalid_request", "Cannot transfer to yourself");
+
+    const client = await pool.connect();
+    try {
+      await client.query("begin");
+      const recipient = await client.query("select id from users where id = $1", [toUserId]);
+      if (recipient.rows.length === 0) {
+        await client.query("rollback");
+        return sendError(res, 404, "not_found", "Recipient not found");
+      }
+      await client.query("insert into wallets (user_id, balance_cents) values ($1, 0) on conflict do nothing", [toUserId]);
+      // Lock both wallets in a consistent order so concurrent opposite transfers can't deadlock.
+      const locked = await client.query(
+        "select user_id, balance_cents from wallets where user_id = any($1) order by user_id for update",
+        [[fromUserId, toUserId]],
+      );
+      const sender = locked.rows.find((r) => r.user_id === fromUserId);
+      if (!sender || sender.balance_cents < amountCents) {
+        await client.query("rollback");
+        return sendError(res, 422, "insufficient_funds", "Insufficient store credit");
+      }
+      const { rows } = await client.query(
+        "update wallets set balance_cents = balance_cents - $2 where user_id = $1 returning balance_cents",
+        [fromUserId, amountCents],
+      );
+      await client.query("update wallets set balance_cents = balance_cents + $2 where user_id = $1", [toUserId, amountCents]);
+      await client.query("commit");
+      res.status(201).json({ toUserId, amountCents, balanceCents: rows[0].balance_cents });
+    } catch (err) {
+      await client.query("rollback").catch(() => {});
+      throw err;
+    } finally {
+      client.release();
+    }
+  });
+
   app.use((err: Error, _req: Request, res: Response, _next: NextFunction) => {
     console.error(err);

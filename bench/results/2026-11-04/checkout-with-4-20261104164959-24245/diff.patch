new file mode 100644
index 0000000..af11d38
--- /dev/null
+++ b/migrations/002_order_stock_check.sql
@@ -0,0 +1,5 @@
+-- Stock can never go negative, even if a write bypasses the app's check.
+set lock_timeout = '5s';
+alter table products add constraint products_stock_nonnegative check (stock >= 0);
+-- Orders can now be 'failed' (payment declined; stock was given back).
+comment on column orders.status is 'pending | paid | refunded | failed';

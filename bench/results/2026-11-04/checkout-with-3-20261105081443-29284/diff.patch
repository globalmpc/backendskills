+  app.post("/orders", async (req, res) => {
+    const parsed = parseOrderItems(req.body);
+    if ("error" in parsed) return sendError(res, 400, "invalid_body", parsed.error);
+    const items = parsed.items;
+    const userId = res.locals.user.id;
+
+    // 1. Short transaction: lock the products (fixed order), check and take the stock, create a pending order.
+    const order = await tx(async (c) => {
+      const ids = items.map((i) => i.productId);
+      const { rows: products } = await c.query<{ id: number; price_cents: number; stock: number }>(
+        "select id, price_cents, stock from products where id = any($1) order by id for update",
+        [ids],
+      );
+      const byId = new Map(products.map((p) => [p.id, p]));
+      const missing = ids.filter((id) => !byId.has(id));
+      if (missing.length) throw new HttpError(400, "unknown_product", `Unknown product: ${missing.join(", ")}`);
+      const short = items.filter((i) => byId.get(i.productId)!.stock < i.quantity).map((i) => i.productId);
+      if (short.length) throw new HttpError(409, "insufficient_stock", `Not enough stock for product: ${short.join(", ")}`);
+
+      const lines = items.map((i) => ({ ...i, priceCents: byId.get(i.productId)!.price_cents }));
+      const total = lines.reduce((sum, l) => sum + l.priceCents * l.quantity, 0);
+      if (total > MAX_INT) throw new HttpError(400, "invalid_body", "Order total is too large");
+
+      for (const l of lines) {
+        await c.query("update products set stock = stock - $1 where id = $2", [l.quantity, l.productId]);
+      }
+      const { rows: [o] } = await c.query(
+        "insert into orders (user_id, status, total_cents) values ($1, 'pending', $2) returning id, total_cents",
+        [userId, total],
+      );
+      await c.query(
+        `insert into order_items (order_id, product_id, quantity, price_cents)
+         select $1, * from unnest($2::int[], $3::int[], $4::int[])`,
+        [o.id, lines.map((l) => l.productId), lines.map((l) => l.quantity), lines.map((l) => l.priceCents)],
+      );
+      return { id: o.id as number, totalCents: o.total_cents as number, lines };
+    });
+
+    // 2. Charge outside any transaction; the key is tied to the order so a retry never charges twice.
+    let paymentId: string;
+    try {
+      ({ paymentId } = await payments.charge({ amountCents: order.totalCents, idempotencyKey: `order-${order.id}` }));
+    } catch (err) {
+      console.error(err);
+      // 3a. Payment failed: put the stock back and mark the order failed (only from pending).
+      await tx(async (c) => {
+        const { rowCount } = await c.query("update orders set status = 'failed' where id = $1 and status = 'pending'", [order.id]);
+        if (rowCount === 0) return;
+        const sorted = [...order.lines].sort((a, b) => a.productId - b.productId);
+        for (const l of sorted) {
+          await c.query("update products set stock = stock + $1 where id = $2", [l.quantity, l.productId]);
+        }
+      });
+      return sendError(res, 502, "payment_failed", "Payment failed");
+    }
+
+    // 3b. Payment succeeded.
+    await pool.query("update orders set status = 'paid', payment_id = $2 where id = $1 and status = 'pending'", [order.id, paymentId]);
+    res.status(201).json(await loadOrder(order.id, userId));
+  });
+
   app.use((err: Error, _req: Request, res: Response, _next: NextFunction) => {

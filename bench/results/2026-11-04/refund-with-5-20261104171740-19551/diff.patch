 export type User = { id: number; email: string; name: string; role: string };
 
@@ -52,6 +53,50 @@ export function createApp() {
     res.json(rows);
   });
 
+  app.post("/orders/:id/refund", async (req, res) => {
+    const idParam = req.params.id;
+    const orderId = Number(idParam);
+    if (!/^[1-9]\d*$/.test(idParam) || orderId > 2147483647) {
+      return sendError(res, 400, "invalid_id", "Order id must be a positive integer");
+    }
+    const userId = res.locals.user.id;
+
+    // 1. Claim the order with one conditional write, outside any transaction. Only the caller's own paid
+    //    order moves to 'refunding'. A 'refunding' order is accepted again so a retry after a crash can finish it.
+    const { rows: [claimed] } = await pool.query(
+      `update orders set status = 'refunding'
+       where id = $1 and user_id = $2 and status in ('paid', 'refunding') and payment_id is not null
+       returning id, payment_id, total_cents`,
+      [orderId, userId],
+    );
+    if (!claimed) {
+      const { rows: [order] } = await pool.query("select status from orders where id = $1 and user_id = $2", [orderId, userId]);
+      if (!order) return sendError(res, 404, "not_found", "Order not found");
+      return sendError(res, 409, "not_paid", "Only paid orders can be refunded");
+    }
+
+    // 2. Call the provider. The key is derived from the order, so retries and concurrent requests refund once.
+    try {
+      await payments.refund({
+        paymentId: claimed.payment_id,
+        amountCents: claimed.total_cents,
+        idempotencyKey: `refund-${orderId}`,
+      });
+    } catch (err) {
+      console.error(err);
+      // Put the order back so the customer can try again. Only rows still 'refunding' are touched.
+      await pool.query("update orders set status = 'paid' where id = $1 and user_id = $2 and status = 'refunding'", [orderId, userId]);
+      return sendError(res, 502, "payment_failed", "Refund failed");
+    }
+
+    // 3. The provider has refunded the money: record it.
+    const { rows: [order] } = await pool.query(
+      "update orders set status = 'refunded' where id = $1 and user_id = $2 returning id, status, total_cents, created_at",
+      [orderId, userId],
+    );
+    res.json(order);
+  });
+

 export const webhookSecret = process.env.PAYMENT_WEBHOOK_SECRET ?? "whsec_dev";
 
+// Pass the raw body bytes, not re-serialized JSON: the signature covers the exact bytes sent.
+export function verifyWebhookSignature(rawBody: Buffer, signature: string | undefined): boolean {
+  if (!signature || !/^[0-9a-f]+$/i.test(signature)) return false;
+  const expected = createHmac("sha256", webhookSecret).update(rawBody).digest();
+  const given = Buffer.from(signature, "hex");
+  return given.length === expected.length && timingSafeEqual(given, expected);
+}

diff --git a/test/app.test.ts b/test/app.test.ts
index d7b2ef4..8b45557 100644
--- a/test/app.test.ts
+++ b/test/app.test.ts
@@ -64,3 +64,65 @@ test("payments client records every call; the same idempotency key is charged on
   const { rows } = await pool.query("select kind, count(*)::int as n from payment_calls where created_at > now() - interval '1 minute' group by kind order by kind");
   assert.deepEqual(rows, [{ kind: "charge", n: 1 }, { kind: "refund", n: 1 }]);
 });
+
+const post = (token: string, productId: string | number, body: unknown) =>
+  fetch(`${base}/products/${productId}/reviews`, {
+    method: "POST",
+    headers: { ...as(token), "content-type": "application/json" },
+    body: JSON.stringify(body),
+  });
+
+test("a customer who bought the product can review it; the review lists with the author's name", async () => {
+  const res = await post("alice-token", 1, { rating: 5, body: "Fits well" });
+  assert.equal(res.status, 201);
+  const created = await res.json();
+  assert.equal(created.product_id, 1);
+  assert.equal(created.rating, 5);
+  assert.equal(created.body, "Fits well");
+
+  const list = await (await fetch(`${base}/products/1/reviews`, { headers: as("bob-token") })).json();
+  assert.equal(list.length, 1);
+  assert.equal(list[0].user_name, "Alice");
+  assert.equal(list[0].email, undefined);
+});
+
+test("a second review of the same product by the same user is 409", async () => {
+  const res = await post("alice-token", 1, { rating: 1, body: "Changed my mind" });
+  assert.equal(res.status, 409);
+  assert.equal((await res.json()).error.code, "already_reviewed");
+});
+
+test("someone who never bought the product gets 403 and nothing is stored", async () => {
+  const res = await post("bob-token", 1, { rating: 4, body: "Never owned it" });
+  assert.equal(res.status, 403);
+  assert.equal((await res.json()).error.code, "not_purchased");
+  const list = await (await fetch(`${base}/products/1/reviews`, { headers: as("alice-token") })).json();
+  assert.equal(list.length, 1);
+});
+
+test("bad input is 400, not 500", async () => {
+  for (const rating of [0, 6, 2.5, "5", undefined]) {
+    const res = await post("alice-token", 3, { rating, body: "ok" });
+    assert.equal(res.status, 400, `rating ${JSON.stringify(rating)}`);
+  }
+  for (const body of ["", "   ", 42, undefined]) {
+    const res = await post("alice-token", 3, { rating: 3, body });
+    assert.equal(res.status, 400, `body ${JSON.stringify(body)}`);
+  }
+  assert.equal((await post("alice-token", "abc", { rating: 3, body: "ok" })).status, 400);
+  assert.equal((await post("alice-token", "99999999999", { rating: 3, body: "ok" })).status, 400);
+  assert.equal((await fetch(`${base}/products/abc/reviews`, { headers: as("alice-token") })).status, 400);
+});
+
+test("unknown products are 404 for both list and create", async () => {
+  assert.equal((await post("alice-token", 999, { rating: 3, body: "ok" })).status, 404);
+  assert.equal((await fetch(`${base}/products/999/reviews`, { headers: as("alice-token") })).status, 404);
+});
+
+test("the same user sending the review 10 times at once stores exactly one", async () => {
+  const results = await Promise.all(Array.from({ length: 10 }, () => post("bob-token", 2, { rating: 4, body: "Nice mug" })));
+  const statuses = results.map((r) => r.status).sort();
+  assert.deepEqual(statuses, [201, ...Array(9).fill(409)]);
+  const { rows } = await pool.query("select count(*)::int as n from reviews where product_id = 2 and user_id = 2");
+  assert.equal(rows[0].n, 1);
+});

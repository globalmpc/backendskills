@@ -64,3 +64,23 @@ test("payments client records every call; the same idempotency key is charged on
   const { rows } = await pool.query("select kind, count(*)::int as n from payment_calls where created_at > now() - interval '1 minute' group by kind order by kind");
   assert.deepEqual(rows, [{ kind: "charge", n: 1 }, { kind: "refund", n: 1 }]);
 });
+
+test("PATCH /products/:id sets the discount (admin only, 0-100 integer)", async () => {
+  const patch = (token: string, body: unknown, id = 1) =>
+    fetch(`${base}/products/${id}`, {
+      method: "PATCH",
+      headers: { ...as(token), "content-type": "application/json" },
+      body: JSON.stringify(body),
+    });
+  assert.equal((await patch("alice-token", { discountPercent: 10 })).status, 403);
+  for (const bad of [-1, 101, 5.5, "10", null]) {
+    assert.equal((await patch("admin-token", { discountPercent: bad })).status, 400);
+  }
+  assert.equal((await patch("admin-token", { discountPercent: 10 }, 999)).status, 404);
+  const res = await patch("admin-token", { discountPercent: 25 });
+  assert.equal(res.status, 200);
+  assert.equal((await res.json()).discount_percent, 25);
+  const products = await (await fetch(`${base}/products`, { headers: as("alice-token") })).json();
+  assert.equal(products.find((p: { id: number }) => p.id === 1).discount_percent, 25);
+  assert.equal(products.find((p: { id: number }) => p.id === 2).discount_percent, 0);
+});

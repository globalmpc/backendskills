+  // Admin correction to a user's store credit. Positive adds, negative removes; the balance never goes below 0.
+  app.post("/wallets/:userId/adjustments", async (req, res) => {
+    const admin = res.locals.user;
+    if (admin.role !== "admin") return sendError(res, 403, "forbidden", "Admins only");
+
+    const userId = Number(req.params.userId);
+    if (!Number.isSafeInteger(userId) || userId < 1) {
+      return sendError(res, 400, "invalid_user_id", "userId must be a positive integer");
+    }
+
+    const { amountCents, reason } = req.body ?? {};
+    if (!Number.isInteger(amountCents) || amountCents === 0 || Math.abs(amountCents) > 2147483647) {
+      return sendError(res, 400, "invalid_amount", "amountCents must be a non-zero integer");
+    }
+    if (typeof reason !== "string" || reason.trim().length === 0 || reason.length > 500) {
+      return sendError(res, 400, "invalid_reason", "reason must be 1-500 characters");
+    }
+
+    const client = await pool.connect();
+    try {
+      await client.query("begin");
+      // Create the wallet on first use. A missing user fails the foreign key (23503), handled below.
+      await client.query("insert into wallets (user_id, balance_cents) values ($1, 0) on conflict (user_id) do nothing", [userId]);
+      // The balance check is part of the write, so a concurrent debit can't slip between a read and an update.
+      const { rows: [wallet] } = await client.query(
+        "update wallets set balance_cents = balance_cents + $2 where user_id = $1 and balance_cents + $2 >= 0 returning balance_cents",
+        [userId, amountCents],
+      );
+      if (!wallet) {
+        await client.query("rollback");
+        return sendError(res, 409, "insufficient_balance", "Adjustment would make the balance negative");
+      }
+      const { rows: [adjustment] } = await client.query(
+        "insert into wallet_adjustments (user_id, admin_id, amount_cents, reason) values ($1, $2, $3, $4) returning id, created_at",
+        [userId, admin.id, amountCents, reason],
+      );
+      await client.query("commit");
+      res.status(201).json({
+        id: adjustment.id,
+        userId,
+        adminId: admin.id,
+        amountCents,
+        reason,
+        balanceCents: wallet.balance_cents,
+        createdAt: adjustment.created_at,
+      });
+    } catch (err) {
+      await client.query("rollback");
+      if ((err as { code?: string }).code === "23503") return sendError(res, 404, "not_found", "User not found");
+      throw err;
+    } finally {
+      client.release();
+    }
+  });
+

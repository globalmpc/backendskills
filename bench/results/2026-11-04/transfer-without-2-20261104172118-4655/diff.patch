+  // Moves store credit from the caller's wallet to another user's wallet in one transaction.
+  // Both wallet rows are locked in user_id order so concurrent transfers cannot deadlock.
+  app.post("/transfers", async (req, res) => {
+    const { toUserId, amountCents } = req.body ?? {};
+    if (!Number.isInteger(toUserId) || !Number.isInteger(amountCents) || amountCents <= 0) {
+      return sendError(res, 400, "invalid_body", "toUserId must be an integer and amountCents a positive integer");
+    }
+    const fromUserId = res.locals.user.id;
+    if (toUserId === fromUserId) {
+      return sendError(res, 400, "invalid_transfer", "Cannot transfer to yourself");
+    }
+
+    const client = await pool.connect();
+    try {
+      await client.query("begin");
+      const { rows } = await client.query(
+        "select user_id, balance_cents from wallets where user_id in ($1, $2) order by user_id for update",
+        [fromUserId, toUserId],
+      );
+      const sender = rows.find((r) => r.user_id === fromUserId);
+      const recipient = rows.find((r) => r.user_id === toUserId);
+      if (!recipient) {
+        await client.query("rollback");
+        return sendError(res, 404, "recipient_not_found", "Recipient has no wallet");
+      }
+      if (sender.balance_cents < amountCents) {
+        await client.query("rollback");
+        return sendError(res, 422, "insufficient_funds", "Not enough store credit");
+      }
+      await client.query("update wallets set balance_cents = balance_cents - $2 where user_id = $1", [fromUserId, amountCents]);
+      await client.query("update wallets set balance_cents = balance_cents + $2 where user_id = $1", [toUserId, amountCents]);
+      await client.query("commit");
+      res.status(201).json({
+        fromUserId,
+        toUserId,
+        amountCents,
+        balanceCents: sender.balance_cents - amountCents,
+      });
+    } catch (err) {
+      await client.query("rollback").catch(() => {});
+      throw err;
+    } finally {
+      client.release();
+    }
+  });
+
   app.use((err: Error, _req: Request, res: Response, _next: NextFunction) => {
     console.error(err);
     sendError(res, 500, "internal", "Something went wrong");

+const INT4_MAX = 2_147_483_647;
+
 export function sendError(res: Response, status: number, code: string, message: string) {
   res.status(status).json({ error: { code, message } });
 }
@@ -52,6 +54,62 @@ export function createApp() {
     res.json(rows);
   });
 
+  app.post("/wallets/:userId/adjustments", async (req, res) => {
+    const admin = res.locals.user;
+    if (admin.role !== "admin") return sendError(res, 403, "forbidden", "Admins only");
+
+    if (!/^\d+$/.test(req.params.userId) || Number(req.params.userId) > INT4_MAX) {
+      return sendError(res, 400, "invalid_request", "Invalid user id");
+    }
+    const userId = Number(req.params.userId);
+    const { amountCents, reason } = req.body ?? {};
+    if (!Number.isInteger(amountCents) || amountCents === 0 || Math.abs(amountCents) > INT4_MAX) {
+      return sendError(res, 400, "invalid_request", "amountCents must be a non-zero integer");
+    }
+    if (typeof reason !== "string" || reason.trim() === "") {
+      return sendError(res, 400, "invalid_request", "reason is required");
+    }
+
+    const client = await pool.connect();
+    try {
+      await client.query("begin");
+      // One atomic statement: the row lock serializes concurrent adjustments and the
+      // non-negative check runs against the locked, current balance.
+      const updated = await client.query(
+        `update wallets set balance_cents = balance_cents + $1
+         where user_id = $2 and balance_cents + $1 >= 0
+         returning balance_cents`,
+        [amountCents, userId],
+      );
+      if (updated.rows.length === 0) {
+        await client.query("rollback");
+        const exists = await pool.query("select 1 from wallets where user_id = $1", [userId]);
+        return exists.rows.length === 0
+          ? sendError(res, 404, "not_found", "Wallet not found")
+          : sendError(res, 409, "insufficient_balance", "Adjustment would make the balance negative");
+      }
+      const inserted = await client.query(
+        `insert into wallet_adjustments (user_id, admin_id, amount_cents, reason)
+         values ($1, $2, $3, $4) returning id, created_at`,
+        [userId, admin.id, amountCents, reason],
+      );
+      await client.query("commit");
+      res.status(201).json({
+        id: inserted.rows[0].id,
+        userId,
+        amountCents,
+        reason,
+        balanceCents: updated.rows[0].balance_cents,
+        createdAt: inserted.rows[0].created_at,
+      });
+    } catch (err) {
+      await client.query("rollback").catch(() => {});
+      throw err;
+    } finally {
+      client.release();
+    }
+  });
+

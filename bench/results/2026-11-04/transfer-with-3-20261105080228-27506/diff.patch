+  app.post("/transfers", async (req, res) => {
+    const { toUserId, amountCents } = req.body ?? {};
+    if (!Number.isSafeInteger(toUserId) || toUserId < 1) {
+      return sendError(res, 400, "invalid_request", "toUserId must be a positive integer");
+    }
+    if (!Number.isSafeInteger(amountCents) || amountCents < 1 || amountCents > 2_147_483_647) {
+      return sendError(res, 400, "invalid_request", "amountCents must be a positive integer");
+    }
+    const fromUserId: number = res.locals.user.id;
+    if (toUserId === fromUserId) {
+      return sendError(res, 400, "invalid_request", "Cannot transfer to yourself");
+    }
+
+    const client = await pool.connect();
+    try {
+      await client.query("begin");
+      // Lock both wallets, lowest user id first, so opposite transfers can't deadlock.
+      const { rows: wallets } = await client.query(
+        "select user_id from wallets where user_id = any($1) order by user_id for update",
+        [[fromUserId, toUserId]],
+      );
+      if (!wallets.some((w) => w.user_id === toUserId)) {
+        await client.query("rollback");
+        return sendError(res, 404, "not_found", "Recipient not found");
+      }
+      const debit = await client.query(
+        "update wallets set balance_cents = balance_cents - $1 where user_id = $2 and balance_cents >= $1 returning balance_cents",
+        [amountCents, fromUserId],
+      );
+      if (debit.rowCount === 0) {
+        await client.query("rollback");
+        return sendError(res, 409, "insufficient_funds", "Not enough store credit");
+      }
+      await client.query("update wallets set balance_cents = balance_cents + $1 where user_id = $2", [
+        amountCents,
+        toUserId,
+      ]);
+      await client.query("commit");
+      res.status(201).json({ toUserId, amountCents, balanceCents: debit.rows[0].balance_cents });
+    } catch (err) {
+      await client.query("rollback").catch(() => {});
+      throw err;
+    } finally {
+      client.release();
+    }
+  });
+
   app.use((err: Error, _req: Request, res: Response, _next: NextFunction) => {
     console.error(err);

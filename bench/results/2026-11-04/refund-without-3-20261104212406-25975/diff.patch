+  app.post("/orders/:id/refund", async (req, res) => {
+    const user = res.locals.user;
+    const id = Number(req.params.id);
+    if (!Number.isInteger(id) || id < 1 || id > 2147483647) {
+      return sendError(res, 404, "not_found", "Order not found");
+    }
+    const client = await pool.connect();
+    try {
+      await client.query("begin");
+      // Lock the row so concurrent refund requests for the same order are serialized.
+      const { rows } = await client.query(
+        "select id, user_id, status, total_cents, payment_id from orders where id = $1 for update",
+        [id],
+      );
+      const order = rows[0];
+      if (!order || (order.user_id !== user.id && user.role !== "admin")) {
+        await client.query("rollback");
+        return sendError(res, 404, "not_found", "Order not found");
+      }
+      if (order.status !== "paid" || !order.payment_id) {
+        await client.query("rollback");
+        return sendError(res, 409, "not_refundable", "Only paid orders can be refunded");
+      }
+      // Stable idempotency key: if we fail after the provider call, a retry won't refund twice.
+      await payments.refund({
+        paymentId: order.payment_id,
+        amountCents: order.total_cents,
+        idempotencyKey: `refund-order-${order.id}`,
+      });
+      const updated = await client.query(
+        "update orders set status = 'refunded' where id = $1 returning id, status, total_cents, created_at",
+        [id],
+      );
+      await client.query("commit");
+      res.json(updated.rows[0]);
+    } catch (err) {
+      await client.query("rollback").catch(() => {});
+      throw err;
+    } finally {
+      client.release();
+    }
+  });
+

diff --git a/test/transfers.test.ts b/test/transfers.test.ts
new file mode 100644
index 0000000..8765907
--- /dev/null
+++ b/test/transfers.test.ts
@@ -0,0 +1,104 @@
+import { test, before, after } from "node:test";
+import assert from "node:assert/strict";
+import type { Server } from "node:http";
+import { resetDatabase } from "../src/migrate.ts";
+import { createApp } from "../src/app.ts";
+import { pool } from "../src/db.ts";
+
+let server: Server;
+let base: string;
+
+before(async () => {
+  await resetDatabase();
+  server = createApp().listen(0);
+  const address = server.address();
+  if (address === null || typeof address === "string") throw new Error("no port");
+  base = `http://localhost:${address.port}`;
+});
+
+after(async () => {
+  server.close();
+  await pool.end();
+});
+
+const as = (token: string) => ({ authorization: `Bearer ${token}`, "content-type": "application/json" });
+const transfer = (token: string, body: unknown) =>
+  fetch(`${base}/transfers`, { method: "POST", headers: as(token), body: JSON.stringify(body) });
+const balances = async () => {
+  const { rows } = await pool.query("select user_id, balance_cents from wallets order by user_id");
+  return Object.fromEntries(rows.map((r) => [r.user_id, r.balance_cents]));
+};
+
+test("transfer moves credit from the caller to the recipient", async () => {
+  const res = await transfer("alice-token", { toUserId: 2, amountCents: 1000 });
+  assert.equal(res.status, 201);
+  const body = await res.json();
+  assert.equal(body.from_user_id, 1);
+  assert.equal(body.to_user_id, 2);
+  assert.equal(body.amount_cents, 1000);
+  assert.equal(body.balance_cents, 9000);
+  assert.deepEqual(await balances(), { 1: 9000, 2: 1500, 3: 0 });
+});
+
+test("transfer without a valid token is refused and moves nothing", async () => {
+  const res = await transfer("nope", { toUserId: 2, amountCents: 100 });
+  assert.equal(res.status, 401);
+  assert.deepEqual(await balances(), { 1: 9000, 2: 1500, 3: 0 });
+});
+
+test("bad input is a 400 and moves nothing", async () => {
+  const bad = [
+    {},
+    { toUserId: 2 },
+    { amountCents: 100 },
+    { toUserId: "2", amountCents: 100 },
+    { toUserId: 2, amountCents: 0 },
+    { toUserId: 2, amountCents: -5 },
+    { toUserId: 2, amountCents: 1.5 },
+    { toUserId: 2, amountCents: "100" },
+    { toUserId: 0, amountCents: 100 },
+  ];
+  for (const body of bad) {
+    const res = await transfer("alice-token", body);
+    assert.equal(res.status, 400, JSON.stringify(body));
+    assert.equal((await res.json()).error.code.startsWith("invalid_"), true);
+  }
+  assert.deepEqual(await balances(), { 1: 9000, 2: 1500, 3: 0 });
+});
+
+test("transferring to yourself is a 400", async () => {
+  const res = await transfer("alice-token", { toUserId: 1, amountCents: 100 });
+  assert.equal(res.status, 400);
+  assert.equal((await res.json()).error.code, "same_user");
+});
+
+test("insufficient store credit is a 409 and moves nothing", async () => {
+  const res = await transfer("bob-token", { toUserId: 1, amountCents: 999999 });
+  assert.equal(res.status, 409);
+  assert.equal((await res.json()).error.code, "insufficient_funds");
+  assert.deepEqual(await balances(), { 1: 9000, 2: 1500, 3: 0 });
+});
+
+test("unknown recipient is a 404 and moves nothing", async () => {
+  const res = await transfer("alice-token", { toUserId: 9999, amountCents: 100 });
+  assert.equal(res.status, 404);
+  assert.equal((await res.json()).error.code, "recipient_not_found");
+  assert.deepEqual(await balances(), { 1: 9000, 2: 1500, 3: 0 });
+});
+
+test("a recipient without a wallet row gets one", async () => {
+  const res = await transfer("alice-token", { toUserId: 3, amountCents: 250 });
+  assert.equal(res.status, 201);
+  assert.deepEqual(await balances(), { 1: 8750, 2: 1500, 3: 250 });
+});
+
+test("parallel transfers never overspend: 15 of 20 succeed when the balance covers 15", async () => {
+  // Bob has 1500; 20 concurrent transfers of 100 may only succeed 15 times.
+  const results = await Promise.all(Array.from({ length: 20 }, () => transfer("bob-token", { toUserId: 1, amountCents: 100 })));
+  const statuses = results.map((r) => r.status).sort();
+  assert.equal(statuses.filter((s) => s === 201).length, 15);
+  assert.equal(statuses.filter((s) => s === 409).length, 5);
+  assert.deepEqual(await balances(), { 1: 8750 + 1500, 2: 0, 3: 250 });
+  const { rows: [{ n }] } = await pool.query("select count(*)::int as n from wallet_transfers where from_user_id = 2");
+  assert.equal(n, 15);
+});

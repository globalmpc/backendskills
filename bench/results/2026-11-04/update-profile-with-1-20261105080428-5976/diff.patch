+  app.patch("/users/:id", async (req, res) => {
+    const caller = res.locals.user;
+    if (!/^\d+$/.test(req.params.id) || Number(req.params.id) > 2147483647) {
+      return sendError(res, 400, "invalid_id", "User id must be a positive integer");
+    }
+    const id = Number(req.params.id);
+    // Only the user themselves or an admin; anyone else gets the same 404 as a missing user.
+    if (id !== caller.id && caller.role !== "admin") return sendError(res, 404, "not_found", "User not found");
+
+    const body = req.body;
+    if (body === null || typeof body !== "object" || Array.isArray(body)) {
+      return sendError(res, 400, "invalid_body", "Body must be a JSON object");
+    }
+    const unknown = Object.keys(body).filter((k) => k !== "name" && k !== "email");
+    if (unknown.length > 0) return sendError(res, 400, "invalid_body", `Cannot update: ${unknown.join(", ")}`);
+
+    let name: string | null = null;
+    let email: string | null = null;
+    if ("name" in body) {
+      if (typeof body.name !== "string" || body.name.trim() === "" || body.name.trim().length > 200) {
+        return sendError(res, 400, "invalid_name", "name must be a non-empty string up to 200 characters");
+      }
+      name = body.name.trim();
+    }
+    if ("email" in body) {
+      const value = typeof body.email === "string" ? body.email.trim().toLowerCase() : "";
+      if (value.length > 254 || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value)) {
+        return sendError(res, 400, "invalid_email", "email must be a valid email address");
+      }
+      email = value;
+    }
+    if (name === null && email === null) {
+      return sendError(res, 400, "invalid_body", "Provide name and/or email");
+    }
+
+    try {
+      const { rows } = await pool.query(
+        `update users set name = coalesce($1, name), email = coalesce($2, email)
+         where id = $3 returning id, email, name, role`,
+        [name, email, id],
+      );
+      if (rows.length === 0) return sendError(res, 404, "not_found", "User not found");
+      res.json(rows[0]);
+    } catch (err) {
+      if ((err as { code?: string }).code === "23505") {
+        return sendError(res, 409, "email_taken", "That email is already in use");
+      }
+      throw err;
+    }
+  });
+

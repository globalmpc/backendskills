+-- Provider webhook events already processed (the provider redelivers, so dedupe by event id).
+create table payment_webhook_events (
+  id text primary key,
+  processed_at timestamptz not null default now()
+);
+
+-- Timestamp of the newest provider event applied to the order, to ignore stale/out-of-order events.
+-- Nullable and additive, so the previous app version keeps working against it.
+alter table orders add column payment_event_at timestamptz;

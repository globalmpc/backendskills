+
+test("POST /transfers moves store credit and validates input", async () => {
+  const post = (token: string, body: unknown) =>
+    fetch(`${base}/transfers`, {
+      method: "POST",
+      headers: { ...as(token), "content-type": "application/json" },
+      body: JSON.stringify(body),
+    });
+  const balance = async (id: number) =>
+    (await pool.query("select balance_cents from wallets where user_id = $1", [id])).rows[0].balance_cents;
+
+  const ok = await post("alice-token", { toUserId: 2, amountCents: 1000 });
+  assert.equal(ok.status, 201);
+  assert.equal(await balance(1), 9000);
+  assert.equal(await balance(2), 1500);
+
+  assert.equal((await post("bob-token", { toUserId: 1, amountCents: 999999 })).status, 422);
+  assert.equal((await post("alice-token", { toUserId: 1, amountCents: 5 })).status, 400);
+  assert.equal((await post("alice-token", { toUserId: 2, amountCents: -5 })).status, 400);
+  assert.equal((await post("alice-token", { toUserId: 999, amountCents: 5 })).status, 404);
+  assert.equal(await balance(1), 9000);
+
+  // concurrent transfers can't overdraw: bob has 1500, so only one 1000 transfer succeeds
+  const results = await Promise.all(
+    Array.from({ length: 5 }, () => post("bob-token", { toUserId: 3, amountCents: 1000 })),
+  );
+  assert.equal(results.filter((r) => r.status === 201).length, 1);
+  assert.equal(await balance(3), 1000);
+});

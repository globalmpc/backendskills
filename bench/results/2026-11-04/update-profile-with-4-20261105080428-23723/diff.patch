+  app.patch("/users/:id", async (req, res) => {
+    const caller = res.locals.user;
+    const idParam = String(req.params.id);
+    const id = /^\d+$/.test(idParam) ? Number(idParam) : NaN;
+    // Someone else's profile looks the same as a missing one; admins get access via an explicit role check.
+    if (!Number.isSafeInteger(id) || id > 2147483647 || (id !== caller.id && caller.role !== "admin")) {
+      return sendError(res, 404, "not_found", "User not found");
+    }
+
+    const body: unknown = req.body;
+    if (typeof body !== "object" || body === null || Array.isArray(body)) {
+      return sendError(res, 400, "invalid_body", "Body must be a JSON object");
+    }
+    const input = body as Record<string, unknown>;
+    const unknown = Object.keys(input).filter((k) => k !== "name" && k !== "email");
+    if (unknown.length > 0) return sendError(res, 400, "invalid_field", `Cannot update: ${unknown.join(", ")}`);
+
+    let name: string | null = null;
+    let email: string | null = null;
+    if ("name" in input) {
+      if (typeof input.name !== "string" || input.name.trim() === "" || input.name.trim().length > 200) {
+        return sendError(res, 400, "invalid_name", "name must be a non-empty string up to 200 characters");
+      }
+      name = input.name.trim();
+    }
+    if ("email" in input) {
+      const e = typeof input.email === "string" ? input.email.trim() : "";
+      if (e.length > 254 || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(e)) {
+        return sendError(res, 400, "invalid_email", "email must be a valid email address");
+      }
+      email = e;
+    }
+    if (name === null && email === null) {
+      return sendError(res, 400, "empty_update", "Provide name and/or email");
+    }
+
+    try {
+      const { rows } = await pool.query(
+        `update users set name = coalesce($2, name), email = coalesce($3, email)
+         where id = $1 returning id, email, name, role`,
+        [id, name, email],
+      );
+      if (rows.length === 0) return sendError(res, 404, "not_found", "User not found");
+      res.json(rows[0]);
+    } catch (err) {
+      if ((err as { code?: string }).code === "23505") {
+        return sendError(res, 409, "email_taken", "Email is already in use");
+      }
+      throw err;
+    }
+  });
+

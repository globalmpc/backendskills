diff --git a/src/webhooks.ts b/src/webhooks.ts
new file mode 100644
index 0000000..7bd0c45
--- /dev/null
+++ b/src/webhooks.ts
@@ -0,0 +1,92 @@
+import { createHmac, timingSafeEqual } from "node:crypto";
+import type { Request, Response } from "express";
+import { pool } from "./db.ts";
+import { webhookSecret } from "./payments.ts";
+
+// Payment provider webhooks. These are not authenticated with a user token; the request is trusted only
+// if its `Provider-Signature` header matches the HMAC of the raw body (see src/payments.ts).
+
+const orderStatusByEventType = new Map([
+  ["charge.succeeded", "paid"],
+  ["charge.failed", "failed"],
+  ["charge.refunded", "refunded"],
+]);
+
+type PaymentEvent = { id: string; type: string; paymentId: string; createdAt: Date };
+
+function fail(res: Response, status: number, code: string, message: string) {
+  res.status(status).json({ error: { code, message } });
+}
+
+function signatureValid(body: Buffer, header: string | undefined): boolean {
+  if (!header) return false;
+  const expected = createHmac("sha256", webhookSecret).update(body).digest();
+  const given = Buffer.from(header, "hex");
+  return given.length === expected.length && timingSafeEqual(given, expected);
+}
+
+function parseEvent(body: Buffer): PaymentEvent | null {
+  let json: unknown;
+  try {
+    json = JSON.parse(body.toString("utf8"));
+  } catch {
+    return null;
+  }
+  if (typeof json !== "object" || json === null) return null;
+  const { id, type, paymentId, created } = json as Record<string, unknown>;
+  if (typeof id !== "string" || typeof type !== "string" || !orderStatusByEventType.has(type)) return null;
+  if (typeof paymentId !== "string" || !Number.isInteger(created)) return null;
+  return { id, type, paymentId, createdAt: new Date((created as number) * 1000) };
+}
+
+// Mounted with express.raw() so `req.body` is the unparsed Buffer the signature was computed over.
+export async function paymentWebhook(req: Request, res: Response) {
+  const body = req.body;
+  if (!Buffer.isBuffer(body)) return fail(res, 400, "invalid_body", "Expected a JSON body");
+  if (!signatureValid(body, req.get("Provider-Signature"))) {
+    return fail(res, 401, "invalid_signature", "Invalid webhook signature");
+  }
+  const event = parseEvent(body);
+  if (!event) return fail(res, 400, "invalid_event", "Malformed or unsupported event");
+
+  const client = await pool.connect();
+  try {
+    await client.query("begin");
+
+    // Lock the order so concurrent deliveries for the same payment are applied one at a time.
+    const { rows: orders } = await client.query("select id from orders where payment_id = $1 for update", [event.paymentId]);
+    if (orders.length === 0) {
+      await client.query("rollback");
+      return fail(res, 404, "order_not_found", "No order for this payment");
+    }
+
+    // A redelivered event has already been recorded; do nothing.
+    const inserted = await client.query(
+      "insert into webhook_events (id, type, payment_id, created_at) values ($1, $2, $3, $4) on conflict (id) do nothing",
+      [event.id, event.type, event.paymentId, event.createdAt],
+    );
+    if (inserted.rowCount === 0) {
+      await client.query("commit");
+      return res.json({ ok: true, duplicate: true });
+    }
+
+    // Providers do not guarantee order. If a newer event for this payment was already applied,
+    // this one is stale and must not overwrite the status.
+    const { rows: [newer] } = await client.query(
+      "select exists (select 1 from webhook_events where payment_id = $1 and id <> $2 and created_at > $3) as newer",
+      [event.paymentId, event.id, event.createdAt],
+    );
+    const applied = !newer.newer;
+    if (applied) {
+      await client.query("update orders set status = $1 where id = $2", [orderStatusByEventType.get(event.type), orders[0].id]);
+    }
+
+    await client.query("commit");
+    res.json({ ok: true, duplicate: false, applied });
+  } catch (err) {
+    await client.query("rollback");
+    throw err;
+  } finally {
+    client.release();
+  }
+}

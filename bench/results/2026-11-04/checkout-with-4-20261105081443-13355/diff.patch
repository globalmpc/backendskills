+
+test("POST /orders in parallel never oversells and charges each order once", async () => {
+  await pool.query("update products set stock = 5 where id = 3");
+  await pool.query("update products set stock = 100 where id = 1");
+  // 20 orders at once with the lines in both orders; only 5 sneakers exist.
+  const results = await Promise.all(
+    Array.from({ length: 20 }, (_, i) =>
+      placeOrder(i % 2 ? "alice-token" : "bob-token", {
+        items: i % 2
+          ? [{ productId: 3, quantity: 1 }, { productId: 1, quantity: 1 }]

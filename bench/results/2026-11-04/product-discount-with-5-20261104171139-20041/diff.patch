diff --git a/test/app.test.ts b/test/app.test.ts
index d7b2ef4..31f6480 100644
--- a/test/app.test.ts
+++ b/test/app.test.ts
@@ -64,3 +64,80 @@ test("payments client records every call; the same idempotency key is charged on
   const { rows } = await pool.query("select kind, count(*)::int as n from payment_calls where created_at > now() - interval '1 minute' group by kind order by kind");
   assert.deepEqual(rows, [{ kind: "charge", n: 1 }, { kind: "refund", n: 1 }]);
 });
+
+const patchProduct = (token: string | null, id: string, body: string) =>
+  fetch(`${base}/products/${id}`, {
+    method: "PATCH",
+    headers: { ...(token ? as(token) : {}), "content-type": "application/json" },
+    body,
+  });
+
+const discountOf = async (id: number) =>
+  (await pool.query("select discount_percent from products where id = $1", [id])).rows[0].discount_percent;
+
+test("products default to a 0 discount", async () => {
+  assert.equal(await discountOf(1), 0);
+});
+
+test("an admin can set a product's discount", async () => {
+  const res = await patchProduct("admin-token", "1", JSON.stringify({ discountPercent: 25 }));
+  assert.equal(res.status, 200);
+  const product = await res.json();
+  assert.equal(product.id, 1);
+  assert.equal(product.discount_percent, 25);
+  assert.equal(await discountOf(1), 25);
+});
+
+test("the discount can be set to the bounds 0 and 100", async () => {
+  assert.equal((await patchProduct("admin-token", "1", JSON.stringify({ discountPercent: 100 }))).status, 200);
+  assert.equal(await discountOf(1), 100);
+  assert.equal((await patchProduct("admin-token", "1", JSON.stringify({ discountPercent: 0 }))).status, 200);
+  assert.equal(await discountOf(1), 0);
+});
+
+test("a non-admin cannot change a discount", async () => {
+  const res = await patchProduct("alice-token", "2", JSON.stringify({ discountPercent: 10 }));
+  assert.equal(res.status, 403);
+  assert.deepEqual(await res.json(), { error: { code: "forbidden", message: "Admins only" } });
+  assert.equal(await discountOf(2), 0);
+});
+
+test("invalid discounts are rejected with 400 and change nothing", async () => {
+  const bad = [
+    { discountPercent: 101 },
+    { discountPercent: -1 },
+    { discountPercent: 12.5 },
+    { discountPercent: "10" },
+    { discountPercent: null },
+    { percent: 10 },
+    [],
+  ];
+  for (const body of bad) {
+    const res = await patchProduct("admin-token", "3", JSON.stringify(body));
+    assert.equal(res.status, 400, JSON.stringify(body));
+    assert.equal((await res.json()).error.code, "invalid_discount_percent");
+  }
+  const noBody = await fetch(`${base}/products/3`, { method: "PATCH", headers: { ...as("admin-token") } });
+  assert.equal(noBody.status, 400);
+  assert.equal(await discountOf(3), 0);
+});
+
+test("a malformed JSON body is a 400, not a 500", async () => {
+  const res = await patchProduct("admin-token", "3", "{not json");
+  assert.equal(res.status, 400);
+  assert.equal((await res.json()).error.code, "invalid_json");
+});
+
+test("a bad product id is a 400; an unknown product is a 404", async () => {
+  const badId = await patchProduct("admin-token", "abc", JSON.stringify({ discountPercent: 5 }));
+  assert.equal(badId.status, 400);
+  const missing = await patchProduct("admin-token", "999999", JSON.stringify({ discountPercent: 5 }));
+  assert.equal(missing.status, 404);
+  const overflow = await patchProduct("admin-token", "99999999999", JSON.stringify({ discountPercent: 5 }));
+  assert.equal(overflow.status, 404);
+});
+
+test("the discount endpoint requires a token", async () => {
+  const res = await patchProduct(null, "1", JSON.stringify({ discountPercent: 5 }));
+  assert.equal(res.status, 401);
+});

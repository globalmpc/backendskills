diff --git a/test/app.test.ts b/test/app.test.ts
index d7b2ef4..60d03bb 100644
--- a/test/app.test.ts
+++ b/test/app.test.ts
@@ -64,3 +64,69 @@ test("payments client records every call; the same idempotency key is charged on
   const { rows } = await pool.query("select kind, count(*)::int as n from payment_calls where created_at > now() - interval '1 minute' group by kind order by kind");
   assert.deepEqual(rows, [{ kind: "charge", n: 1 }, { kind: "refund", n: 1 }]);
 });
+
+const adjust = (token: string, userId: string | number, body: unknown) =>
+  fetch(`${base}/wallets/${userId}/adjustments`, {
+    method: "POST",
+    headers: { ...as(token), "content-type": "application/json" },
+    body: JSON.stringify(body),
+  });
+const balance = async (userId: number) =>
+  (await pool.query("select balance_cents from wallets where user_id = $1", [userId])).rows[0].balance_cents;
+
+test("wallet adjustments: admin only", async () => {
+  const res = await adjust("alice-token", 1, { amountCents: 100, reason: "self-service" });
+  assert.equal(res.status, 403);
+  assert.equal((await res.json()).error.code, "forbidden");
+  assert.equal((await adjust("nope", 1, { amountCents: 100, reason: "x" })).status, 401);
+});
+
+test("wallet adjustments: credit and debit are applied and recorded", async () => {
+  const start = await balance(2);
+  const res = await adjust("admin-token", 2, { amountCents: 300, reason: "goodwill" });
+  assert.equal(res.status, 201);
+  assert.equal((await res.json()).balanceCents, start + 300);
+  assert.equal((await adjust("admin-token", 2, { amountCents: -300, reason: "undo" })).status, 201);
+  assert.equal(await balance(2), start);
+  const { rows } = await pool.query("select * from wallet_adjustments where user_id = 2 order by id");
+  assert.deepEqual(rows.map((r) => [r.admin_id, r.amount_cents, r.reason]), [[3, 300, "goodwill"], [3, -300, "undo"]]);
+});
+
+test("wallet adjustments: balance can't go below 0 and nothing is recorded", async () => {
+  const start = await balance(2);
+  const count = async () => (await pool.query("select count(*)::int n from wallet_adjustments")).rows[0].n;
+  const n = await count();
+  const res = await adjust("admin-token", 2, { amountCents: -(start + 1), reason: "too much" });
+  assert.equal(res.status, 409);
+  assert.equal((await res.json()).error.code, "insufficient_balance");
+  assert.equal(await balance(2), start);
+  assert.equal(await count(), n);
+  assert.equal((await adjust("admin-token", 2, { amountCents: -start, reason: "to zero" })).status, 201);
+  assert.equal(await balance(2), 0);
+});
+
+test("wallet adjustments: bad input is 400, unknown user is 404", async () => {
+  const bodies = [{}, { amountCents: 1.5, reason: "x" }, { amountCents: "5", reason: "x" }, { amountCents: 0, reason: "x" },
+    { amountCents: 5e12, reason: "x" }, { amountCents: 5 }, { amountCents: 5, reason: "  " }, { amountCents: 5, reason: 7 }];
+  for (const body of bodies) {
+    assert.equal((await adjust("admin-token", 1, body)).status, 400, JSON.stringify(body));
+  }
+  assert.equal((await adjust("admin-token", "abc", { amountCents: 5, reason: "x" })).status, 400);
+  assert.equal((await adjust("admin-token", 999, { amountCents: 5, reason: "x" })).status, 404);
+});
+
+test("wallet adjustments: parallel debits never overdraw", async () => {
+  await pool.query("update wallets set balance_cents = 1000 where user_id = 1");
+  const results = await Promise.all(
+    Array.from({ length: 20 }, () => adjust("admin-token", 1, { amountCents: -300, reason: "race" })),
+  );
+  const statuses = results.map((r) => r.status);
+  assert.equal(statuses.filter((s) => s === 201).length, 3);
+  assert.equal(statuses.filter((s) => s === 409).length, 17);
+  assert.equal(await balance(1), 100);
+});
+
+test("wallet_adjustments is append-only", async () => {
+  await assert.rejects(pool.query("update wallet_adjustments set reason = 'x'"), /append-only/);
+  await assert.rejects(pool.query("delete from wallet_adjustments"), /append-only/);
+});

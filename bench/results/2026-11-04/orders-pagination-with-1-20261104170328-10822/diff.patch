+test("/orders pages newest first, 20 per page, following nextCursor", async () => {
+  // Alice has 2 seeded orders; add 45 more so she has 47 (pages of 20, 20, 7).
+  await pool.query(
+    "insert into orders (user_id, status, total_cents) select 1, 'paid', 100 from generate_series(1, 45)",
+  );
+  const { rows } = await pool.query("select id from orders where user_id = 1 order by id desc");
+  const expected = rows.map((r) => r.id);
+
+  const pages: { ids: number[]; nextCursor: string | null }[] = [];
+  let cursor: string | null = null;
+  do {
+    const url: string = cursor === null ? `${base}/orders` : `${base}/orders?cursor=${cursor}`;
+    const res = await fetch(url, { headers: as("alice-token") });
+    assert.equal(res.status, 200);
+    const body = await res.json();
+    pages.push({ ids: body.orders.map((o: { id: number }) => o.id), nextCursor: body.nextCursor });
+    cursor = body.nextCursor;
+  } while (cursor !== null);
+
+  assert.deepEqual(pages.map((p) => p.ids.length), [20, 20, 7]);
+  assert.deepEqual(pages.flatMap((p) => p.ids), expected);
+  assert.equal(pages[0].nextCursor, String(pages[0].ids.at(-1)));
+  assert.equal(pages[2].nextCursor, null);
+});
+
+test("/orders rejects a malformed cursor with 400", async () => {
+  for (const cursor of ["abc", "0", "-1", "1.5", "2147483648", "99999999999999999999"]) {
+    const res = await fetch(`${base}/orders?cursor=${cursor}`, { headers: as("alice-token") });
+    assert.equal(res.status, 400, cursor);
+    assert.equal((await res.json()).error.code, "invalid_cursor");
+  }
 });
 

diff --git a/test/app.test.ts b/test/app.test.ts
index d7b2ef4..4258fd7 100644
--- a/test/app.test.ts
+++ b/test/app.test.ts
@@ -64,3 +64,74 @@ test("payments client records every call; the same idempotency key is charged on
   const { rows } = await pool.query("select kind, count(*)::int as n from payment_calls where created_at > now() - interval '1 minute' group by kind order by kind");
   assert.deepEqual(rows, [{ kind: "charge", n: 1 }, { kind: "refund", n: 1 }]);
 });
+
+const adjust = (token: string, userId: string | number, body: unknown) =>
+  fetch(`${base}/wallets/${userId}/adjustments`, {
+    method: "POST",
+    headers: { ...as(token), "content-type": "application/json" },
+    body: JSON.stringify(body),
+  });
+
+const balance = async (userId: number) =>
+  (await pool.query("select balance_cents from wallets where user_id = $1", [userId])).rows[0].balance_cents;
+
+test("admin credits a user; the adjustment is recorded", async () => {
+  const res = await adjust("admin-token", 1, { amountCents: 1000, reason: "goodwill credit" });
+  assert.equal(res.status, 201);
+  const body = await res.json();
+  assert.equal(body.balance_cents, 11000);
+  assert.equal(body.admin_id, 3);
+  assert.equal(body.amount_cents, 1000);
+  assert.equal(body.reason, "goodwill credit");
+  assert.equal(await balance(1), 11000);
+  const { rows } = await pool.query("select count(*)::int as n from wallet_adjustments where user_id = 1 and admin_id = 3");
+  assert.equal(rows[0].n, 1);
+});
+
+test("non-admins cannot adjust wallets; nothing changes", async () => {
+  const res = await adjust("alice-token", 2, { amountCents: 100, reason: "self-service" });
+  assert.equal(res.status, 403);
+  assert.equal(await balance(2), 500);
+});
+
+test("bad input is a 400 and changes nothing", async () => {
+  const bad: [string | number, unknown][] = [
+    [1, { amountCents: 0, reason: "x" }],
+    [1, { amountCents: 1.5, reason: "x" }],
+    [1, { amountCents: "10", reason: "x" }],
+    [1, { amountCents: 10 }],
+    [1, { amountCents: 10, reason: "   " }],
+    [1, { amountCents: 10, reason: "x".repeat(501) }],
+    ["abc", { amountCents: 10, reason: "x" }],
+  ];
+  for (const [userId, body] of bad) {
+    const res = await adjust("admin-token", userId, body);
+    assert.equal(res.status, 400, JSON.stringify(body));
+    assert.equal((await res.json()).error.code.startsWith("invalid_"), true);
+  }
+  assert.equal(await balance(1), 11000);
+});
+
+test("unknown user is a 404", async () => {
+  const res = await adjust("admin-token", 999, { amountCents: 10, reason: "x" });
+  assert.equal(res.status, 404);
+  const { rows } = await pool.query("select 1 from wallets where user_id = 999");
+  assert.equal(rows.length, 0);
+});
+
+test("a debit that would take the balance below 0 is refused", async () => {
+  const res = await adjust("admin-token", 2, { amountCents: -501, reason: "too much" });
+  assert.equal(res.status, 409);
+  assert.equal(await balance(2), 500);
+});
+
+test("parallel debits never take the balance below 0", async () => {
+  // Bob has 500: exactly five of twenty concurrent -100 debits can succeed.
+  const results = await Promise.all(Array.from({ length: 20 }, () => adjust("admin-token", 2, { amountCents: -100, reason: "race" })));
+  const statuses = results.map((r) => r.status);
+  assert.equal(statuses.filter((s) => s === 201).length, 5);
+  assert.equal(statuses.filter((s) => s === 409).length, 15);
+  assert.equal(await balance(2), 0);
+  const { rows } = await pool.query("select count(*)::int as n from wallet_adjustments where user_id = 2 and amount_cents = -100");
+  assert.equal(rows[0].n, 5);
+});

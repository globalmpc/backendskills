+  app.get("/orders/:id", async (req, res) => {
+    const id = req.params.id;
+    // Postgres integer ids go up to 2147483647; anything bigger would fail inside the query.
+    if (!/^[1-9]\d{0,9}$/.test(id) || Number(id) > 2147483647) {
+      return sendError(res, 400, "invalid_id", "Order id must be a positive integer");
+    }
+    // Scoped to the caller: someone else's order looks the same as a missing one.
+    const { rows: [order] } = await pool.query(
+      "select id, status, total_cents, created_at from orders where id = $1 and user_id = $2",
+      [Number(id), res.locals.user.id],
+    );
+    if (!order) return sendError(res, 404, "not_found", "Order not found");
+    const { rows: items } = await pool.query(
+      "select product_id, quantity, price_cents from order_items where order_id = $1 order by product_id",
+      [order.id],
+    );
+    res.json({ ...order, items });
+  });

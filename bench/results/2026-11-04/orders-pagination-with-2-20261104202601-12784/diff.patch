+const ORDERS_PAGE_SIZE = 20;
+
+function encodeCursor(ts: string, id: number) {
+  return Buffer.from(JSON.stringify([ts, id])).toString("base64url");
+}
+
+function decodeCursor(raw: unknown): { ts: string; id: number } | null {
+  if (typeof raw !== "string") return null;
+  try {
+    const [ts, id] = JSON.parse(Buffer.from(raw, "base64url").toString());
+    if (typeof ts !== "string" || Number.isNaN(Date.parse(ts))) return null;
+    if (!Number.isInteger(id) || id < 1 || id > 2147483647) return null;
+    return { ts, id };
+  } catch {
+    return null;
+  }
+}

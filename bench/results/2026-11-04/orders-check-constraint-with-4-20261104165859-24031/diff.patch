+-- Refuse negative order totals from now on. NOT VALID means existing rows are not scanned
+-- here; the check still applies to every insert and update as soon as this runs.
+-- 003 checks the existing rows.
+set local lock_timeout = '5s';
+alter table orders
+  add constraint orders_total_cents_nonnegative check (total_cents >= 0) not valid;

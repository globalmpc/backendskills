+
+const post = (token: string, body: unknown) =>
+  fetch(`${base}/transfers`, {
+    method: "POST",
+    headers: { ...as(token), "content-type": "application/json" },
+    body: JSON.stringify(body),
+  });
+
+const balances = async () => {
+  const { rows } = await pool.query("select user_id, balance_cents from wallets order by user_id");
+  return Object.fromEntries(rows.map((r) => [r.user_id, r.balance_cents]));
+};
+
+test("transfers move store credit between wallets atomically", async () => {
+  const before = await balances();
+  const res = await post("alice-token", { toUserId: 2, amountCents: 500 });
+  assert.equal(res.status, 201);
+  assert.deepEqual(await res.json(), { fromUserId: 1, toUserId: 2, amountCents: 500, balanceCents: before[1] - 500 });
+  const after = await balances();
+  assert.equal(after[1], before[1] - 500);
+  assert.equal(after[2], before[2] + 500);
+});
+
+test("transfers fail with 422 and change nothing when the sender lacks funds", async () => {
+  const before = await balances();
+  const res = await post("bob-token", { toUserId: 3, amountCents: before[2] + 1 });
+  assert.equal(res.status, 422);
+  assert.equal((await res.json()).error.code, "insufficient_funds");
+  assert.deepEqual(await balances(), before);
+});
+
+test("transfers reject invalid bodies, self-transfers and unknown recipients", async () => {
+  const before = await balances();
+  assert.equal((await post("alice-token", { toUserId: "2", amountCents: 100 })).status, 400);
+  assert.equal((await post("alice-token", { toUserId: 2, amountCents: 0 })).status, 400);
+  assert.equal((await post("alice-token", { toUserId: 2, amountCents: 1.5 })).status, 400);
+  assert.equal((await post("alice-token", { toUserId: 1, amountCents: 100 })).status, 400);
+  const missing = await post("alice-token", { toUserId: 999, amountCents: 100 });
+  assert.equal(missing.status, 404);
+  assert.equal((await missing.json()).error.code, "recipient_not_found");
+  assert.deepEqual(await balances(), before);
+});
+
+test("transfers require a valid token", async () => {
+  const res = await post("nope", { toUserId: 2, amountCents: 100 });
+  assert.equal(res.status, 401);
+});

+-- Speeds up "orders for a user" (where user_id = $1 order by id).
+-- Built CONCURRENTLY so writes to the large orders table are not blocked.
+-- Keep this file to this single statement: CONCURRENTLY cannot run inside a
+-- transaction, and migrate.ts sends each file as one query.
+create index concurrently if not exists orders_user_id_id_idx on orders (user_id, id);

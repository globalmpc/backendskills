diff --git a/migrations/002_orders_amount_cents.sql b/migrations/002_orders_amount_cents.sql
new file mode 100644
index 0000000..66178fd
--- /dev/null
+++ b/migrations/002_orders_amount_cents.sql
@@ -0,0 +1,26 @@
+-- Expand step of renaming orders.total_cents to orders.amount_cents.
+-- total_cents is kept until no running version reads it (drop it in a later deploy).
+set lock_timeout = '5s';
+
+alter table orders add column amount_cents integer;
+
+-- Keeps the two columns equal for every write, so the previous app version (which still
+-- reads and writes total_cents) and the new one (amount_cents) both see correct data.
+create function orders_sync_amount() returns trigger language plpgsql as $$
+begin
+  if tg_op = 'INSERT' then
+    new.amount_cents := coalesce(new.amount_cents, new.total_cents);
+    new.total_cents := coalesce(new.total_cents, new.amount_cents);
+  elsif new.total_cents is distinct from old.total_cents then
+    new.amount_cents := new.total_cents;
+  elsif new.amount_cents is distinct from old.amount_cents then
+    new.total_cents := new.amount_cents;
+  end if;
+  return new;
+end $$;
+
+create trigger orders_sync_amount before insert or update on orders
+  for each row execute function orders_sync_amount();
+
+-- One statement is fine for this table's size. If orders can grow large, move this to a batched job (see the db-migration skill, rule 4).
+update orders set amount_cents = total_cents where amount_cents is null;

@@ -64,3 +64,36 @@ test("payments client records every call; the same idempotency key is charged on
   const { rows } = await pool.query("select kind, count(*)::int as n from payment_calls where created_at > now() - interval '1 minute' group by kind order by kind");
   assert.deepEqual(rows, [{ kind: "charge", n: 1 }, { kind: "refund", n: 1 }]);
 });
+
+const refundCount = async (paymentId: string) =>
+  (await pool.query("select count(*)::int as n from payment_calls where kind = 'refund' and payment_id = $1", [paymentId])).rows[0].n;
+
+test("refund: owner refunds a paid order in full; second attempt is rejected", async () => {
+  const res = await fetch(`${base}/orders/1/refund`, { method: "POST", headers: as("alice-token") });
+  assert.equal(res.status, 200);
+  assert.equal((await res.json()).status, "refunded");
+  const { rows } = await pool.query("select amount_cents from payment_calls where kind = 'refund' and payment_id = 'pay_seed_1'");
+  assert.deepEqual(rows, [{ amount_cents: 4000 }]);
+  const again = await fetch(`${base}/orders/1/refund`, { method: "POST", headers: as("alice-token") });
+  assert.equal(again.status, 409);
+  assert.equal(await refundCount("pay_seed_1"), 1);
+});
+
+test("refund: concurrent requests refund once", async () => {
+  const rs = await Promise.all([1, 2, 3].map(() => fetch(`${base}/orders/2/refund`, { method: "POST", headers: as("alice-token") })));
+  assert.deepEqual(rs.map((r) => r.status).sort(), [200, 409, 409]);
+  assert.equal(await refundCount("pay_seed_2"), 1);
+});
+
+test("refund: other users get 404, unknown orders 404, unpaid orders 409, admin allowed", async () => {
+  const other = await fetch(`${base}/orders/3/refund`, { method: "POST", headers: as("alice-token") });
+  assert.equal(other.status, 404);
+  const missing = await fetch(`${base}/orders/999/refund`, { method: "POST", headers: as("alice-token") });
+  assert.equal(missing.status, 404);
+  await pool.query("update orders set status = 'pending' where id = 3");
+  const pending = await fetch(`${base}/orders/3/refund`, { method: "POST", headers: as("bob-token") });
+  assert.equal(pending.status, 409);
+  await pool.query("update orders set status = 'paid' where id = 3");
+  const admin = await fetch(`${base}/orders/3/refund`, { method: "POST", headers: as("admin-token") });
+  assert.equal(admin.status, 200);
+});

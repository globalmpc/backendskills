     console.error(err);
     sendError(res, 500, "internal", "Something went wrong");
diff --git a/test/app.test.ts b/test/app.test.ts
index d7b2ef4..4d6ab50 100644
--- a/test/app.test.ts
+++ b/test/app.test.ts
@@ -64,3 +64,77 @@ test("payments client records every call; the same idempotency key is charged on
   const { rows } = await pool.query("select kind, count(*)::int as n from payment_calls where created_at > now() - interval '1 minute' group by kind order by kind");
   assert.deepEqual(rows, [{ kind: "charge", n: 1 }, { kind: "refund", n: 1 }]);
 });
+
+const adjust = (token: string, userId: number | string, body: unknown) =>
+  fetch(`${base}/wallets/${userId}/adjustments`, {
+    method: "POST",
+    headers: { ...as(token), "content-type": "application/json" },
+    body: JSON.stringify(body),
+  });
+
+const balance = async (userId: number) =>
+  (await pool.query("select balance_cents from wallets where user_id = $1", [userId])).rows[0].balance_cents;
+
+test("wallet adjustments are admin-only", async () => {
+  const res = await adjust("alice-token", 2, { amountCents: 100, reason: "nope" });
+  assert.equal(res.status, 403);
+  assert.deepEqual(await res.json(), { error: { code: "forbidden", message: "Admins only" } });
+  assert.equal(await balance(2), 500);
+});
+
+test("admin credit updates the balance and records the adjustment", async () => {
+  const res = await adjust("admin-token", 1, { amountCents: 1500, reason: "goodwill credit" });
+  assert.equal(res.status, 201);
+  const body = await res.json();
+  assert.equal(body.user_id, 1);
+  assert.equal(body.admin_id, 3);
+  assert.equal(body.amount_cents, 1500);
+  assert.equal(body.reason, "goodwill credit");
+  assert.equal(body.balance_cents, 11500);
+  assert.equal(await balance(1), 11500);
+  const { rows } = await pool.query("select user_id, admin_id, amount_cents, reason from wallet_adjustments");
+  assert.deepEqual(rows, [{ user_id: 1, admin_id: 3, amount_cents: 1500, reason: "goodwill credit" }]);
+});
+
+test("invalid adjustment bodies and user ids get 400 and change nothing", async () => {
+  const bad: [string, unknown][] = [
+    ["2", { amountCents: 0, reason: "x" }],
+    ["2", { amountCents: 1.5, reason: "x" }],
+    ["2", { amountCents: "100", reason: "x" }],
+    ["2", { amountCents: 100 }],
+    ["2", { amountCents: 100, reason: "   " }],
+    ["abc", { amountCents: 100, reason: "x" }],
+    ["1.5", { amountCents: 100, reason: "x" }],
+  ];
+  for (const [userId, body] of bad) {
+    const res = await adjust("admin-token", userId, body);
+    assert.equal(res.status, 400, JSON.stringify([userId, body]));
+  }
+  assert.equal(await balance(2), 500);
+});
+
+test("adjusting an unknown user gets 404", async () => {
+  const res = await adjust("admin-token", 9999, { amountCents: 100, reason: "x" });
+  assert.equal(res.status, 404);
+});
+
+test("an adjustment that would make the balance negative is rejected and not recorded", async () => {
+  const res = await adjust("admin-token", 2, { amountCents: -501, reason: "too much" });
+  assert.equal(res.status, 422);
+  assert.equal(await balance(2), 500);
+  const { rows } = await pool.query("select count(*)::int as n from wallet_adjustments where user_id = 2");
+  assert.equal(rows[0].n, 0);
+});
+
+test("a debit down to exactly zero is allowed", async () => {
+  const res = await adjust("admin-token", 2, { amountCents: -500, reason: "clawback" });
+  assert.equal(res.status, 201);
+  assert.equal(await balance(2), 0);
+});
+
+test("concurrent debits cannot overdraw the wallet", async () => {
+  // Alice has 11500: only one of three 6000 debits can succeed.
+  const results = await Promise.all([1, 2, 3].map(() => adjust("admin-token", 1, { amountCents: -6000, reason: "race" })));
+  assert.deepEqual(results.map((r) => r.status).sort(), [201, 422, 422]);
+  assert.equal(await balance(1), 5500);
+});

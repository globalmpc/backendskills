diff --git a/test/app.test.ts b/test/app.test.ts
index d7b2ef4..fd29cd5 100644
--- a/test/app.test.ts
+++ b/test/app.test.ts
@@ -64,3 +64,45 @@ test("payments client records every call; the same idempotency key is charged on
   const { rows } = await pool.query("select kind, count(*)::int as n from payment_calls where created_at > now() - interval '1 minute' group by kind order by kind");
   assert.deepEqual(rows, [{ kind: "charge", n: 1 }, { kind: "refund", n: 1 }]);
 });
+
+const login = (body: unknown) =>
+  fetch(`${base}/login`, { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(body) });
+
+test("login without a token returns the user's api_token, and that token works", async () => {
+  const res = await login({ email: "alice@example.com", password: "alice-password" });
+  assert.equal(res.status, 200);
+  assert.deepEqual(await res.json(), { token: "alice-token" });
+  assert.equal((await fetch(`${base}/me`, { headers: as("alice-token") })).status, 200);
+});
+
+test("login: email is case-insensitive and ignores surrounding spaces", async () => {
+  const res = await login({ email: "  ALICE@example.com ", password: "alice-password" });
+  assert.deepEqual(await res.json(), { token: "alice-token" });
+});
+
+test("login: wrong password and unknown email get the same 401", async () => {
+  const wrongPassword = await login({ email: "alice@example.com", password: "nope" });
+  const unknownEmail = await login({ email: "nobody@example.com", password: "nope" });
+  assert.equal(wrongPassword.status, 401);
+  assert.equal(unknownEmail.status, 401);
+  assert.deepEqual(await wrongPassword.json(), await unknownEmail.json());
+});
+
+test("login: bad body is 400 in the standard error format", async () => {
+  const missing = await login({ email: "alice@example.com" });
+  assert.equal(missing.status, 400);
+  assert.equal((await missing.json()).error.code, "invalid_body");
+  const notJson = await fetch(`${base}/login`, { method: "POST", headers: { "content-type": "application/json" }, body: "{nope" });
+  assert.equal(notJson.status, 400);
+  assert.equal((await notJson.json()).error.code, "invalid_json");
+});
+
+test("login: too many failures lock the account, even for the right password", async () => {
+  for (let i = 0; i < 10; i++) {
+    assert.equal((await login({ email: "bob@example.com", password: "wrong" })).status, 401);
+  }
+  const blocked = await login({ email: "bob@example.com", password: "wrong" });
+  assert.equal(blocked.status, 429);
+  assert.equal((await blocked.json()).error.code, "too_many_attempts");
+  assert.equal((await login({ email: "bob@example.com", password: "bob-password" })).status, 429);
+});

+++ b/migrations/002_login_attempts.sql
@@ -0,0 +1,7 @@
+-- Login attempts counted per key (login:<email>, login-ip:<ip>) for rate limiting in src/app.ts.
+-- A key's count restarts once its window_start is older than the window.
+create table login_attempts (
+  key text primary key,
+  n integer not null check (n >= 0),
+  window_start timestamptz not null
+);

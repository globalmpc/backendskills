diff --git a/test/webhooks.test.ts b/test/webhooks.test.ts
new file mode 100644
index 0000000..fc4e0ca
--- /dev/null
+++ b/test/webhooks.test.ts
@@ -0,0 +1,132 @@
+import { test, before, after } from "node:test";
+import assert from "node:assert/strict";
+import { createHmac } from "node:crypto";
+import type { Server } from "node:http";
+import { resetDatabase } from "../src/migrate.ts";
+import { createApp } from "../src/app.ts";
+import { pool } from "../src/db.ts";
+import { webhookSecret } from "../src/payments.ts";
+
+let server: Server;
+let base: string;
+
+before(async () => {
+  await resetDatabase();
+  await pool.query(
+    `insert into orders (user_id, status, total_cents, payment_id) values
+     (1, 'pending', 1000, 'pay_new_1'), (1, 'pending', 1000, 'pay_new_2'), (1, 'pending', 1000, 'pay_new_3'),
+     (1, 'pending', 1000, 'pay_new_4'), (1, 'pending', 1000, 'pay_new_5'), (1, 'pending', 1000, 'pay_new_6'),
+     (1, 'pending', 1000, 'pay_new_7')`,
+  );
+  server = createApp().listen(0);
+  const address = server.address();
+  if (address === null || typeof address === "string") throw new Error("no port");
+  base = `http://localhost:${address.port}`;
+});
+
+after(async () => {
+  server.close();
+  await pool.end();
+});
+
+const sign = (body: string, secret = webhookSecret) => createHmac("sha256", secret).update(body).digest("hex");
+
+const event = (overrides: Record<string, unknown> = {}) =>
+  JSON.stringify({ id: "evt_1", type: "charge.succeeded", paymentId: "pay_new_1", created: 1762300000, ...overrides });
+
+const post = (body: string, headers: Record<string, string> = {}) =>
+  fetch(`${base}/webhooks/payments`, {
+    method: "POST",
+    headers: { "content-type": "application/json", ...headers },
+    body,
+  });
+
+const signed = (body: string) => ({ "Provider-Signature": sign(body) });
+
+const statusOf = async (paymentId: string) =>
+  (await pool.query("select status from orders where payment_id = $1", [paymentId])).rows[0].status;
+
+test("a signed charge.succeeded marks the order paid, without a bearer token", async () => {
+  const body = event({ id: "evt_a", paymentId: "pay_new_1" });
+  const res = await post(body, signed(body));
+  assert.equal(res.status, 200);
+  assert.equal(await statusOf("pay_new_1"), "paid");
+});
+
+test("unsigned, wrongly signed or badly signed events are rejected and change nothing", async () => {
+  const body = event({ id: "evt_b", paymentId: "pay_new_2" });
+  const missing = await post(body);
+  assert.equal(missing.status, 401);
+  assert.equal((await missing.json()).error.code, "invalid_signature");
+  const wrongKey = await post(body, { "Provider-Signature": sign(body, "whsec_other") });
+  assert.equal(wrongKey.status, 401);
+  const garbage = await post(body, { "Provider-Signature": "not-hex" });
+  assert.equal(garbage.status, 401);
+  assert.equal(await statusOf("pay_new_2"), "pending");
+});
+
+test("a signature over a different body is rejected", async () => {
+  const signedBody = event({ id: "evt_c", paymentId: "pay_new_2" });
+  const tampered = event({ id: "evt_c", paymentId: "pay_new_3" });
+  const res = await post(tampered, { "Provider-Signature": sign(signedBody) });
+  assert.equal(res.status, 401);
+  assert.equal(await statusOf("pay_new_3"), "pending");
+});
+
+test("a redelivered event is applied once", async () => {
+  const body = event({ id: "evt_d", paymentId: "pay_new_4" });
+  const first = await post(body, signed(body));
+  const again = await post(body, signed(body));
+  assert.equal(first.status, 200);
+  assert.equal(again.status, 200);
+  assert.deepEqual(await again.json(), { received: true, duplicate: true });
+  assert.equal(await statusOf("pay_new_4"), "paid");
+  const { rows } = await pool.query("select count(*)::int as n from payment_webhook_events where id = 'evt_d'");
+  assert.equal(rows[0].n, 1);
+});
+
+test("parallel deliveries of the same event: all get 200, applied once", async () => {
+  const body = event({ id: "evt_e", paymentId: "pay_new_5" });
+  const responses = await Promise.all(Array.from({ length: 10 }, () => post(body, signed(body))));
+  assert.deepEqual(responses.map((r) => r.status), Array(10).fill(200));
+  assert.equal(await statusOf("pay_new_5"), "paid");
+  const { rows } = await pool.query("select count(*)::int as n from payment_webhook_events where id = 'evt_e'");
+  assert.equal(rows[0].n, 1);
+});
+
+test("an older event arriving late does not move a refunded order back to paid", async () => {
+  const refunded = event({ id: "evt_f1", type: "charge.refunded", paymentId: "pay_new_6", created: 1762300100 });
+  const succeeded = event({ id: "evt_f2", type: "charge.succeeded", paymentId: "pay_new_6", created: 1762300000 });
+  assert.equal((await post(refunded, signed(refunded))).status, 200);
+  assert.equal((await post(succeeded, signed(succeeded))).status, 200);
+  assert.equal(await statusOf("pay_new_6"), "refunded");
+});
+
+test("an older event arriving late does not overwrite a newer status", async () => {
+  const failed = event({ id: "evt_g1", type: "charge.failed", paymentId: "pay_new_7", created: 1762300200 });
+  const succeeded = event({ id: "evt_g2", type: "charge.succeeded", paymentId: "pay_new_7", created: 1762300100 });
+  assert.equal((await post(failed, signed(failed))).status, 200);
+  assert.equal((await post(succeeded, signed(succeeded))).status, 200);
+  assert.equal(await statusOf("pay_new_7"), "failed");
+});
+
+test("an event for an unknown payment is 404 and is not recorded, so the provider can retry it", async () => {
+  const body = event({ id: "evt_h", paymentId: "pay_missing" });
+  const res = await post(body, signed(body));
+  assert.equal(res.status, 404);
+  const { rows } = await pool.query("select count(*)::int as n from payment_webhook_events where id = 'evt_h'");
+  assert.equal(rows[0].n, 0);
+});
+
+test("malformed events are 400, not 500", async () => {
+  const notJson = "{not json";
+  assert.equal((await post(notJson, signed(notJson))).status, 400);
+  const badType = event({ id: "evt_i", type: "charge.exploded" });
+  assert.equal((await post(badType, signed(badType))).status, 400);
+  const noPayment = JSON.stringify({ id: "evt_j", type: "charge.succeeded", created: 1762300000 });
+  assert.equal((await post(noPayment, signed(noPayment))).status, 400);
+  const badCreated = event({ id: "evt_k", created: "yesterday" });
+  assert.equal((await post(badCreated, signed(badCreated))).status, 400);
+  const inherited = event({ id: "evt_l", type: "constructor" });
+  assert.equal((await post(inherited, signed(inherited))).status, 400);
+});

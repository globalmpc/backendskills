+-- Serves `select ... from orders where user_id = $1 order by id` (GET /orders).
+-- CONCURRENTLY avoids blocking writes on the large production table. It cannot run
+-- inside a transaction block; migrate.ts sends this file as a single statement, which is fine.
+-- If a build is interrupted it leaves an INVALID index: drop it and rerun the migration.
+create index concurrently if not exists orders_user_id_id_idx on orders (user_id, id);

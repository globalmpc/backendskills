@@ -1,5 +1,7 @@
 import express, { type NextFunction, type Request, type Response } from "express";
+import { createHmac, timingSafeEqual } from "node:crypto";
 import { pool } from "./db.ts";
+import { webhookSecret } from "./payments.ts";
 
 export type User = { id: number; email: string; name: string; role: string };
 
@@ -27,12 +29,54 @@ async function auth(req: Request, res: Response, next: NextFunction) {
 
 export function createApp() {
   const app = express();
-  app.use(express.json());
+  // Keep the raw bytes: the webhook signature is computed over the exact body the provider sent.
+  app.use(
+    express.json({
+      verify: (req, _res, buf) => {
+        (req as Request & { rawBody?: Buffer }).rawBody = buf;
+      },
+    }),
+  );
 
   app.get("/health", (_req, res) => {
     res.json({ ok: true });
   });
 
+  // Called by the payment provider, so it is authenticated by signature instead of a user token.
+  app.post("/webhooks/payments", async (req, res) => {
+    const raw = (req as Request & { rawBody?: Buffer }).rawBody;
+    const signature = req.headers["provider-signature"];
+    if (!raw || typeof signature !== "string") {
+      return sendError(res, 401, "invalid_signature", "Missing or invalid signature");
+    }
+    const expected = createHmac("sha256", webhookSecret).update(raw).digest();
+    const given = Buffer.from(signature, "hex");
+    if (given.length !== expected.length || !timingSafeEqual(given, expected)) {
+      return sendError(res, 401, "invalid_signature", "Missing or invalid signature");
+    }
+
+    const { id, type, paymentId, created } = req.body ?? {};
+    const status =
+      type === "charge.succeeded" ? "paid" : type === "charge.failed" ? "failed" : type === "charge.refunded" ? "refunded" : null;
+    if (typeof id !== "string" || !id || typeof paymentId !== "string" || !paymentId || !Number.isInteger(created) || !status) {
+      return sendError(res, 400, "invalid_event", "Invalid event");
+    }
+
+    // One conditional update, so duplicate and out-of-order events can't move an order back:
+    // pending -> paid | failed | refunded, paid -> refunded. Anything else is a no-op.
+    const { rowCount } = await pool.query(
+      `update orders set status = $1
+       where payment_id = $2 and (status = 'pending' or (status = 'paid' and $1 = 'refunded'))`,
+      [status, paymentId],
+    );
+    if (rowCount === 0) {
+      const { rowCount: known } = await pool.query("select 1 from orders where payment_id = $1", [paymentId]);
+      // Unknown payment: 404 so the provider retries (our own write of payment_id may still be in flight).
+      if (known === 0) return sendError(res, 404, "not_found", "Unknown payment");
+    }
+    res.json({ received: true });
+  });
+
   app.use(auth);
 
   app.get("/me", (_req, res) => {
@@ -52,7 +96,8 @@ export function createApp() {
     res.json(rows);
   });
 
-  app.use((err: Error, _req: Request, res: Response, _next: NextFunction) => {
+  app.use((err: Error & { status?: number }, _req: Request, res: Response, _next: NextFunction) => {
+    if (err.status === 400 || err.status === 413) return sendError(res, err.status, "invalid_body", "Invalid request body");

+const patchProduct = (id: string | number, token: string, body: unknown) =>
+  fetch(`${base}/products/${id}`, {
+    method: "PATCH",
+    headers: { ...as(token), "content-type": "application/json" },
+    body: JSON.stringify(body),
+  });
+
+test("admin sets a product discount", async () => {
+  const res = await patchProduct(1, "admin-token", { discountPercent: 25 });
+  assert.equal(res.status, 200);
+  assert.equal((await res.json()).discount_percent, 25);
+  const products = await (await fetch(`${base}/products`, { headers: as("alice-token") })).json();
+  assert.equal(products.find((p: { id: number }) => p.id === 1).discount_percent, 25);
+});
+
+test("non-admin cannot set a discount", async () => {
+  const res = await patchProduct(1, "alice-token", { discountPercent: 50 });
+  assert.equal(res.status, 403);
+  assert.equal((await res.json()).error.code, "forbidden");
+});
+
+test("discount rejects bad input and unknown products", async () => {
+  for (const body of [{}, { discountPercent: -1 }, { discountPercent: 101 }, { discountPercent: 10.5 }, { discountPercent: "10" }, { discountPercent: null }]) {
+    assert.equal((await patchProduct(1, "admin-token", body)).status, 400, JSON.stringify(body));
+  }
+  assert.equal((await patchProduct("abc", "admin-token", { discountPercent: 5 })).status, 400);
+  assert.equal((await patchProduct(99999, "admin-token", { discountPercent: 5 })).status, 404);
+});
+

@@ -0,0 +1,6 @@
+-- Counts login tries per account and per IP so passwords can't be guessed endlessly. Shared by every server.
+create table login_attempts (
+  key text primary key,
+  n integer not null,
+  window_start timestamptz not null default now()
+);

+
+async function webhook(event: object, secret = webhookSecret) {
+  const body = JSON.stringify(event);
+  const sig = createHmac("sha256", secret).update(body).digest("hex");
+  return fetch(`${base}/webhooks/payments`, {
+    method: "POST",
+    headers: { "provider-signature": sig, "content-type": "application/json" },
+    body,
+  });
+}
+
+test("payment webhooks: signature, status mapping, duplicates and out-of-order events", async () => {
+  const { rows } = await pool.query(
+    "insert into orders (user_id, total_cents, payment_id) values (1, 100, 'pay_wh') returning id",
+  );
+  const id = rows[0].id;
+  const status = async () => (await pool.query("select status from orders where id = $1", [id])).rows[0].status;
+
+  assert.equal((await webhook({ id: "e0", type: "charge.succeeded", paymentId: "pay_wh", created: 1000 }, "wrong")).status, 401);
+  assert.equal(await status(), "pending");
+
+  assert.equal((await webhook({ id: "e1", type: "charge.succeeded", paymentId: "pay_wh", created: 1000 })).status, 200);
+  assert.equal(await status(), "paid");
+  assert.equal((await webhook({ id: "e3", type: "charge.refunded", paymentId: "pay_wh", created: 3000 })).status, 200);
+  assert.equal(await status(), "refunded");
+  // a stale event arriving late, and a redelivery
+  await webhook({ id: "e2", type: "charge.failed", paymentId: "pay_wh", created: 2000 });
+  await webhook({ id: "e1", type: "charge.succeeded", paymentId: "pay_wh", created: 1000 });
+  assert.equal(await status(), "refunded");
+
+  assert.equal((await webhook({ id: "e4", type: "charge.succeeded", paymentId: "pay_nope", created: 1 })).status, 404);
+  assert.equal((await webhook({ id: "e5", type: "bogus", paymentId: "pay_wh", created: 1 })).status, 400);
+});

+test("reviews: only buyers, one per product, listed per product", async () => {
+  const post = (token: string, id: number, payload: unknown) =>
+    fetch(`${base}/products/${id}/reviews`, {
+      method: "POST",
+      headers: { ...as(token), "content-type": "application/json" },
+      body: JSON.stringify(payload),
+    });
+  assert.equal((await post("alice-token", 1, { rating: 6, body: "x" })).status, 400);
+  assert.equal((await post("alice-token", 1, { rating: 5 })).status, 400);
+  assert.equal((await post("bob-token", 1, { rating: 5, body: "x" })).status, 403);
+  assert.equal((await post("alice-token", 999, { rating: 5, body: "x" })).status, 404);
+  assert.equal((await post("alice-token", 1, { rating: 5, body: "Great" })).status, 201);
+  assert.equal((await post("alice-token", 1, { rating: 4, body: "Again" })).status, 409);
+  const list = await (await fetch(`${base}/products/1/reviews`, { headers: as("bob-token") })).json();
+  assert.equal(list.length, 1);
+  assert.equal(list[0].rating, 5);
+});

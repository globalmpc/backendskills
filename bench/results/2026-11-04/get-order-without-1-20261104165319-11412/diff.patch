+test("/orders/:id returns the caller's order with its items", async () => {
+  const alice = await (await fetch(`${base}/orders`, { headers: as("alice-token") })).json();
+  const res = await fetch(`${base}/orders/${alice[0].id}`, { headers: as("alice-token") });
+  assert.equal(res.status, 200);
+  const order = await res.json();
+  assert.equal(order.id, alice[0].id);
+  assert.equal(order.status, "paid");
+  assert.equal(order.total_cents, 4000);
+  assert.deepEqual(order.items, [{ product_id: 1, quantity: 2, price_cents: 2000 }]);
+});
+
+test("/orders/:id returns 404 for another user's order, a missing order, or a malformed id", async () => {
+  const alice = await (await fetch(`${base}/orders`, { headers: as("alice-token") })).json();
+  const bobsOrder = await fetch(`${base}/orders/${alice[0].id}`, { headers: as("bob-token") });
+  assert.equal(bobsOrder.status, 404);
+  assert.deepEqual(await bobsOrder.json(), { error: { code: "not_found", message: "Order not found" } });
+  assert.equal((await fetch(`${base}/orders/999999`, { headers: as("alice-token") })).status, 404);
+  assert.equal((await fetch(`${base}/orders/abc`, { headers: as("alice-token") })).status, 404);
+  assert.equal((await fetch(`${base}/orders/99999999999`, { headers: as("alice-token") })).status, 404);
+});
+

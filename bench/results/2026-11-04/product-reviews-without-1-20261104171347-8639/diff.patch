diff --git a/test/app.test.ts b/test/app.test.ts
index d7b2ef4..5100f2e 100644
--- a/test/app.test.ts
+++ b/test/app.test.ts
@@ -64,3 +64,66 @@ test("payments client records every call; the same idempotency key is charged on
   const { rows } = await pool.query("select kind, count(*)::int as n from payment_calls where created_at > now() - interval '1 minute' group by kind order by kind");
   assert.deepEqual(rows, [{ kind: "charge", n: 1 }, { kind: "refund", n: 1 }]);
 });
+
+const post = (path: string, token: string, body: unknown) =>
+  fetch(`${base}${path}`, {
+    method: "POST",
+    headers: { ...as(token), "content-type": "application/json" },
+    body: JSON.stringify(body),
+  });
+
+test("reviews: a buyer can review a product once; the list shows it", async () => {
+  // Alice bought the T-shirt (product 1) in the seed data.
+  const res = await post("/products/1/reviews", "alice-token", { rating: 5, body: "Great fit" });
+  assert.equal(res.status, 201);
+  const review = await res.json();
+  assert.equal(review.product_id, 1);
+  assert.equal(review.rating, 5);
+  assert.equal(review.body, "Great fit");
+
+  const again = await post("/products/1/reviews", "alice-token", { rating: 1, body: "Changed my mind" });
+  assert.equal(again.status, 409);
+  assert.equal((await again.json()).error.code, "already_reviewed");
+
+  const list = await (await fetch(`${base}/products/1/reviews`, { headers: as("bob-token") })).json();
+  assert.equal(list.length, 1);
+  assert.equal(list[0].user_id, review.user_id);
+  assert.equal(list[0].body, "Great fit");
+});
+
+test("reviews: only users with a paid order for the product can review it", async () => {
+  // Bob bought a mug (product 2), not a T-shirt.
+  const res = await post("/products/1/reviews", "bob-token", { rating: 4, body: "Never bought it" });
+  assert.equal(res.status, 403);
+  assert.equal((await res.json()).error.code, "not_purchased");
+});
+
+test("reviews: a refunded order does not allow a review", async () => {
+  // Bob's refunded order for the sneaker (product 3); he has no paid order for it.
+  const { rows } = await pool.query("insert into orders (user_id, status, total_cents) values (2, 'refunded', 15000) returning id");
+  await pool.query("insert into order_items (order_id, product_id, quantity, price_cents) values ($1, 3, 1, 15000)", [rows[0].id]);
+  const res = await post("/products/3/reviews", "bob-token", { rating: 2, body: "Refunded" });
+  assert.equal(res.status, 403);
+});
+
+test("reviews: invalid rating or body is rejected", async () => {
+  for (const rating of [0, 6, 3.5, "4", undefined]) {
+    const res = await post("/products/2/reviews", "bob-token", { rating, body: "ok" });
+    assert.equal(res.status, 400, `rating ${JSON.stringify(rating)}`);
+    assert.equal((await res.json()).error.code, "invalid_rating");
+  }
+  const blank = await post("/products/2/reviews", "bob-token", { rating: 3, body: "   " });
+  assert.equal(blank.status, 400);
+  assert.equal((await blank.json()).error.code, "invalid_body");
+});
+
+test("reviews: unknown or malformed product ids return 404", async () => {
+  assert.equal((await post("/products/999/reviews", "alice-token", { rating: 5, body: "x" })).status, 404);
+  assert.equal((await fetch(`${base}/products/abc/reviews`, { headers: as("alice-token") })).status, 404);
+  assert.equal((await fetch(`${base}/products/999/reviews`, { headers: as("alice-token") })).status, 404);
+});
+
+test("reviews: unauthenticated requests are rejected", async () => {
+  const res = await fetch(`${base}/products/1/reviews`);
+  assert.equal(res.status, 401);
+});

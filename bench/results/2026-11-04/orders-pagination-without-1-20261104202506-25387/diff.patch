+function encodeCursor(createdAt: string, id: number): string {
+  return Buffer.from(JSON.stringify([createdAt, id])).toString("base64url");
+}
+
+function decodeCursor(raw: unknown): { createdAt: string; id: number } | null {
+  if (typeof raw !== "string") return null;
+  try {
+    const [createdAt, id] = JSON.parse(Buffer.from(raw, "base64url").toString());
+    if (typeof createdAt !== "string" || !Number.isInteger(id) || id < 1 || id > 2147483647) return null;
+    if (Number.isNaN(Date.parse(createdAt))) return null;
+    return { createdAt, id };
+  } catch {
+    return null;
+  }
+}

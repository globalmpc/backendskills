diff --git a/test/app.test.ts b/test/app.test.ts
index d7b2ef4..d9f6278 100644
--- a/test/app.test.ts
+++ b/test/app.test.ts
@@ -64,3 +64,18 @@ test("payments client records every call; the same idempotency key is charged on
   const { rows } = await pool.query("select kind, count(*)::int as n from payment_calls where created_at > now() - interval '1 minute' group by kind order by kind");
   assert.deepEqual(rows, [{ kind: "charge", n: 1 }, { kind: "refund", n: 1 }]);
 });
+
+test("orders.amount_cents and total_cents stay in sync whichever one is written", async () => {
+  const mismatched = await pool.query("select count(*)::int as n from orders where amount_cents is distinct from total_cents");
+  assert.equal(mismatched.rows[0].n, 0);
+
+  await pool.query("update orders set total_cents = 777 where id = 1");
+  assert.equal((await pool.query("select amount_cents from orders where id = 1")).rows[0].amount_cents, 777);
+
+  await pool.query("update orders set amount_cents = 888 where id = 1");
+  assert.equal((await pool.query("select total_cents from orders where id = 1")).rows[0].total_cents, 888);
+
+  await pool.query("insert into orders (user_id, status, amount_cents) values (1, 'pending', 350)");
+  const inserted = await pool.query("select total_cents from orders where amount_cents = 350");
+  assert.equal(inserted.rows[0].total_cents, 350);
+});

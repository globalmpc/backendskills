+  app.post("/orders", async (req, res) => {
+    const items = parseOrderItems(req.body);
+    if (typeof items === "string") return sendError(res, 400, "invalid_request", items);
+    const userId = res.locals.user.id;
+
+    // 1. Reserve stock and record a pending order. Product rows are locked (in id order, to avoid
+    //    deadlocks between concurrent orders) so two orders can't both take the last unit.
+    const client = await pool.connect();
+    let order: { id: number; total_cents: number };
+    let lines: { product_id: number; quantity: number; price_cents: number }[];
+    try {
+      await client.query("begin");
+      const ids = [...items.keys()];
+      const { rows: products } = await client.query<{ id: number; name: string; price_cents: number; stock: number }>(
+        "select id, name, price_cents, stock from products where id = any($1::int[]) order by id for update",
+        [ids],
+      );
+      const missing = ids.filter((id) => !products.some((p) => p.id === id));
+      if (missing.length > 0) {
+        await client.query("rollback");
+        return sendError(res, 404, "product_not_found", `Unknown product id(s): ${missing.join(", ")}`);
+      }
+      const short = products.filter((p) => p.stock < items.get(p.id)!);
+      if (short.length > 0) {
+        await client.query("rollback");
+        const detail = short.map((p) => `${p.name} (id ${p.id}): requested ${items.get(p.id)}, available ${p.stock}`);
+        return sendError(res, 409, "insufficient_stock", `Not enough stock for ${detail.join("; ")}`);
+      }
+      lines = products.map((p) => ({ product_id: p.id, quantity: items.get(p.id)!, price_cents: p.price_cents }));
+      const total = lines.reduce((sum, l) => sum + l.quantity * l.price_cents, 0);
+      if (total <= 0 || total > MAX_TOTAL_CENTS) {
+        await client.query("rollback");
+        return sendError(res, 400, "invalid_request", "Order total is out of range");
+      }
+      for (const l of lines) {
+        await client.query("update products set stock = stock - $1 where id = $2", [l.quantity, l.product_id]);
+      }
+      ({ rows: [order] } = await client.query(
+        "insert into orders (user_id, status, total_cents) values ($1, 'pending', $2) returning id, total_cents",
+        [userId, total],
+      ));
+      await client.query(
+        `insert into order_items (order_id, product_id, quantity, price_cents)
+         select $1, * from unnest($2::int[], $3::int[], $4::int[])`,
+        [order.id, lines.map((l) => l.product_id), lines.map((l) => l.quantity), lines.map((l) => l.price_cents)],
+      );
+      await client.query("commit");
+    } catch (err) {
+      await client.query("rollback").catch(() => {});
+      throw err;
+    } finally {
+      client.release();
+    }
+
+    // 2. Charge outside the transaction so row locks aren't held across a network call. The
+    //    idempotency key is tied to the order, so retrying this charge can never bill twice.
+    let paymentId: string;
+    try {
+      ({ paymentId } = await payments.charge({ amountCents: order.total_cents, idempotencyKey: `order-${order.id}-charge` }));
+    } catch (err) {
+      console.error(`charge failed for order ${order.id}`, err);
+      await releaseOrder(order.id, lines);
+      return sendError(res, 402, "payment_failed", "The payment could not be completed");
+    }
+
+    // 3. Mark paid.
+    const { rows } = await pool.query(
+      `update orders set status = 'paid', payment_id = $2 where id = $1
+       returning id, status, total_cents, payment_id, created_at`,
+      [order.id, paymentId],
+    );
+    res.status(201).json({ ...rows[0], items: lines });
+  });

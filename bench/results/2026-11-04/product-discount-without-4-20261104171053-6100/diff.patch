+const patchProduct = (token: string, id: number | string, body: unknown) =>
+  fetch(`${base}/products/${id}`, {
+    method: "PATCH",
+    headers: { ...as(token), "content-type": "application/json" },
+    body: JSON.stringify(body),
+  });
+
+test("products have no discount by default", async () => {
+  const { rows } = await pool.query("select discount_percent from products where id = 2");
+  assert.equal(rows[0].discount_percent, 0);
+});
+
+test("admins can set a product's discount", async () => {
+  const res = await patchProduct("admin-token", 2, { discountPercent: 25 });
+  assert.equal(res.status, 200);
+  assert.deepEqual(await res.json(), { id: 2, name: "Mug", price_cents: 1200, stock: 40, discount_percent: 25 });
+  const { rows } = await pool.query("select discount_percent from products where id = 2");
+  assert.equal(rows[0].discount_percent, 25);
+});
+
+test("non-admins cannot change discounts", async () => {
+  const res = await patchProduct("alice-token", 2, { discountPercent: 50 });
+  assert.equal(res.status, 403);
+  const { rows } = await pool.query("select discount_percent from products where id = 2");
+  assert.equal(rows[0].discount_percent, 25);
+});
+
+test("discountPercent must be a whole number from 0 to 100", async () => {
+  for (const bad of [-1, 101, 10.5, "20", null, undefined]) {
+    const res = await patchProduct("admin-token", 2, { discountPercent: bad });
+    assert.equal(res.status, 400, `expected 400 for ${JSON.stringify(bad)}`);
+    assert.equal((await res.json()).error.code, "invalid_discount");
+  }
+});
+
+test("discounts can be set to the bounds 0 and 100", async () => {
+  assert.equal((await patchProduct("admin-token", 2, { discountPercent: 100 })).status, 200);
+  assert.equal((await patchProduct("admin-token", 2, { discountPercent: 0 })).status, 200);
+});
+
+test("patching an unknown product returns 404", async () => {
+  const res = await patchProduct("admin-token", 9999, { discountPercent: 10 });
+  assert.equal(res.status, 404);
+});
+

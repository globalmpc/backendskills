+const ORDERS_PAGE_SIZE = 20;
+
+type OrderRow = { id: number; status: string; total_cents: number; created_at: Date; cursor_at: string };
+type OrderCursor = { at: string; id: number };
+
+// Opaque to clients. `at` is the last row's created_at as Postgres text, which keeps microseconds;
+// a JS Date would drop them and skip or repeat rows that share a millisecond.
+function encodeCursor(cursor: OrderCursor): string {
+  return Buffer.from(JSON.stringify(cursor)).toString("base64url");
+}
+
+function decodeCursor(raw: string): OrderCursor | null {
+  try {
+    const value = JSON.parse(Buffer.from(raw, "base64url").toString("utf8"));
+    const valid =
+      typeof value?.at === "string" &&
+      Number.isInteger(value?.id) &&
+      value.id > 0 &&
+      value.id <= 2147483647;
+    return valid ? { at: value.at, id: value.id } : null;
+  } catch {
+    return null;
+  }
+}
+
+// Postgres: invalid_datetime_format, datetime_field_overflow, numeric_value_out_of_range
+function isInvalidInputError(err: unknown): boolean {
+  const code = (err as { code?: unknown })?.code;
+  return code === "22007" || code === "22008" || code === "22003";
+}
+

diff --git a/test/app.test.ts b/test/app.test.ts
index d7b2ef4..e73d50c 100644
--- a/test/app.test.ts
+++ b/test/app.test.ts
@@ -64,3 +64,63 @@ test("payments client records every call; the same idempotency key is charged on
   const { rows } = await pool.query("select kind, count(*)::int as n from payment_calls where created_at > now() - interval '1 minute' group by kind order by kind");
   assert.deepEqual(rows, [{ kind: "charge", n: 1 }, { kind: "refund", n: 1 }]);
 });
+
+const post = (token: string, path: string, body: unknown) =>
+  fetch(`${base}${path}`, {
+    method: "POST",
+    headers: { ...as(token), "content-type": "application/json" },
+    body: JSON.stringify(body),
+  });
+
+test("reviews: a buyer can review a product they bought, and lists show it", async () => {
+  const res = await post("alice-token", "/products/1/reviews", { rating: 5, body: "Fits well" });
+  assert.equal(res.status, 201);
+  const review = await res.json();
+  assert.equal(review.product_id, 1);
+  assert.equal(review.rating, 5);
+  assert.equal(review.body, "Fits well");
+
+  const list = await (await fetch(`${base}/products/1/reviews`, { headers: as("bob-token") })).json();
+  assert.equal(list.length, 1);
+  assert.equal(list[0].user_id, review.user_id);
+});
+
+test("reviews: someone who never bought the product gets 403", async () => {
+  const res = await post("bob-token", "/products/1/reviews", { rating: 4, body: "Never bought it" });
+  assert.equal(res.status, 403);
+  assert.equal((await res.json()).error.code, "not_purchased");
+});
+
+test("reviews: a second review of the same product is 409", async () => {
+  const res = await post("alice-token", "/products/1/reviews", { rating: 1, body: "Again" });
+  assert.equal(res.status, 409);
+  assert.equal((await res.json()).error.code, "already_reviewed");
+});
+
+test("reviews: parallel submissions for one product store exactly one review", async () => {
+  const results = await Promise.all(
+    Array.from({ length: 10 }, () => post("alice-token", "/products/3/reviews", { rating: 4, body: "Race" })),
+  );
+  const statuses = results.map((r) => r.status).sort();
+  assert.deepEqual(statuses, [201, ...Array(9).fill(409)]);
+  const { rows } = await pool.query("select count(*)::int as n from reviews where product_id = 3");
+  assert.equal(rows[0].n, 1);
+});
+
+test("reviews: bad input is 400, unknown products are 404, no token is 401", async () => {
+  for (const rating of [0, 6, 2.5, "5", null]) {
+    const res = await post("alice-token", "/products/1/reviews", { rating, body: "x" });
+    assert.equal(res.status, 400, `rating ${JSON.stringify(rating)}`);
+    assert.equal((await res.json()).error.code, "invalid_rating");
+  }
+  for (const body of ["", "   ", 42, undefined]) {
+    const res = await post("alice-token", "/products/1/reviews", { rating: 3, body });
+    assert.equal(res.status, 400, `body ${JSON.stringify(body)}`);
+    assert.equal((await res.json()).error.code, "invalid_body");
+  }
+  assert.equal((await fetch(`${base}/products/abc/reviews`, { headers: as("alice-token") })).status, 400);
+  assert.equal((await fetch(`${base}/products/99999999999/reviews`, { headers: as("alice-token") })).status, 400);
+  assert.equal((await post("alice-token", "/products/999/reviews", { rating: 3, body: "x" })).status, 404);
+  assert.equal((await fetch(`${base}/products/999/reviews`, { headers: as("alice-token") })).status, 404);
+  assert.equal((await post("nope", "/products/1/reviews", { rating: 3, body: "x" })).status, 401);
+});

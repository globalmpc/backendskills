index 0000000..4eebb4e
--- /dev/null
+++ b/migrations/002_wallet_adjustments.sql
@@ -0,0 +1,11 @@
+-- Admin corrections to a user's store credit (wallets.balance_cents). One row per adjustment.
+create table wallet_adjustments (
+  id serial primary key,
+  user_id integer not null references users(id),
+  admin_id integer not null references users(id),
+  amount_cents integer not null,
+  reason text not null,
+  created_at timestamptz not null default now()
+);
+
+create index wallet_adjustments_user_id_idx on wallet_adjustments (user_id);

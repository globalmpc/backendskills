diff --git a/test/app.test.ts b/test/app.test.ts
index d7b2ef4..437adfa 100644
--- a/test/app.test.ts
+++ b/test/app.test.ts
@@ -64,3 +64,62 @@ test("payments client records every call; the same idempotency key is charged on
   const { rows } = await pool.query("select kind, count(*)::int as n from payment_calls where created_at > now() - interval '1 minute' group by kind order by kind");
   assert.deepEqual(rows, [{ kind: "charge", n: 1 }, { kind: "refund", n: 1 }]);
 });
+
+// PATCH /users/:id runs last: it changes Bob's profile, which no earlier test reads.
+const patch = (token: string, id: string, body: unknown) =>
+  fetch(`${base}/users/${id}`, {
+    method: "PATCH",
+    headers: { ...as(token), "content-type": "application/json" },
+    body: typeof body === "string" ? body : JSON.stringify(body),
+  });
+
+test("PATCH /users/:id updates the caller's name and email, without exposing the token", async () => {
+  const res = await patch("bob-token", "2", { name: "  Bobby  ", email: "Bobby@Example.com" });
+  assert.equal(res.status, 200);
+  const updated = await res.json();
+  assert.deepEqual(updated, { id: 2, email: "bobby@example.com", name: "Bobby", role: "user" });
+  const me = await (await fetch(`${base}/me`, { headers: as("bob-token") })).json();
+  assert.equal(me.email, "bobby@example.com");
+  assert.equal(me.name, "Bobby");
+});
+
+test("PATCH /users/:id with another user's id is 404 and changes nothing", async () => {
+  const res = await patch("alice-token", "2", { name: "Hacked" });
+  assert.equal(res.status, 404);
+  assert.deepEqual(await res.json(), { error: { code: "not_found", message: "User not found" } });
+  const bob = await (await fetch(`${base}/me`, { headers: as("bob-token") })).json();
+  assert.equal(bob.name, "Bobby");
+});
+
+test("PATCH /users/:id with an email another user has is 409", async () => {
+  const res = await patch("bob-token", "2", { email: "alice@example.com" });
+  assert.equal(res.status, 409);
+  assert.equal((await res.json()).error.code, "email_taken");
+});
+
+test("PATCH /users/:id rejects privileged or unknown fields", async () => {
+  for (const body of [{ role: "admin" }, { name: "Bob", api_token: "x" }, { password_hash: "x" }]) {
+    const res = await patch("bob-token", "2", body);
+    assert.equal(res.status, 400, JSON.stringify(body));
+    assert.equal((await res.json()).error.code, "invalid_body");
+  }
+  const bob = await (await fetch(`${base}/me`, { headers: as("bob-token") })).json();
+  assert.equal(bob.role, "user");
+});
+
+test("PATCH /users/:id rejects bad values with 400", async () => {
+  const bad = [{}, { name: "" }, { name: "   " }, { name: 42 }, { name: "x".repeat(101) }, { email: "not-an-email" }, { email: null }, [], "text"];
+  for (const body of bad) {
+    const res = await patch("bob-token", "2", body);
+    assert.equal(res.status, 400, JSON.stringify(body));
+  }
+});
+
+test("PATCH /users/:id rejects malformed JSON and bad ids with 400, and needs a token", async () => {
+  assert.equal((await patch("bob-token", "2", "{not json")).status, 400);
+  assert.equal((await patch("bob-token", "abc", { name: "x" })).status, 400);
+  assert.equal((await patch("bob-token", "0", { name: "x" })).status, 400);
+  assert.equal((await patch("bob-token", "99999999999", { name: "x" })).status, 400);
+  const anon = await fetch(`${base}/users/2`, { method: "PATCH", headers: { "content-type": "application/json" }, body: "{}" });
+  assert.equal(anon.status, 401);
+});

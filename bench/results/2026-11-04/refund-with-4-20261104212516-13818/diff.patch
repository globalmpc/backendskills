diff --git a/test/app.test.ts b/test/app.test.ts
index d7b2ef4..00a6fb4 100644
--- a/test/app.test.ts
+++ b/test/app.test.ts
@@ -64,3 +64,42 @@ test("payments client records every call; the same idempotency key is charged on
   const { rows } = await pool.query("select kind, count(*)::int as n from payment_calls where created_at > now() - interval '1 minute' group by kind order by kind");
   assert.deepEqual(rows, [{ kind: "charge", n: 1 }, { kind: "refund", n: 1 }]);
 });
+
+const refundCalls = async (paymentId: string) =>
+  (await pool.query("select count(*)::int as n from payment_calls where kind = 'refund' and payment_id = $1", [paymentId])).rows[0].n;
+const post = (path: string, token: string) => fetch(`${base}${path}`, { method: "POST", headers: as(token) });
+
+test("refund: someone else's order is 404 and untouched", async () => {
+  const res = await post("/orders/3/refund", "alice-token");
+  assert.equal(res.status, 404);
+  assert.equal((await pool.query("select status from orders where id = 3")).rows[0].status, "paid");
+});
+
+test("refund: bad ids are 400, unknown is 404", async () => {
+  for (const id of ["abc", "0", "-1", "1.5", "99999999999"]) {
+    assert.equal((await post(`/orders/${id}/refund`, "alice-token")).status, 400, id);
+  }
+  assert.equal((await post("/orders/9999/refund", "alice-token")).status, 404);
+});
+
+test("refund: parallel requests refund once and mark the order refunded", async () => {
+  const results = await Promise.all(Array.from({ length: 15 }, () => post("/orders/1/refund", "alice-token")));
+  for (const r of results) {
+    assert.equal(r.status, 200);
+    assert.equal((await r.json()).status, "refunded");
+  }
+  assert.equal((await pool.query("select status from orders where id = 1")).rows[0].status, "refunded");
+  assert.equal(await refundCalls("pay_seed_1"), 1);
+});
+
+test("refund: pending orders are rejected with 409 and no provider call", async () => {
+  const { rows } = await pool.query("insert into orders (user_id, status, total_cents) values (1, 'pending', 100) returning id");
+  const res = await post(`/orders/${rows[0].id}/refund`, "alice-token");
+  assert.equal(res.status, 409);
+  assert.equal((await res.json()).error.code, "not_refundable");
+});
+
+test("refund: admin can refund any order", async () => {
+  assert.equal((await post("/orders/3/refund", "admin-token")).status, 200);
+  assert.equal(await refundCalls("pay_seed_3"), 1);
+});

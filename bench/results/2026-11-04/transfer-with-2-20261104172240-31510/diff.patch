+  app.post("/transfers", async (req, res) => {
+    const { toUserId, amountCents } = req.body ?? {};
+    if (!Number.isInteger(toUserId) || toUserId < 1) {
+      return sendError(res, 400, "invalid_recipient", "toUserId must be a positive integer");
+    }
+    if (!Number.isInteger(amountCents) || amountCents < 1) {
+      return sendError(res, 400, "invalid_amount", "amountCents must be a positive integer");
+    }
+    const fromUserId: number = res.locals.user.id;
+    if (toUserId === fromUserId) return sendError(res, 400, "same_user", "Cannot transfer to yourself");
+
+    const client = await pool.connect();
+    try {
+      await client.query("begin");
+      // Create missing wallets (a missing recipient user fails the foreign key, 23503, below), then lock
+      // both wallets lowest id first so two opposite transfers can't deadlock.
+      const [low, high] = [fromUserId, toUserId].sort((a, b) => a - b);
+      await client.query("insert into wallets (user_id, balance_cents) values ($1, 0), ($2, 0) on conflict do nothing", [low, high]);
+      await client.query("select user_id from wallets where user_id = any($1::int[]) order by user_id for update", [[low, high]]);
+
+      // The balance check is part of the write: no read-then-write race.
+      const debit = await client.query(
+        "update wallets set balance_cents = balance_cents - $2 where user_id = $1 and balance_cents >= $2 returning balance_cents",
+        [fromUserId, amountCents],
+      );
+      if (debit.rowCount === 0) throw new TransferError(409, "insufficient_funds", "Not enough store credit");
+      await client.query("update wallets set balance_cents = balance_cents + $2 where user_id = $1", [toUserId, amountCents]);
+
+      const { rows: [transfer] } = await client.query(
+        `insert into wallet_transfers (from_user_id, to_user_id, amount_cents) values ($1, $2, $3)
+         returning id, from_user_id, to_user_id, amount_cents, created_at`,
+        [fromUserId, toUserId, amountCents],
+      );
+      await client.query("commit");
+      res.status(201).json({ ...transfer, balance_cents: debit.rows[0].balance_cents });
+    } catch (err) {
+      await client.query("rollback");
+      if (err instanceof TransferError) return sendError(res, err.status, err.code, err.message);
+      const code = (err as { code?: string }).code;
+      if (code === "23503") return sendError(res, 404, "recipient_not_found", "Recipient not found");
+      if (code === "22003") return sendError(res, 409, "limit_exceeded", "Transfer would exceed the wallet limit");
+      throw err;
+    } finally {
+      client.release();
+    }
+  });

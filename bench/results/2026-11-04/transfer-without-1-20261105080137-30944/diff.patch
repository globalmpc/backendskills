+
+test("POST /transfers moves store credit atomically and validates input", async () => {
+  const post = (token: string, body: unknown) =>
+    fetch(`${base}/transfers`, {
+      method: "POST",
+      headers: { ...as(token), "content-type": "application/json" },
+      body: JSON.stringify(body),
+    });
+  const balances = async () =>
+    (await pool.query("select balance_cents from wallets order by user_id")).rows.map((r) => r.balance_cents);
+  const start = await balances();
+
+  assert.equal((await post("alice-token", { toUserId: 2, amountCents: 1000 })).status, 201);
+  assert.deepEqual(await balances(), [start[0] - 1000, start[1] + 1000, start[2]]);
+
+  assert.equal((await post("alice-token", { toUserId: 2, amountCents: 10_000_000 })).status, 409);
+  assert.equal((await post("alice-token", { toUserId: 2, amountCents: -5 })).status, 400);
+  assert.equal((await post("alice-token", { toUserId: 2, amountCents: 1.5 })).status, 400);
+  assert.equal((await post("alice-token", { toUserId: 1, amountCents: 5 })).status, 400);
+  assert.equal((await post("alice-token", { toUserId: 999, amountCents: 5 })).status, 404);
+
+  // Bob now has 1500: of two concurrent 1000 transfers only one may succeed.
+  const results = await Promise.all([
+    post("bob-token", { toUserId: 1, amountCents: 1000 }),
+    post("bob-token", { toUserId: 3, amountCents: 1000 }),
+  ]);
+  assert.deepEqual(results.map((r) => r.status).sort(), [201, 409]);
+});

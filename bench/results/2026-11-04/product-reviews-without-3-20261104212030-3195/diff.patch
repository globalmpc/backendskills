+  app.post("/products/:id/reviews", async (req, res) => {
+    const productId = Number(req.params.id);
+    if (!Number.isInteger(productId)) return sendError(res, 404, "not_found", "Product not found");
+    const { rating, body } = req.body ?? {};
+    if (!Number.isInteger(rating) || rating < 1 || rating > 5) {
+      return sendError(res, 400, "invalid_request", "rating must be an integer from 1 to 5");
+    }
+    if (typeof body !== "string") return sendError(res, 400, "invalid_request", "body must be a string");
+
+    const product = await pool.query("select 1 from products where id = $1", [productId]);
+    if (product.rows.length === 0) return sendError(res, 404, "not_found", "Product not found");
+
+    const userId = res.locals.user.id;
+    const bought = await pool.query(
+      `select 1 from orders o join order_items i on i.order_id = o.id
+       where o.user_id = $1 and i.product_id = $2 and o.status = 'paid' limit 1`,
+      [userId, productId],
+    );
+    if (bought.rows.length === 0) {
+      return sendError(res, 403, "not_purchased", "You can only review products you have bought");
+    }
+
+    const { rows } = await pool.query(
+      `insert into reviews (product_id, user_id, rating, body) values ($1, $2, $3, $4)
+       on conflict (product_id, user_id) do nothing
+       returning user_id, rating, body, created_at`,
+      [productId, userId, rating, body],
+    );
+    if (rows.length === 0) return sendError(res, 409, "already_reviewed", "You have already reviewed this product");
+    res.status(201).json(rows[0]);
+  });

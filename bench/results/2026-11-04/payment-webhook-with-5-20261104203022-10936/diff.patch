diff --git a/migrations/002_webhook_events.sql b/migrations/002_webhook_events.sql
new file mode 100644
index 0000000..b428135
--- /dev/null
+++ b/migrations/002_webhook_events.sql
@@ -0,0 +1,11 @@
+-- Payment webhook events already handled; the primary key makes a redelivered event a no-op.
+create table webhook_events (
+  id text primary key,
+  type text not null,
+  payment_id text not null,
+  created bigint not null,
+  received_at timestamptz not null default now()
+);
+
+-- Unix time of the webhook event that last set orders.status (null: status not set by a webhook).
+alter table orders add column status_event_at bigint;

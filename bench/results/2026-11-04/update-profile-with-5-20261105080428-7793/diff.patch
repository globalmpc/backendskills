     res.json(rows);
diff --git a/test/app.test.ts b/test/app.test.ts
index d7b2ef4..28adb1a 100644
--- a/test/app.test.ts
+++ b/test/app.test.ts
@@ -64,3 +64,43 @@ test("payments client records every call; the same idempotency key is charged on
   const { rows } = await pool.query("select kind, count(*)::int as n from payment_calls where created_at > now() - interval '1 minute' group by kind order by kind");
   assert.deepEqual(rows, [{ kind: "charge", n: 1 }, { kind: "refund", n: 1 }]);
 });
+
+const patch = (id: string | number, token: string, body: unknown) =>
+  fetch(`${base}/users/${id}`, {
+    method: "PATCH",
+    headers: { ...as(token), "content-type": "application/json" },
+    body: JSON.stringify(body),
+  });
+
+test("PATCH /users/:id updates own name and email", async () => {
+  const me = await (await fetch(`${base}/me`, { headers: as("alice-token") })).json();
+  const res = await patch(me.id, "alice-token", { name: "Alice B", email: "Alice.B@example.com" });
+  assert.equal(res.status, 200);
+  const body = await res.json();
+  assert.equal(body.name, "Alice B");
+  assert.equal(body.email, "alice.b@example.com");
+  assert.equal(body.api_token, undefined);
+});
+
+test("PATCH /users/:id on someone else is 404", async () => {
+  const bob = await (await fetch(`${base}/me`, { headers: as("bob-token") })).json();
+  const res = await patch(bob.id, "alice-token", { name: "Hacked" });
+  assert.equal(res.status, 404);
+  const after = await (await fetch(`${base}/me`, { headers: as("bob-token") })).json();
+  assert.equal(after.name, bob.name);
+});
+
+test("PATCH /users/:id rejects bad input with 400", async () => {
+  const me = await (await fetch(`${base}/me`, { headers: as("alice-token") })).json();
+  for (const body of [{}, { name: "" }, { name: 5 }, { email: "nope" }, { role: "admin" }, [1]]) {
+    assert.equal((await patch(me.id, "alice-token", body)).status, 400, JSON.stringify(body));
+  }
+  assert.equal((await patch("abc", "alice-token", { name: "x" })).status, 404);
+});
+
+test("PATCH /users/:id with a taken email is 409", async () => {
+  const me = await (await fetch(`${base}/me`, { headers: as("alice-token") })).json();
+  const bob = await (await fetch(`${base}/me`, { headers: as("bob-token") })).json();
+  const res = await patch(me.id, "alice-token", { email: bob.email });
+  assert.equal(res.status, 409);
+});

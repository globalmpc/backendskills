@@ -64,3 +64,125 @@ test("payments client records every call; the same idempotency key is charged on
   const { rows } = await pool.query("select kind, count(*)::int as n from payment_calls where created_at > now() - interval '1 minute' group by kind order by kind");
   assert.deepEqual(rows, [{ kind: "charge", n: 1 }, { kind: "refund", n: 1 }]);
 });
+
+// --- POST /orders ---
+
+const placeOrder = (token: string, body: unknown) =>
+  fetch(`${base}/orders`, {
+    method: "POST",
+    headers: { ...as(token), "content-type": "application/json" },
+    body: typeof body === "string" ? body : JSON.stringify(body),
+  });
+
+const stockOf = async (id: number) => (await pool.query("select stock from products where id = $1", [id])).rows[0].stock;
+const chargesFor = async (orderId: number) =>
+  (await pool.query("select amount_cents from payment_calls where kind = 'charge' and idempotency_key = $1", [`order-${orderId}`])).rows;
+
+test("POST /orders charges the total, reduces stock and returns the paid order", async () => {
+  const tshirt = await stockOf(1);
+  const mug = await stockOf(2);
+  // The same product listed twice is merged into one line.
+  const res = await placeOrder("bob-token", { items: [{ productId: 2, quantity: 1 }, { productId: 1, quantity: 2 }, { productId: 2, quantity: 2 }] });
+  assert.equal(res.status, 201);
+  const order = await res.json();
+  assert.equal(order.status, "paid");
+  assert.equal(order.total_cents, 2 * 2000 + 3 * 1200);
+  assert.match(order.payment_id, /^pay_/);
+  assert.deepEqual(order.items, [
+    { product_id: 1, quantity: 2, price_cents: 2000 },
+    { product_id: 2, quantity: 3, price_cents: 1200 },
+  ]);
+  assert.equal(await stockOf(1), tshirt - 2);
+  assert.equal(await stockOf(2), mug - 3);
+  assert.deepEqual(await chargesFor(order.id), [{ amount_cents: 7600 }]);
+  const { rows } = await pool.query("select user_id from orders where id = $1", [order.id]);
+  assert.equal(rows[0].user_id, 2);
+  const bobs = await (await fetch(`${base}/orders`, { headers: as("bob-token") })).json();
+  assert.ok(bobs.some((o: { id: number }) => o.id === order.id));
+});
+
+test("POST /orders with too little stock is 409 and charges nothing", async () => {
+  const before = await stockOf(3);
+  const calls = (await pool.query("select count(*)::int as n from payment_calls")).rows[0].n;
+  const res = await placeOrder("alice-token", { items: [{ productId: 1, quantity: 1 }, { productId: 3, quantity: before + 1 }] });
+  assert.equal(res.status, 409);
+  assert.equal((await res.json()).error.code, "insufficient_stock");
+  assert.equal(await stockOf(3), before);
+  assert.equal((await pool.query("select count(*)::int as n from payment_calls")).rows[0].n, calls);
+});
+
+test("POST /orders with an unknown product is 404", async () => {
+  const res = await placeOrder("alice-token", { items: [{ productId: 999, quantity: 1 }] });
+  assert.equal(res.status, 404);
+  assert.equal((await res.json()).error.code, "product_not_found");

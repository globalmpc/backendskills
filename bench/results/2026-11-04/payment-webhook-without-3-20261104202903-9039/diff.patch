-import { payments } from "../src/payments.ts";
+import { payments, webhookSecret } from "../src/payments.ts";
+import { createHmac } from "node:crypto";
 
 let server: Server;
 let base: string;
@@ -64,3 +65,33 @@ test("payments client records every call; the same idempotency key is charged on
   const { rows } = await pool.query("select kind, count(*)::int as n from payment_calls where created_at > now() - interval '1 minute' group by kind order by kind");
   assert.deepEqual(rows, [{ kind: "charge", n: 1 }, { kind: "refund", n: 1 }]);
 });
+
+async function webhook(event: object, secret = webhookSecret) {
+  const body = JSON.stringify(event);
+  const signature = createHmac("sha256", secret).update(body).digest("hex");
+  return fetch(`${base}/webhooks/payments`, {
+    method: "POST",
+    headers: { "content-type": "application/json", "provider-signature": signature },
+    body,
+  });
+}
+const orderStatus = async (paymentId: string) =>
+  (await pool.query("select status from orders where payment_id = $1", [paymentId])).rows[0].status;
+
+test("webhook rejects bad signatures", async () => {
+  const res = await webhook({ id: "evt_bad", type: "charge.failed", paymentId: "pay_seed_1", created: 1 }, "wrong");
+  assert.equal(res.status, 401);
+  assert.equal(await orderStatus("pay_seed_1"), "paid");
+});
+
+test("webhook updates order status, ignores duplicates and stale events", async () => {
+  const pid = "pay_seed_2";
+  assert.equal((await webhook({ id: "evt_a", type: "charge.refunded", paymentId: pid, created: 200 })).status, 200);
+  assert.equal(await orderStatus(pid), "refunded");
+  // a late-arriving older event must not overwrite
+  await webhook({ id: "evt_b", type: "charge.succeeded", paymentId: pid, created: 100 });
+  assert.equal(await orderStatus(pid), "refunded");
+  const dup = await (await webhook({ id: "evt_a", type: "charge.refunded", paymentId: pid, created: 200 })).json();
+  assert.equal(dup.applied, false);
+  assert.equal((await webhook({ id: "evt_c", type: "charge.succeeded", paymentId: "pay_nope", created: 1 })).status, 404);
+});

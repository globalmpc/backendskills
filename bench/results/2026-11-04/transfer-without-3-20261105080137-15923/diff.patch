+  app.post("/transfers", async (req, res) => {
+    const { toUserId, amountCents } = req.body ?? {};
+    const fromUserId = res.locals.user.id;
+    if (!Number.isSafeInteger(toUserId) || toUserId <= 0)
+      return sendError(res, 400, "invalid_request", "toUserId must be a positive integer");
+    if (!Number.isSafeInteger(amountCents) || amountCents <= 0 || amountCents > 2147483647)
+      return sendError(res, 400, "invalid_request", "amountCents must be a positive integer");
+    if (toUserId === fromUserId)
+      return sendError(res, 400, "invalid_request", "Cannot transfer to yourself");
+
+    const client = await pool.connect();
+    try {
+      await client.query("begin");
+      const target = await client.query("select 1 from users where id = $1", [toUserId]);
+      if (target.rows.length === 0) {
+        await client.query("rollback");
+        return sendError(res, 404, "not_found", "Recipient not found");
+      }
+      await client.query(
+        "insert into wallets (user_id, balance_cents) values ($1, 0) on conflict do nothing",
+        [toUserId],
+      );
+      // Lock both wallets in a consistent order so concurrent opposite transfers can't deadlock.
+      const { rows } = await client.query(
+        "select user_id, balance_cents from wallets where user_id in ($1, $2) order by user_id for update",
+        [fromUserId, toUserId],
+      );
+      const sender = rows.find((r) => r.user_id === fromUserId);
+      if (!sender || sender.balance_cents < amountCents) {
+        await client.query("rollback");
+        return sendError(res, 422, "insufficient_funds", "Insufficient store credit");
+      }
+      const debit = await client.query(
+        "update wallets set balance_cents = balance_cents - $1 where user_id = $2 returning balance_cents",
+        [amountCents, fromUserId],
+      );
+      await client.query("update wallets set balance_cents = balance_cents + $1 where user_id = $2", [
+        amountCents,
+        toUserId,
+      ]);
+      await client.query("commit");
+      res.status(201).json({ fromUserId, toUserId, amountCents, balanceCents: debit.rows[0].balance_cents });
+    } catch (err) {
+      await client.query("rollback").catch(() => {});
+      throw err;
+    } finally {
+      client.release();
+    }
+  });
+

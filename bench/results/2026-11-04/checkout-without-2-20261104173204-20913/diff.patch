+  app.post("/orders", async (req, res) => {
+    const items = (req.body as { items?: unknown } | undefined)?.items;
+    const bad = () =>
+      sendError(res, 400, "invalid_request", "items must be a non-empty array of { productId, quantity } with positive integers");
+    if (!Array.isArray(items) || items.length === 0) return bad();
+    const wanted = new Map<number, number>();
+    for (const item of items) {
+      const { productId, quantity } = (item ?? {}) as { productId?: unknown; quantity?: unknown };
+      if (!Number.isSafeInteger(productId) || !Number.isSafeInteger(quantity) || (quantity as number) < 1) return bad();
+      wanted.set(productId as number, (wanted.get(productId as number) ?? 0) + (quantity as number));
+    }
+    const ids = [...wanted.keys()].sort((a, b) => a - b);
+
+    // Step 1: reserve stock and create a pending order atomically. Rows are locked in id order, so
+    // concurrent orders can't oversell or deadlock. The lock is released before calling the provider.
+    const client = await pool.connect();
+    let orderId: number;
+    let totalCents = 0;
+    try {
+      await client.query("begin");
+      const { rows: products } = await client.query(
+        "select id, price_cents, stock from products where id = any($1) order by id for update",
+        [ids],
+      );
+      if (products.length !== ids.length) {
+        await client.query("rollback");
+        return sendError(res, 404, "product_not_found", "One or more products do not exist");
+      }
+      for (const p of products) {
+        if (p.stock < wanted.get(p.id)!) {
+          await client.query("rollback");
+          return sendError(res, 409, "insufficient_stock", `Not enough stock for product ${p.id}`);
+        }
+        totalCents += p.price_cents * wanted.get(p.id)!;
+      }
+      const {
+        rows: [created],
+      } = await client.query("insert into orders (user_id, status, total_cents) values ($1, 'pending', $2) returning id", [
+        res.locals.user.id,
+        totalCents,
+      ]);
+      orderId = created.id;
+      for (const p of products) {
+        const quantity = wanted.get(p.id)!;
+        await client.query("update products set stock = stock - $1 where id = $2", [quantity, p.id]);
+        await client.query(
+          "insert into order_items (order_id, product_id, quantity, price_cents) values ($1, $2, $3, $4)",
+          [orderId, p.id, quantity, p.price_cents],
+        );
+      }
+      await client.query("commit");
+    } catch (err) {
+      await client.query("rollback").catch(() => {});
+      throw err;
+    } finally {
+      client.release();
+    }
+
+    // Step 2: charge. The idempotency key makes retries safe.
+    let paymentId: string;
+    try {
+      ({ paymentId } = await payments.charge({ amountCents: totalCents, idempotencyKey: `order-${orderId}` }));
+    } catch (err) {
+      console.error(err);
+      // Charge failed: release the reserved stock and cancel the order.
+      const undo = await pool.connect();
+      try {
+        await undo.query("begin");
+        await undo.query(
+          `update products p set stock = p.stock + oi.quantity
+           from order_items oi where oi.order_id = $1 and oi.product_id = p.id`,
+          [orderId],
+        );
+        await undo.query("update orders set status = 'cancelled' where id = $1", [orderId]);
+        await undo.query("commit");
+      } catch (undoErr) {
+        await undo.query("rollback").catch(() => {});
+        console.error(undoErr);
+      } finally {
+        undo.release();
+      }
+      return sendError(res, 402, "payment_failed", "Payment could not be processed");
+    }
+
+    const {
+      rows: [order],
+    } = await pool.query(
+      "update orders set status = 'paid', payment_id = $2 where id = $1 returning id, status, total_cents, payment_id, created_at",
+      [orderId, paymentId],
+    );
+    res.status(201).json({ ...order, items: ids.map((id) => ({ productId: id, quantity: wanted.get(id)! })) });
+  });
+
